<section
  class="pf-contact-form color-{{ section.settings.color_scheme }}"
  style="--form-pt: {{ section.settings.padding_top | default: 20 }}px; --form-pb: {{ section.settings.padding_bottom | default: 28 }}px;"
>
  <div class="pf-contact-shell">
    <div class="pf-contact-form__wrapper">
      
      {% if section.settings.heading != blank %}
        <div class="pf-contact-form__head">
          {% if section.settings.eyebrow != blank %}
            <span class="pf-contact-form__eyebrow">{{ section.settings.eyebrow }}</span>
          {% endif %}
          
          <h2 class="pf-contact-form__title">
            {{ section.settings.heading }}
          </h2>

          {% if section.settings.subheading != blank %}
            <p class="pf-contact-form__intro">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="pf-contact-form__card">
        {% form 'contact', class: 'pf-contact-form__form', novalidate: 'novalidate' %}
          
          {% if form.posted_successfully? %}
            <div class="pf-form-alert pf-form-alert--success" role="status" tabindex="-1" autofocus>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>{{ section.settings.success_message | default: "Thank you for reaching out! We'll get back to you shortly." }}</span>
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="pf-form-alert pf-form-alert--error" role="alert" tabindex="-1" autofocus>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              <div>{{ form.errors | default_errors }}</div>
            </div>
          {% endif %}

          {% if section.settings.show_topics %}
            <!-- Subject / Topic Chips -->
            <div class="pf-contact-form__topics">
              <label class="pf-form-label">Quick Topic</label>
              <div class="pf-topic-chips" role="radiogroup" aria-label="Inquiry Topic">
                <button type="button" class="pf-chip is-active" data-topic="General Inquiry">General</button>
                <button type="button" class="pf-chip" data-topic="Order & Delivery Support">Order Support</button>
                <button type="button" class="pf-chip" data-topic="Fragrance Advice">Fragrance Advice</button>
                <button type="button" class="pf-chip" data-topic="Stylist & Creator Collabs">Collabs</button>
              </div>
            </div>
          {% endif %}

          <!-- Fields Grid -->
          <div class="pf-form-grid">
            <div class="pf-form-group">
              <label for="ContactFormName" class="pf-form-label">Your Name <span class="pf-req">*</span></label>
              <input
                id="ContactFormName"
                type="text"
                name="contact[name]"
                class="pf-input"
                placeholder="e.g. Alex Morgan"
                value="{{ form.name | default: customer.name }}"
                required
                aria-required="true"
              >
            </div>

            <div class="pf-form-group">
              <label for="ContactFormEmail" class="pf-form-label">Email Address <span class="pf-req">*</span></label>
              <input
                id="ContactFormEmail"
                type="email"
                name="contact[email]"
                class="pf-input"
                placeholder="e.g. alex@example.com"
                value="{{ form.email | default: customer.email }}"
                required
                aria-required="true"
                spellcheck="false"
                autocomplete="email"
              >
            </div>

            <div class="pf-form-group">
              <label for="ContactFormPhone" class="pf-form-label">Phone Number (Optional)</label>
              <input
                id="ContactFormPhone"
                type="tel"
                name="contact[phone]"
                class="pf-input"
                placeholder="+91 00000 00000"
                value="{{ form.phone }}"
                autocomplete="tel"
              >
            </div>

            <div class="pf-form-group">
              <label for="ContactFormSubject" class="pf-form-label">Subject</label>
              <input
                id="ContactFormSubject"
                type="text"
                name="contact[subject]"
                class="pf-input"
                placeholder="e.g. Fragrance Advice or Product Enquiry"
                value="{{ form.subject | default: 'General Inquiry' }}"
              >
            </div>

            <div class="pf-form-group pf-form-group--full">
              <label for="ContactFormMessage" class="pf-form-label">How can we help? <span class="pf-req">*</span></label>
              <textarea
                id="ContactFormMessage"
                name="contact[body]"
                rows="5"
                class="pf-input pf-textarea"
                placeholder="Please describe your query in detail..."
                required
                aria-required="true"
              >{{ form.body }}</textarea>
            </div>
          </div>

          <!-- Form Action Footer -->
          <div class="pf-contact-form__footer">
            <button type="submit" class="pf-submit-btn">
              <span>{{ section.settings.button_label | default: 'Send Message' }}</span>
              <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M2.5 8h11M9.5 3.5l4.5 4.5-4.5 4.5"/>
              </svg>
            </button>
            <p class="pf-form-privacy">
              {{ section.settings.privacy_text | default: 'We respect your privacy and will never share your details.' }}
            </p>
          </div>

        {% endform %}
      </div>

    </div>
  </div>
</section>

<style>
  .pf-contact-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .pf-contact-shell {
      padding: 0 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .pf-contact-shell {
      padding: 0 10px;
    }
  }

  .pf-contact-form {
    background-color: #ffffff;
    color: var(--color-foreground, #111111);
    padding-top: var(--form-pt, 20px);
    padding-bottom: var(--form-pb, 28px);
  }

  .pf-contact-form__wrapper {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .pf-contact-form__head {
    text-align: center;
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  .pf-contact-form__eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pf-gold, #c5a880);
    margin-bottom: 8px;
  }

  .pf-contact-form__title {
    margin: 0 0 8px;
    font-family: var(--font-heading--family), sans-serif;
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-foreground-heading, #111111);
  }

  .pf-contact-form__intro {
    margin: 0 auto;
    font-size: 13.5px;
    line-height: 1.5;
    color: currentColor;
    opacity: 0.75;
    max-width: 48ch;
  }

  .pf-contact-form__card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: clamp(24px, 4vw, 40px);
    box-shadow: 0 10px 36px -8px rgba(0, 0, 0, 0.04);
    box-sizing: border-box;
  }

  .pf-form-alert {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-radius: 6px;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.4;
  }

  .pf-form-alert--success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .pf-form-alert--error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .pf-contact-form__topics {
    margin-bottom: 24px;
  }

  .pf-topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .pf-chip {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 5px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 500;
    color: currentColor;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    -webkit-appearance: none;
  }

  .pf-chip:hover {
    border-color: #111111;
    color: #111111;
    background: rgba(0, 0, 0, 0.04);
  }

  .pf-chip.is-active {
    background: #111111;
    border-color: #111111;
    color: #ffffff;
  }

  .pf-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .pf-form-group {
    display: flex;
    flex-direction: column;
  }

  .pf-form-group--full {
    grid-column: 1 / -1;
  }

  .pf-form-label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-foreground-heading, #111111);
    margin-bottom: 7px;
    letter-spacing: 0.01em;
  }

  .pf-req {
    color: #e11d48;
    margin-left: 2px;
  }

  .pf-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 5px;
    background: #ffffff;
    color: var(--color-foreground-heading, #111111);
    font-size: 13.5px;
    font-family: inherit;
    line-height: 1.4;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .pf-input::placeholder {
    color: rgba(0, 0, 0, 0.35);
  }

  .pf-input:focus {
    outline: none;
    border-color: #111111;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
  }

  .pf-textarea {
    resize: vertical;
    min-height: 130px;
  }

  .pf-contact-form__footer {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .pf-submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 28px;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    border: 0;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .pf-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -4px rgba(0, 0, 0, 0.2);
    background: #2a2a2a;
  }

  .pf-submit-btn:active {
    transform: translateY(0);
  }

  .pf-form-privacy {
    margin: 0;
    font-size: 12px;
    color: currentColor;
    opacity: 0.6;
    max-width: 34ch;
  }

  @media screen and (max-width: 640px) {
    .pf-contact-form__card {
      padding: 22px 16px;
    }

    .pf-form-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pf-contact-form__footer {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }

    .pf-submit-btn {
      width: 100%;
      justify-content: center;
    }

    .pf-form-privacy {
      max-width: 100%;
    }
  }
</style>

{% javascript %}
  (() => {
    document.querySelectorAll('.pf-contact-form').forEach((section) => {
      if (section.dataset.init === 'true') return;
      section.dataset.init = 'true';

      const chips = section.querySelectorAll('.pf-chip');
      const subjectInput = section.querySelector('#ContactFormSubject');

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');
          if (subjectInput) {
            subjectInput.value = chip.dataset.topic || chip.textContent.trim();
          }
        });
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inquiries & Fragrance Advice" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send Us a Message" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Fill in the details below and our concierge team will respond within one business day." },
    { "type": "checkbox", "id": "show_topics", "label": "Show quick topic chips", "default": false },
    { "type": "header", "content": "Form Settings" },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Send Message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you for reaching out! We've received your note and will be in touch shortly." },
    { "type": "text", "id": "privacy_text", "label": "Privacy assurance note", "default": "We respect your privacy and will never share your details with third parties." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Top padding", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Bottom padding", "default": 28 }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
