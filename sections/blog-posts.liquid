<section class="pf-blog color-{{ section.settings.color_scheme }}">
  <div class="pf-section-shell pf-blog__shell">
    <div class="pf-blog__header">
      <div class="pf-blog__heading-wrap">
        <span class="pf-blog__dot" aria-hidden="true"></span>
        <div class="pf-blog__heading-copy">
          {% if section.settings.heading != blank %}<h2 class="pf-blog__heading">{{ section.settings.heading }}</h2>{% endif %}
          {% if section.settings.subheading != blank %}<p class="pf-blog__subheading">{{ section.settings.subheading }}</p>{% endif %}
        </div>
      </div>
      {% if section.settings.button_label != blank and section.settings.blog != blank %}
        <a class="pf-blog__button" href="{{ section.settings.blog.url }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>

    <div class="pf-blog__grid">
      {% if section.settings.blog != blank %}
        {% for article in section.settings.blog.articles limit: section.settings.max_posts %}
          <article class="pf-blog-card">
            <a href="{{ article.url }}" class="pf-blog-card__media">
              {% if article.image != blank %}{{ article.image | image_url: width: 1400 | image_tag: class: 'pf-blog-card__image', loading: 'lazy', widths: '360, 540, 720, 900, 1400', alt: article.title }}{% endif %}
            </a>
            <div class="pf-blog-card__body">
              <p class="pf-blog-card__meta">
                <span>{{ section.settings.meta_label }}</span>
                <span aria-hidden="true">|</span>
                <span>{{ article.published_at | date: "%b %d, %Y" }}</span>
              </p>
              <a href="{{ article.url }}" class="pf-blog-card__title">{{ article.title }}</a>
              <p class="pf-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
              <a href="{{ article.url }}" class="pf-blog-card__button">Read more</a>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pf-blog__shell {
    padding-block: clamp(42px, 5.5vw, 92px);
  }

  .pf-blog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(28px, 3.5vw, 54px);
  }

  .pf-blog__heading-wrap {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    min-width: 0;
  }

  .pf-blog__dot {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: #2f201c;
    flex: 0 0 auto;
    margin-top: 10px;
  }

  .pf-blog__heading-copy {
    min-width: 0;
  }

  .pf-blog__heading {
    margin: 0;
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
    color: #2f201c;
  }

  .pf-blog__subheading {
    margin: 12px 0 0;
    max-width: 58ch;
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgb(47 32 28 / 0.72);
  }

  .pf-blog__button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 34px;
    border: 1px solid rgb(220 123 72 / 0.9);
    border-radius: 999px;
    color: rgb(220 123 72 / 0.95);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .pf-blog__button:hover {
    background: rgb(220 123 72 / 0.08);
    transform: translateY(-1px);
  }

  .pf-blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 38px 32px;
  }

  .pf-blog-card {
    overflow: hidden;
    border: 0;
    background: transparent;
  }

  .pf-blog-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .pf-blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .pf-blog-card:hover .pf-blog-card__image {
    transform: scale(1.03);
  }

  .pf-blog-card__body {
    padding: 18px 2px 0;
  }

  .pf-blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin: 0 0 12px;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(47 32 28 / 0.8);
  }

  .pf-blog-card__title {
    display: block;
    color: #2f201c;
    text-decoration: none;
    font-size: clamp(1.4rem, 1.8vw, 2.15rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .pf-blog-card__excerpt {
    margin: 18px 0 0;
    line-height: 1.7;
    font-size: 1rem;
    color: rgb(47 32 28 / 0.78);
  }

  .pf-blog-card__button {
    display: inline-flex;
    margin-top: 18px;
    color: #2f201c;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .pf-blog__header {
      flex-direction: column;
    }

    .pf-blog__button {
      min-height: 52px;
      padding-inline: 28px;
    }

    .pf-blog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    .pf-blog__dot {
      width: 46px;
      height: 46px;
      margin-top: 8px;
    }

    .pf-blog__heading {
      font-size: clamp(2.6rem, 13vw, 3.6rem);
    }

    .pf-blog-card__title {
      font-size: clamp(1.25rem, 6vw, 1.7rem);
    }

    .pf-blog-card__excerpt {
      font-size: 0.96rem;
    }

    .pf-blog__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "max_posts", "label": "Posts", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "meta_label", "label": "Meta label", "default": "Style & Streetwear" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spill the Style" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The latest reads, styling guides, and drop updates from the Stag Men Fashion world." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
