          "settings": {
            "rating": 5,
            "quote": "\"Finally found streetwear that gets the oversized silhouette just right for men. The heavyweight cotton feels incredibly luxe and holds its shape.\"",
            "name": "Sneha",
            "initials": "SM",
            "role": "Fashion Creator"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "\"The co-ord sets are an absolute staple in my wardrobe now. Impeccable tailoring, vibrant colors, and super comfortable for all-day styling.\"",
            "name": "Ananya",
            "initials": "AR",
            "role": "Verified Buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
