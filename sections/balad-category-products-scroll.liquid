  /* ── Modals & Shared UI ────────────────────────────────────────── */
  .balad-wishlist-modal,
  .balad-qa-modal,
  .balad-size-guide-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
