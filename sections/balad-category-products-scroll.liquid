{{ 'balad-product-card.css' | asset_url | stylesheet_tag }}
{% liquid
  assign coll_handle = section.settings.collection
  if coll_handle != blank
    assign active_collection = collections[coll_handle]
  endif
  if active_collection == blank or active_collection.products.size == 0
    assign active_collection = collections['all']
  endif
  if active_collection == blank or active_collection.products.size == 0
    assign active_collection = collections['new-in']
  endif
  if active_collection == blank or active_collection.products.size == 0
    assign active_collection = collections['co-ords']
  endif

  assign limit_count = section.settings.products_to_show | default: 12
  assign sorted_products = active_collection.products
  assign discover_url = section.settings.discover_more_link | default: active_collection.url
%}

<section
  class="balad-catprod color-{{ section.settings.color_scheme }}"
  data-catprod-section="{{ section.id }}"
  style="
    --catprod-section-bg: {{ section.settings.section_background | default: 'transparent' }};
    --catprod-bg: {{ section.settings.background | default: '#f0f1f4' }};
    --catprod-radius: {{ section.settings.shell_radius | default: 16 }}px;
  "
>
  <div class="balad-catprod__shell">
    
    <!-- ── Header ── -->
    <div class="balad-catprod__head">
      <div class="balad-catprod__heading-wrap">
        {% if section.settings.heading != blank %}
          <h2 class="balad-catprod__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="balad-catprod__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="balad-catprod__head-right">
        {% if section.settings.discover_more_label != blank and discover_url != blank %}
          <a
            href="{{ discover_url }}"
            class="balad-catprod__discover-more"
          >
            {{ section.settings.discover_more_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- ── Horizontally Scrolling Products Rail ── -->
    <div class="balad-catprod__rail-wrap">
      <div class="balad-catprod__rail" data-catprod-rail>
        {% if sorted_products.size > 0 %}
          {% for product in sorted_products limit: limit_count %}
            {% liquid
              assign images = product.images
              assign image_count = images.size
              assign first_image = product.featured_image | default: images.first
              assign sizes_list = ''
              for opt in product.options_with_values
                assign opt_name_down = opt.name | downcase
                if opt_name_down contains 'size' or opt.name == 'Size'
                  assign sizes_list = opt.values | join: ','
                endif
              endfor
              if sizes_list == ''
                assign sizes_check = '|'
                for v in product.variants
                  assign sz = v.option1 | strip
                  unless sz == blank or sz == 'Default Title'
                    assign check_sz = '|' | append: sz | append: '|'
                    unless sizes_check contains check_sz
                      assign sizes_check = sizes_check | append: check_sz
                      if sizes_list != ''
                        assign sizes_list = sizes_list | append: ','
                      endif
                      assign sizes_list = sizes_list | append: sz
                    endunless
                  endunless
                endfor
              endif

              assign card_has_sale = false
              assign card_discount_pct = 0
              if product.compare_at_price > product.price
                assign card_has_sale = true
                assign card_discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
              endif
            %}

            <div class="balad-catprod__card" data-product-card>
              {% render 'balad-product-card', product: product, limit: 6, show_buy_now: section.settings.show_buy_now %}
            </div>
          {% endfor %}

        {% else %}
          {% for i in (1..6) %}
            <div class="balad-catprod__card balad-catprod__card--placeholder">
              <div class="balad-catprod__media-wrap">
                <div class="balad-catprod__media">
                  {{ 'product-1' | placeholder_svg_tag: 'balad-catprod__placeholder' }}
                  <div class="balad-catprod__badges">
                    <span class="balad-catprod__badge balad-catprod__badge--sale">-20%</span>
                  </div>
                </div>
              </div>
              <div class="balad-catprod__body">
                <div class="balad-catprod__meta">
                  <h3 class="balad-catprod__title">Stag Essential {{ i }}</h3>
                  <div class="balad-catprod__price-row">
                    <span class="balad-catprod__price">₹1,499</span>
                    <span class="balad-catprod__compare-price">₹1,899</span>
                    <span class="balad-catprod__discount-tag">20% OFF</span>
                  </div>
                </div>
                <span class="balad-catprod__action-btn">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>Quick Add</span>
                </span>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

  </div>

  <!-- ── Wishlist Modal ── -->
  <div class="balad-wishlist-modal" data-wishlist-modal style="display:none;" hidden>
    <div class="balad-wishlist-modal__backdrop" data-wishlist-close></div>
    <div class="balad-wishlist-modal__card">
      <button type="button" class="balad-wishlist-modal__close" data-wishlist-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="balad-wishlist-modal__header">
        <div class="balad-wishlist-modal__product-img" data-wishlist-img></div>
        <div class="balad-wishlist-modal__product-info">
          <h3 class="balad-wishlist-modal__title" data-wishlist-title></h3>
          <div class="balad-wishlist-modal__price-wrap">
            <span class="balad-wishlist-modal__price" data-wishlist-price></span>
            <span class="balad-wishlist-modal__compare-price" data-wishlist-compare-price></span>
          </div>
        </div>
      </div>

      <div class="balad-wishlist-modal__sizes">
        <div class="balad-wishlist-modal__sizes-top">
          <span class="balad-wishlist-modal__label" data-wishlist-size-label>Size</span>
        </div>
        <div class="balad-wishlist-modal__size-grid" data-wishlist-sizes></div>
      </div>

      <button type="button" class="balad-wishlist-modal__add-btn" data-wishlist-add>
        Add To List
      </button>
    </div>
  </div>

  <!-- ── Quick Add Modal ── -->
  <div class="balad-qa-modal" data-qa-modal style="display:none;" hidden>
    <div class="balad-qa-modal__backdrop" data-qa-close></div>
    <div class="balad-qa-modal__card">
      <button type="button" class="balad-qa-modal__close" data-qa-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="balad-qa-modal__header">
        <div class="balad-qa-modal__product-img" data-qa-img></div>
        <div class="balad-qa-modal__product-info">
          <h3 class="balad-qa-modal__title" data-qa-title></h3>
          <span class="balad-qa-modal__price" data-qa-price></span>
        </div>
      </div>

      <div class="balad-qa-modal__sizes">
        <div class="balad-qa-modal__sizes-top">
          <span class="balad-qa-modal__label">Size</span>
        </div>
        <div class="balad-qa-modal__size-grid" data-qa-sizes></div>
      </div>

      <div class="balad-qa-modal__actions" data-qa-actions>
        <button type="button" class="balad-qa-modal__btn balad-qa-modal__btn--bag" data-qa-add-bag>Add To Bag</button>
        <button type="button" class="balad-qa-modal__btn balad-qa-modal__btn--buy" data-qa-buy-now>Buy Now</button>
      </div>
      <div class="balad-qa-modal__sold-out" data-qa-sold-out style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        <span>Sold Out</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section & Styled Shell with Background, Margin & Border Radius ── */
  .balad-catprod {
    background: var(--catprod-section-bg, #ffffff) !important;
    padding-top: clamp(14px, 2vw, 22px);
    padding-bottom: 0;
    --catprod-heading-size: 20px;
    --catprod-discover-more-size: 13px;
    --catprod-card-title-size: 14px;
    --catprod-card-price-size: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .balad-catprod__shell {
    width: auto;
    max-width: 100%;
    margin: 0 36px;
    background: var(--catprod-bg, #ffffff) !important;
    border-radius: var(--catprod-radius, 16px);
    padding: clamp(14px, 1.6vw, 20px) clamp(12px, 1.4vw, 20px) clamp(14px, 1.6vw, 20px);
    box-sizing: border-box;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
  }

  /* ── Header ── */
  .balad-catprod__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgb(17 17 17 / 0.1);
  }

  .balad-catprod__heading-wrap {
    flex: 1;
    min-width: 0;
  }

  .balad-catprod__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--catprod-heading-size);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading, #111111);
  }

  .balad-catprod__subheading {
    margin: 6px 0 0;
    font-size: 14px;
    color: #6b7280;
    line-height: 1.4;
    font-weight: 400;
  }

  .balad-catprod__head-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .balad-catprod__discover-more {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #111111;
    font-size: var(--catprod-discover-more-size);
    font-weight: 600;
    padding: 0;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.25s ease;
    flex-shrink: 0;
  }

  .balad-catprod__discover-more:hover {
    color: var(--color-primary, #000000);
  }

  /* ── Rail Container matching Category Scroll ── */
  .balad-catprod__rail-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .balad-catprod__rail {
    --catprod-cols: 6;
    --catprod-gap: 8px;
    display: grid;
    grid-template-columns: repeat(var(--catprod-cols), minmax(0, 1fr));
    gap: 12px var(--catprod-gap);
    width: 100%;
    padding-bottom: 4px;
    box-sizing: border-box;
  }

  /* Only show the chosen number of rows */
  .balad-catprod__card:nth-child(n + {{ section.settings.rows | default: 2 | times: 6 | plus: 1 }}) {
    display: none;
  }

  /* ── Product Card (Modern Shop Card with Bottom Action Bar) ── */
  .balad-catprod__card {
    width: 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: transparent;
    border-radius: 0;
    border: none;
    box-shadow: none;
    position: relative;
  }

  .balad-catprod__media-wrap {
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #f5f5f7;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  /* Responsive column sizing */
  @media screen and (min-width: 1025px) and (max-width: 1400px) {
    .balad-catprod__rail { --catprod-cols: 5; }
    .balad-catprod__card:nth-child(n + {{ section.settings.rows | default: 2 | times: 5 | plus: 1 }}) { display: none; }
    .balad-catprod__card:nth-child(-n + {{ section.settings.rows | default: 2 | times: 5 }}) { display: flex; }
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .balad-catprod__shell { margin: 0 20px; }
    .balad-catprod__rail { --catprod-cols: 4; }
    .balad-catprod__card:nth-child(n + {{ section.settings.rows | default: 2 | times: 4 | plus: 1 }}) { display: none; }
    .balad-catprod__card:nth-child(-n + {{ section.settings.rows | default: 2 | times: 4 }}) { display: flex; }
  }

  @media screen and (max-width: 749px) {
    .balad-catprod {
      --catprod-heading-size: 18px;
      --catprod-card-title-size: 14px;
      --catprod-card-price-size: 12px;
      --catprod-discover-more-size: 12.5px;
    }

    .balad-catprod__shell {
      margin: 0 12px;
      border-radius: 16px;
      padding: 12px 10px 14px;
    }

    .balad-catprod__head {
      margin-bottom: 12px;
      padding-bottom: 10px;
    }

    .balad-catprod__rail {
      --catprod-cols: 2;
      gap: 10px 8px;
    }

    .balad-catprod__card:nth-child(n + {{ section.settings.rows | default: 2 | times: 2 | plus: 1 }}) { display: none; }
    .balad-catprod__card:nth-child(-n + {{ section.settings.rows | default: 2 | times: 2 }}) { display: flex; }

    .balad-catprod__action-btn {
      height: 30px;
      font-size: 10px;
      margin-top: 6px;
    }

    .balad-catprod__action-btn svg {
      width: 12px;
      height: 12px;
    }
  }

  /* Media Box */
  .balad-catprod__media {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #f5f5f7;
    text-decoration: none;
    touch-action: pan-x pan-y;
    user-select: none;
    -webkit-user-drag: none;
    cursor: pointer;
  }

  .balad-catprod__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .balad-catprod__image.is-active {
    opacity: 1;
    z-index: 2;
  }

  .balad-catprod__card:hover .balad-catprod__image.is-active {
    transform: scale(1.04);
  }

  .balad-catprod__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #fafafa;
  }

  /* Badges */
  .balad-catprod__badges {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 4px;
    pointer-events: none;
  }

  .balad-catprod__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 6px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 3px;
    line-height: 1;
  }

  .balad-catprod__badge--sale {
    background: #111111;
    color: #ffffff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  }

  /* Wishlist / Heart Button */
  .balad-catprod__heart {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 6;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 50%;
    color: #111111;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease, color 0.2s ease;
  }

  .balad-catprod__heart:hover {
    background: #ffffff;
    transform: scale(1.12);
    color: #111111;
  }

  .balad-catprod__heart svg {
    width: 15px;
    height: 15px;
    pointer-events: none;
    display: block;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .balad-catprod__heart.is-saved {
    background: #ffffff;
    color: #111111;
  }

  .balad-catprod__heart.is-saved svg {
    fill: currentColor;
  }

  /* Carousel Dots */
  .balad-catprod__dots {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 4px;
    z-index: 5;
    padding: 3px 6px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .balad-catprod__card:hover .balad-catprod__dots {
    opacity: 1;
  }

  .balad-catprod__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .balad-catprod__dot:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  .balad-catprod__dot.is-active {
    background: #ffffff;
    width: 10px;
    border-radius: 999px;
  }

  /* ── Product Body Details ── */
  .balad-catprod__body {
    display: flex;
    flex-direction: column;
    padding: 8px 2px 2px 2px;
  }

  .balad-catprod__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    min-width: 0;
  }

  .balad-catprod__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
  }

  .balad-catprod__title-link {
    text-decoration: none;
    color: inherit;
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.3;
  }

  .balad-catprod__rating {
    display: inline-flex;
    align-items: center;
    gap: 3.5px;
    flex-shrink: 0;
    line-height: 1;
    white-space: nowrap;
    padding: 1px 0;
  }

  .balad-catprod__stars {
    display: inline-flex;
    align-items: center;
    gap: 1.5px;
    color: #ffb400;
    font-size: 14px;
    line-height: 1;
  }

  .balad-catprod__star {
    display: inline-block;
    color: #ffb400;
    font-size: 14px;
    line-height: 1;
  }

  .balad-catprod__star.is-dim {
    color: #dedede;
  }

  .balad-catprod__rating-score {
    font-size: 12.5px;
    font-weight: 700;
    color: #111111;
    line-height: 1;
    margin-left: 2px;
  }

  .balad-catprod__rating-count {
    font-size: 11.5px;
    font-weight: 600;
    color: #666666;
    line-height: 1;
  }

  /* Judge.me preview badge sizing overrides */
  .balad-catprod__rating .jdgm-preview-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 3.5px !important;
    line-height: 1 !important;
    margin: 0 !important;
  }

  .balad-catprod__rating .jdgm-prev-badge__stars {
    display: inline-flex !important;
    align-items: center !important;
    gap: 1.5px !important;
    color: #ffb400 !important;
    font-size: 14px !important;
    line-height: 1 !important;
  }

  .balad-catprod__rating .jdgm-star {
    font-size: 14px !important;
    color: #ffb400 !important;
    line-height: 1 !important;
  }

  .balad-catprod__rating .jdgm-prev-badge__text {
    font-size: 11.5px !important;
    font-weight: 600 !important;
    color: #666666 !important;
    line-height: 1 !important;
    margin-left: 2px !important;
  }

  .balad-catprod__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--catprod-card-title-size);
    font-weight: 600;
    color: var(--color-foreground, #111111);
    letter-spacing: -0.01em;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  .balad-catprod__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left bottom;
    transition: transform 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .balad-catprod__title-link:hover .balad-catprod__title::after {
    transform: scaleX(1);
  }

  .balad-catprod__price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 0;
  }

  .balad-catprod__price {
    font-size: var(--catprod-card-price-size);
    font-weight: 700;
    color: var(--color-foreground, #111111);
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .balad-catprod__compare-price {
    font-size: calc(var(--catprod-card-price-size) * 0.9);
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.45);
    text-decoration: line-through;
    line-height: 1.2;
    white-space: nowrap;
  }

  .balad-catprod__discount-tag {
    font-size: 9.5px;
    font-weight: 700;
    color: #111111;
    background: rgba(17, 17, 17, 0.08);
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* ── Full-Width Action Button Bar ── */
  .balad-catprod__action-btn {
    width: 100%;
    height: 32px;
    background: #111111;
    color: #ffffff;
