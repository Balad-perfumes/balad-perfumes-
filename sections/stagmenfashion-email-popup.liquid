<section
  class="stagmenfashion-email-popup"
  data-stagmenfashion-email-popup
  data-popup-id="{{ section.id }}"
  data-show-after-time="{{ section.settings.show_after_seconds }}"
  hidden
>
  <div
    id="stagmenfashion-email-popup-dialog-{{ section.id }}"
    class="stagmenfashion-email-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="stagmenfashion-email-popup-title-{{ section.id }}"
    aria-describedby="stagmenfashion-email-popup-description-{{ section.id }}"
  >
    <div class="stagmenfashion-email-popup__panel">
      <button type="button" class="stagmenfashion-email-popup__close" aria-label="Close popup" data-stagmenfashion-email-popup-close>
        <span aria-hidden="true">×</span>
      </button>

      <div class="stagmenfashion-email-popup__hero">
        <p class="stagmenfashion-email-popup__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="stagmenfashion-email-popup-title-{{ section.id }}" class="stagmenfashion-email-popup__hero-title">
          {{ section.settings.hero_heading }}
        </h2>
      </div>

      <div class="stagmenfashion-email-popup__body">
        <p class="stagmenfashion-email-popup__brand">{{ section.settings.brand }}</p>

        <h3 class="stagmenfashion-email-popup__title">{{ section.settings.heading }}</h3>
        <p id="stagmenfashion-email-popup-description-{{ section.id }}" class="stagmenfashion-email-popup__description">
          {{ section.settings.subheading }}
        </p>

        {% form 'customer', class: 'stagmenfashion-email-popup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">

          <label class="stagmenfashion-email-popup__label" for="StagMenFashionEmailPopupEmail-{{ section.id }}">
            {{ 'sections.email_popup.email_label' | t | default: 'Your email address' }}
          </label>
          <input
            id="StagMenFashionEmailPopupEmail-{{ section.id }}"
            class="stagmenfashion-email-popup__input"
            type="email"
            name="contact[email]"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ section.settings.placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >

          <button type="submit" class="stagmenfashion-email-popup__submit">
            {{ section.settings.button_label }}
          </button>

          {% if form.posted_successfully? %}
            <p class="stagmenfashion-email-popup__message stagmenfashion-email-popup__message--success">
              {{ section.settings.success_message }}
            </p>
          {% endif %}

          {% if form.errors %}
            <p class="stagmenfashion-email-popup__message stagmenfashion-email-popup__message--error">
              {{ form.errors | default_errors }}
            </p>
          {% endif %}
        {% endform %}

        {% if section.settings.fine_print != blank %}
          <p class="stagmenfashion-email-popup__fine-print">{{ section.settings.fine_print }}</p>
        {% endif %}
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.currentScript?.closest('.stagmenfashion-email-popup');
      if (!root) return;

      const dialog = root.querySelector('[role="dialog"]');
      const closeButton = root.querySelector('[data-stagmenfashion-email-popup-close]');
      const showAfterTime = Number(root.dataset.showAfterTime || 5);
      const storageKey = `stagmenfashion-email-popup-dismissed-${root.dataset.popupId}`;

      if (!dialog) return;

      const storage = window.sessionStorage;

      const closePopup = () => {
        root.hidden = true;
        root.classList.remove('is-open');
        try {
          storage.setItem(storageKey, '1');
        } catch (error) {
          // Ignore storage failures.
        }
      };

      const openPopup = () => {
        if (!root.hidden) return;
        try {
          if (storage.getItem(storageKey)) return;
        } catch (error) {
          // Ignore storage failures.
        }
        root.hidden = false;
        root.classList.add('is-open');
      };

      window.setTimeout(() => {
        openPopup();
      }, Math.max(0, showAfterTime) * 1000);

      closeButton?.addEventListener('click', closePopup);
      root.addEventListener('click', (event) => {
        if (event.target === root) closePopup();
      });

    })();
  </script>
</section>

<style>
  .stagmenfashion-email-popup {
    position: fixed;
    inset: 0;
    z-index: 999;
    box-sizing: border-box;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    background: rgb(0 0 0 / 0.52);
    backdrop-filter: blur(10px);
  }

  .stagmenfashion-email-popup.is-open {
    display: flex;
  }

  .stagmenfashion-email-popup[hidden] {
    display: none !important;
  }

  .stagmenfashion-email-popup__dialog {
    width: min(92vw, 720px);
    max-width: min(92vw, 720px);
    color: #171717;
  }

  .stagmenfashion-email-popup__panel {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: var(--shadow-popover);
  }

  .stagmenfashion-email-popup__dialog::backdrop {
    background: transparent;
  }

  .stagmenfashion-email-popup__close {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 0;
    border-radius: 999px;
    background: #0800CF;
    color: #ffffff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .stagmenfashion-email-popup__hero {
    position: relative;
    padding: 72px 72px 74px;
    color: #ffffff;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.72)),
      radial-gradient(circle at 25% 20%, rgb(8 0 207 / 0.4), transparent 28%),
      radial-gradient(circle at 80% 30%, rgb(255 255 255 / 0.14), transparent 18%),
      linear-gradient(135deg, #1a1a1a 0%, #080808 100%);
  }

  .stagmenfashion-email-popup__eyebrow {
    margin: 0 0 18px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.84);
  }

  .stagmenfashion-email-popup__hero-title {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
    font-weight: 900;
  }

  .stagmenfashion-email-popup__body {
    padding: 48px 72px 56px;
    background: #ffffff;
  }

  .stagmenfashion-email-popup__brand {
    margin: 0 0 28px;
    color: rgb(23 23 23 / 0.62);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .stagmenfashion-email-popup__title {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(2.1rem, 4.3vw, 3.5rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    font-weight: 900;
  }

  .stagmenfashion-email-popup__description {
    margin: 18px 0 0;
    max-width: 35ch;
    color: rgb(23 23 23 / 0.72);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .stagmenfashion-email-popup__form {
    margin-top: 34px;
  }

  .stagmenfashion-email-popup__label {
    display: block;
    margin: 0 0 12px;
    color: rgb(23 23 23 / 0.8);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .stagmenfashion-email-popup__input {
    width: 100%;
    min-height: 66px;
    padding: 0 18px;
    border: 1px solid rgb(23 23 23 / 0.18);
    border-radius: 4px;
    background: #ffffff;
    color: #111111;
    font-size: 1rem;
  }

  .stagmenfashion-email-popup__input::placeholder {
    color: rgb(23 23 23 / 0.35);
  }

  .stagmenfashion-email-popup__submit {
    width: 100%;
    margin-top: 16px;
    min-height: 66px;
    border: 0;
    border-radius: 4px;
    background: #0800CF;
    color: #ffffff;
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .stagmenfashion-email-popup__message {
    margin: 14px 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .stagmenfashion-email-popup__message--success {
    color: #137333;
  }

  .stagmenfashion-email-popup__message--error {
    color: #b42318;
  }

  .stagmenfashion-email-popup__fine-print {
    margin: 18px 0 0;
    color: rgb(23 23 23 / 0.58);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .stagmenfashion-email-popup {
      padding: 56px 16px;
    }

    .stagmenfashion-email-popup__panel {
      width: min(90vw, 520px);
      max-width: min(90vw, 520px);
      margin: 0 auto;
      border-radius: 14px;
      background: #f3efe8;
      box-shadow: var(--shadow-popover);
      overflow: hidden;
      box-sizing: border-box;
      position: relative;
    }

    .stagmenfashion-email-popup__close {
      top: 14px;
      right: 14px;
      width: 46px;
      height: 46px;
      font-size: 1.2rem;
    }

    .stagmenfashion-email-popup__hero {
      padding: 30px 18px 22px;
    }

    .stagmenfashion-email-popup__body {
      padding: 20px 18px 22px;
    }

    .stagmenfashion-email-popup__hero-title {
      font-size: clamp(1.7rem, 7vw, 2.4rem);
      max-width: 12ch;
    }

    .stagmenfashion-email-popup__title {
      font-size: clamp(1.55rem, 6.5vw, 2.1rem);
      max-width: 12ch;
    }

    .stagmenfashion-email-popup__description {
      margin-top: 14px;
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .stagmenfashion-email-popup__form {
      margin-top: 22px;
    }

    .stagmenfashion-email-popup__label {
      margin-bottom: 10px;
      font-size: 0.72rem;
    }

    .stagmenfashion-email-popup__input,
    .stagmenfashion-email-popup__submit {
      min-height: 46px;
      font-size: 0.88rem;
    }

    .stagmenfashion-email-popup__submit {
      margin-top: 12px;
    }

    .stagmenfashion-email-popup__fine-print {
      margin-top: 12px;
      font-size: 0.76rem;
    }
  }
</style>

{% schema %}
{
  "name": "Stag Email Popup",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Join & Get Rewards"
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand text",
      "default": "Stag Men Fashion"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Get the Inside Scoop"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Drop your email. We'll let you in on all the secret details about our deals - before anyone else."
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Unlock now"
    },
    {
      "type": "textarea",
      "id": "fine_print",
      "label": "Fine print",
      "default": "By subscribing, you agree to receive email marketing from us."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for joining. Check your inbox for updates."
    },
    {
      "type": "range",
      "id": "show_after_seconds",
      "label": "Show after seconds",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Stag Email Popup"
    }
  ]
}
{% endschema %}
