{% javascript %}
  (() => {
    const initDrawerSpotlight = (scope = document) => {
      scope.querySelectorAll('[data-stagmenfashion-spotlight]').forEach((section) => {
        if (section.dataset.ready === 'true') return;
        section.dataset.ready = 'true';

        const panels = Array.from(section.querySelectorAll('[data-spotlight-panel]'));
        const seeAllBottom = section.querySelector('[data-spotlight-see-all-bottom]');
        const prevBtn = section.querySelector('[data-spotlight-nav="prev"]');
        const nextBtn = section.querySelector('[data-spotlight-nav="next"]');
        const bottomRowEl = section.querySelector('[data-spotlight-bottom-nav-row]');
        const cartAddUrl = section.dataset.cartAddUrl || '/cart/add';
        const noResults = section.querySelector('[data-spotlight-no-results]');
        const activeFiltersEl = section.querySelector('[data-spotlight-active-filters]');
        const activeTagEl = section.querySelector('[data-spotlight-active-tag]');
        const resultsCountEl = section.querySelector('[data-spotlight-results-count]');

        // Drawer elements
        const drawer = section.querySelector('[data-spotlight-drawer]');
        const drawerOverlay = section.querySelector('[data-spotlight-drawer-overlay]');
        const drawerTrigger = section.querySelector('[data-spotlight-drawer-trigger]');
        const drawerCloseBtns = Array.from(section.querySelectorAll('[data-spotlight-drawer-close]'));
        const filterBadge = section.querySelector('[data-spotlight-filter-badge]');

        // ---- State ----
        let activeCollectionPanelId = null;
        let activeCategory = 'all';
        let activeSubcategory = 'all';
        let activePrice = 'all';
        let activeSort = 'best-selling';

        // ---- Drawer Actions ----
        const openDrawer = () => {
          if (!drawer) return;
          drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden'; // prevent scrolling underneath
        };

        const closeDrawer = () => {
          if (!drawer) return;
          drawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        };

        if (drawerTrigger) {
          drawerTrigger.addEventListener('click', openDrawer);
        }

        if (drawerOverlay) {
          drawerOverlay.addEventListener('click', closeDrawer);
        }

        drawerCloseBtns.forEach((btn) => btn.addEventListener('click', closeDrawer));

        // ESC key to close
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer && drawer.getAttribute('aria-hidden') === 'false') {
            closeDrawer();
          }
        });

        // ---- Collection switching ----
        const activateCollection = (targetId) => {
          activeCollectionPanelId = targetId;

          // Toggle drawer option UI
          section.querySelectorAll('[data-spotlight-collection-tab-ref]').forEach((btn) => {
            const isActive = btn.dataset.spotlightCollectionTabRef === targetId;
            btn.classList.toggle('is-active', isActive);
          });

          // Toggle panel views
          panels.forEach((panel) => {
            const isActive = panel.id === targetId;
            panel.classList.toggle('is-active', isActive);
            panel.hidden = !isActive;

            if (isActive && seeAllBottom && panel.dataset.spotlightUrl) {
              seeAllBottom.href = panel.dataset.spotlightUrl;
            }
          });

          applyFilters();
        };

        section.querySelectorAll('[data-spotlight-collection-filters]').forEach((group) => {
          group.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-spotlight-collection-tab-ref]');
            if (!btn) return;
            activateCollection(btn.dataset.spotlightCollectionTabRef);
          });
        });

        // ---- Category filter ----
        section.querySelectorAll('[data-spotlight-category-filters]').forEach((group) => {
          group.addEventListener('click', (e) => {
            const item = e.target.closest('[data-spotlight-category]');
            if (!item) return;
            group.querySelectorAll('[data-spotlight-category]').forEach((c) => c.classList.remove('is-active'));
            item.classList.add('is-active');
            activeCategory = item.dataset.spotlightCategory;
            applyFilters();
          });
        });

        // ---- Sub-category filter ----
        section.querySelectorAll('[data-spotlight-subcategory-filters]').forEach((group) => {
          group.addEventListener('click', (e) => {
            const item = e.target.closest('[data-spotlight-subcategory]');
            if (!item) return;
            group.querySelectorAll('[data-spotlight-subcategory]').forEach((c) => c.classList.remove('is-active'));
            item.classList.add('is-active');
            activeSubcategory = item.dataset.spotlightSubcategory;
            applyFilters();
          });
        });

        // ---- Price filter ----
        section.querySelectorAll('[data-spotlight-price-filters]').forEach((group) => {
          group.addEventListener('click', (e) => {
            const item = e.target.closest('[data-spotlight-price]');
            if (!item) return;
            group.querySelectorAll('[data-spotlight-price]').forEach((c) => c.classList.remove('is-active'));
            item.classList.add('is-active');
            activePrice = item.dataset.spotlightPrice;
            applyFilters();
          });
        });

        // ---- Sort options ----
        section.querySelectorAll('[data-spotlight-sort-options]').forEach((group) => {
          group.addEventListener('click', (e) => {
            const item = e.target.closest('[data-spotlight-sort-val]');
            if (!item) return;
            group.querySelectorAll('[data-spotlight-sort-val]').forEach((c) => c.classList.remove('is-active'));
            item.classList.add('is-active');
            activeSort = item.dataset.spotlightSortVal;
            applyFilters();
          });
        });

        // ---- Clear filters ----
        const clearFilters = () => {
          activeCategory = 'all';
          activeSubcategory = 'all';
          activePrice = 'all';
          activeSort = 'best-selling';

          section.querySelectorAll('[data-spotlight-category]').forEach((c) => {
            c.classList.toggle('is-active', c.dataset.spotlightCategory === 'all');
          });
          section.querySelectorAll('[data-spotlight-subcategory]').forEach((c) => {
            c.classList.toggle('is-active', c.dataset.spotlightSubcategory === 'all');
          });
          section.querySelectorAll('[data-spotlight-price]').forEach((c) => {
            c.classList.toggle('is-active', c.dataset.spotlightPrice === 'all');
          });
          section.querySelectorAll('[data-spotlight-sort-val]').forEach((c) => {
            c.classList.toggle('is-active', c.dataset.spotlightSortVal === 'best-selling');
          });

          applyFilters();
        };

        const clearBtn = section.querySelector('[data-spotlight-clear-filters]');
        if (clearBtn) {
          clearBtn.addEventListener('click', clearFilters);
        }

        // ---- Filtering + Sorting ----
        const applyFilters = () => {
          const currentPanel = panels.find((p) => p.id === activeCollectionPanelId);
          if (!currentPanel) return;

          const carousel = currentPanel.querySelector('.stagmenfashion-spotlight__carousel');
          if (!carousel) return;

          const cards = Array.from(carousel.querySelectorAll('.stagmenfashion-spotlight-card'));
          let visibleCount = 0;

          cards.forEach((card) => {
            const cardType = (card.dataset.productType || '').toLowerCase();
            const cardPrice = parseInt(card.dataset.productPrice || '0', 10) / 100;
            const cardTags = (card.dataset.productTags || '').split(',');

            let showByCategory = activeCategory === 'all' || cardType === activeCategory;
            let showBySubcategory = activeSubcategory === 'all' || cardTags.includes(activeSubcategory);
            let showByPrice = true;

            if (activePrice !== 'all') {
              const parts = activePrice.split('-');
              const min = parseInt(parts[0], 10);
              const max = parseInt(parts[1], 10);
              showByPrice = cardPrice >= min && cardPrice <= max;
            }

            const visible = showByCategory && showBySubcategory && showByPrice;
            card.dataset.filtered = visible ? 'false' : 'true';
            if (visible) visibleCount++;
          });

          // Sort visible cards
          const visibleCards = cards.filter((c) => c.dataset.filtered !== 'true');
          const priceAsc = (a, b) => parseInt(a.dataset.productPrice || '0') - parseInt(b.dataset.productPrice || '0');
          const priceDesc = (a, b) => parseInt(b.dataset.productPrice || '0') - parseInt(a.dataset.productPrice || '0');
          const titleAsc = (a, b) => (a.dataset.productTitle || '').localeCompare(b.dataset.productTitle || '');
          const titleDesc = (a, b) => (b.dataset.productTitle || '').localeCompare(a.dataset.productTitle || '');

          const sortMap = {
            'best-selling': null,
            'price-ascending': priceAsc,
            'price-descending': priceDesc,
            'title-ascending': titleAsc,
            'title-descending': titleDesc,
          };

          const sortFn = sortMap[activeSort];
          if (sortFn) {
            visibleCards.sort(sortFn);
            visibleCards.forEach((card) => carousel.appendChild(card));
          }

          // Update active filters badge count
          let activeCount = 0;
          if (activeCategory !== 'all') activeCount++;
          if (activeSubcategory !== 'all') activeCount++;
          if (activePrice !== 'all') activeCount++;
          if (activeSort !== 'best-selling') activeCount++;
          if (filterBadge) {
            filterBadge.textContent = activeCount;
            filterBadge.style.display = activeCount > 0 ? 'inline-flex' : 'none';
          }

          // Update active filter tags banner on homepage
          if (activeFiltersEl) {
            const tags = [];
            if (activeCategory !== 'all') {
              const catItem = section.querySelector(`[data-spotlight-category="${activeCategory}"]`);
              tags.push(catItem?.dataset.spotlightCategoryLabel || activeCategory);
            }
            if (activeSubcategory !== 'all') {
              const subItem = section.querySelector(`[data-spotlight-subcategory="${activeSubcategory}"]`);
              tags.push(subItem?.dataset.spotlightSubcategoryLabel || activeSubcategory);
            }
            if (activePrice !== 'all') {
              const priceItem = section.querySelector(`[data-spotlight-price="${activePrice}"]`);
              tags.push(priceItem?.dataset.spotlightPriceLabel || activePrice);
            }

            if (tags.length > 0) {
              activeFiltersEl.style.display = 'flex';
              activeTagEl.textContent = tags.join(' · ');
            } else {
              activeFiltersEl.style.display = 'none';
            }
          }

          // Results count
          if (resultsCountEl) {
            resultsCountEl.textContent = `${visibleCount} product${visibleCount !== 1 ? 's' : ''} found`;
          }

          // No results
          if (noResults) {
            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
          }

          // Hide bottom row if no results matching filters
          if (bottomRowEl) {
            bottomRowEl.style.display = visibleCount === 0 ? 'none' : 'flex';
          }
        };

        // ---- Add to Cart ----
        section.querySelectorAll('[data-stagmenfashion-spotlight-add]').forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            const form = button.closest('form');
            const variantId = form?.querySelector('input[name="id"]')?.value;
            if (!variantId) return;

            button.disabled = true;
            button.dataset.loading = 'true';

            try {
              const response = await fetch(`${cartAddUrl}.js`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ id: Number(variantId), quantity: 1 }),
              });

              const cart = await response.json();
              if (!response.ok || cart?.status) {
                throw new Error(cart?.description || cart?.message || 'Add to cart failed');
              }

              document.dispatchEvent(
                new CustomEvent('cart:update', {
                  bubbles: true,
                  detail: {
                    resource: cart,
                    data: { source: 'stagmenfashion-spotlight', itemCount: cart.item_count },
                  },
                })
              );

              document.querySelector('[data-testid="cart-drawer-trigger"]')?.click();
            } catch (error) {
              console.error(error);
            } finally {
              button.disabled = false;
              button.dataset.loading = 'false';
            }
          });
        });

        // ---- Navigation Scrolling ----
        const getActiveCarousel = () => {
          const currentPanel = panels.find((p) => p.id === activeCollectionPanelId);
          return currentPanel?.querySelector('.stagmenfashion-spotlight__carousel');
        };

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            const carousel = getActiveCarousel();
            if (carousel) {
              const card = carousel.querySelector('.stagmenfashion-spotlight-card');
              const scrollVal = card ? card.offsetWidth + 20 : 320;
              carousel.scrollBy({ left: -scrollVal, behavior: 'smooth' });
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            const carousel = getActiveCarousel();
            if (carousel) {
              const card = carousel.querySelector('.stagmenfashion-spotlight-card');
              const scrollVal = card ? card.offsetWidth + 20 : 320;
              carousel.scrollBy({ left: scrollVal, behavior: 'smooth' });
            }
          });
        }

        // ---- Init ----
        const initialOption = section.querySelector('[data-spotlight-collection-tab-ref].is-active') || section.querySelector('[data-spotlight-collection-tab-ref]');
        const initialTargetId = initialOption?.dataset.spotlightCollectionTabRef;
        if (initialTargetId) {
          activateCollection(initialTargetId);
        } else {
          applyFilters();
        }
      });
    };

    document.addEventListener('DOMContentLoaded', () => initDrawerSpotlight());
    document.addEventListener('shopify:section:load', (event) => initDrawerSpotlight(event.target));
  })();
{% endjavascript %}

