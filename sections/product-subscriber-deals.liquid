<section class="pf-product-subscriber color-{{ section.settings.color_scheme }}">
  <div class="pf-product-subscriber__shell">
    {% if section.settings.heading != blank %}
      <h2 class="pf-product-subscriber__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% form 'customer', class: 'pf-product-subscriber__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      <label class="visually-hidden" for="PfProductSubscriberEmail-{{ section.id }}">Email address</label>
      <div class="pf-product-subscriber__row">
        <input
          id="PfProductSubscriberEmail-{{ section.id }}"
          class="pf-product-subscriber__input"
          type="email"
          name="contact[email]"
          value="{% if customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ section.settings.placeholder | default: 'Enter email address' }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
        >

        <button type="submit" class="pf-product-subscriber__button">
          {{ section.settings.button_label | default: 'SUBMIT' }}
        </button>
      </div>

      {% if form.posted_successfully? %}
        <p class="pf-product-subscriber__message pf-product-subscriber__message--success">
          {{ section.settings.success_message | default: 'Thanks for subscribing.' }}
        </p>
      {% endif %}

      {% if form.errors %}
        <p class="pf-product-subscriber__message pf-product-subscriber__message--error">
          {{ form.errors | default_errors }}
        </p>
      {% endif %}
    {% endform %}

    {% if section.settings.fine_print != blank %}
      <p class="pf-product-subscriber__fine-print">{{ section.settings.fine_print }}</p>
    {% endif %}
  </div>
</section>

<style>
  .pf-product-subscriber {
    background: #ffffff;
    color: #111111;
  }

  .pf-product-subscriber__shell {
    width: min(100%, 1600px);
    margin: 0 auto;
    padding: 15px 60px 10px;
    text-align: center;
    border-top: 1px solid rgb(17 17 17 / 0.12);
  }

  .pf-product-subscriber__heading {
    margin: 0;
    color: #111111;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 32px;
    line-height: 0.95;
    font-weight: 500;
    display: flex;
  }

  .pf-product-subscriber__form {
    margin-top: 30px;
  }

  .pf-product-subscriber__row {
    display: flex;
    align-items: stretch;
    gap: 14px;
    overflow: hidden;
  }

  .pf-product-subscriber__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 76px;
    border: 0;
    background: transparent;
    padding: 0 20px;
    font-size: clamp(0.98rem, 0.84rem + 0.36vw, 1.18rem);
    color: #111111;
    outline: none;
    border: 1.5px solid #0800CF !important;
    border-radius: 10px;
  }

  .pf-product-subscriber__input::placeholder {
    color: rgb(17 17 17 / 0.42);
  }

  .pf-product-subscriber__button {
    flex: 0 0 clamp(132px, 24vw, 240px);
    min-height: 76px;
    border: 0;
    border-radius: 10px;
    background: #0800CF;
    color: #ffffff;
    font-size: clamp(0.92rem, 0.75rem + 0.4vw, 1.08rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .pf-product-subscriber__button:hover {
    background: #0600a3;
  }

  .pf-product-subscriber__message {
    margin: 10px 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .pf-product-subscriber__message--success {
    color: #196b2f;
  }

  .pf-product-subscriber__message--error {
    color: #a11a1a;
  }

  .pf-product-subscriber__fine-print {
    margin: 10px auto 0;
    color: rgb(17 17 17 / 0.56);
    font-size: 0.92rem;
    line-height: 1.45;
    display: flex;
    text-align: start !important;
  }

  @media screen and (max-width: 749px) {
    .pf-product-subscriber__shell {
      padding-inline: 16px;
    }

    .pf-product-subscriber__heading {
      font-size: 24px;
      font-weight: 500;
    }

    .pf-product-subscriber__form {
      margin-top: 24px;
    }

    .pf-product-subscriber__row {
      gap: 10px;
      padding: 0px;
      flex-direction: row;
      align-items: center;
    }

    .pf-product-subscriber__input {
      min-height: 52px;
      padding-inline: 14px;
      font-size: 0.9rem;
    }

    .pf-product-subscriber__button {
      min-height: 46px;
      flex-basis: clamp(96px, 19vw, 130px);
      font-size: 14px;
      padding-inline: 14px;
    }

      .pf-product-subscriber__fine-print {
          color: black;
          font-size: 14px;
          font-weight: 400;
          display: flex;
      }
  }
</style>

{% schema %}
{
  "name": "Product Subscriber Deals",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Want subscriber only deals?"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Enter email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SUBMIT"
    },
    {
      "type": "textarea",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Get exclusive drops, product updates, and subscriber-only offers."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing."
    }
  ],
  "presets": [
    {
      "name": "Product Subscriber Deals"
    }
  ]
}
{% endschema %}
