  /* ── Responsive ──────────────────────────────────────────────── */
  @media screen and (max-width: 1400px) {
    .stagmenfashion-collection-grid.is-grid-12,
    .stagmenfashion-collection-grid.is-grid-6 {
      grid-template-columns: repeat(8, 1fr) !important;
      gap: 4px !important;
    }
  }

  @media screen and (max-width: 1024px) {
    .stagmenfashion-collection-grid {
      grid-template-columns: repeat(var(--col-tablet, 4), 1fr);
      gap: 8px;
    }

    .stagmenfashion-collection-grid.is-grid-12,
    .stagmenfashion-collection-grid.is-grid-6 {
      grid-template-columns: repeat(6, 1fr) !important;
      gap: 5px !important;
    }
  }

  @media screen and (max-width: 749px) {
    .stagmenfashion-collection {
      padding-top: 0;
      padding-bottom: clamp(10px, 3.5vw, 12px);
      padding-left: 0;
      padding-right: 0;
      --col-card-title-size: 12px;
      --col-card-price-size: 11px;
    }

    .stagmenfashion-collection__shell {
      padding: 10px 10px 0;
    }

    .stagmenfashion-collection-head {
      margin-bottom: 10px;
    }

    .stagmenfashion-collection-head__title {
      font-size: 16px;
    }

    .stagmenfashion-advance-filters-btn {
      padding: 6px 14px;
      font-size: 12px;
    }

    .stagmenfashion-nav-pill {
      padding: 5px 12px;
      font-size: 12px;
