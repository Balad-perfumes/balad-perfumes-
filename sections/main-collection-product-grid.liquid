{% liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign columns_desktop = section.settings.columns_desktop | default: 6
  assign columns_tablet = section.settings.columns_tablet | default: 3
  assign columns_mobile = section.settings.columns_mobile | default: 2

  case current_sort
    when 'manual'
      assign current_sort_label = 'Featured'
    when 'best-selling'
      assign current_sort_label = 'Best selling'
    when 'title-ascending'
      assign current_sort_label = 'A–Z'
    when 'title-descending'
      assign current_sort_label = 'Z–A'
    when 'price-ascending'
      assign current_sort_label = 'Price: low–high'
    when 'price-descending'
      assign current_sort_label = 'Price: high–low'
    when 'created-descending'
      assign current_sort_label = 'Newest'
    when 'created-ascending'
      assign current_sort_label = 'Oldest'
    else
      assign current_sort_label = 'Featured'
  endcase
%}

<section
  class="stagmenfashion-collection color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="stagmenfashion-collection__shell">
    
    <!-- ── Top Toolbar ─────────────────────────────────────────── -->
    <div class="stagmenfashion-collection-head">
      <div class="stagmenfashion-collection-head__left">
        <h1 class="stagmenfashion-collection-head__title">{{ collection.title }}</h1>
      </div>

      <div class="stagmenfashion-collection-head__right">
        <!-- View grid icon (6 vs 12) -->
        <button
          type="button"
          class="stagmenfashion-view-icon-btn"
          data-grid-toggle
          aria-label="Toggle 6 or 12 column grid layout"
          title="Toggle grid layout"
        >
          <!-- 6 Grid Icon (Default) -->
          <svg class="stagmenfashion-grid-icon stagmenfashion-grid-icon--6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="3.5" width="4.8" height="7" rx="1"></rect>
            <rect x="9.6" y="3.5" width="4.8" height="7" rx="1"></rect>
            <rect x="16.7" y="3.5" width="4.8" height="7" rx="1"></rect>
            <rect x="2.5" y="13.5" width="4.8" height="7" rx="1"></rect>
            <rect x="9.6" y="13.5" width="4.8" height="7" rx="1"></rect>
            <rect x="16.7" y="13.5" width="4.8" height="7" rx="1"></rect>
          </svg>
          <!-- 12 Grid Icon (12 Items) -->
          <svg class="stagmenfashion-grid-icon stagmenfashion-grid-icon--12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3.5" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="5.6" y="3.5" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="9.2" y="3.5" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="12.8" y="3.5" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="16.4" y="3.5" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="20" y="3.5" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="2" y="13" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="5.6" y="13" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="9.2" y="13" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="12.8" y="13" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="16.4" y="13" width="2.8" height="6.5" rx="0.6"></rect>
            <rect x="20" y="13" width="2.8" height="6.5" rx="0.6"></rect>
          </svg>
        </button>

        <!-- Advance Filters Button -->
        <button
          type="button"
          class="stagmenfashion-advance-filters-btn"
          data-open-filter-drawer
          aria-label="Open advance filters"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          <span>Advance Filters</span>
        </button>
      </div>
    </div>



    <!-- ── Product Grid ────────────────────────────────────────── -->
    {% paginate collection.products by section.settings.products_per_page %}
      <div
        class="stagmenfashion-collection-grid"
        style="--col-desktop: {{ columns_desktop }}; --col-tablet: {{ columns_tablet }}; --col-mobile: {{ columns_mobile }};"
      >
        {% for product in collection.products %}
          {% liquid
            assign images = product.images
            assign image_count = images.size
            assign first_image = product.featured_image | default: images.first
            assign sizes_list = ''
            for opt in product.options_with_values
              assign opt_name_down = opt.name | downcase
              if opt_name_down contains 'size' or opt.name == 'Size'
                assign sizes_list = opt.values | join: ','
              endif
            endfor
            if sizes_list == ''
              assign sizes_check = '|'
              for v in product.variants
                assign sz = v.option1 | strip
                unless sz == blank or sz == 'Default Title'
                  assign check_sz = '|' | append: sz | append: '|'
                  unless sizes_check contains check_sz
                    assign sizes_check = sizes_check | append: check_sz
                    if sizes_list != ''
                      assign sizes_list = sizes_list | append: ','
                    endif
                    assign sizes_list = sizes_list | append: sz
                  endunless
                endunless
              endfor
            endif
          %}
          <div class="stagmenfashion-collection-grid__card" data-product-card>
            <a href="{{ product.url }}" class="stagmenfashion-collection-grid__media" data-carousel>
              {% unless product.available %}
                <span class="stagmenfashion-collection-grid__badge">Sold Out</span>
              {% endunless %}

              {% if image_count > 0 %}
                {% for image in images limit: 6 %}
                  <img
                    class="stagmenfashion-collection-grid__image{% if forloop.first %} is-active{% endif %}"
                    src="{{ image | image_url: width: 600 }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    width="600"
                    height="750"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    data-carousel-slide
                  >
                {% endfor %}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'stagmenfashion-collection-grid__placeholder' }}
              {% endif %}

              <!-- Heart / Wishlist button -->
              <button
                type="button"
                class="stagmenfashion-collection-grid__heart"
                data-wishlist-heart
                data-product-id="{{ product.id }}"
                data-product-title="{{ product.title | escape }}"
                data-product-price="{{ product.price | money_without_currency | remove: ',' }}"
                data-product-compare-price="{{ product.compare_at_price | money_without_currency | remove: ',' }}"
                data-product-url="{{ product.url }}"
                data-product-image="{{ first_image | image_url: width: 400 }}"
                data-product-sizes="{{ sizes_list | split: ',' | join: ',' }}"
                data-product-available="{{ product.available }}"
                aria-label="Add {{ product.title | escape }} to wishlist"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                </svg>
              </button>

              {% if image_count > 1 %}
                <div class="stagmenfashion-collection-grid__dots" data-carousel-dots>
                  {% for image in images limit: 6 %}
                    <span class="stagmenfashion-collection-grid__dot{% if forloop.first %} is-active{% endif %}" data-carousel-dot data-index="{{ forloop.index0 }}"></span>
                  {% endfor %}
                </div>
              {% endif %}
            </a>

            <div class="stagmenfashion-collection-grid__info">
              <div class="stagmenfashion-collection-grid__details">
                <a href="{{ product.url }}" class="stagmenfashion-collection-grid__title-link">
                  <h3 class="stagmenfashion-collection-grid__title">{{ product.title }}</h3>
                </a>
                <span class="stagmenfashion-collection-grid__price">RS. {{ product.price | money_without_currency | remove: ',' }}</span>
              </div>
              <button
                type="button"
                class="stagmenfashion-collection-grid__plus-btn"
                data-quick-add
                data-qa-title="{{ product.title | escape }}"
                data-qa-price="{{ product.price | money_without_currency | remove: ',' }}"
                data-qa-url="{{ product.url }}"
                data-qa-id="{{ product.id }}"
                data-qa-image="{{ first_image | image_url: width: 400 }}"
                data-qa-sizes="{{ sizes_list | split: ',' | join: ',' }}"
                data-qa-first-variant="{{ product.selected_or_first_available_variant.id }}"
                data-qa-variants="{% for v in product.variants %}{% unless v.option1 == 'Default Title' %}{{ v.option1 }}:{{ v.id }},{% endunless %}{% endfor %}"
                data-qa-available="{{ product.available }}"
                data-qa-variant-availability="{% for v in product.variants %}{% unless v.option1 == 'Default Title' %}{{ v.option1 }}:{{ v.available }},{% endunless %}{% endfor %}"
                aria-label="Quick add {{ product.title | escape }}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
          </div>
        {% endfor %}

        {% if collection.products.size == 0 %}
          <p class="stagmenfashion-collection__empty">No products found in this collection.</p>
        {% endif %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="stagmenfashion-collection__pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════════
     FILTER DRAWER (SLIDE-IN MODAL)
     ══════════════════════════════════════════════════════════════ -->
<div class="stagmenfashion-filter-drawer" data-filter-drawer>
  <div class="stagmenfashion-filter-drawer__backdrop" data-close-filter-drawer></div>
  <div class="stagmenfashion-filter-drawer__panel">
    
    <!-- Drawer Header -->
    <div class="stagmenfashion-filter-drawer__header">
      <div class="stagmenfashion-filter-drawer__header-copy">
        <h2 class="stagmenfashion-filter-drawer__title">FILTER</h2>
        <span class="stagmenfashion-filter-drawer__count">{{ collection.products_count }} PRODUCTS</span>
      </div>
      <button type="button" class="stagmenfashion-filter-drawer__close" data-close-filter-drawer aria-label="Close Filter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Drawer Body / Filter Form -->
    <form method="get" action="{{ collection.url }}" id="CollectionFilterDrawerForm" class="stagmenfashion-filter-drawer__form">
      <input type="hidden" name="sort_by" id="FilterSortByInput" value="{{ current_sort }}">

      <div class="stagmenfashion-filter-drawer__body">
        <!-- ── Category Filter Group ── -->
        <div class="stagmenfashion-filter-group">
          <h3 class="stagmenfashion-filter-group__heading">Category</h3>
          <div class="stagmenfashion-filter-pills">
            <a href="/collections/all" class="stagmenfashion-filter-pill{% if collection.handle == 'all' %} is-active{% endif %}">
              <span class="stagmenfashion-filter-pill__text">View all</span>
            </a>
            {% if section.settings.category_list != blank %}
              {% for coll in section.settings.category_list %}
                <a href="{{ coll.url }}" class="stagmenfashion-filter-pill{% if coll.handle == collection.handle %} is-active{% endif %}">
                  <span class="stagmenfashion-filter-pill__text">{{ coll.title }}</span>
                </a>
              {% endfor %}
            {% else %}
              {% for coll in collections limit: 20 %}
                {% unless coll.handle == 'all' or coll.handle == 'frontpage' %}
                  <a href="{{ coll.url }}" class="stagmenfashion-filter-pill{% if coll.handle == collection.handle %} is-active{% endif %}">
                    <span class="stagmenfashion-filter-pill__text">{{ coll.title }}</span>
                  </a>
                {% endunless %}
              {% endfor %}
            {% endif %}
          </div>
        </div>

        {% if collection.filters.size > 0 %}
          {% for filter in collection.filters %}
            <div class="stagmenfashion-filter-group">
              <h3 class="stagmenfashion-filter-group__heading">{{ filter.label }}</h3>

              {% case filter.type %}
                {% when 'list', 'boolean' %}
                  <div class="stagmenfashion-filter-pills">
                    {% for value in filter.values %}
                      <label class="stagmenfashion-filter-pill{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          class="visually-hidden"
                          data-filter-checkbox
                        >
                        <span class="stagmenfashion-filter-pill__text">{{ value.label }}</span>
                        {% if filter.label == 'Color' or filter.label == 'Colour' or value.swatch != blank %}
                          <span class="stagmenfashion-filter-pill__color-dots stagmenfashion-color-{{ value.label | handle }}"><i></i><i></i><i></i><i></i></span>
                        {% endif %}
                      </label>
                    {% endfor %}
                  </div>

                {% when 'price_range' %}
                  <div class="stagmenfashion-filter-price-range">
                    <div class="stagmenfashion-filter-price-field">
                      <span>Min</span>
                      <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | default: '' }}" placeholder="0">
                    </div>
                    <div class="stagmenfashion-filter-price-field">
                      <span>Max</span>
                      <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | default: '' }}" placeholder="9999">
                    </div>
                  </div>
              {% endcase %}
            </div>
          {% endfor %}
        {% else %}
          <!-- Fallback filter pills if collection.filters is not configured yet in Search & Discovery -->
          <div class="stagmenfashion-filter-group">
            <h3 class="stagmenfashion-filter-group__heading">Size</h3>
            <div class="stagmenfashion-filter-pills">
              {% assign demo_sizes = 'XXXS,XXS,XS,S,M,L,XL,XXL,XXXL' | split: ',' %}
              {% for s in demo_sizes %}
                <label class="stagmenfashion-filter-pill">
                  <input type="checkbox" name="filter.v.option.size" value="{{ s }}" class="visually-hidden" data-filter-checkbox>
                  <span class="stagmenfashion-filter-pill__text">{{ s }}</span>
                </label>
              {% endfor %}
            </div>
          </div>

          <div class="stagmenfashion-filter-group">
            <h3 class="stagmenfashion-filter-group__heading">Availability</h3>
            <div class="stagmenfashion-filter-pills">
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.availability" value="1" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">In stock</span>
              </label>
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.availability" value="0" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Out of stock</span>
              </label>
            </div>
          </div>

          <div class="stagmenfashion-filter-group">
            <h3 class="stagmenfashion-filter-group__heading">Type</h3>
            <div class="stagmenfashion-filter-pills">
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.type" value="Coats & jackets" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Coats & jackets</span>
              </label>
            </div>
          </div>

          <div class="stagmenfashion-filter-group">
            <h3 class="stagmenfashion-filter-group__heading">Color</h3>
            <div class="stagmenfashion-filter-pills">
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.option.color" value="Blues" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Blues</span>
                <span class="stagmenfashion-filter-pill__color-dots stagmenfashion-color-blues"><i></i><i></i><i></i><i></i></span>
              </label>
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.option.color" value="Browns" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Browns</span>
                <span class="stagmenfashion-filter-pill__color-dots stagmenfashion-color-browns"><i></i><i></i><i></i><i></i></span>
              </label>
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.option.color" value="Greens" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Greens</span>
                <span class="stagmenfashion-filter-pill__color-dots stagmenfashion-color-greens"><i></i><i></i><i></i><i></i></span>
              </label>
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.option.color" value="Neutrals" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Neutrals</span>
                <span class="stagmenfashion-filter-pill__color-dots stagmenfashion-color-neutrals"><i></i><i></i><i></i><i></i></span>
              </label>
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.option.color" value="Purples" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Purples</span>
                <span class="stagmenfashion-filter-pill__color-dots stagmenfashion-color-purples"><i></i><i></i><i></i><i></i></span>
              </label>
              <label class="stagmenfashion-filter-pill">
                <input type="checkbox" name="filter.v.option.color" value="Reds" class="visually-hidden" data-filter-checkbox>
                <span class="stagmenfashion-filter-pill__text">Reds</span>
                <span class="stagmenfashion-filter-pill__color-dots stagmenfashion-color-reds"><i></i><i></i><i></i><i></i></span>
              </label>
            </div>
          </div>
        {% endif %}

        <!-- ── Sort By Accordion in Drawer ── -->
        <div class="stagmenfashion-filter-group stagmenfashion-filter-group--sort">
          <button type="button" class="stagmenfashion-sort-accordion-btn" data-toggle-sort-accordion aria-expanded="false">
            <span class="stagmenfashion-sort-accordion-title">Sort by:</span>
            <span class="stagmenfashion-sort-accordion-value" data-sort-active-label>{{ current_sort_label }}</span>
            <svg class="stagmenfashion-sort-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="stagmenfashion-sort-accordion-options" data-sort-options-list>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'manual' %} is-selected{% endif %}" data-sort-val="manual" data-sort-name="Featured">
              Featured
            </button>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'best-selling' %} is-selected{% endif %}" data-sort-val="best-selling" data-sort-name="Best selling">
              Best selling
            </button>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'title-ascending' %} is-selected{% endif %}" data-sort-val="title-ascending" data-sort-name="A–Z">
              A–Z
            </button>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'title-descending' %} is-selected{% endif %}" data-sort-val="title-descending" data-sort-name="Z–A">
              Z–A
            </button>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'price-ascending' %} is-selected{% endif %}" data-sort-val="price-ascending" data-sort-name="Price: low–high">
              Price: low–high
            </button>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'price-descending' %} is-selected{% endif %}" data-sort-val="price-descending" data-sort-name="Price: high–low">
              Price: high–low
            </button>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'created-descending' %} is-selected{% endif %}" data-sort-val="created-descending" data-sort-name="Newest">
              Newest
            </button>
            <button type="button" class="stagmenfashion-sort-option{% if current_sort == 'created-ascending' %} is-selected{% endif %}" data-sort-val="created-ascending" data-sort-name="Oldest">
              Oldest
            </button>
          </div>
        </div>
      </div>

      <!-- Drawer Footer Actions -->
      <div class="stagmenfashion-filter-drawer__footer">
        <a href="{{ collection.url }}" class="stagmenfashion-filter-btn stagmenfashion-filter-btn--remove">
          REMOVE ALL
        </a>
        <button type="submit" class="stagmenfashion-filter-btn stagmenfashion-filter-btn--apply">
          APPLY
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Wishlist Modal -->
<div class="stagmenfashion-wishlist-modal" data-wishlist-modal style="display:none;" hidden>
  <div class="stagmenfashion-wishlist-modal__backdrop" data-wishlist-close></div>
  <div class="stagmenfashion-wishlist-modal__card">
    <button type="button" class="stagmenfashion-wishlist-modal__close" data-wishlist-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="stagmenfashion-wishlist-modal__header">
      <div class="stagmenfashion-wishlist-modal__product-img" data-wishlist-img></div>
      <div class="stagmenfashion-wishlist-modal__product-info">
        <h3 class="stagmenfashion-wishlist-modal__title" data-wishlist-title></h3>
        <div class="stagmenfashion-wishlist-modal__price-wrap">
          <span class="stagmenfashion-wishlist-modal__price" data-wishlist-price></span>
          <span class="stagmenfashion-wishlist-modal__compare-price" data-wishlist-compare-price></span>
        </div>
      </div>
    </div>

    <div class="stagmenfashion-wishlist-modal__sizes">
      <div class="stagmenfashion-wishlist-modal__sizes-top">
        <span class="stagmenfashion-wishlist-modal__label" data-wishlist-size-label>Size</span>
      </div>
      <div class="stagmenfashion-wishlist-modal__size-grid" data-wishlist-sizes></div>
    </div>

    <button type="button" class="stagmenfashion-wishlist-modal__add-btn" data-wishlist-add>
      Add To List
    </button>
  </div>
</div>

<!-- Quick Add Modal -->
<div class="stagmenfashion-qa-modal" data-qa-modal style="display:none;" hidden>
  <div class="stagmenfashion-qa-modal__backdrop" data-qa-close></div>
  <div class="stagmenfashion-qa-modal__card">
    <button type="button" class="stagmenfashion-qa-modal__close" data-qa-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="stagmenfashion-qa-modal__header">
      <div class="stagmenfashion-qa-modal__product-img" data-qa-img></div>
      <div class="stagmenfashion-qa-modal__product-info">
        <h3 class="stagmenfashion-qa-modal__title" data-qa-title></h3>
        <span class="stagmenfashion-qa-modal__price" data-qa-price></span>
      </div>
    </div>

    <div class="stagmenfashion-qa-modal__sizes">
      <div class="stagmenfashion-qa-modal__sizes-top">
        <span class="stagmenfashion-qa-modal__label">Size</span>
      </div>
      <div class="stagmenfashion-qa-modal__size-grid" data-qa-sizes></div>
    </div>

    <div class="stagmenfashion-qa-modal__actions" data-qa-actions>
      <button type="button" class="stagmenfashion-qa-modal__btn stagmenfashion-qa-modal__btn--bag" data-qa-add-bag>Add To Bag</button>
      <button type="button" class="stagmenfashion-qa-modal__btn stagmenfashion-qa-modal__btn--buy" data-qa-buy-now>Buy Now</button>
    </div>
    <div class="stagmenfashion-qa-modal__sold-out" data-qa-sold-out style="display:none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
      </svg>
      <span>Sold Out</span>
    </div>
  </div>
</div>



<script>
  (() => {
    /* ── Filter Drawer Management ────────────────────────────────── */
    const initFilterDrawer = () => {
      const drawer = document.querySelector('[data-filter-drawer]');
      if (!drawer) return;

      const openBtns = document.querySelectorAll('[data-open-filter-drawer]');
      const closeBtns = document.querySelectorAll('[data-close-filter-drawer]');
      const sortAccordionBtn = drawer.querySelector('[data-toggle-sort-accordion]');
      const sortOptionsList = drawer.querySelector('[data-sort-options-list]');
      const sortHiddenInput = drawer.querySelector('#FilterSortByInput');
      const sortActiveLabel = drawer.querySelector('[data-sort-active-label]');

      openBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          drawer.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        });
      });

      closeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          drawer.classList.remove('is-open');
          document.body.style.overflow = '';
        });
      });

      // Filter Pill toggles
      drawer.querySelectorAll('.stagmenfashion-filter-pill').forEach((pill) => {
        const checkbox = pill.querySelector('[data-filter-checkbox]');
        if (!checkbox) return;
        pill.addEventListener('click', (e) => {
          if (e.target !== checkbox) {
            checkbox.checked = !checkbox.checked;
          }
          pill.classList.toggle('is-active', checkbox.checked);
        });
      });

      // Sort by Accordion
      if (sortAccordionBtn && sortOptionsList) {
        sortAccordionBtn.addEventListener('click', () => {
          const isOpen = sortOptionsList.classList.toggle('is-open');
          sortAccordionBtn.classList.toggle('is-open', isOpen);
          sortAccordionBtn.setAttribute('aria-expanded', isOpen);
        });

        sortOptionsList.querySelectorAll('.stagmenfashion-sort-option').forEach((optBtn) => {
          optBtn.addEventListener('click', () => {
            sortOptionsList.querySelectorAll('.stagmenfashion-sort-option').forEach(b => b.classList.remove('is-selected'));
            optBtn.classList.add('is-selected');
            const sortVal = optBtn.dataset.sortVal;
            const sortName = optBtn.dataset.sortName;
            if (sortHiddenInput) sortHiddenInput.value = sortVal;
            if (sortActiveLabel) sortActiveLabel.textContent = sortName;
            sortOptionsList.classList.remove('is-open');
            sortAccordionBtn.classList.remove('is-open');
          });
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
          drawer.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      });
    };

    /* ── Wishlist Management ─────────────────────────────────────── */
    const STORAGE_KEY = 'wishlist';
    let selectedSize = null;
    let currentProductId = '';

    const getWishlist = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch(e) { return []; }
    };

    const saveWishlist = (list) => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch(e) { console.warn('Wishlist save failed:', e); }
    };

    const extractHandle = (url) => {
      if (!url) return '';
      const parts = url.split('/');
      return parts[parts.length - 1] || parts[parts.length - 2] || '';
    };

    const updateHeartStates = (scope) => {
      const wishlist = getWishlist();
      scope.querySelectorAll('[data-wishlist-heart]').forEach((btn) => {
        const handle = extractHandle(btn.dataset.productUrl);
        const isInList = wishlist.some((item) => item.handle === handle);
        btn.classList.toggle('is-saved', isInList);
        const svg = btn.querySelector('svg');
        if (isInList) { svg.setAttribute('fill', 'currentColor'); }
        else { svg.setAttribute('fill', 'none'); }
      });
    };

    const openModal = (btn) => {
      const modal = document.querySelector('[data-wishlist-modal]');
      const titleEl = modal.querySelector('[data-wishlist-title]');
      const priceEl = modal.querySelector('[data-wishlist-price]');
      const comparePriceEl = modal.querySelector('[data-wishlist-compare-price]');
      const imgEl = modal.querySelector('[data-wishlist-img]');
      const sizesEl = modal.querySelector('[data-wishlist-sizes]');
      const sizeLabel = modal.querySelector('[data-wishlist-size-label]');
      const addBtn = modal.querySelector('[data-wishlist-add]');

      const title = btn.dataset.productTitle || '';
      const price = btn.dataset.productPrice || '0';
      const comparePrice = btn.dataset.productComparePrice || '';
      const productId = String(btn.dataset.productId || '').trim();
      const productUrl = btn.dataset.productUrl || '#';
      const productImage = btn.dataset.productImage || '';
      const sizesRaw = btn.dataset.productSizes || '';
      const sizes = sizesRaw.split(',').map(s => s.trim()).filter(s => s.length > 0);

      currentProductId = productId;
      titleEl.textContent = title;
      priceEl.textContent = 'INR ' + price;

      if (comparePrice && comparePrice !== price && comparePrice !== '0' && comparePrice !== '') {
        comparePriceEl.textContent = 'INR ' + comparePrice;
        comparePriceEl.style.display = 'inline';
      } else {
        comparePriceEl.textContent = '';
        comparePriceEl.style.display = 'none';
      }

      if (productImage) {
        imgEl.innerHTML = '<img src="' + productImage + '" alt="' + title.replace(/"/g, '&quot;') + '" />';
        imgEl.style.display = 'flex';
      } else {
        imgEl.innerHTML = '';
        imgEl.style.display = 'none';
      }

      selectedSize = null;

      if (sizes.length > 0) {
        sizeLabel.textContent = 'Size';
        sizesEl.parentElement.style.display = 'block';
        sizesEl.innerHTML = sizes.map((size, i) => {
          const isSelected = i === 0 ? ' is-selected' : '';
          if (i === 0) selectedSize = size;
          return '<button type="button" class="stagmenfashion-wishlist-modal__size' + isSelected + '" data-size-btn data-size="' + size + '">' + size + '</button>';
        }).join('');

        sizesEl.querySelectorAll('[data-size-btn]').forEach((sizeBtn) => {
          sizeBtn.addEventListener('click', () => {
            sizesEl.querySelectorAll('[data-size-btn]').forEach(b => b.classList.remove('is-selected'));
            sizeBtn.classList.add('is-selected');
            selectedSize = sizeBtn.dataset.size;
          });
        });
      } else {
        sizeLabel.textContent = 'Default';
        sizesEl.parentElement.style.display = 'block';
        selectedSize = 'Default';
        sizesEl.innerHTML = '<button type="button" class="stagmenfashion-wishlist-modal__size is-selected" data-size-btn data-size="Default">Default</button>';
      }

      addBtn.dataset.productId = productId;
      addBtn.dataset.productTitle = title;
      addBtn.dataset.productPrice = price;
      addBtn.dataset.productUrl = productUrl;
      addBtn.dataset.productImage = productImage;

      modal.style.display = 'flex';
      modal.removeAttribute('hidden');
      requestAnimationFrame(() => {
        modal.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      const modal = document.querySelector('[data-wishlist-modal]');
      if (!modal) return;
      modal.classList.remove('is-open');
      setTimeout(() => {
        if (!modal.classList.contains('is-open')) {
          modal.style.display = 'none';
          modal.setAttribute('hidden', '');
        }
      }, 220);
      document.body.style.overflow = '';
    };

    const removeFromWishlist = (handle) => {
      let wishlist = getWishlist();
      wishlist = wishlist.filter((item) => item.handle !== handle);
      saveWishlist(wishlist);
      document.dispatchEvent(new CustomEvent('wishlist:update'));
    };

    const addToWishlist = (handle, id, title, price, image, size) => {
      const wishlist = getWishlist();
      const exists = wishlist.some((item) => item.handle === handle);
      if (!exists) {
        wishlist.push({ handle, id, title, price, image, size: size || '' });
        saveWishlist(wishlist);
        document.dispatchEvent(new CustomEvent('wishlist:update'));
      }
    };

    const toggleWishlist = (btn) => {
      const handle = extractHandle(btn.dataset.productUrl);
      const wishlist = getWishlist();
      const isInList = wishlist.some((item) => item.handle === handle);
      if (isInList) {
        removeFromWishlist(handle);
        updateHeartStates(document);
        return;
      }
      openModal(btn);
    };

    const initSection = (scope = document) => {
      scope.querySelectorAll('[data-wishlist-heart]').forEach((btn) => {
        if (btn.dataset.ready === 'true') return;
        btn.dataset.ready = 'true';
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleWishlist(btn);
        });
      });
      updateHeartStates(scope);
    };

    const initModal = () => {
      document.querySelectorAll('[data-wishlist-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });

      const addBtn = document.querySelector('[data-wishlist-add]');
      if (addBtn && !addBtn.dataset.ready) {
        addBtn.dataset.ready = 'true';
        addBtn.addEventListener('click', () => {
          const productId = currentProductId;
          const title = addBtn.dataset.productTitle || '';
          const price = addBtn.dataset.productPrice || '0';
          const url = addBtn.dataset.productUrl || '#';
          const image = addBtn.dataset.productImage || '';
          const handle = extractHandle(url);
          if (!handle) return;
          addToWishlist(handle, productId, title, price, image, selectedSize || '');
          closeModal();
          updateHeartStates(document);
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    };

    /* ── Quick Add Modal ──────────────────────────────────────────── */
    let qaSelectedSize = null;
    let qaProductUrl = '';

    const getQAModal = () => document.querySelector('[data-qa-modal]');

    const resolveVariantId = (modal) => {
      const variantsData = modal?.dataset.qaVariants || '';
      const firstVariant = modal?.dataset.qaFirstVariant || '';
      let variantId = '';
      if (variantsData && qaSelectedSize) {
        const pairs = variantsData.split(',').filter(Boolean);
        for (const pair of pairs) {
          const [name, id] = pair.split(':');
          if (name && id && name.trim() === qaSelectedSize.trim()) {
            variantId = id.trim();
            break;
          }
        }
      }
      if (!variantId && firstVariant) variantId = firstVariant;
      return variantId;
    };

    const openQAModal = (btn) => {
      const modal = getQAModal();
      if (!modal) return;

      const titleEl = modal.querySelector('[data-qa-title]');
      const priceEl = modal.querySelector('[data-qa-price]');
      const imgEl = modal.querySelector('[data-qa-img]');
      const sizesEl = modal.querySelector('[data-qa-sizes]');

      const title = btn.dataset.qaTitle || '';
      const price = btn.dataset.qaPrice || '0';
      const url = btn.dataset.qaUrl || '#';
      const image = btn.dataset.qaImage || '';
      const firstVariant = btn.dataset.qaFirstVariant || '';
      const sizesRaw = btn.dataset.qaSizes || '';
      const variantsRaw = btn.dataset.qaVariants || '';
      const productAvailable = btn.dataset.qaAvailable === 'true';
      const variantAvailRaw = btn.dataset.qaVariantAvailability || '';
      const sizes = sizesRaw.split(',').map(s => s.trim()).filter(s => s.length > 0);

      const variantAvailMap = {};
      if (variantAvailRaw) {
        variantAvailRaw.split(',').filter(Boolean).forEach(pair => {
          const [name, avail] = pair.split(':');
          if (name) variantAvailMap[name.trim()] = avail && avail.trim() === 'true';
        });
      }

      qaProductUrl = url;
      qaSelectedSize = null;

      modal.dataset.qaVariants = variantsRaw;
      modal.dataset.qaFirstVariant = firstVariant;
      modal.dataset.qaProductAvailable = productAvailable;

      titleEl.textContent = title;
      priceEl.textContent = 'RS. ' + price;

      if (image) {
        imgEl.innerHTML = '<img src="' + image + '" alt="' + title.replace(/"/g, '&quot;') + '" />';
        imgEl.style.display = 'flex';
      } else {
        imgEl.innerHTML = '';
        imgEl.style.display = 'none';
      }

      const actionsEl = modal.querySelector('[data-qa-actions]');
      const soldOutEl = modal.querySelector('[data-qa-sold-out]');

      const setQASoldOut = (isSoldOut) => {
        if (actionsEl) actionsEl.style.display = isSoldOut ? 'none' : '';
        if (soldOutEl) soldOutEl.style.display = isSoldOut ? 'flex' : 'none';
      };
      modal._setQASoldOut = setQASoldOut;
      modal._variantAvailMap = variantAvailMap;

      if (!productAvailable) {
        setQASoldOut(true);
      } else {
        setQASoldOut(false);
      }

      if (sizes.length > 0) {
        let firstAvailIdx = sizes.findIndex(s => variantAvailMap[s] !== false);
        if (firstAvailIdx === -1) firstAvailIdx = 0;
        sizesEl.innerHTML = sizes.map((size, i) => {
          const isSelected = i === firstAvailIdx ? ' is-selected' : '';
          const isUnavailable = variantAvailMap[size] === false ? ' is-unavailable' : '';
          if (i === firstAvailIdx) qaSelectedSize = size;
          return '<button type="button" class="stagmenfashion-qa-modal__size' + isSelected + isUnavailable + '" data-qa-size-btn data-size="' + size + '">' + size + '</button>';
        }).join('');
        if (productAvailable && variantAvailMap[qaSelectedSize] === false) {
          setQASoldOut(true);
        }
      } else {
        sizesEl.innerHTML = '<button type="button" class="stagmenfashion-qa-modal__size is-selected" data-qa-size-btn data-size="Default">Default</button>';
        qaSelectedSize = 'Default';
      }

      modal.style.display = 'flex';
      modal.removeAttribute('hidden');
      requestAnimationFrame(() => {
        modal.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
    };

    const closeQAModal = () => {
      const modal = getQAModal();
      if (!modal) return;
      modal.classList.remove('is-open');
      setTimeout(() => {
        if (!modal.classList.contains('is-open')) {
          modal.style.display = 'none';
          modal.setAttribute('hidden', '');
        }
      }, 220);
      document.body.style.overflow = '';
    };

    const cartAddUrl = window.Shopify?.routes?.root ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js';

    const initQAModal = (scope = document) => {
      scope.querySelectorAll('[data-quick-add]').forEach((btn) => {
        if (btn.dataset.ready === 'true') return;
        btn.dataset.ready = 'true';
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openQAModal(btn);
        });
      });

      scope.querySelectorAll('[data-qa-sizes]').forEach((grid) => {
        if (grid.dataset.ready === 'true') return;
        grid.dataset.ready = 'true';
        grid.addEventListener('click', (e) => {
          const sizeBtn = e.target.closest('[data-qa-size-btn]');
          if (!sizeBtn) return;
          grid.querySelectorAll('[data-qa-size-btn]').forEach(b => b.classList.remove('is-selected'));
          sizeBtn.classList.add('is-selected');
          qaSelectedSize = sizeBtn.dataset.size;
          const modal = getQAModal();
          if (modal && modal._setQASoldOut && modal._variantAvailMap) {
            const isVariantSoldOut = modal._variantAvailMap[qaSelectedSize] === false;
            modal._setQASoldOut(isVariantSoldOut);
          }
        });
      });

      scope.querySelectorAll('[data-qa-close]').forEach((el) => {
        if (el.dataset.ready === 'true') return;
        el.dataset.ready = 'true';
        el.addEventListener('click', closeQAModal);
      });

      if (!document._qaModalHandlerReady) {
        document._qaModalHandlerReady = true;

        const openSizeGuideModal = () => {
          const sgModal = document.querySelector('[data-qa-size-guide-modal]');
          if (sgModal) {
            sgModal.style.display = 'flex';
            sgModal.removeAttribute('hidden');
            requestAnimationFrame(() => {
              sgModal.classList.add('is-open');
              sgModal.setAttribute('aria-hidden', 'false');
            });
            document.body.style.overflow = 'hidden';
          }
        };

        const closeSizeGuideModal = () => {
          const sgModal = document.querySelector('[data-qa-size-guide-modal]');
          if (sgModal) {
            sgModal.classList.remove('is-open');
            sgModal.setAttribute('aria-hidden', 'true');
            setTimeout(() => {
              if (!sgModal.classList.contains('is-open')) {
                sgModal.style.display = 'none';
                sgModal.setAttribute('hidden', '');
              }
            }, 220);
            const qaModal = getQAModal();
            if (!qaModal || !qaModal.classList.contains('is-open')) {
              document.body.style.overflow = '';
            }
          }
        };

        document.addEventListener('click', (e) => {
          const unitBtn = e.target.closest('.stagmenfashion-unit-btn');
          if (unitBtn) {
            e.preventDefault();
            e.stopPropagation();
            const unit = unitBtn.dataset.unit;
            const modal = unitBtn.closest('[data-qa-size-guide-modal]');
            if (!unit || !modal) return;
            const allUnitBtns = modal.querySelectorAll('.stagmenfashion-unit-btn');
            const table = modal.querySelector('[data-qa-size-table]');
            allUnitBtns.forEach((b) => {
              const active = b === unitBtn;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-checked', active ? 'true' : 'false');
            });
            if (table) {
              table.dataset.activeUnit = unit;
              const cells = table.querySelectorAll('td[data-val-cm]');
              cells.forEach((cell) => {
                cell.textContent = unit === 'in' ? cell.dataset.valIn : cell.dataset.valCm;
              });
            }
            return;
          }

          const sizeGuideBtn = e.target.closest('[data-qa-size-guide], [data-wishlist-size-guide]');
          if (sizeGuideBtn) {
            e.preventDefault();
            e.stopPropagation();
            openSizeGuideModal();
            return;
          }

          const sizeGuideCloseBtn = e.target.closest('[data-qa-size-guide-close]');
          if (sizeGuideCloseBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeSizeGuideModal();
            return;
          }

          const addBagBtn = e.target.closest('[data-qa-add-bag]');
          if (addBagBtn) {
            e.preventDefault();
            e.stopPropagation();
            const modal = getQAModal();
            const variantId = resolveVariantId(modal);
            if (!variantId) return;
            addBagBtn.textContent = 'Adding...';
            addBagBtn.disabled = true;
            fetch(cartAddUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' },
              body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
            })
            .then(res => { if (!res.ok) return res.json().then(data => { throw new Error(data.description || 'Add to cart failed'); }); return res.json(); })
            .then((cart) => {
              addBagBtn.textContent = 'Added!';
              document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: { data: cart, resource: cart, metadata: { itemCount: cart.item_count } } }));
              setTimeout(() => { addBagBtn.textContent = 'Add To Bag'; addBagBtn.disabled = false; closeQAModal(); }, 1200);
            })
            .catch((err) => { console.error('Add to bag failed:', err); addBagBtn.textContent = 'Add To Bag'; addBagBtn.disabled = false; });
            return;
          }

          const buyBtn = e.target.closest('[data-qa-buy-now]');
          if (buyBtn) {
            e.preventDefault();
            e.stopPropagation();
            const modal = getQAModal();
            const variantId = resolveVariantId(modal);
            if (!variantId) return;
            buyBtn.textContent = 'Redirecting...';
            buyBtn.disabled = true;
            const rootUrl = window.Shopify?.routes?.root || '/';
            const cleanRoot = rootUrl.endsWith('/') ? rootUrl : rootUrl + '/';
            window.location.href = `${cleanRoot}cart/${variantId}:1`;
            return;
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            const sgModal = document.querySelector('[data-qa-size-guide-modal]');
            if (sgModal && sgModal.classList.contains('is-open')) {
              closeSizeGuideModal();
            } else {
              closeQAModal();
            }
          }
        });
      }
    };

    const initCarousels = (scope = document) => {
      scope.querySelectorAll('[data-carousel]').forEach((carousel) => {
        if (carousel.dataset.ready === 'true') return;
        carousel.dataset.ready = 'true';
        const slides = carousel.querySelectorAll('[data-carousel-slide]');
        const dots = carousel.querySelectorAll('[data-carousel-dot]');
        if (slides.length <= 1) return;

        let currentIndex = 0;

        const goTo = (index) => {
          if (index < 0) index = slides.length - 1;
          if (index >= slides.length) index = 0;
          slides[currentIndex].classList.remove('is-active');
          dots[currentIndex]?.classList.remove('is-active');
          currentIndex = index;
          slides[currentIndex].classList.add('is-active');
          dots[currentIndex]?.classList.add('is-active');
        };

        // Desktop Hover: Show next image on hover, restore first image on leave
        const cardEl = carousel.closest('[data-product-card]') || carousel;
        cardEl.addEventListener('mouseenter', () => {
          if (slides.length > 1) {
            goTo(1);
          }
        });

        cardEl.addEventListener('mouseleave', () => {
          if (slides.length > 1) {
            goTo(0);
          }
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            goTo(parseInt(dot.dataset.index, 10));
          });
        });

        // Touch & Pointer Swipe Support
        carousel.addEventListener('dragstart', (e) => e.preventDefault());

        let startX = 0;
        let startY = 0;
        let diffX = 0;
        let diffY = 0;
        let isPointerActive = false;
        let wasSwiped = false;
        let swipeCooldown = null;
        let lastSwipeTime = 0;

        const triggerSwipe = (direction) => {
          const now = Date.now();
          if (now - lastSwipeTime < 250) return;
          lastSwipeTime = now;
          wasSwiped = true;
          if (swipeCooldown) clearTimeout(swipeCooldown);
          swipeCooldown = setTimeout(() => {
            wasSwiped = false;
          }, 350);

          if (direction === 'next') {
            goTo(currentIndex + 1);
          } else {
            goTo(currentIndex - 1);
          }
        };

        const onPointerDown = (e) => {
          if (e.target.closest('button')) return;
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          startX = e.clientX;
          startY = e.clientY;
          diffX = 0;
          diffY = 0;
          isPointerActive = true;
          try {
            carousel.setPointerCapture(e.pointerId);
          } catch (_) {}
        };

        const onPointerMove = (e) => {
          if (!isPointerActive) return;
          diffX = e.clientX - startX;
          diffY = e.clientY - startY;
        };

        const onPointerUp = (e) => {
          if (!isPointerActive) return;
          isPointerActive = false;
          try {
            carousel.releasePointerCapture(e.pointerId);
          } catch (_) {}

          if (e.clientX !== undefined) {
            diffX = e.clientX - startX;
            diffY = e.clientY - startY;
          }

          const threshold = 20;
          if (Math.abs(diffX) >= threshold && Math.abs(diffX) > Math.abs(diffY)) {
            triggerSwipe(diffX < 0 ? 'next' : 'prev');
          }
        };

        const onPointerCancel = (e) => {
          isPointerActive = false;
          try {
            carousel.releasePointerCapture(e.pointerId);
          } catch (_) {}
        };

        carousel.addEventListener('pointerdown', onPointerDown);
        carousel.addEventListener('pointermove', onPointerMove);
        carousel.addEventListener('pointerup', onPointerUp);
        carousel.addEventListener('pointercancel', onPointerCancel);

        // Touch events fallback for older mobile browsers / WebViews
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;

        carousel.addEventListener('touchstart', (e) => {
          if (e.target.closest('button')) return;
          if (e.touches && e.touches[0]) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
            touchEndX = touchStartX;
            touchEndY = touchStartY;
          }
        }, { passive: true });

        carousel.addEventListener('touchmove', (e) => {
          if (e.touches && e.touches[0]) {
            touchEndX = e.touches[0].clientX;
            touchEndY = e.touches[0].clientY;
          }
        }, { passive: true });

        carousel.addEventListener('touchend', (e) => {
          if (e.changedTouches && e.changedTouches[0]) {
            touchEndX = e.changedTouches[0].clientX;
            touchEndY = e.changedTouches[0].clientY;
          }
          const tDiffX = touchEndX - touchStartX;
          const tDiffY = touchEndY - touchStartY;
          const threshold = 20;

          if (Math.abs(tDiffX) >= threshold && Math.abs(tDiffX) > Math.abs(tDiffY)) {
            triggerSwipe(tDiffX < 0 ? 'next' : 'prev');
          }
        }, { passive: true });

        // Prevent link navigation if a swipe was performed
        carousel.addEventListener('click', (e) => {
          if (e.target.closest('button')) return;
          if (wasSwiped) {
            e.preventDefault();
            e.stopPropagation();
            wasSwiped = false;
          }
        });
      });
    };

    /* ── Grid View Layout Toggle (6 vs 12 Items Per Row) ────────── */
    const STORAGE_GRID_KEY = 'stagmenfashion_grid_view';

    const setGridView = (isTwelve) => {
      document.querySelectorAll('.stagmenfashion-collection-grid').forEach((grid) => {
        grid.classList.toggle('is-grid-12', isTwelve);
        grid.classList.toggle('is-grid-6', isTwelve);
      });
      document.querySelectorAll('[data-grid-toggle], .stagmenfashion-view-icon-btn').forEach((btn) => {
        btn.classList.toggle('is-grid-12-active', isTwelve);
        btn.classList.toggle('is-grid-6-active', isTwelve);
        btn.setAttribute('aria-pressed', isTwelve ? 'true' : 'false');
      });
      try {
        localStorage.setItem(STORAGE_GRID_KEY, isTwelve ? '12' : '6');
      } catch(e) {}
    };

    const initGridViewToggle = () => {
      try {
        const saved = localStorage.getItem(STORAGE_GRID_KEY);
        if (saved === '12') {
          setGridView(true);
        }
      } catch(e) {}
    };

    if (!document._gridToggleDelegated) {
      document._gridToggleDelegated = true;
      document.addEventListener('click', (e) => {
        const toggleBtn = e.target.closest('[data-grid-toggle], .stagmenfashion-view-icon-btn');
        if (toggleBtn) {
          e.preventDefault();
          e.stopPropagation();
          const grid = document.querySelector('.stagmenfashion-collection-grid');
          const isCurrentTwelve = grid ? (grid.classList.contains('is-grid-12') || grid.classList.contains('is-grid-6')) : false;
          setGridView(!isCurrentTwelve);
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      initFilterDrawer();
      initCarousels();
      initSection();
      initModal();
      initQAModal();
      initGridViewToggle();
    });
    document.addEventListener('shopify:section:load', (event) => {
      initFilterDrawer();
      initCarousels(event.target);
      initSection(event.target);
      initQAModal(event.target);
      initGridViewToggle();
    });
  })();
</script>

