<dialog
  id="wishlist-drawer"
  class="wl-drawer"
  aria-label="Wishlist"
>
  <div class="wl-drawer__inner">
    <!-- Header (Compact minimal height) -->
    <div class="wl-drawer__header">
      <div class="wl-drawer__title-wrap">
        <h2 class="wl-drawer__heading">Wishlist</h2>
        <span class="wl-drawer__count" id="wishlist-drawer-count">(0)</span>
      </div>

      <button
        class="wl-drawer__close"
        type="button"
        aria-label="Close wishlist"
        id="wishlist-drawer-close"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Notification Toast -->
    <div class="wl-drawer__toast" id="wishlist-drawer-toast" style="display:none;" role="status"></div>

    <!-- Drawer Body (Scrollable container) -->
    <div class="wl-drawer__body" id="wishlist-drawer-body">
      <!-- Empty state -->
      <div class="wl-drawer__empty" id="wishlist-drawer-empty" style="display:none">
        <p class="wl-drawer__empty-title">Your wishlist is empty</p>
        <p class="wl-drawer__empty-sub">Save your favourite pieces to review them anytime.</p>
        <a href="/collections/all" class="wl-drawer__empty-cta" id="wishlist-drawer-shop-btn">
          Explore Collection
        </a>
      </div>

      <!-- Populated item list -->
      <div class="wl-drawer__items-wrap" id="wishlist-drawer-items-wrap">
        <div class="wl-drawer__list" id="wishlist-drawer-grid"></div>
      </div>
    </div>

    <!-- Drawer Sticky Footer (Clear Wishlist + Continue Shopping) -->
    <div class="wl-drawer__footer" id="wishlist-drawer-footer" style="display:none">
      <button type="button" class="wl-drawer__footer-btn wl-drawer__footer-btn--outline" id="wishlist-drawer-clear-btn">
        Clear Wishlist
      </button>
      <button type="button" class="wl-drawer__footer-btn wl-drawer__footer-btn--solid" id="wishlist-continue-shop-btn">
        Continue Shopping
      </button>
    </div>
  </div>
</dialog>

<button
  class="wl-drawer__backdrop visually-hidden"
  id="wishlist-drawer-backdrop"
  aria-label="Close wishlist"
  type="button"
></button>

<style>
  /* Backdrop */
  .wl-drawer__backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 499;
    border: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }

  .wl-drawer__backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Drawer Dialog Container */
  .wl-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: auto;
    height: 100dvh;
    max-height: 100dvh;
    width: min(100vw, 400px);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #ffffff;
    color: #111111;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.08);
    z-index: 500;
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.2, 0.9, 0.3, 1), visibility 0.32s;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    visibility: hidden;
    max-width: 100%;
  }

  .wl-drawer[open] {
    display: flex;
    flex-direction: column;
    transform: translateX(0);
    visibility: visible;
  }

  .wl-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
    max-height: 100dvh;
    overflow: hidden;
    background: #ffffff;
  }

  /* Header (Reduced Height) */
  .wl-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    box-sizing: border-box;
    border-bottom: 1px solid #f0f0f0;
    flex-shrink: 0;
    background: #ffffff;
  }

  .wl-drawer__title-wrap {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .wl-drawer__heading {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
    line-height: 1;
  }

  .wl-drawer__count {
    font-size: 0.8rem;
    font-weight: 500;
    color: #888888;
    line-height: 1;
  }

  .wl-drawer__close {
    width: 26px;
    height: 26px;
    display: inline-grid;
    place-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: #111111;
    padding: 0;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .wl-drawer__close:hover {
    opacity: 1;
  }

  /* Toast Notification */
  .wl-drawer__toast {
    background: #111111;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 7px 20px;
    text-align: center;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  /* Body Content (Dedicated Smooth Scroll) */
  .wl-drawer__body {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    min-height: 0;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
  }

  /* Empty State */
  .wl-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 50px 16px;
    gap: 6px;
  }

  .wl-drawer__empty-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111111;
    margin: 0;
  }

  .wl-drawer__empty-sub {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #777777;
    margin: 0 0 14px 0;
    max-width: 240px;
  }

  .wl-drawer__empty-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    min-height: 38px;
    background: #111111;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.75rem;
    text-decoration: none;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: opacity 0.18s ease;
  }

  .wl-drawer__empty-cta:hover {
    opacity: 0.85;
  }

  /* Populated Item List */
  .wl-drawer__items-wrap {
    width: 100%;
    padding-top: 4px;
    padding-bottom: 16px;
  }

  .wl-drawer__list {
    display: flex;
    flex-direction: column;
  }

  /* Individual Wishlist Item */
  .wl-item {
    display: grid;
    grid-template-columns: 68px 1fr;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #f2f2f2;
    transition: opacity 0.2s ease, transform 0.2s ease;
    align-items: start;
  }

  .wl-item:last-child {
    border-bottom: none;
  }

  .wl-item.is-removing {
    opacity: 0;
    transform: translateX(12px);
  }

  .wl-item__media {
    display: block;
    aspect-ratio: 3 / 4;
    background: #f7f7f7;
    overflow: hidden;
    position: relative;
    border-radius: 1px;
  }

  .wl-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wl-item__img-placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  .wl-item__details {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .wl-item__row-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .wl-item__title {
    font-size: 0.82rem;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wl-item__title:hover {
    text-decoration: underline;
  }

  .wl-item__remove {
    width: 20px;
    height: 20px;
    display: inline-grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: #999999;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .wl-item__remove:hover {
    color: #111111;
  }

  .wl-item__meta {
    font-size: 0.74rem;
    color: #888888;
  }

  .wl-item__price {
    font-size: 0.82rem;
    font-weight: 600;
    color: #111111;
    margin-top: 1px;
  }

  .wl-item__actions {
    margin-top: 6px;
  }

  .wl-item__add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    min-height: 28px;
    background: #111111;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 0;
    cursor: pointer;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }

  .wl-item__add-btn:hover {
    opacity: 0.85;
  }

  .wl-item__add-btn.is-loading {
    opacity: 0.5;
    pointer-events: none;
  }

  .wl-item__view-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.74rem;
    font-weight: 600;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.15s ease;
  }

  .wl-item__view-link:hover {
    opacity: 0.7;
  }

  /* Footer (Clear Wishlist & Continue Shopping) */
  .wl-drawer__footer {
    border-top: 1px solid #f0f0f0;
    padding: 14px 20px 16px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }

  .wl-drawer__footer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    min-height: 40px;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
    box-sizing: border-box;
    width: 100%;
  }

  .wl-drawer__footer-btn--solid {
    background: #111111;
    color: #ffffff;
    border: 1px solid #111111;
  }

  .wl-drawer__footer-btn--solid:hover {
    opacity: 0.85;
  }

  .wl-drawer__footer-btn--outline {
    background: #ffffff;
    color: #111111;
    border: 1px solid #e0e0e0;
  }

  .wl-drawer__footer-btn--outline:hover {
    border-color: #111111;
    background: #fafafa;
  }

  @media (max-width: 749px) {
    .wl-drawer {
      width: 100vw;
    }

    .wl-drawer__header {
      padding: 12px 16px;
    }

    .wl-drawer__body {
      padding: 0 16px;
    }

    .wl-drawer__footer {
      padding: 12px 16px 14px;
    }
  }
</style>

{% javascript %}
(function() {
  const drawer   = document.getElementById('wishlist-drawer');
  const backdrop = document.getElementById('wishlist-drawer-backdrop');
  const closeBtn = document.getElementById('wishlist-drawer-close');
  const grid     = document.getElementById('wishlist-drawer-grid');
  const empty    = document.getElementById('wishlist-drawer-empty');
  const footer   = document.getElementById('wishlist-drawer-footer');
  const countEl  = document.getElementById('wishlist-drawer-count');
  const clearBtn = document.getElementById('wishlist-drawer-clear-btn');
  const toast    = document.getElementById('wishlist-drawer-toast');
  const continueBtn = document.getElementById('wishlist-continue-shop-btn');

  if (!drawer) return;

  let toastTimer = null;
  function showToast(msg, duration = 2200) {
    if (!toast) return;
    toast.textContent = msg;
    toast.style.display = 'block';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.style.display = 'none';
    }, duration);
  }

  function openDrawer() {
    drawer.setAttribute('open', '');
    if (backdrop) backdrop.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    renderGrid();
  }

  function closeDrawer() {
    drawer.removeAttribute('open');
    if (backdrop) backdrop.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  // Close handlers
  if (backdrop) backdrop.addEventListener('click', closeDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (continueBtn) continueBtn.addEventListener('click', closeDrawer);
  drawer.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

  // Clear all button handler in footer
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (confirm('Clear all items from wishlist?')) {
        if (typeof window.clearWishlist === 'function') {
          window.clearWishlist();
        } else {
          localStorage.setItem('wishlist', '[]');
          document.dispatchEvent(new CustomEvent('wishlist:update'));
        }
        showToast('Wishlist cleared');
      }
    });
  }

  // Add to Bag handler inside drawer
  grid.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-wl-add-cart]');
    if (!btn) return;

    e.preventDefault();
    e.stopPropagation();

    const variantId = btn.dataset.wlAddCart;
    if (!variantId) return;

    btn.classList.add('is-loading');
    const originalText = btn.textContent;
    btn.textContent = 'Adding...';

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: Number(variantId), quantity: 1 })
      });

      if (response.ok) {
        const item = await response.json();
        showToast(`Added to Bag`);
        
        // Dispatch cart updates
        document.dispatchEvent(new CustomEvent('cart:update', { detail: { resource: item } }));
        window.dispatchEvent(new CustomEvent('cart:update', { detail: { resource: item } }));
        
        // Trigger cart drawer if available
        const cartDrawerTrigger = document.querySelector('[data-testid="cart-drawer-trigger"], [data-open-cart-drawer], .stagmenfashion-header__cart-button');
        if (cartDrawerTrigger) {
          setTimeout(() => {
            closeDrawer();
            cartDrawerTrigger.click();
          }, 500);
        }
      } else {
        const err = await response.json();
        showToast(err.description || 'Could not add item');
      }
    } catch (error) {
      showToast('Error adding to bag.');
    } finally {
      btn.classList.remove('is-loading');
      btn.textContent = originalText;
    }
  });

  // Remove handler with smooth slide-out animation
  grid.addEventListener('click', (e) => {
    const removeBtn = e.target.closest('[data-wishlist-remove]');
    if (!removeBtn) return;

    e.preventDefault();
    e.stopPropagation();

    const handle = removeBtn.dataset.wishlistRemove;
    const itemEl = removeBtn.closest('.wl-item');

    if (itemEl) {
      itemEl.classList.add('is-removing');
      setTimeout(() => {
        if (typeof window.removeFromWishlist === 'function') {
          window.removeFromWishlist(handle);
        } else {
          let list = JSON.parse(localStorage.getItem('wishlist') || '[]');
          list = list.filter(i => i.handle !== handle);
          localStorage.setItem('wishlist', JSON.stringify(list));
          document.dispatchEvent(new CustomEvent('wishlist:update'));
        }
      }, 180);
    }
  });

  function renderGrid() {
    const list = JSON.parse(localStorage.getItem('wishlist') || '[]');
    const count = list.length;

    if (countEl) countEl.textContent = `(${count})`;

    if (count === 0) {
      grid.innerHTML = '';
      grid.style.display   = 'none';
      empty.style.display  = 'flex';
      footer.style.display = 'none';
      return;
    }

    grid.style.display   = 'flex';
    empty.style.display  = 'none';
    footer.style.display = 'flex';

    grid.innerHTML = list.map(item => {
      const t  = (item.title || '').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      const img = item.image || '';
      const sizeParam = item.size && item.size !== 'Default' ? '?size=' + encodeURIComponent(item.size) : '';
      const productUrl = '/products/' + item.handle + sizeParam;
      const variantId = item.variantId || '';

      return `
        <article class="wl-item" data-handle="${item.handle}">
          <a class="wl-item__media" href="${productUrl}">
            ${img ? `<img class="wl-item__img" src="${img}" alt="${t}" loading="lazy">` : `<div class="wl-item__img-placeholder"></div>`}
          </a>

          <div class="wl-item__details">
            <div class="wl-item__row-top">
              <a class="wl-item__title" href="${productUrl}">${t}</a>
              <button
                class="wl-item__remove"
                type="button"
                aria-label="Remove item"
                title="Remove"
                data-wishlist-remove="${item.handle}"
              >
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            ${item.size && item.size !== 'Default' ? `<div class="wl-item__meta">Size: ${item.size}</div>` : ''}

            <div class="wl-item__price">${item.price || ''}</div>

            <div class="wl-item__actions">
              ${variantId ? `
                <button
                  type="button"
                  class="wl-item__add-btn"
                  data-wl-add-cart="${variantId}"
                  data-product-handle="${item.handle}"
                  data-product-title="${t}"
                >
                  Add to Bag
                </button>
              ` : `
                <a
                  href="${productUrl}"
                  class="wl-item__view-link"
                >
                  View Product
                </a>
              `}
            </div>
          </div>
        </article>`;
    }).join('');
  }

  // Re-render when wishlist changes
  document.addEventListener('wishlist:update', renderGrid);

  // Listen for the open trigger (header button dispatches this)
  document.addEventListener('wishlist-drawer:open', openDrawer);
  document.addEventListener('wishlist-drawer:close', closeDrawer);

  // Expose globally so the header button or scripts can call it
  window.openWishlistDrawer = openDrawer;
  window.closeWishlistDrawer = closeDrawer;
})();
{% endjavascript %}

{% schema %}
{
  "name": "Wishlist Drawer",
  "settings": []
}
{% endschema %}
