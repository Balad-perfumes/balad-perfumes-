<dialog id="wishlist-drawer" class="wl-drawer" aria-labelledby="wishlist-drawer-heading">
  <div class="wl-drawer__inner">
    <div class="wl-drawer__header">
      <div class="wl-drawer__title-wrap">
        <h2 class="wl-drawer__heading" id="wishlist-drawer-heading">Wishlist</h2>
        <span class="wl-drawer__badge" id="wishlist-drawer-count">0</span>
      </div>
      <div class="wl-drawer__header-actions">
        <button type="button" class="wl-drawer__clear" id="wishlist-drawer-clear-btn" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9.5 7V4.8h5V7"/><path d="M6.5 7l.8 12.2a1 1 0 0 0 1 .9h7.4a1 1 0 0 0 1-.9L17.5 7"/></svg>
          <span>Clear all</span>
        </button>
        <span class="wl-drawer__header-sep" id="wishlist-drawer-sep" aria-hidden="true" hidden></span>
        <button class="wl-drawer__close" type="button" aria-label="Close wishlist" id="wishlist-drawer-close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <line x1="17.5" y1="6.5" x2="6.5" y2="17.5"></line>
            <line x1="6.5" y1="6.5" x2="17.5" y2="17.5"></line>
          </svg>
        </button>
      </div>
    </div>

    <div class="wl-drawer__scroll">
      <div class="wl-drawer__empty" id="wishlist-drawer-empty" hidden>
        <span class="wl-drawer__empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-3.8-6.5 3.8v-16a1 1 0 0 1 1-1z"/>
          </svg>
        </span>
        <p class="wl-drawer__empty-title">Your wishlist is empty</p>
        <p class="wl-drawer__empty-sub">Tap the bookmark on any fragrance to save it for later.</p>
        <a href="{{ routes.all_products_collection_url }}" class="wl-drawer__empty-btn">Shop fragrances</a>
      </div>

      <div class="wl-drawer__note" id="wishlist-drawer-note" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-3.8-6.5 3.8v-16a1 1 0 0 1 1-1z"/></svg>
        <span>Saved on this device. Add your favourites to the bag anytime.</span>
      </div>

      <ul class="wl-drawer__list" id="wishlist-drawer-grid" role="list"></ul>
    </div>

    <div class="wl-drawer__footer" id="wishlist-drawer-footer" hidden>
      <button type="button" class="wl-drawer__secondary" id="wishlist-continue-shop-btn">Continue shopping</button>
      <button type="button" class="wl-drawer__cta" id="wishlist-add-all-btn">
        <svg class="wl-drawer__cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.75 9.25A2.25 2.25 0 0 1 7 7h10a2.25 2.25 0 0 1 2.25 2.25V17.5A3.5 3.5 0 0 1 15.75 21h-7.5a3.5 3.5 0 0 1-3.5-3.5z"/><path d="M8.75 7V6.25a3.25 3.25 0 0 1 6.5 0V7"/><path d="M12 11.25v5.5M9.25 14h5.5"/></svg>
        <span class="wl-drawer__cta-label">Add all to bag</span>
        <span class="wl-drawer__cta-count" id="wishlist-add-all-count"></span>
      </button>
    </div>

    <div class="wl-drawer__toast" id="wishlist-drawer-toast" role="status" aria-live="polite"></div>
  </div>
</dialog>

<style>
  /* =============================================================
     BALAD WISHLIST DRAWER — matches the cart drawer
     ============================================================= */
  .wl-drawer {
    --d-bg: #ffffff;
    --d-tint: #f7f3ed;
    --d-tint-2: #efe8dd;
    --d-ink: #15130f;
    --d-text: #2c2823;
    --d-muted: #8a8279;
    --d-line: #efeae2;
    --d-gold: #a8844a;
    --d-success: #2f7a4b;
    --d-danger: #b3261e;
    --d-pad: 20px;
    --d-head: var(--font-heading--family, 'Manrope'), var(--font-body--family, sans-serif);
    --d-ease: cubic-bezier(0.22, 1, 0.36, 1);

    position: fixed;
    inset: 0 0 0 auto;
    width: min(100vw, 400px);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--d-bg);
    color: var(--d-text);
    box-shadow: -24px 0 60px -28px rgba(21, 19, 15, 0.35);
    overflow: hidden;
  }
  .wl-drawer *, .wl-drawer *::before, .wl-drawer *::after { box-sizing: border-box; }
  .wl-drawer p { margin: 0; }
  .wl-drawer [hidden] { display: none !important; }

  .wl-drawer[open] { display: flex; flex-direction: column; animation: wlIn 0.42s var(--d-ease) both; }
  .wl-drawer.is-closing { animation: wlOut 0.28s ease-in both; }
  .wl-drawer::backdrop { background: rgba(21, 19, 15, 0.42); animation: wlFade 0.3s ease both; }
  .wl-drawer.is-closing::backdrop { animation: wlFade 0.28s ease reverse both; }
  @keyframes wlIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @keyframes wlOut { from { transform: translateX(0); } to { transform: translateX(100%); } }
  @keyframes wlFade { from { opacity: 0; } to { opacity: 1; } }

  .wl-drawer__inner { position: relative; display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 0; }

  /* ---------- Header ---------- */
  .wl-drawer__header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 60px;
    padding: 0 12px 0 var(--d-pad);
    border-bottom: 1px solid var(--d-line);
  }
  .wl-drawer__title-wrap { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .wl-drawer__heading {
    margin: 0;
    font-family: var(--d-head);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--d-ink);
  }
  .wl-drawer__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--d-tint-2);
    color: var(--d-ink);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
  .wl-drawer__header-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .wl-drawer__clear {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 32px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--d-muted);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .wl-drawer__clear svg { width: 14px; height: 14px; }
  .wl-drawer__clear:hover { color: var(--d-danger); background: rgba(179, 38, 30, 0.06); }
  .wl-drawer__header-sep { width: 1px; height: 18px; margin: 0 2px; background: var(--d-line); }
  .wl-drawer__close {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--d-tint);
    color: var(--d-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .wl-drawer__close svg { width: 16px; height: 16px; display: block; transition: transform 0.35s var(--d-ease); }
  .wl-drawer__close:hover { background: var(--d-ink); color: #ffffff; }
  .wl-drawer__close:hover svg { transform: rotate(90deg); }
  .wl-drawer__close:focus-visible { outline: 2px solid var(--d-ink); outline-offset: 2px; }

  /* ---------- Scroll ---------- */
  .wl-drawer__scroll {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 12px var(--d-pad) 18px;
    scrollbar-width: thin;
    scrollbar-color: rgba(21, 19, 15, 0.15) transparent;
  }

  .wl-drawer__note {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--d-tint);
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--d-muted);
  }
  .wl-drawer__note svg { flex-shrink: 0; width: 16px; height: 16px; color: var(--d-gold); }

  /* ---------- Items ---------- */
  .wl-drawer__list { list-style: none; margin: 4px 0 0; padding: 0; }

  .wl-item {
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr);
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--d-line);
    transition: opacity 0.25s ease, transform 0.3s var(--d-ease);
  }
  .wl-item:last-child { border-bottom: 0; }
  .wl-item.is-removing { opacity: 0; transform: translateX(16px); }
  .wl-drawer[open] .wl-item { animation: wlRowIn 0.5s var(--d-ease) both; }
  .wl-drawer[open] .wl-item:nth-child(2) { animation-delay: 0.05s; }
  .wl-drawer[open] .wl-item:nth-child(3) { animation-delay: 0.1s; }
  .wl-drawer[open] .wl-item:nth-child(4) { animation-delay: 0.15s; }
  .wl-drawer[open] .wl-item:nth-child(n + 5) { animation-delay: 0.2s; }
  @keyframes wlRowIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .wl-item__media {
    display: block;
    width: 68px;
    height: 84px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--d-tint);
  }
  .wl-item__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--d-ease); }
  .wl-item__media:hover .wl-item__img { transform: scale(1.06); }

  .wl-item__body { display: flex; flex-direction: column; min-width: 0; }
  .wl-item__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .wl-item__info { min-width: 0; }
  .wl-item__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--d-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .wl-item__title:hover { color: var(--d-gold); }
  .wl-item__meta {
    margin-top: 4px !important;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--d-muted);
  }
  .wl-item__price {
    flex-shrink: 0;
    font-family: var(--d-head);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--d-ink);
    white-space: nowrap;
  }

  .wl-item__foot {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .wl-item__add-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 30px;
    padding: 0 13px 0 11px;
    border: 0;
    border-radius: 999px;
    background: var(--d-tint);
    color: var(--d-ink);
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .wl-item__add-btn svg { width: 14px; height: 14px; }
  .wl-item__add-btn:hover { background: var(--d-ink); color: #ffffff; }
  .wl-item__add-btn.is-loading { pointer-events: none; color: transparent; }
  .wl-item__add-btn.is-loading::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid var(--d-ink);
    border-right-color: transparent;
    border-radius: 50%;
    animation: wlSpin 0.7s linear infinite;
  }
  .wl-item__add-btn.is-added { background: var(--d-success); color: #ffffff; }
  @keyframes wlSpin { to { transform: rotate(360deg); } }

  .wl-item__remove {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    margin-right: -6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #b0a89e;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .wl-item__remove svg { width: 15px; height: 15px; }
  .wl-item__remove:hover { color: var(--d-danger); background: rgba(179, 38, 30, 0.07); }

  /* ---------- Empty ---------- */
  .wl-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 20px 64px;
  }
  .wl-drawer__empty-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--d-tint);
    color: var(--d-gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wl-drawer__empty-icon svg { width: 24px; height: 24px; }
  .wl-drawer__empty-title { margin: 0 0 6px !important; font-family: var(--d-head); font-size: 17px; font-weight: 700; letter-spacing: -0.01em; color: var(--d-ink); }
  .wl-drawer__empty-sub { margin: 0 0 20px !important; max-width: 250px; font-size: 12.5px; line-height: 1.5; color: var(--d-muted); }
  .wl-drawer__empty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--d-ink);
    color: #ffffff;
    font-family: var(--d-head);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .wl-drawer__empty-btn:hover { background: #26221d; }

  /* ---------- Footer ---------- */
  .wl-drawer__footer {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 12px var(--d-pad) calc(10px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--d-line);
    background: var(--d-bg);
  }
  /* Add all to bag — centred pill (deliberately unlike the checkout button) */
  .wl-drawer__cta {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    height: 48px;
    margin: 0;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--d-ink);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    box-shadow: 0 10px 22px -14px rgba(21, 19, 15, 0.7);
    transition: background-color 0.2s ease, transform 0.25s var(--d-ease), box-shadow 0.25s ease;
  }
  .wl-drawer__cta:hover { background: #2a2620; transform: translateY(-1px); box-shadow: 0 14px 26px -14px rgba(21, 19, 15, 0.75); }
  .wl-drawer__cta:active { transform: translateY(0); }
  .wl-drawer__cta:focus-visible { outline: 2px solid var(--d-ink); outline-offset: 3px; }
  .wl-drawer__cta-icon { width: 18px; height: 18px; flex-shrink: 0; color: #d9bf8a; transition: transform 0.3s var(--d-ease); }
  .wl-drawer__cta:hover .wl-drawer__cta-icon { transform: scale(1.1); }
  .wl-drawer__cta-label { font-family: var(--d-head); font-size: 14px; font-weight: 600; letter-spacing: 0.01em; line-height: 1; }
  .wl-drawer__cta-count {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    background: rgba(217, 191, 138, 0.18);
    color: #e8d3a6;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  /* Count already shows in the header badge; hidden so both footer buttons fit on one row */
  .wl-drawer__cta-count { display: none !important; }

  .wl-drawer__cta.is-loading { pointer-events: none; }
  .wl-drawer__cta.is-loading > * { visibility: hidden; }
  .wl-drawer__cta.is-loading::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: wlSpin 0.7s linear infinite;
  }

  .wl-drawer__secondary {
    flex: 0 0 auto;
    height: 48px;
    margin: 0;
    padding: 0 18px;
    border: 1px solid #ddd5c9;
    border-radius: 999px;
    background: var(--d-bg);
    color: var(--d-ink);
    font-family: var(--d-head);
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .wl-drawer__secondary:hover { border-color: var(--d-ink); background: var(--d-tint); }
  .wl-drawer__secondary:focus-visible { outline: 2px solid var(--d-ink); outline-offset: 3px; }

  /* ---------- Toast ---------- */
  .wl-drawer__toast {
    position: absolute;
    left: 50%;
    bottom: 84px;
    z-index: 5;
    max-width: calc(100% - 40px);
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--d-ink);
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 10px 24px -10px rgba(21, 19, 15, 0.5);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition: opacity 0.25s ease, transform 0.3s var(--d-ease);
  }
  .wl-drawer__toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
  .wl-drawer__inner:has(.wl-drawer__footer[hidden]) .wl-drawer__toast { bottom: 24px; }

  @media (max-width: 749px) {
    .wl-drawer { width: 100vw; --d-pad: 16px; }
    .wl-drawer__header { height: 56px; padding-right: 10px; }
    .wl-drawer__heading { font-size: 17px; }
  }
  @media (max-width: 440px) {
    .wl-drawer__secondary { padding: 0 14px; font-size: 13px; }
    .wl-drawer__cta { padding: 0 12px; gap: 8px; }
    .wl-drawer__cta-label { font-size: 13.5px; }
  }
  @media (max-width: 360px) {
    .wl-drawer__clear span { display: none; }
    .wl-drawer__secondary { padding: 0 12px; font-size: 12px; }
    .wl-drawer__cta-icon { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-drawer, .wl-drawer *, .wl-drawer::backdrop { transition: none !important; animation: none !important; }
  }
</style>

{% javascript %}
(function () {
  const drawer = document.getElementById('wishlist-drawer');
  if (!drawer) return;

  const closeBtn = document.getElementById('wishlist-drawer-close');
  const grid = document.getElementById('wishlist-drawer-grid');
  const empty = document.getElementById('wishlist-drawer-empty');
  const note = document.getElementById('wishlist-drawer-note');
  const footer = document.getElementById('wishlist-drawer-footer');
  const countEl = document.getElementById('wishlist-drawer-count');
  const clearBtn = document.getElementById('wishlist-drawer-clear-btn');
  const sep = document.getElementById('wishlist-drawer-sep');
  const addAllBtn = document.getElementById('wishlist-add-all-btn');
  const addAllCount = document.getElementById('wishlist-add-all-count');
  const toast = document.getElementById('wishlist-drawer-toast');
  const continueBtn = document.getElementById('wishlist-continue-shop-btn');

  const getList = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem('wishlist') || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      return [];
    }
  };

  const escapeHtml = (s) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Prices are stored as plain numbers ("1499.00"); older entries may already be formatted.
  const formatPrice = (value) => {
    const raw = String(value ?? '').trim();
    if (!raw) return '';
    if (/[^\d.,\s]/.test(raw)) return raw;
    const n = Number(raw.replace(/,/g, ''));
    if (!n) return '';
    return '₹' + n.toLocaleString('en-IN', { maximumFractionDigits: 2 });
  };

  let toastTimer = null;
  const showToast = (msg, duration = 2200) => {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('is-visible');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('is-visible'), duration);
  };

  // ---------- Open / close (true modal so it sits above the mobile nav bar) ----------
  let closeTimer = null;
  const openDrawer = () => {
    clearTimeout(closeTimer);
    drawer.classList.remove('is-closing');
    renderGrid();
    if (!drawer.open) {
      if (typeof drawer.showModal === 'function') drawer.showModal();
      else drawer.setAttribute('open', '');
    }
    document.documentElement.style.overflow = 'hidden';
  };

  const closeDrawer = () => {
    if (!drawer.open || drawer.classList.contains('is-closing')) return;
    drawer.classList.add('is-closing');
    closeTimer = setTimeout(() => {
      drawer.classList.remove('is-closing');
      if (typeof drawer.close === 'function') drawer.close();
      else drawer.removeAttribute('open');
      document.documentElement.style.overflow = '';
    }, 260);
  };

  drawer.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeDrawer();
  });
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });
  closeBtn?.addEventListener('click', closeDrawer);
  continueBtn?.addEventListener('click', closeDrawer);

  clearBtn?.addEventListener('click', () => {
    if (!confirm('Remove all items from your wishlist?')) return;
    if (typeof window.clearWishlist === 'function') {
      window.clearWishlist();
    } else {
      localStorage.setItem('wishlist', '[]');
      document.dispatchEvent(new CustomEvent('wishlist:update'));
    }
    showToast('Wishlist cleared');
  });

  // ---------- Cart helpers ----------
  // Saved items have no variant id: match the saved size, else first available variant.
  const resolveVariantId = async (item) => {
    if (item.variantId) return item.variantId;
    const res = await fetch('/products/' + encodeURIComponent(item.handle) + '.js', { headers: { Accept: 'application/json' } });
    if (!res.ok) throw new Error('Product not found');
    const product = await res.json();
    const variants = product.variants || [];
    const size = String(item.size || '').trim().toLowerCase();
    const bySize =
      size && size !== 'default'
        ? variants.find((v) => v.available && (v.options || []).some((o) => String(o).trim().toLowerCase() === size))
        : null;
    const variant = bySize || variants.find((v) => v.available);
    if (!variant) throw new Error('sold-out');
    return variant.id;
  };

  const addToCart = async (items) => {
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items })
    });
    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err.description || 'Could not add item');
    }
  };

  const goToCart = () => {
    closeDrawer();
    setTimeout(() => {
      if (typeof window.pfOpenCart === 'function') window.pfOpenCart('wishlist-drawer');
      else window.location.href = '/cart';
    }, 280);
  };

  addAllBtn?.addEventListener('click', async () => {
    const list = getList();
    if (!list.length) return;
    addAllBtn.classList.add('is-loading');
    const results = await Promise.allSettled(list.map(resolveVariantId));
    const items = results.filter((r) => r.status === 'fulfilled').map((r) => ({ id: Number(r.value), quantity: 1 }));
    try {
      if (!items.length) throw new Error('These items are sold out');
      await addToCart(items);
      const skipped = list.length - items.length;
      showToast(skipped ? `Added ${items.length} · ${skipped} unavailable` : 'All items added to your bag');
      setTimeout(goToCart, 600);
    } catch (error) {
      showToast(error.message || 'Could not add items');
    } finally {
      addAllBtn.classList.remove('is-loading');
    }
  });

  grid.addEventListener('click', async (e) => {
    const removeBtn = e.target.closest('[data-wl-remove]');
    if (removeBtn) {
      e.preventDefault();
      const handle = removeBtn.dataset.wlRemove;
      removeBtn.closest('.wl-item')?.classList.add('is-removing');
      setTimeout(() => {
        if (typeof window.removeFromWishlist === 'function') {
          window.removeFromWishlist(handle);
        } else {
          localStorage.setItem('wishlist', JSON.stringify(getList().filter((i) => i.handle !== handle)));
          document.dispatchEvent(new CustomEvent('wishlist:update'));
        }
      }, 220);
      return;
    }

    const addBtn = e.target.closest('[data-wl-add-cart]');
    if (!addBtn) return;
    e.preventDefault();

    const item = getList().find((i) => i.handle === addBtn.dataset.wlAddCart);
    if (!item) return;

    addBtn.classList.add('is-loading');
    try {
      const variantId = await resolveVariantId(item);
      await addToCart([{ id: Number(variantId), quantity: 1 }]);
      addBtn.classList.remove('is-loading');
      addBtn.classList.add('is-added');
      addBtn.textContent = 'Added';
      showToast('Added to your bag');
      setTimeout(goToCart, 550);
    } catch (error) {
      addBtn.classList.remove('is-loading');
      showToast(error.message === 'sold-out' ? 'This item is sold out' : error.message || 'Could not add item');
    }
  });

  // ---------- Render ----------
  const bagIcon =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.75 9.25A2.25 2.25 0 0 1 7 7h10a2.25 2.25 0 0 1 2.25 2.25V17.5A3.5 3.5 0 0 1 15.75 21h-7.5a3.5 3.5 0 0 1-3.5-3.5z"/><path d="M8.75 7V6.25a3.25 3.25 0 0 1 6.5 0V7"/><path d="M12 11.25v5.5M9.25 14h5.5"/></svg>';
  const trashIcon =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9.5 7V4.8h5V7"/><path d="M6.5 7l.8 12.2a1 1 0 0 0 1 .9h7.4a1 1 0 0 0 1-.9L17.5 7"/></svg>';

  function renderGrid() {
    const list = getList();
    const count = list.length;
    const has = count > 0;

    if (countEl) countEl.textContent = String(count);
    if (addAllCount) addAllCount.textContent = count === 1 ? '1 item' : `${count} items`;
    grid.hidden = !has;
    note.hidden = !has;
    footer.hidden = !has;
    clearBtn.hidden = !has;
    sep.hidden = !has;
    empty.hidden = has;

    if (!has) {
      grid.innerHTML = '';
      return;
    }

    grid.innerHTML = list
      .map((item) => {
        const title = escapeHtml(item.title);
        const handle = escapeHtml(item.handle);
        const hasSize = item.size && item.size !== 'Default';
        const productUrl =
          '/products/' + encodeURIComponent(item.handle || '') + (hasSize ? '?size=' + encodeURIComponent(item.size) : '');
        const price = formatPrice(item.price);
        const img = item.image
          ? `<img class="wl-item__img" src="${escapeHtml(item.image)}" alt="${title}" loading="lazy" width="68" height="84">`
          : '';

        return `
          <li class="wl-item" data-handle="${handle}">
            <a class="wl-item__media" href="${productUrl}" tabindex="-1" aria-hidden="true">${img}</a>
            <div class="wl-item__body">
              <div class="wl-item__head">
                <div class="wl-item__info">
                  <a class="wl-item__title" href="${productUrl}">${title}</a>
                  ${hasSize ? `<p class="wl-item__meta">${escapeHtml(item.size)}</p>` : ''}
                </div>
                ${price ? `<span class="wl-item__price">${price}</span>` : ''}
              </div>
              <div class="wl-item__foot">
                <button type="button" class="wl-item__add-btn" data-wl-add-cart="${handle}">${bagIcon}<span>Add to bag</span></button>
                <button class="wl-item__remove" type="button" aria-label="Remove ${title} from wishlist" data-wl-remove="${handle}">${trashIcon}</button>
              </div>
            </div>
          </li>`;
      })
      .join('');
  }

  document.addEventListener('wishlist:update', renderGrid);
  document.addEventListener('wishlist-drawer:open', openDrawer);
  document.addEventListener('wishlist-drawer:close', closeDrawer);

  window.openWishlistDrawer = openDrawer;
  window.closeWishlistDrawer = closeDrawer;
})();
{% endjavascript %}

{% schema %}
{
  "name": "Wishlist Drawer",
  "settings": []
}
{% endschema %}
