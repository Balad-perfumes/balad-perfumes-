<dialog id="wishlist-drawer" class="wl-drawer" aria-labelledby="wishlist-drawer-heading">
  <div class="wl-drawer__inner">
    <div class="wl-drawer__header">
      <div class="wl-drawer__title-wrap">
        <h2 class="wl-drawer__heading" id="wishlist-drawer-heading">Wishlist</h2>
        <span class="wl-drawer__badge" id="wishlist-drawer-count">0</span>
      </div>
      <div class="wl-drawer__header-actions">
        <button type="button" class="wl-drawer__clear" id="wishlist-drawer-clear-btn" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9.5 7V4.8h5V7"/><path d="M6.5 7l.8 12.2a1 1 0 0 0 1 .9h7.4a1 1 0 0 0 1-.9L17.5 7"/></svg>
          <span>Clear all</span>
        </button>
        <span class="wl-drawer__header-sep" id="wishlist-drawer-sep" aria-hidden="true" hidden></span>
        <button class="wl-drawer__close" type="button" aria-label="Close wishlist" id="wishlist-drawer-close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <line x1="17.5" y1="6.5" x2="6.5" y2="17.5"></line>
            <line x1="6.5" y1="6.5" x2="17.5" y2="17.5"></line>
          </svg>
        </button>
      </div>
    </div>

    <div class="wl-drawer__scroll">
      <div class="wl-drawer__empty" id="wishlist-drawer-empty" hidden>
        <span class="wl-drawer__empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-3.8-6.5 3.8v-16a1 1 0 0 1 1-1z"/>
          </svg>
        </span>
        <p class="wl-drawer__empty-title">Your wishlist is empty</p>
        <p class="wl-drawer__empty-sub">Tap the bookmark on any fragrance to save it for later.</p>
        <a href="{{ routes.all_products_collection_url }}" class="wl-drawer__empty-btn">Shop fragrances</a>
      </div>

      <div class="wl-drawer__note" id="wishlist-drawer-note" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3.5h11a1 1 0 0 1 1 1v16l-6.5-3.8-6.5 3.8v-16a1 1 0 0 1 1-1z"/></svg>
        <span>Saved on this device. Add your favourites to the bag anytime.</span>
      </div>

      <ul class="wl-drawer__list" id="wishlist-drawer-grid" role="list"></ul>
    </div>

    <div class="wl-drawer__footer" id="wishlist-drawer-footer" hidden>
      <button type="button" class="wl-drawer__secondary" id="wishlist-continue-shop-btn">Continue shopping</button>
      <button type="button" class="wl-drawer__cta" id="wishlist-add-all-btn">
        <svg class="wl-drawer__cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.75 9.25A2.25 2.25 0 0 1 7 7h10a2.25 2.25 0 0 1 2.25 2.25V17.5A3.5 3.5 0 0 1 15.75 21h-7.5a3.5 3.5 0 0 1-3.5-3.5z"/><path d="M8.75 7V6.25a3.25 3.25 0 0 1 6.5 0V7"/><path d="M12 11.25v5.5M9.25 14h5.5"/></svg>
        <span class="wl-drawer__cta-label">Add all to bag</span>
        <span class="wl-drawer__cta-count" id="wishlist-add-all-count"></span>
      </button>
    </div>

    <div class="wl-drawer__toast" id="wishlist-drawer-toast" role="status" aria-live="polite"></div>
  </div>
</dialog>

{%- comment -%} Drawer styles live in assets/wishlist-drawer.css (cached, loaded without blocking: the drawer is a closed <dialog> until opened) {%- endcomment -%}
<link rel="stylesheet" href="{{ 'wishlist-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'wishlist-drawer.css' | asset_url | stylesheet_tag }}</noscript>

{% javascript %}
(function () {
  const drawer = document.getElementById('wishlist-drawer');
  if (!drawer) return;

  const closeBtn = document.getElementById('wishlist-drawer-close');
  const grid = document.getElementById('wishlist-drawer-grid');
  const empty = document.getElementById('wishlist-drawer-empty');
  const note = document.getElementById('wishlist-drawer-note');
  const footer = document.getElementById('wishlist-drawer-footer');
  const countEl = document.getElementById('wishlist-drawer-count');
  const clearBtn = document.getElementById('wishlist-drawer-clear-btn');
  const sep = document.getElementById('wishlist-drawer-sep');
  const addAllBtn = document.getElementById('wishlist-add-all-btn');
  const addAllCount = document.getElementById('wishlist-add-all-count');
  const toast = document.getElementById('wishlist-drawer-toast');
  const continueBtn = document.getElementById('wishlist-continue-shop-btn');

  const getList = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem('wishlist') || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      return [];
    }
  };

  const escapeHtml = (s) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Prices are stored as plain numbers ("1499.00"); older entries may already be formatted.
  const formatPrice = (value) => {
    const raw = String(value ?? '').trim();
    if (!raw) return '';
    if (/[^\d.,\s]/.test(raw)) return raw;
    const n = Number(raw.replace(/,/g, ''));
    if (!n) return '';
    return '₹' + n.toLocaleString('en-IN', { maximumFractionDigits: 2 });
  };

  let toastTimer = null;
  const showToast = (msg, duration = 2200) => {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('is-visible');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('is-visible'), duration);
  };

  // ---------- Open / close (true modal so it sits above the mobile nav bar) ----------
  let closeTimer = null;
  const openDrawer = () => {
    clearTimeout(closeTimer);
    drawer.classList.remove('is-closing');
    renderGrid();
    if (!drawer.open) {
      if (typeof drawer.showModal === 'function') drawer.showModal();
      else drawer.setAttribute('open', '');
    }
    document.documentElement.style.overflow = 'hidden';
  };

  const closeDrawer = () => {
    if (!drawer.open || drawer.classList.contains('is-closing')) return;
    drawer.classList.add('is-closing');
    closeTimer = setTimeout(() => {
      drawer.classList.remove('is-closing');
      if (typeof drawer.close === 'function') drawer.close();
      else drawer.removeAttribute('open');
      document.documentElement.style.overflow = '';
    }, 260);
  };

  drawer.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeDrawer();
  });
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });
  closeBtn?.addEventListener('click', closeDrawer);
  continueBtn?.addEventListener('click', closeDrawer);

  clearBtn?.addEventListener('click', () => {
    if (!confirm('Remove all items from your wishlist?')) return;
    if (typeof window.clearWishlist === 'function') {
      window.clearWishlist();
    } else {
      localStorage.setItem('wishlist', '[]');
      document.dispatchEvent(new CustomEvent('wishlist:update'));
    }
    showToast('Wishlist cleared');
  });

  // ---------- Cart helpers ----------
  // Saved items have no variant id: match the saved size, else first available variant.
  const resolveVariantId = async (item) => {
    if (item.variantId) return item.variantId;
    const res = await fetch('/products/' + encodeURIComponent(item.handle) + '.js', { headers: { Accept: 'application/json' } });
    if (!res.ok) throw new Error('Product not found');
    const product = await res.json();
    const variants = product.variants || [];
    const size = String(item.size || '').trim().toLowerCase();
    const bySize =
      size && size !== 'default'
        ? variants.find((v) => v.available && (v.options || []).some((o) => String(o).trim().toLowerCase() === size))
        : null;
    const variant = bySize || variants.find((v) => v.available);
    if (!variant) throw new Error('sold-out');
    return variant.id;
  };

  const addToCart = async (items) => {
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items })
    });
    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err.description || 'Could not add item');
    }
  };

  const goToCart = () => {
    closeDrawer();
    setTimeout(() => {
      if (typeof window.pfOpenCart === 'function') window.pfOpenCart('wishlist-drawer');
      else window.location.href = '/cart';
    }, 280);
  };

  addAllBtn?.addEventListener('click', async () => {
    const list = getList();
    if (!list.length) return;
    addAllBtn.classList.add('is-loading');
    const results = await Promise.allSettled(list.map(resolveVariantId));
    const items = results.filter((r) => r.status === 'fulfilled').map((r) => ({ id: Number(r.value), quantity: 1 }));
    try {
      if (!items.length) throw new Error('These items are sold out');
      await addToCart(items);
      const skipped = list.length - items.length;
      showToast(skipped ? `Added ${items.length} · ${skipped} unavailable` : 'All items added to your bag');
      setTimeout(goToCart, 600);
    } catch (error) {
      showToast(error.message || 'Could not add items');
    } finally {
      addAllBtn.classList.remove('is-loading');
    }
  });

  grid.addEventListener('click', async (e) => {
    const removeBtn = e.target.closest('[data-wl-remove]');
    if (removeBtn) {
      e.preventDefault();
      const handle = removeBtn.dataset.wlRemove;
      removeBtn.closest('.wl-item')?.classList.add('is-removing');
      setTimeout(() => {
        if (typeof window.removeFromWishlist === 'function') {
          window.removeFromWishlist(handle);
        } else {
          localStorage.setItem('wishlist', JSON.stringify(getList().filter((i) => i.handle !== handle)));
          document.dispatchEvent(new CustomEvent('wishlist:update'));
        }
      }, 220);
      return;
    }

    const addBtn = e.target.closest('[data-wl-add-cart]');
    if (!addBtn) return;
    e.preventDefault();

    const item = getList().find((i) => i.handle === addBtn.dataset.wlAddCart);
    if (!item) return;

    addBtn.classList.add('is-loading');
    try {
      const variantId = await resolveVariantId(item);
      await addToCart([{ id: Number(variantId), quantity: 1 }]);
      addBtn.classList.remove('is-loading');
      addBtn.classList.add('is-added');
      addBtn.textContent = 'Added';
      showToast('Added to your bag');
      setTimeout(goToCart, 550);
    } catch (error) {
      addBtn.classList.remove('is-loading');
      showToast(error.message === 'sold-out' ? 'This item is sold out' : error.message || 'Could not add item');
    }
  });

  // ---------- Render ----------
  const bagIcon =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.75 9.25A2.25 2.25 0 0 1 7 7h10a2.25 2.25 0 0 1 2.25 2.25V17.5A3.5 3.5 0 0 1 15.75 21h-7.5a3.5 3.5 0 0 1-3.5-3.5z"/><path d="M8.75 7V6.25a3.25 3.25 0 0 1 6.5 0V7"/><path d="M12 11.25v5.5M9.25 14h5.5"/></svg>';
  const trashIcon =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9.5 7V4.8h5V7"/><path d="M6.5 7l.8 12.2a1 1 0 0 0 1 .9h7.4a1 1 0 0 0 1-.9L17.5 7"/></svg>';

  function renderGrid() {
    const list = getList();
    const count = list.length;
    const has = count > 0;

    if (countEl) countEl.textContent = String(count);
    if (addAllCount) addAllCount.textContent = count === 1 ? '1 item' : `${count} items`;
    grid.hidden = !has;
    note.hidden = !has;
    footer.hidden = !has;
    clearBtn.hidden = !has;
    sep.hidden = !has;
    empty.hidden = has;

    if (!has) {
      grid.innerHTML = '';
      return;
    }

    grid.innerHTML = list
      .map((item) => {
        const title = escapeHtml(item.title);
        const handle = escapeHtml(item.handle);
        const hasSize = item.size && item.size !== 'Default';
        const productUrl =
          '/products/' + encodeURIComponent(item.handle || '') + (hasSize ? '?size=' + encodeURIComponent(item.size) : '');
        const price = formatPrice(item.price);
        const img = item.image
          ? `<img class="wl-item__img" src="${escapeHtml(item.image)}" alt="${title}" loading="lazy" width="68" height="84">`
          : '';

        return `
          <li class="wl-item" data-handle="${handle}">
            <a class="wl-item__media" href="${productUrl}" tabindex="-1" aria-hidden="true">${img}</a>
            <div class="wl-item__body">
              <div class="wl-item__head">
                <div class="wl-item__info">
                  <a class="wl-item__title" href="${productUrl}">${title}</a>
                  ${hasSize ? `<p class="wl-item__meta">${escapeHtml(item.size)}</p>` : ''}
                </div>
                ${price ? `<span class="wl-item__price">${price}</span>` : ''}
              </div>
              <div class="wl-item__foot">
                <button type="button" class="wl-item__add-btn" data-wl-add-cart="${handle}">${bagIcon}<span>Add to bag</span></button>
                <button class="wl-item__remove" type="button" aria-label="Remove ${title} from wishlist" data-wl-remove="${handle}">${trashIcon}</button>
              </div>
            </div>
          </li>`;
      })
      .join('');
  }

  document.addEventListener('wishlist:update', renderGrid);
  document.addEventListener('wishlist-drawer:open', openDrawer);
  document.addEventListener('wishlist-drawer:close', closeDrawer);

  window.openWishlistDrawer = openDrawer;
  window.closeWishlistDrawer = closeDrawer;
})();
{% endjavascript %}

{% schema %}
{
  "name": "Wishlist Drawer",
  "settings": []
}
{% endschema %}
