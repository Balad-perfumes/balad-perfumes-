{% liquid
  assign header_logo = settings.logo
  assign logo_height = settings.logo_height | default: 36
  assign logo_height_mobile = settings.logo_height_mobile | default: 28

  if header_logo != blank
    assign logo_width = logo_height | times: header_logo.aspect_ratio | ceil
    assign logo_width_mobile = logo_height_mobile | times: header_logo.aspect_ratio | ceil
  else
    assign logo_width = 'auto'
    assign logo_width_mobile = 'auto'
  endif
  assign selected_menu = section.settings.menu | default: 'main-menu'
  assign main_menu = linklists[selected_menu]
  assign brand_name = section.settings.brand_name | default: settings.brand_name | default: 'stagmenfashion'
  assign logo_alt = brand_name
  assign use_cart_drawer = section.settings.enable_cart_drawer
  assign force_white_header = false
  assign has_about_link = false
  assign is_about_page = false

  if template.name == 'collection' or template.name == 'search' or template.name == 'product'
    assign force_white_header = true
  endif

  if template.name == 'page' and template.suffix == 'about'
    assign is_about_page = true
  elsif request.path contains '/pages/about'
    assign is_about_page = true
  endif

  if header_logo != blank and header_logo.alt != blank
    assign logo_alt = header_logo.alt
  endif

  if main_menu != blank and main_menu.links.size > 0
    for link in main_menu.links
      assign link_url = link.url | downcase
      assign link_title = link.title | downcase
      if link_url contains '/pages/about' or link_title contains 'about'
        assign has_about_link = true
        break
      endif
    endfor
  endif
%}

<header
  class="stagmenfashion-header color-{{ section.settings.color_scheme }}{% if template.name == 'index' or is_about_page %} stagmenfashion-header--hero-overlay{% endif %}{% if is_about_page %} stagmenfashion-header--about-page{% endif %}"
  data-scrolled="false"
  style="--stagmenfashion-header-background: {% if is_about_page %}transparent{% elsif force_white_header %}#ffffff{% else %}{{ section.settings.header_background }}{% endif %};"
>
  <div class="stagmenfashion-header__shell section section--full-width">
    <div class="stagmenfashion-header__left">
      <button
        type="button"
        class="stagmenfashion-header__icon-button stagmenfashion-header__menu-toggle"
        data-open-mobile-menu
        aria-label="Open categories"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M5 7h14M5 12h14M5 17h14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </button>

      {% if section.settings.show_search %}
        <a class="stagmenfashion-header__icon-button stagmenfashion-header__search-button stagmenfashion-header__search-button--mobile" href="{{ routes.search_url }}" aria-label="Search">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </a>
      {% endif %}

      <div class="stagmenfashion-header__mobile-nav">
        {% render 'header-drawer', linklist: main_menu, class: 'stagmenfashion-header__mobile-nav-drawer', data_header_drawer_type: 'mobile-drawer', section: section %}
      </div>

      <a class="stagmenfashion-header__brand" href="{{ routes.root_url }}" aria-label="{{ brand_name | escape }}">
        {% if header_logo != blank %}
          {% capture logo_style %}--logo-height: {{ logo_height }}px; --logo-width: {{ logo_width }}px; --logo-height-mobile: {{ logo_height_mobile }}px; --logo-width-mobile: {{ logo_width_mobile }}px;{% endcapture %}
          {{
            header_logo
            | image_url: width: 640
            | image_tag:
              class: 'stagmenfashion-header__logo-image stagmenfashion-header__logo-image--default',
              widths: '160, 240, 320, 480, 640',
              loading: 'eager',
              alt: logo_alt,
              style: logo_style
          }}
          {% if settings.logo_inverse != blank %}
            {% liquid
              if settings.logo_inverse != blank
                assign inverse_logo_width = logo_height | times: settings.logo_inverse.aspect_ratio | ceil
                assign inverse_logo_width_mobile = logo_height_mobile | times: settings.logo_inverse.aspect_ratio | ceil
              else
                assign inverse_logo_width = 'auto'
                assign inverse_logo_width_mobile = 'auto'
              endif
            %}
            {% capture inverse_logo_style %}--logo-height: {{ logo_height }}px; --logo-width: {{ inverse_logo_width }}px; --logo-height-mobile: {{ logo_height_mobile }}px; --logo-width-mobile: {{ inverse_logo_width_mobile }}px;{% endcapture %}
            {{
              settings.logo_inverse
              | image_url: width: 640
              | image_tag:
                class: 'stagmenfashion-header__logo-image stagmenfashion-header__logo-image--inverse',
                widths: '160, 240, 320, 480, 640',
                loading: 'eager',
                alt: logo_alt,
                style: inverse_logo_style
            }}
          {% endif %}
        {% else %}
          <span class="stagmenfashion-header__logo-text">{{ brand_name }}</span>
        {% endif %}
      </a>
    </div>

    <div class="stagmenfashion-header__center">
      {% if main_menu != blank and main_menu.links.size > 0 %}
        <nav class="stagmenfashion-header__nav" aria-label="Primary navigation">
          <ul class="stagmenfashion-header__nav-list" role="list">
          {% for link in main_menu.links %}
              {% liquid
                assign child_active = false
                for child_link in link.links
                  if child_link.current
                    assign child_active = true
                    break
                  endif
                endfor
                assign link_active = false
                if link.current or child_active
                  assign link_active = true
                endif
              %}
              <li class="stagmenfashion-header__nav-item">
                {% if link.links != blank %}
                  <details class="stagmenfashion-header__dropdown">
                    <summary class="stagmenfashion-header__nav-link{% if link_active %} is-active{% endif %}">
                      <span>{{ link.title | escape }}</span>
                      <span class="stagmenfashion-header__desktop-caret"></span>
                    </summary>
                    <div class="stagmenfashion-header__dropdown-panel">
                      <ul class="stagmenfashion-header__dropdown-list" role="list">
                        {% for child_link in link.links %}
                          <li>
                            <a class="stagmenfashion-header__dropdown-link{% if child_link.current %} is-current{% endif %}" href="{{ child_link.url }}">
                              {{ child_link.title | escape }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  </details>
                {% else %}
                  <a class="stagmenfashion-header__nav-link{% if link.current %} is-active{% endif %}" href="{{ link.url }}">
                    <span>{{ link.title | escape }}</span>
                  </a>
              {% endif %}
            </li>
          {% endfor %}
          {% unless has_about_link %}
            <li class="stagmenfashion-header__nav-item">
              <a class="stagmenfashion-header__nav-link{% if request.path contains '/pages/about' %} is-active{% endif %}" href="/pages/about">
                <span>About</span>
              </a>
            </li>
          {% endunless %}
        </ul>
      </nav>
      {% endif %}
    </div>

    <div class="stagmenfashion-header__right">
      {% if section.settings.show_search %}
        <a class="stagmenfashion-header__icon-button stagmenfashion-header__search-button stagmenfashion-header__search-button--desktop" href="{{ routes.search_url }}" aria-label="Search">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.show_account %}
        <a class="stagmenfashion-header__icon-button" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" aria-label="Account">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}

      {% if use_cart_drawer and template.name != 'cart' %}
        <script
          src="{{ 'cart-drawer.js' | asset_url }}"
          type="module"
          fetchpriority="low"
        ></script>

        {% capture empty_cart_drawer_content %}
          <div class="cart-drawer__header">
            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button close-button cart-drawer__close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div
            class="cart-drawer__content"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <h2
              class="cart-drawer__heading h4 cart-drawer__heading--empty"
              id="cart-drawer-heading-empty"
            >
              {{ 'content.your_cart_is_empty' | t }}
            </h2>

            <div class="cart-drawer__items">
              {% render 'cart-products', force_empty: true %}
            </div>
          </div>
        {% endcapture %}

        {% assign drawer_recommendation_cards = '' %}
        {% assign drawer_recommendation_count = 0 %}

        {% if cart != empty %}
          {% for recommended_product in collections.all.products limit: 12 %}
            {% if drawer_recommendation_count >= 4 %}
              {% break %}
            {% endif %}

            {% assign recommended_in_cart = false %}
            {% for cart_item in cart.items %}
              {% if cart_item.product_id == recommended_product.id %}
                {% assign recommended_in_cart = true %}
                {% break %}
              {% endif %}
            {% endfor %}

            {% unless recommended_in_cart or recommended_product.available == false %}
              {% capture drawer_recommendation_card %}
                <article class="cart-drawer__recommendation-slide" data-cart-drawer-recommendation-slide>
                  <a class="cart-drawer__recommendation-card" href="{{ recommended_product.url }}">
                    <span class="cart-drawer__recommendation-media">
                      {%- if recommended_product.featured_image -%}
                        {{
                          recommended_product.featured_image
                          | image_url: width: 360
                          | image_tag:
                            class: 'cart-drawer__recommendation-image',
                            loading: 'lazy',
                            alt: recommended_product.title
                        }}
                      {%- endif -%}
                    </span>

                    <span class="cart-drawer__recommendation-copy">
                      <span class="cart-drawer__recommendation-title">
                        {{ recommended_product.title | escape }}
                      </span>

                      <span class="cart-drawer__recommendation-price">
                        {% if recommended_product.compare_at_price > recommended_product.price %}
                          <s>{{ recommended_product.compare_at_price | money }}</s>
                        {% endif %}
                        <span>{{ recommended_product.price | money }}</span>
                      </span>
                    </span>

                    <span class="cart-drawer__recommendation-eye" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                        <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"/>
                      </svg>
                    </span>
                  </a>
                </article>
              {% endcapture %}

              {% assign drawer_recommendation_cards = drawer_recommendation_cards | append: drawer_recommendation_card %}
              {% assign drawer_recommendation_count = drawer_recommendation_count | plus: 1 %}
            {% endunless %}
          {% endfor %}
        {% endif %}

        <cart-drawer-component
          class="cart-drawer"
          {% if section.settings.auto_open_cart_drawer %}
            auto-open
          {% endif %}
        >
          <template id="empty-cart-template">
            {{ empty_cart_drawer_content }}
          </template>
          <button
            class="stagmenfashion-header__icon-button stagmenfashion-header__cart-button"
            on:click="/open"
            aria-haspopup="dialog"
            aria-label="Cart"
            aria-describedby="cart-bubble-text"
            data-testid="cart-drawer-trigger"
          >
            <span class="svg-wrapper" aria-hidden="true" style="line-height:0; display:inline-flex;">
              {% if section.settings.custom_cart_icon != blank %}
                {{
                  section.settings.custom_cart_icon
                  | image_url: width: 60
                  | image_tag: class: 'stagmenfashion-header__custom-icon', loading: 'lazy', alt: 'Cart'
                }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:22px; height:22px;">
                  <circle cx="8.5" cy="20.5" r="1.5"></circle>
                  <circle cx="18.5" cy="20.5" r="1.5"></circle>
                  <path d="M2.5 2.5h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6l2.3-8.4H5.8"></path>
                </svg>
              {% endif %}
            </span>
            {% if cart != empty %}
              <span class="stagmenfashion-header__cart-count">{{ cart.item_count }}</span>
            {% endif %}
          </button>

          <dialog
            ref="dialog"
            class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{% endif %}"
            data-testid="cart-drawer-dialog"
            aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
            scroll-lock
            cart-summary-sticky="true"
          >
            <span
              ref="liveRegion"
              class="visually-hidden"
              role="status"
            ></span>
            <div
              class="cart-drawer__inner"
              data-hydration-key="cart-drawer-inner"
            >
              {% capture cart_items_children %}
                {%- if cart.empty? -%}
                  {{ empty_cart_drawer_content }}
                {%- else -%}
                  <div
                    class="cart-drawer__header"
                    id="cart-drawer-header"
                  >
                    <h2
                      class="cart-drawer__heading h4"
                      id="cart-drawer-heading"
                    >
                      Shopping Bag
                      {% render 'cart-bubble' %}
                    </h2>

                    <button
                      ref="closeButton"
                      on:click="cart-drawer-component/close"
                      class="button close-button cart-drawer__close-button button-unstyled"
                      aria-label="{{ 'actions.close_dialog' | t }}"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-close.svg' | inline_asset_content -}}
                      </span>
                    </button>
                  </div>

                  <scroll-hint
                    class="cart-drawer__content"
                    aria-label="{{ 'accessibility.cart' | t }}"
                    style="--header-height: 60px;"
                  >
                    <div class="cart-drawer__scroll-body">
                      <scroll-hint class="cart-drawer__items">
                        {% render 'cart-products' %}
                      </scroll-hint>

                      {% if drawer_recommendation_cards != blank %}
                        <section class="cart-drawer__recommendations" data-cart-drawer-recommendations>
                          <div class="cart-drawer__recommendations-card">
                            <div class="cart-drawer__recommendations-header">
                              <h3 class="cart-drawer__recommendations-title">You may also like</h3>
                            </div>

                            <div class="cart-drawer__recommendations-viewport" data-cart-drawer-recommendations-viewport>
                              <div class="cart-drawer__recommendations-track">
                                {{ drawer_recommendation_cards }}
                              </div>
                            </div>

                            <div class="cart-drawer__recommendations-controls">
                                <button
                                  type="button"
                                  class="cart-drawer__recommendations-arrow"
                                  data-cart-drawer-recommendations-prev
                                  aria-label="Previous recommendation"
                                >
                                  <span aria-hidden="true">‹</span>
                                </button>

                                <div
                                  class="cart-drawer__recommendations-dots"
                                  aria-label="Recommendation slides"
                                >
                                  {% for i in (1..drawer_recommendation_count) %}
                                    <button
                                      type="button"
                                      class="cart-drawer__recommendations-dot{% if forloop.first %} is-active{% endif %}"
                                      data-cart-drawer-recommendation-dot="{{ forloop.index0 }}"
                                      aria-label="Go to recommendation {{ forloop.index }}"
                                      {% if forloop.first %}aria-current="true"{% endif %}
                                    ></button>
                                  {% endfor %}
                                </div>

                                <button
                                  type="button"
                                  class="cart-drawer__recommendations-arrow"
                                  data-cart-drawer-recommendations-next
                                  aria-label="Next recommendation"
                                >
                                  <span aria-hidden="true">›</span>
                                </button>
                              </div>
                            </div>
                          </section>
                        {% endif %}
                    </div>

                    <div class="cart-drawer__summary">
                      {% render 'cart-summary', section_id: section.id, show_view_cart_button: false %}
                    </div>
                  </scroll-hint>
                {%- endif -%}
{% endcapture %}
              {% render 'cart-items-component', children: cart_items_children, is_drawer: true, section_id: section.id %}
            </div>
          </dialog>
        </cart-drawer-component>
      {% else %}
        <a class="stagmenfashion-header__icon-button stagmenfashion-header__cart-button" href="{{ routes.cart_url }}" aria-label="Cart">
          <span class="svg-wrapper" aria-hidden="true" style="line-height:0; display:inline-flex;">
            {% if section.settings.custom_cart_icon != blank %}
              {{
                section.settings.custom_cart_icon
                | image_url: width: 60
                | image_tag: class: 'stagmenfashion-header__custom-icon', loading: 'lazy', alt: 'Cart'
              }}
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:22px; height:22px;">
                <circle cx="8.5" cy="20.5" r="1.5"></circle>
                <circle cx="18.5" cy="20.5" r="1.5"></circle>
                <path d="M2.5 2.5h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6l2.3-8.4H5.8"></path>
              </svg>
            {% endif %}
          </span>
          {% if cart != empty %}
            <span class="stagmenfashion-header__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      {% endif %}

    </div>
  </div>
</header>

<nav class="stagmenfashion-mobile-tabs" aria-label="Mobile quick navigation">
  <a class="stagmenfashion-mobile-tabs__item{% if request.page_type == 'index' %} is-active{% endif %}" href="{{ routes.root_url }}" aria-label="Home">
    <span class="stagmenfashion-mobile-tabs__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M4 11.5 12 5l8 6.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6.5 10.5V20h4.5v-5h2v5h4.5v-9.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="stagmenfashion-mobile-tabs__label">Home</span>
  </a>

  <a class="stagmenfashion-mobile-tabs__item" href="{{ routes.search_url }}" aria-label="Search">
    <span class="stagmenfashion-mobile-tabs__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7"/>
        <path d="M16.2 16.2 20 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="stagmenfashion-mobile-tabs__label">Search</span>
  </a>

  <a class="stagmenfashion-mobile-tabs__item{% if request.page_type == 'collection' or request.page_type == 'search' and request.path contains '/collections' %} is-active{% endif %}" href="{{ routes.all_products_collection_url }}" aria-label="Shop">
    <span class="stagmenfashion-mobile-tabs__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M4.5 8.5h15l-1.2 10h-12.6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        <path d="M8 8.5c0-2.4 1.8-4.3 4-4.3s4 1.9 4 4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="stagmenfashion-mobile-tabs__label">Shop</span>
  </a>

  {% if use_cart_drawer and template.name != 'cart' %}
    <button
      type="button"
      class="stagmenfashion-mobile-tabs__item"
      data-open-cart-drawer
      aria-label="Cart"
    >
      <span class="stagmenfashion-mobile-tabs__icon" aria-hidden="true">
        {% if section.settings.custom_cart_icon != blank %}
          {{
            section.settings.custom_cart_icon
            | image_url: width: 60
            | image_tag: class: 'stagmenfashion-mobile-tabs__custom-icon', loading: 'lazy', alt: 'Cart'
          }}
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8.5" cy="20.5" r="1.5"></circle>
            <circle cx="18.5" cy="20.5" r="1.5"></circle>
            <path d="M2.5 2.5h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6l2.3-8.4H5.8"></path>
          </svg>
        {% endif %}
        {% if cart != empty %}
          <span class="stagmenfashion-mobile-tabs__badge">{{ cart.item_count }}</span>
        {% endif %}
      </span>
      <span class="stagmenfashion-mobile-tabs__label">Cart</span>
    </button>
  {% else %}
    <a class="stagmenfashion-mobile-tabs__item" href="{{ routes.cart_url }}" aria-label="Cart">
      <span class="stagmenfashion-mobile-tabs__icon" aria-hidden="true">
        {% if section.settings.custom_cart_icon != blank %}
          {{
            section.settings.custom_cart_icon
            | image_url: width: 60
            | image_tag: class: 'stagmenfashion-mobile-tabs__custom-icon', loading: 'lazy', alt: 'Cart'
          }}
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8.5" cy="20.5" r="1.5"></circle>
            <circle cx="18.5" cy="20.5" r="1.5"></circle>
            <path d="M2.5 2.5h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6l2.3-8.4H5.8"></path>
          </svg>
        {% endif %}
        {% if cart != empty %}
          <span class="stagmenfashion-mobile-tabs__badge">{{ cart.item_count }}</span>
        {% endif %}
      </span>
      <span class="stagmenfashion-mobile-tabs__label">Cart</span>
    </a>
  {% endif %}
</nav>

{% javascript %}
  (() => {
    const header = document.querySelector('.stagmenfashion-header--hero-overlay');
    let lastScrollY = window.scrollY;

    const applyHeroHeaderState = () => {
      if (!header) return;

      if (header.classList.contains('stagmenfashion-header--about-page')) {
        header.dataset.scrollDirection = 'none';
        header.dataset.scrolled = 'false';
        header.dataset.stickyState = 'inactive';
        return;
      }

      const currentScrollY = window.scrollY;
      const isAtTop = currentScrollY <= 12;
      const isScrollingUp = currentScrollY < lastScrollY;
      const isScrollingDown = currentScrollY > lastScrollY;

      header.dataset.scrollDirection = isAtTop ? 'none' : isScrollingUp ? 'up' : isScrollingDown ? 'down' : header.dataset.scrollDirection || 'none';

      if (isAtTop) {
        header.dataset.scrolled = 'false';
        header.dataset.stickyState = 'inactive';
      } else if (isScrollingUp) {
        header.dataset.scrolled = 'true';
        header.dataset.stickyState = 'active';
      } else if (isScrollingDown) {
        header.dataset.scrolled = 'false';
        header.dataset.stickyState = 'inactive';
      }

      lastScrollY = currentScrollY;
    };

    const updateCartCount = (itemCount) => {
      const cartButtons = document.querySelectorAll('.stagmenfashion-header__cart-button, .stagmenfashion-mobile-tabs__item[href*="/cart"], .stagmenfashion-mobile-tabs__item[aria-label="Cart"]');
      
      cartButtons.forEach((cartBtn) => {
        let countNode = cartBtn.querySelector('.stagmenfashion-header__cart-count, .stagmenfashion-mobile-tabs__badge');
        
        if (!countNode) {
          countNode = document.createElement('span');
          if (cartBtn.classList.contains('stagmenfashion-mobile-tabs__item')) {
            countNode.className = 'stagmenfashion-mobile-tabs__badge';
            const iconWrapper = cartBtn.querySelector('.stagmenfashion-mobile-tabs__icon');
            if (iconWrapper) {
              iconWrapper.appendChild(countNode);
            } else {
              cartBtn.appendChild(countNode);
            }
          } else {
            countNode.className = 'stagmenfashion-header__cart-count';
            cartBtn.appendChild(countNode);
          }
        }

        if (itemCount > 0) {
          countNode.textContent = String(itemCount);
          countNode.style.display = '';
          countNode.hidden = false;
          countNode.removeAttribute('aria-hidden');
        } else {
          countNode.textContent = '0';
          countNode.style.display = 'none';
          countNode.hidden = true;
          countNode.setAttribute('aria-hidden', 'true');
        }
      });
    };

    const readSessionCount = () => {
      try {
        const raw = sessionStorage.getItem('cart-count');
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        const value = Number(parsed?.value);
        return Number.isFinite(value) ? value : null;
      } catch (error) {
        return null;
      }
    };

    const syncFromServer = async () => {
      try {
        const response = await fetch('/cart.js', {
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) return;
        const cart = await response.json();
        updateCartCount(Number(cart?.item_count) || 0);
      } catch (error) {
        // Ignore network failures; the session/event-based sync will still work.
      }
    };

    document.addEventListener('cart:update', (event) => {
      const itemCount = Number(event.detail?.data?.itemCount ?? event.detail?.resource?.item_count ?? 0);
      updateCartCount(itemCount);
    });

    window.addEventListener('cart:update', (event) => {
      const itemCount = Number(event.detail?.data?.itemCount ?? event.detail?.resource?.item_count ?? 0);
      updateCartCount(itemCount);
    });

    const initialCount = readSessionCount();
    if (initialCount !== null) {
      updateCartCount(initialCount);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncFromServer, { once: true });
    } else {
      syncFromServer();
    }

    const openMobileMenu = () => {
      const drawer = document.querySelector('header-drawer.header-drawer');
      const details = drawer?.querySelector('details.menu-drawer-container');

      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
      }

      if (details) {
        details.open = true;
        details.setAttribute('open', '');
        details.classList.add('menu-open');
        details.querySelector('summary')?.setAttribute('aria-expanded', 'true');
      }
    };

    const openCartDrawer = () => {
      const trigger = document.querySelector('[data-testid="cart-drawer-trigger"]');
      if (trigger) {
        trigger.click();
        return;
      }

      window.location.href = document.querySelector('.stagmenfashion-mobile-tabs a[href*="/cart"]')?.href || '/cart';
    };

    document.querySelectorAll('[data-open-mobile-menu]').forEach((button) => {
      button.addEventListener('click', openMobileMenu);
    });

    document.querySelectorAll('[data-open-cart-drawer]').forEach((button) => {
      button.addEventListener('click', openCartDrawer);
    });

    document.querySelectorAll('[data-cart-drawer-recommendations]').forEach((drawer) => {
      const track = drawer.querySelector('.cart-drawer__recommendations-track');
      const prev = drawer.querySelector('[data-cart-drawer-recommendations-prev]');
      const next = drawer.querySelector('[data-cart-drawer-recommendations-next]');
      const slides = Array.from(drawer.querySelectorAll('[data-cart-drawer-recommendation-slide]'));
      const dots = Array.from(drawer.querySelectorAll('[data-cart-drawer-recommendation-dot]'));

      if (!track || slides.length === 0) return;

      const getStep = () => {
        const slide = slides[0];
        const slideWidth = slide.getBoundingClientRect().width;
        const gap = parseFloat(window.getComputedStyle(track).gap || '0') || 0;
        return slideWidth + gap;
      };

      const setActiveDot = (index) => {
        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === index;
          dot.classList.toggle('is-active', isActive);
          if (isActive) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      };

      const setArrowState = () => {
        const atStart = track.scrollLeft <= 2;
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

        if (prev) prev.disabled = atStart;
        if (next) next.disabled = atEnd;
      };

      const getActiveIndex = () => {
        const viewportCenter = track.scrollLeft + track.clientWidth / 2;
        let activeIndex = 0;
        let activeDistance = Number.POSITIVE_INFINITY;

        slides.forEach((slide, index) => {
          const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
          const distance = Math.abs(slideCenter - viewportCenter);
          if (distance < activeDistance) {
            activeDistance = distance;
            activeIndex = index;
          }
        });

        return activeIndex;
      };

      const updateActiveState = () => {
        setActiveDot(getActiveIndex());
        setArrowState();
      };

      prev?.addEventListener('click', () => {
        track.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });

      next?.addEventListener('click', () => {
        track.scrollBy({ left: getStep(), behavior: 'smooth' });
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const index = Number(dot.dataset.cartDrawerRecommendationDot || 0);
          const slide = slides[index];
          if (!slide) return;
          track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
        });
      });

      track.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateActiveState);
      }, { passive: true });

      window.addEventListener('resize', updateActiveState, { passive: true });
      updateActiveState();
    });

    if (header) {
      applyHeroHeaderState();
      window.addEventListener('scroll', applyHeroHeaderState, { passive: true });
      window.addEventListener('resize', applyHeroHeaderState, { passive: true });
    }
  })();
