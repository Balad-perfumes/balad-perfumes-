  {% endstyle %}

  <script>
    (() => {
      const runtimeLocale = document.documentElement.lang || navigator.language || 'en-IN';
      const runtimeCurrency = document.querySelector('meta[property="og:price:currency"]')?.content || 'INR';
      const money = new Intl.NumberFormat(runtimeLocale, {
        style: 'currency',
        currency: runtimeCurrency,
        maximumFractionDigits: 2,
      });

      function formatMoney(cents) {
        return money.format((cents || 0) / 100);
      }

      function initSection(section) {
        if (!section || section.dataset.initialized === 'true') return;
        section.dataset.initialized = 'true';

        const variantsNode = section.querySelector('[data-variants-json]');
        const variants = variantsNode ? JSON.parse(variantsNode.textContent) : [];
        const mainImage = section.querySelector('[data-main-image]');
        const thumbs = Array.from(section.querySelectorAll('[data-thumb]'));
        const optionButtons = Array.from(section.querySelectorAll('[data-option-button]'));
        const variantInput = section.querySelector('[data-variant-id-input]');
        const priceNode = section.querySelector('[data-price]');
        const compareNode = section.querySelector('[data-compare-price]');
        const addToCart = section.querySelector('[data-add-to-cart]');
        const addToCartText = section.querySelector('[data-add-to-cart-text]');
        const stickyPrice = section.querySelector('[data-sticky-price]');
        const stickyButtonText = section.querySelector('[data-sticky-button-text]');
        const stickyButton = section.querySelector('.stagmenfashion-premium-product__sticky-button');
        const qtyInput = section.querySelector('[data-qty-input]');
        const minus = section.querySelector('[data-qty-minus]');
        const plus = section.querySelector('[data-qty-plus]');
        const socialCountNodes = Array.from(section.querySelectorAll('[data-social-count]'));
        const infoTabs = Array.from(section.querySelectorAll('[data-info-tab]'));
        const infoPanels = Array.from(section.querySelectorAll('[data-info-panel]'));
        const tablist = section.querySelector('[data-info-tablist]');
        const tabArrowPrev = section.querySelector('[data-info-tab-arrow="prev"]');
        const tabArrowNext = section.querySelector('[data-info-tab-arrow="next"]');

        function setMainImage(button) {
          if (!button || !mainImage) return;
          const nextSrc = button.dataset.imageSrc;
          const nextAlt = button.dataset.imageAlt || '';
          if (!nextSrc || mainImage.getAttribute('src') === nextSrc) {
            thumbs.forEach((thumb) => thumb.classList.toggle('is-active', thumb === button));
            return;
          }

          const preload = new Image();
          preload.onload = () => {
            mainImage.classList.add('is-switching');
            window.setTimeout(() => {
              mainImage.src = nextSrc;
              mainImage.alt = nextAlt;
              mainImage.classList.remove('is-switching');
            }, 120);
          };
          preload.src = nextSrc;

          thumbs.forEach((thumb) => thumb.classList.toggle('is-active', thumb === button));
        }

        function getSelectedOptions() {
          const selected = [];
          const groups = new Map();

          optionButtons.forEach((button) => {
            const index = Number(button.dataset.optionIndex || 0);
            if (!groups.has(index)) groups.set(index, []);
            groups.get(index).push(button);
          });

          Array.from(groups.keys())
            .sort((a, b) => a - b)
            .forEach((index) => {
              const active = groups.get(index).find((button) => button.classList.contains('is-active'));
              selected.push(active ? active.dataset.optionValue : groups.get(index)[0]?.dataset.optionValue || '');
            });

          return selected;
        }

        function updateVariant() {
          if (!variants.length) return;
          const selectedOptions = getSelectedOptions();
          const matched = variants.find((variant) =>
            Array.isArray(variant.options) &&
            variant.options.every((optionValue, index) => optionValue === selectedOptions[index])
          );

          if (!matched) return;

          if (variantInput) variantInput.value = matched.id;
          if (priceNode) priceNode.textContent = matched.formatted_price || formatMoney(matched.price);
          if (stickyPrice) stickyPrice.textContent = matched.formatted_price || formatMoney(matched.price);

          if (compareNode) {
            const hasCompare = matched.compare_at_price && matched.compare_at_price > matched.price;
            compareNode.textContent = hasCompare
              ? matched.formatted_compare_at_price || formatMoney(matched.compare_at_price)
              : '';
            compareNode.classList.toggle('hidden', !hasCompare);
          }

          const isAvailable = Boolean(matched.available);
          if (addToCart) addToCart.disabled = !isAvailable;
          if (stickyButton) stickyButton.disabled = !isAvailable;
          if (addToCartText) addToCartText.textContent = isAvailable ? 'Add to cart' : 'Sold out';
          if (stickyButtonText) stickyButtonText.textContent = isAvailable ? 'Add to cart' : 'Sold out';

          if (matched.featured_image_id) {
            const thumb = thumbs.find((item) => item.dataset.imageId === String(matched.featured_image_id));
            if (thumb) setMainImage(thumb);
          }
        }

        const updateTabArrowState = () => {
          if (!tablist) return;

          const maxScrollLeft = tablist.scrollWidth - tablist.clientWidth;
          const isScrollable = maxScrollLeft > 4;

          if (tabArrowPrev instanceof HTMLButtonElement) {
            tabArrowPrev.hidden = !isScrollable;
            tabArrowPrev.disabled = tablist.scrollLeft <= 4;
          }

          if (tabArrowNext instanceof HTMLButtonElement) {
            tabArrowNext.hidden = !isScrollable;
            tabArrowNext.disabled = tablist.scrollLeft >= maxScrollLeft - 4;
          }
        };

        const scrollTabList = (direction) => {
          if (!tablist) return;
          const amount = Math.max(220, tablist.clientWidth * 0.8);
          tablist.scrollBy({ left: direction === 'prev' ? -amount : amount, behavior: 'smooth' });
        };

        const setActiveInfoTab = (tabId, shouldScroll = false) => {
          const nextTabId = infoTabs.some((tab) => tab.dataset.infoTab === tabId)
            ? tabId
            : infoTabs[0]?.dataset.infoTab;

          if (!nextTabId) return;

          infoTabs.forEach((tab) => {
            const isActive = tab.dataset.infoTab === nextTabId;
            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
            tab.tabIndex = isActive ? 0 : -1;
            if (isActive && shouldScroll) {
              tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
          });

          infoPanels.forEach((panel) => {
            const isActive = panel.dataset.infoPanel === nextTabId;
            panel.hidden = !isActive;
            panel.classList.toggle('is-active', isActive);
          });

          window.requestAnimationFrame(updateTabArrowState);
        };

        const toggleReadMore = (button) => {
          const group = button.closest('[data-read-more-group]');
          if (!group) return;

          const preview = group.querySelector('.stagmenfashion-premium-product__expand-preview');
          const full = group.querySelector('.stagmenfashion-premium-product__expand-full');
          if (!preview || !full) return;

          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          const nextExpanded = !isExpanded;

          button.setAttribute('aria-expanded', nextExpanded ? 'true' : 'false');
          button.textContent = nextExpanded ? 'Read less' : 'Read more';
          preview.hidden = nextExpanded;
          full.hidden = !nextExpanded;
        };

        infoTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            setActiveInfoTab(tab.dataset.infoTab || 'description', true);
          });
        });

        if (tabArrowPrev instanceof HTMLButtonElement) {
          tabArrowPrev.addEventListener('click', () => scrollTabList('prev'));
        }

        if (tabArrowNext instanceof HTMLButtonElement) {
          tabArrowNext.addEventListener('click', () => scrollTabList('next'));
        }

        tablist?.addEventListener('scroll', () => {
          window.requestAnimationFrame(updateTabArrowState);
        });

        window.addEventListener('resize', updateTabArrowState, { passive: true });

        section.addEventListener('click', (event) => {
          const button = /** @type {HTMLElement | null} */ (event.target instanceof HTMLElement ? event.target.closest('[data-read-more-toggle]') : null);
          if (!button) return;
          toggleReadMore(button);
        });

        const initialTabFromHash = window.location.hash.replace('#product-info-', '');
        setActiveInfoTab(initialTabFromHash || infoTabs[0]?.dataset.infoTab || 'description');
        updateTabArrowState();

        thumbs.forEach((thumb) => {
          thumb.addEventListener('click', () => setMainImage(thumb));
        });

        optionButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const groupIndex = button.dataset.optionIndex;
            optionButtons.forEach((item) => {
              if (item.dataset.optionIndex === groupIndex) item.classList.remove('is-active');
            });
            button.classList.add('is-active');
            updateVariant();
          });
        });

        const form = section.querySelector('.stagmenfashion-premium-product__form');
        
        const handleAddToCart = async (e, btn) => {
          e.preventDefault();
          if (btn) btn.disabled = true;

          try {
            const formData = new FormData(form);
            
            const cartItemsComponents = document.querySelectorAll('cart-items-component');
            let sectionIds = [];
            cartItemsComponents.forEach((item) => {
              if (item.dataset.sectionId && !sectionIds.includes(item.dataset.sectionId)) {
                sectionIds.push(item.dataset.sectionId);
              }
            });
            
            if (sectionIds.length > 0) {
              formData.append('sections', sectionIds.join(','));
              formData.append('sections_url', window.location.pathname);
            }

            const cartAddUrl = window.Shopify?.routes?.root ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js';
            const res = await fetch(cartAddUrl, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/javascript',
                'X-Requested-With': 'XMLHttpRequest'
              }
            });

            const cart = await res.json();
            if (cart.status) throw new Error(cart.description || 'Add to cart failed');

            document.dispatchEvent(
              new CustomEvent('cart:add', {
                bubbles: true,
                detail: { 
                  data: cart,
                  resource: cart 
                }
              })
            );
            document.dispatchEvent(
              new CustomEvent('cart:update', {
                bubbles: true,
                detail: { 
                  data: cart,
                  resource: cart, 
                  metadata: { itemCount: cart.item_count } 
                }
              })
            );
            
          } catch (err) {
            console.error(err);
            form.submit();
          } finally {
            if (btn) btn.disabled = false;
          }
        };

        if (form) {
          form.addEventListener('submit', (e) => {
            handleAddToCart(e, e.submitter || form.querySelector('[type="submit"]'));
          });
        }
        
        if (stickyButton && form) {
          stickyButton.addEventListener('click', (e) => {
            handleAddToCart(e, stickyButton);
          });
        }


        minus?.addEventListener('click', () => {
          if (!qtyInput) return;
          const current = Number(qtyInput.value || 1);
          qtyInput.value = String(Math.max(1, current - 1));
        });

        plus?.addEventListener('click', () => {
          if (!qtyInput) return;
          const current = Number(qtyInput.value || 1);
          qtyInput.value = String(current + 1);
        });

        const pulseCount = (node) => {
          node.classList.add('is-updated');
          window.setTimeout(() => node.classList.remove('is-updated'), 180);
        };

        const setupFloatingCount = (
          node,
          { minDelta, maxDelta, floorOffset, ceilOffset }
        ) => {
          const base = Number(node.dataset.socialBase || node.textContent.trim() || 0);
          const floor = Math.max(1, base - floorOffset);
          const ceil = base + ceilOffset;
          let value = base;
          let timeoutId = null;
          let active = true;

          const render = (animate = true) => {
            node.textContent = String(value);
            if (animate) pulseCount(node);
          };

          const schedule = () => {
            timeoutId = window.setTimeout(() => {
              if (!active) return;

              const delta = Math.floor(Math.random() * (maxDelta - minDelta + 1)) + minDelta;
              let nextValue = value + delta;

              if (nextValue < floor) nextValue = floor + Math.floor(Math.random() * 3);
              if (nextValue > ceil) nextValue = ceil - Math.floor(Math.random() * 3);
              if (nextValue === value) nextValue = Math.min(ceil, value + 1);

              value = nextValue;
              render();
              schedule();
            }, 3000 + Math.floor(Math.random() * 1000));
          };

          render(false);
          schedule();

          return () => {
            active = false;
            if (timeoutId) {
              window.clearTimeout(timeoutId);
            }
          };
        };

        const stopFloatingCounts = socialCountNodes.map((node) => {
          if (node.dataset.socialCount === 'viewing') {
            return setupFloatingCount(node, { minDelta: -2, maxDelta: 3, floorOffset: 7, ceilOffset: 12 });
          }

          return setupFloatingCount(node, { minDelta: -1, maxDelta: 2, floorOffset: 4, ceilOffset: 8 });
        });

        const handleSectionUnload = (event) => {
          if (event.target !== section) return;
          stopFloatingCounts.forEach((stop) => stop());
          document.removeEventListener('shopify:section:unload', handleSectionUnload);
          window.removeEventListener('resize', updateTabArrowState);
        };

        document.addEventListener('shopify:section:unload', handleSectionUnload);
      }

      const initAll = (root = document) => {
        root.querySelectorAll('[data-stagmenfashion-premium-product]').forEach(initSection);
      };

      document.addEventListener('DOMContentLoaded', () => initAll());
      document.addEventListener('shopify:section:load', (event) => initAll(event.target));
    })();
  </script>
{% elsif request.design_mode %}
  <section class="section section--page-width" style="padding: 32px 20px;">
    Select a product in the "stagmenfashion Premium Product" section settings.
  </section>
{% endif %}

