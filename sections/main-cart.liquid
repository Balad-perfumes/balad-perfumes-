<script src="{{ 'component-cart-items.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- comment -%}
  Cart page. Line items reuse snippets/pf-cart-drawer-items.liquid (same refs as the theme cart scripts),
  and the checkout button / trust row reuse the classes styled in sections/cart-drawer.liquid.
{%- endcomment -%}

{%- liquid
  assign cart_savings = 0
  for item in cart.items
    assign line_compare = item.variant.compare_at_price | default: 0 | times: item.quantity
    if line_compare > item.final_line_price
      assign line_saving = line_compare | minus: item.final_line_price
      assign cart_savings = cart_savings | plus: line_saving
    endif
  endfor
  for discount in cart.cart_level_discount_applications
    assign cart_savings = cart_savings | plus: discount.total_allocated_amount
  endfor

  assign ship_ts = 'now' | date: '%s' | plus: 86400
  assign ship_wd = ship_ts | date: '%w'
  if ship_wd == '0'
    assign ship_ts = ship_ts | plus: 86400
  endif
  assign ship_date = ship_ts | date: '%a, %-d %b'

  assign continue_url = section.settings.continue_url | default: routes.all_products_collection_url
-%}

{% capture empty_cart_page %}
  <div class="pf-cart-page__empty">
    <span class="pf-cart-drawer__empty-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5.5 7.5h13l-1 12.2a1.5 1.5 0 0 1-1.5 1.3H8a1.5 1.5 0 0 1-1.5-1.3l-1-12.2z"/>
        <path d="M9 9.5V6a3 3 0 0 1 6 0v3.5"/>
      </svg>
    </span>
    <h1 class="pf-cart-page__empty-title">Your bag is empty</h1>
    <p class="pf-cart-page__empty-sub">Find a fragrance you love and it will show up here.</p>
    <a href="{{ continue_url }}" class="pf-drawer-btn pf-drawer-btn--solid">Shop fragrances</a>
  </div>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="pf-cart-page">{{ empty_cart_page }}</div>
  </template>

  <div class="pf-cart-page color-{{ section.settings.color_scheme }}">
    {%- if cart.empty? -%}
      {{ empty_cart_page }}
    {%- else -%}
      <div class="pf-cart-page__head">
        <div class="pf-cart-page__title-wrap">
          <h1 class="pf-cart-page__title">Shopping Bag</h1>
          <span class="pf-cart-drawer__badge">{{ cart.item_count }}</span>
        </div>
        <a class="pf-cart-page__continue" href="{{ continue_url }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="11 6 5 12 11 18"/></svg>
          Continue shopping
        </a>
      </div>

      <div class="pf-cart-page__grid">
        <div class="pf-cart-page__main">
          {%- if section.settings.show_delivery -%}
            <div class="pf-cart-drawer__info">
              <span class="pf-cart-drawer__info-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5h11v9.5h-11z"/><path d="M13.5 9.5h4l3 3.2V16h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
              </span>
              <div class="pf-cart-drawer__info-text">
                <p class="pf-cart-drawer__info-title">
                  {{ section.settings.delivery_title | default: 'Ships next working day' }}
                  <span aria-hidden="true">·</span>
                  <strong>{{ ship_date }}</strong>
                </p>
                {%- if section.settings.delivery_text != blank -%}
                  <p class="pf-cart-drawer__info-sub">{{ section.settings.delivery_text }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <div class="pf-cart-page__items">
            <div class="pf-cart-page__items-head">
              <span>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} in your bag</span>
              <button type="button" class="pf-cart-drawer__clear" data-pf-clear-cart>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9.5 7V4.8h5V7"/><path d="M6.5 7l.8 12.2a1 1 0 0 0 1 .9h7.4a1 1 0 0 0 1-.9L17.5 7"/></svg>
                <span>Clear all</span>
              </button>
            </div>
            {% render 'pf-cart-drawer-items' %}
          </div>
        </div>

        <aside class="pf-cart-page__aside" aria-label="Order summary">
          <div class="pf-cart-page__summary">
            <h2 class="pf-cart-page__summary-title">Order summary</h2>

            <dl class="pf-cart-page__rows">
              <div class="pf-cart-page__row">
                <dt>Subtotal</dt>
                <dd>{% render 'format-price', price: cart.items_subtotal_price %}</dd>
              </div>
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="pf-cart-page__row pf-cart-page__row--green">
                  <dt>{{ discount.title | escape }}</dt>
                  <dd>−{% render 'format-price', price: discount.total_allocated_amount %}</dd>
                </div>
              {%- endfor -%}
              <div class="pf-cart-page__row">
                <dt>Shipping</dt>
                <dd class="pf-cart-page__muted">Calculated at checkout</dd>
              </div>
              <div class="pf-cart-page__row pf-cart-page__row--total">
                <dt>Total</dt>
                <dd>
                  {%- capture total_price -%}{%- render 'format-price', price: cart.total_price -%}{%- endcapture -%}
                  <text-component ref="cartTotal" value="{{ total_price | strip_html | strip }}" data-cart-subtotal>{{ total_price }}</text-component>
                </dd>
              </div>
            </dl>

            {%- if cart_savings > 0 -%}
              <p class="pf-cart-page__saving">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg>
                You're saving <strong>{% render 'format-price', price: cart_savings %}</strong> on this order
              </p>
            {%- endif -%}

            <form action="{{ routes.cart_url }}" method="post" class="pf-cart-drawer__checkout-form">
              {%- if settings.show_cart_note -%}
                <details class="pf-cart-page__note"{% if cart.note != blank %} open{% endif %}>
                  <summary>
                    Add a gift note or instructions
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </summary>
                  <label class="visually-hidden" for="pf-cart-note">Order note</label>
                  <textarea id="pf-cart-note" name="note" rows="3" placeholder="Write your message…">{{ cart.note }}</textarea>
                </details>
              {%- endif -%}

              <button type="submit" name="checkout" class="pf-cart-drawer__checkout">
                <span class="pf-cart-drawer__checkout-lock" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/></svg>
                </span>
                <span class="pf-cart-drawer__checkout-label">Checkout</span>
                <span class="pf-cart-drawer__checkout-amount">{{ total_price }}</span>
                <span class="pf-cart-drawer__checkout-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
                </span>
              </button>
            </form>

            <div class="pf-cart-drawer__trust">
              <p class="pf-cart-drawer__trust-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/></svg>
                100% secure payments
              </p>
              <div class="pf-cart-drawer__payments">
                {% render 'payment-icons' %}
              </div>
            </div>
          </div>
        </aside>
      </div>
    {%- endif -%}
  </div>
{% endcapture %}

{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

<style>
  /* =============================================================
     BALAD CART PAGE — shares tokens + components with the cart drawer
     ============================================================= */
  .pf-cart-page {
    --d-bg: #ffffff;
    --d-tint: #f7f3ed;
    --d-tint-2: #efe8dd;
    --d-ink: #15130f;
    --d-text: #2c2823;
    --d-muted: #8a8279;
    --d-line: #efeae2;
    --d-gold: #a8844a;
    --d-success: #2f7a4b;
    --d-danger: #b3261e;
    --d-head: var(--font-heading--family, 'Manrope'), var(--font-body--family, sans-serif);
    --d-ease: cubic-bezier(0.22, 1, 0.36, 1);

    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ section.settings.padding-block-start | default: 32 }}px 20px {{ section.settings.padding-block-end | default: 64 }}px;
    color: var(--d-text);
    background: transparent;
  }
  .pf-cart-page *, .pf-cart-page *::before, .pf-cart-page *::after { box-sizing: border-box; }
  .pf-cart-page p { margin: 0; }

  /* Head */
  .pf-cart-page__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--d-line);
  }
  .pf-cart-page__title-wrap { display: flex; align-items: center; gap: 10px; }
  .pf-cart-page__title {
    margin: 0;
    font-family: var(--d-head);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--d-ink);
  }
  .pf-cart-page .pf-cart-drawer__badge { min-width: 24px; height: 24px; font-size: 12px; }
  .pf-cart-page__continue {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--d-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .pf-cart-page__continue svg { width: 15px; height: 15px; transition: transform 0.3s var(--d-ease); }
  .pf-cart-page__continue:hover { color: var(--d-ink); }
  .pf-cart-page__continue:hover svg { transform: translateX(-3px); }

  /* Layout */
  .pf-cart-page__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; align-items: start; }
  @media screen and (min-width: 990px) {
    .pf-cart-page__grid { grid-template-columns: minmax(0, 1fr) 380px; gap: 48px; }
    .pf-cart-page__aside { position: sticky; top: calc(var(--header-height, 76px) + 24px); }
  }

  .pf-cart-page__main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

  /* White cards so the page reads clearly on the cream site background */
  .pf-cart-page__card,
  .pf-cart-page .pf-cart-drawer__info,
  .pf-cart-page__items,
  .pf-cart-page__summary {
    background: var(--d-bg);
    border: 1px solid var(--d-line);
    box-shadow: 0 1px 2px rgba(21, 19, 15, 0.03), 0 12px 32px -20px rgba(21, 19, 15, 0.18);
  }
  .pf-cart-page .pf-cart-drawer__info { padding: 14px 18px; border-radius: 16px; }
  .pf-cart-page .pf-cart-drawer__info-icon { background: var(--d-tint); }
  .pf-cart-page__items { padding: 6px 24px 4px; border-radius: 20px; }

  /* Items */
  .pf-cart-page__items-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0 12px;
    border-bottom: 1px solid var(--d-line);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--d-muted);
  }
  .pf-cart-page__items-head .pf-cart-drawer__clear { margin-right: -10px; text-transform: none; letter-spacing: 0; }

  .pf-cart-page .pf-ci-list { margin: 0; }
  .pf-cart-page .pf-ci { grid-template-columns: 96px minmax(0, 1fr); gap: 18px; padding: 20px 0; }
  .pf-cart-page .pf-ci__media { width: 96px; height: 120px; border-radius: 14px; }
  .pf-cart-page .pf-ci__title { font-size: 15px; }
  .pf-cart-page .pf-ci__variant { font-size: 11.5px; }
  .pf-cart-page .pf-ci__price { font-size: 16px; }
  .pf-cart-page .pf-ci__compare { font-size: 12px; }
  .pf-cart-page .pf-ci__qty .quantity-selector { width: 104px; height: 36px; }
  .pf-cart-page .pf-ci__qty .quantity-selector :is(.quantity-minus, .quantity-plus) { width: 30px; height: 30px; min-width: 30px; max-height: 30px; }
  .pf-cart-page .pf-ci__remove { width: 34px; height: 34px; }

  /* Summary */
  .pf-cart-page__summary {
    padding: 24px;
    border-radius: 20px;
  }
  .pf-cart-page__summary-title {
    margin: 0 0 16px;
    font-family: var(--d-head);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--d-ink);
  }
  .pf-cart-page__rows { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .pf-cart-page__row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: 13.5px; color: var(--d-text); }
  .pf-cart-page__row dt, .pf-cart-page__row dd { margin: 0; }
  .pf-cart-page__row dd { font-weight: 600; color: var(--d-ink); }
  .pf-cart-page__row--green, .pf-cart-page__row--green dd { color: var(--d-success); }
  .pf-cart-page__muted { font-weight: 500 !important; color: var(--d-muted) !important; font-size: 12.5px; }
  .pf-cart-page__row--total {
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1px solid rgba(21, 19, 15, 0.1);
    font-family: var(--d-head);
    font-size: 15px;
    font-weight: 700;
    color: var(--d-ink);
  }
  .pf-cart-page__row--total dd { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }

  .pf-cart-page__saving {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 14px !important;
    padding: 8px 12px;
    border-radius: 10px;
    background: rgba(47, 122, 75, 0.09);
    color: var(--d-success);
    font-size: 12.5px;
    font-weight: 500;
  }
  .pf-cart-page__saving svg { width: 14px; height: 14px; flex-shrink: 0; }

  .pf-cart-page .pf-cart-drawer__checkout-form { margin-top: 18px; }
  .pf-cart-page .pf-cart-drawer__checkout { height: 54px; }

  .pf-cart-page__note { margin-bottom: 14px; border-radius: 12px; background: var(--d-tint); }
  .pf-cart-page__note summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--d-text);
    cursor: pointer;
    list-style: none;
  }
  .pf-cart-page__note summary::-webkit-details-marker { display: none; }
  .pf-cart-page__note summary svg { width: 15px; height: 15px; transition: transform 0.3s var(--d-ease); }
  .pf-cart-page__note[open] summary svg { transform: rotate(180deg); }
  .pf-cart-page__note textarea {
    display: block;
    width: calc(100% - 28px);
    margin: 0 14px 14px;
    padding: 10px 12px;
    border: 1px solid var(--d-line);
    border-radius: 10px;
    background: var(--d-bg);
    font: inherit;
    font-size: 13px;
    resize: vertical;
  }

  .pf-cart-page .pf-cart-drawer__trust { margin-top: 14px; flex-wrap: wrap; justify-content: center; row-gap: 8px; }
  .pf-cart-page .pf-cart-drawer__payments .balad-payment-badge { background: #ffffff; }

  /* Empty */
  .pf-cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 72px 20px 88px;
  }
  .pf-cart-page__empty .pf-cart-drawer__empty-icon { width: 76px; height: 76px; }
  .pf-cart-page__empty-title {
    margin: 0 0 8px;
    font-family: var(--d-head);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--d-ink);
  }
  .pf-cart-page__empty-sub { margin: 0 0 24px !important; max-width: 320px; font-size: 14px; line-height: 1.55; color: var(--d-muted); }

  @media screen and (max-width: 749px) {
    .pf-cart-page { padding: 20px 16px 48px; }
    .pf-cart-page__head { padding-bottom: 14px; margin-bottom: 16px; align-items: center; }
    .pf-cart-page__continue { font-size: 12px; }
    .pf-cart-page .pf-ci { grid-template-columns: 76px minmax(0, 1fr); gap: 14px; padding: 16px 0; }
    .pf-cart-page .pf-ci__media { width: 76px; height: 96px; }
    .pf-cart-page .pf-ci__title { font-size: 14px; }
    .pf-cart-page .pf-ci__price { font-size: 14.5px; }
    .pf-cart-page__summary { padding: 18px; border-radius: 16px; }
    .pf-cart-page__items { padding: 4px 16px 2px; border-radius: 16px; }
    .pf-cart-page .pf-cart-drawer__info { padding: 12px 14px; }
  }
</style>

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "url",
      "id": "continue_url",
      "label": "Continue shopping link"
    },
    {
      "type": "header",
      "content": "Delivery info"
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show delivery estimate",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_title",
      "label": "Heading",
      "default": "Ships next working day",
      "info": "The next working date (skipping Sunday) is added automatically."
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery times",
      "default": "Delivered across India in 3–7 business days"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
