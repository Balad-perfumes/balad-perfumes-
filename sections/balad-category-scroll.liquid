{%- liquid
  assign hide_empty = section.settings.hide_empty_collections
  assign discover_url = section.settings.discover_more_link | default: routes.collections_url
  assign bg_image = section.settings.background_image
  assign use_parallax = false
  if section.settings.enable_parallax and bg_image != blank
    assign use_parallax = true
  endif
  assign slack = section.settings.parallax_strength | default: 15
  assign bg_height = slack | times: 2 | plus: 100

  # Use the picked collections; if none are picked, fall back to the store's collections
  assign use_picked = false
  if section.settings.collection_list != blank
    assign use_picked = true
  endif
  assign cols_desktop = section.settings.columns_desktop | default: 4
-%}

<section
  class="balad-cats{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}{% if use_parallax %} balad-cats--parallax{% endif %}"
  data-cats-section="{{ section.id }}"
  {% if use_parallax %}data-cats-parallax="{{ slack }}"{% endif %}
  style="
    --cats-bg: {{ section.settings.background | default: '#ffffff' }};
    --cats-text: {{ section.settings.text_color | default: '#111111' }};
    --cats-muted: {{ section.settings.muted_text_color | default: '#6b7280' }};
    --cats-radius: {{ section.settings.image_radius | default: 20 }}px;
    --cats-cols: {{ cols_desktop }};
    {% case section.settings.card_size %}
      {% when 'medium' %}
        --cats-aspect: 1 / 1.22;
        --cats-aspect-mobile: 1 / 1.22;
      {% when 'tall' %}
        --cats-aspect: 3 / 4;
        --cats-aspect-mobile: 3 / 4;
      {% else %}
        --cats-aspect: 1 / 1.12;
        --cats-aspect-mobile: 1 / 1.15;
    {% endcase %}
    {% if use_parallax %}
    --cats-overlay: {{ section.settings.overlay_opacity | default: 45 | divided_by: 100.0 }};
    --cats-slack: {{ slack }}%;
    --cats-bg-height: {{ bg_height }}%;
    {% endif %}
  "
>
  {%- if use_parallax -%}
    <div class="balad-cats__bg" aria-hidden="true">
      {{ bg_image | image_url: width: 2400 | image_tag: class: 'balad-cats__bg-img', loading: 'lazy', alt: '', widths: '800, 1200, 1600, 2400', sizes: '100vw' }}
    </div>
  {%- endif -%}

  <div class="balad-cats__shell">
    <div class="balad-cats__head">
      <div class="balad-cats__heading-wrap">
        {% if section.settings.heading != blank %}
          <h2 class="balad-cats__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="balad-cats__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      <div class="balad-cats__head-actions">
        {% if section.settings.discover_more_label != blank and discover_url != blank %}
          <a href="{{ discover_url }}" class="balad-cats__discover">{{ section.settings.discover_more_label }}</a>
        {% endif %}
      </div>
    </div>

    <div class="balad-cats__grid" data-cats-track>
      {%- if use_picked -%}
        {%- assign coll_source = section.settings.collection_list -%}
      {%- else -%}
        {%- assign coll_source = collections -%}
      {%- endif -%}

      {%- for coll in coll_source limit: 12 -%}
        {%- liquid
          unless use_picked
            if coll.handle == 'all' or coll.handle == 'frontpage'
              continue
            endif
          endunless
          if hide_empty and coll.products_count == 0
            continue
          endif
          assign img = coll.image
          if img == blank
            assign img = coll.products.first.featured_image
          endif
        -%}
        <a href="{{ coll.url }}" class="balad-cc" draggable="false">
          <span class="balad-cc__media">
            {%- if img != blank -%}
              {%- capture cc_img -%}
                {{
                  img
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    fetchpriority: 'low',
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 46vw',
                    alt: coll.title,
                    class: 'balad-cc__image',
                    draggable: 'false'
                }}
              {%- endcapture -%}
              {%- comment -%}
                Below the hero, hold the photos until the hero has painted (assets/balad-product-card.js).
                On mobile these ~75 KB downloaded alongside the hero and pushed PageSpeed's simulated LCP back.
              {%- endcomment -%}
              {%- if section.index > 1 -%}
                {{ cc_img | replace: ' srcset=', ' data-defer-srcset=' | replace: ' src=', ' data-defer-src=' }}
              {%- else -%}
                {{ cc_img }}
              {%- endif -%}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'balad-cc__image balad-cc__placeholder' }}
            {%- endif -%}
            <span class="balad-cc__overlay" aria-hidden="true"></span>
          </span>

          <span class="balad-cc__info">
            <span class="balad-cc__text">
              <span class="balad-cc__title">{{ coll.title }}</span>
              <span class="balad-cc__count">{{ coll.products_count }} {{ coll.products_count | pluralize: 'product', 'products' }}</span>
            </span>
            <span class="balad-cc__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>

    <div class="balad-cats__dots" data-cats-dots role="tablist" aria-label="Category pages" hidden></div>
  </div>
</section>

<style>
  .balad-cats {
    background: var(--cats-bg, #ffffff) !important;
    padding-top: clamp(10px, 1.2vw, 16px);
    padding-bottom: clamp(10px, 1.2vw, 16px);
    width: 100%;
    box-sizing: border-box;
  }

  .balad-cats__shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
    box-sizing: border-box;
  }

  .balad-cats__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgb(17 17 17 / 0.08);
  }

  .balad-cats__heading-wrap { flex: 1; min-width: 0; }

  .balad-cats__heading {
    margin: 0;
    color: var(--cats-text, #111111);
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .balad-cats__subheading {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--cats-muted, #6b7280);
    line-height: 1.4;
    font-weight: 400;
  }

  .balad-cats__discover {
    flex-shrink: 0;
    color: var(--cats-text, #111111);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }
  .balad-cats__discover:hover { opacity: 0.7; }

  /* ── Single scrolling row: 4 visible on desktop, 3 on tablet, 2 on mobile ── */
  .balad-cats__grid {
    --cats-visible: var(--cats-cols, 4);
    --cats-gap: 16px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--cats-visible) - 1) * var(--cats-gap)) / var(--cats-visible));
    grid-template-columns: none;
    gap: var(--cats-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 0 10px;
    margin: -4px 0 -10px;
  }
  .balad-cats__grid::-webkit-scrollbar { display: none; }
  .balad-cats__grid > .balad-cc { scroll-snap-align: start; }

  .balad-cats__head-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .balad-cats__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }
  .balad-cats__dots[hidden] { display: none; }
  .balad-cats__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(17 17 17 / 0.18);
    cursor: pointer;
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.25s ease;
  }
  .balad-cats__dot:hover { background: rgb(17 17 17 / 0.35); }
  .balad-cats__dot.is-active { width: 22px; background: #111111; }
  .balad-cats__dot:focus-visible { outline: 2px solid #111111; outline-offset: 3px; }
  .balad-cats--parallax .balad-cats__dot { background: rgb(255 255 255 / 0.4); }
  .balad-cats--parallax .balad-cats__dot.is-active { background: #ffffff; }

  /* Tap targets: 24x24 button (WCAG minimum), the visible pill is drawn with ::before */
  .balad-cats .balad-cats__dots { gap: 0; }
  .balad-cats .balad-cats__dot,
  .balad-cats .balad-cats__dot:hover,
  .balad-cats .balad-cats__dot.is-active {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 24px;
    height: 24px;
    background: transparent;
  }
  .balad-cats .balad-cats__dot.is-active { min-width: 30px; }
  .balad-cats .balad-cats__dot::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: rgb(17 17 17 / 0.18);
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.25s ease;
  }
  .balad-cats .balad-cats__dot:hover::before { background: rgb(17 17 17 / 0.35); }
  .balad-cats .balad-cats__dot.is-active::before { width: 22px; background: #111111; }
  .balad-cats--parallax .balad-cats__dot::before { background: rgb(255 255 255 / 0.4); }
  .balad-cats--parallax .balad-cats__dot.is-active::before { background: #ffffff; }

  /* ── Collection item: image card with content and gradient overlay inside ── */
  .balad-cc {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: var(--cats-aspect, 1 / 1.12);
    border-radius: var(--cats-radius, 20px);
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    background: #1c1a17;
    box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.16);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s ease;
    -webkit-user-drag: none;
  }

  .balad-cc:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px -8px rgba(0, 0, 0, 0.26);
  }

  .balad-cc__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .balad-cc .balad-cc__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transform-origin: center center;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
    -webkit-user-drag: none;
  }

  .balad-cc:hover .balad-cc__image,
  .balad-cc:focus-visible .balad-cc__image {
    transform: scale(1.06);
  }

  /* Gradient overlay: smooth bottom-to-top dark fade for optimal text legibility */
  .balad-cc__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.82) 0%,
      rgba(0, 0, 0, 0.52) 28%,
      rgba(0, 0, 0, 0.16) 55%,
      rgba(0, 0, 0, 0) 80%
    );
    transition: background 0.3s ease;
  }

  .balad-cc:hover .balad-cc__overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.6) 32%,
      rgba(0, 0, 0, 0.22) 60%,
      rgba(0, 0, 0, 0) 85%
    );
  }

  /* Content inside the image at the bottom */
  .balad-cc__info {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    min-width: 0;
    padding: clamp(12px, 1.4vw, 16px);
    width: 100%;
    box-sizing: border-box;
  }

  .balad-cc__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }

  .balad-cc__title {
    color: #ffffff !important;
    font-family: var(--font-heading--family, -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: clamp(14px, 1.1vw, 17px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .balad-cc__count {
    color: rgba(255, 255, 255, 0.82) !important;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  /* Circular frosted arrow badge */
  .balad-cc__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #ffffff !important;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .balad-cc__arrow svg { width: 13px; height: 13px; }

  .balad-cc:hover .balad-cc__arrow,
  .balad-cc:focus-visible .balad-cc__arrow {
    background: #ffffff;
    border-color: #ffffff;
    color: #111111 !important;
    transform: translateX(3px);
  }

  .balad-cc:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .balad-cats {
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .balad-cats__shell { padding: 0 20px; }
    .balad-cats__grid {
      --cats-visible: 3;
      --cats-gap: 14px;
    }
    .balad-cc {
      aspect-ratio: var(--cats-aspect, 1 / 1.12);
    }
    .balad-cc__title { font-size: 15px; }
    .balad-cc__arrow { width: 30px; height: 30px; }
    .balad-cc__arrow svg { width: 12px; height: 12px; }
  }

  @media screen and (max-width: 749px) {
    .balad-cats { padding-top: 8px; padding-bottom: 8px; }
    .balad-cats__shell { padding: 0 12px; }
    .balad-cats__head { margin-bottom: 12px; padding-bottom: 6px; }
    .balad-cats__heading { font-size: 18px; }
    .balad-cats__subheading { font-size: 13px; margin-top: 4px; }
    .balad-cats__discover { font-size: 12.5px; }

    .balad-cats__grid {
      --cats-visible: 2;
      --cats-gap: 10px;
    }

    .balad-cc {
      aspect-ratio: var(--cats-aspect-mobile, 1 / 1.15);
      border-radius: clamp(12px, var(--cats-radius, 20px), 16px);
    }

    .balad-cc__info {
      padding: 10px 9px;
      gap: 6px;
    }

    .balad-cc__title { font-size: 13.5px; }
    .balad-cc__count { font-size: 11px; }
    .balad-cc__arrow { width: 26px; height: 26px; }
    .balad-cc__arrow svg { width: 11px; height: 11px; }
  }

  /* ── Parallax background (optional) ── */
  .balad-cats--parallax {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-top: clamp(14px, 1.6vw, 20px);
    padding-bottom: clamp(14px, 1.6vw, 20px);
  }

  .balad-cats__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .balad-cats__bg-img {
    position: absolute;
    left: 0;
    top: calc(var(--cats-slack, 15%) * -1);
    width: 100%;
    height: var(--cats-bg-height, 130%);
    object-fit: cover;
    will-change: transform;
    transform: translate3d(0, var(--cats-shift, 0px), 0);
  }

  .balad-cats--parallax::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / calc(var(--cats-overlay, 0.45) + 0.12)) 0%,
      rgb(0 0 0 / var(--cats-overlay, 0.45)) 55%,
      rgb(0 0 0 / calc(var(--cats-overlay, 0.45) + 0.18)) 100%
    );
  }

  .balad-cats--parallax .balad-cats__head { border-bottom-color: rgb(255 255 255 / 0.22); }
  .balad-cats--parallax .balad-cats__heading,
  .balad-cats--parallax .balad-cats__discover,
  .balad-cats--parallax .balad-cc,
  .balad-cats--parallax .balad-cc__title,
  .balad-cats--parallax .balad-cc__arrow { color: #ffffff; }
  .balad-cats--parallax .balad-cats__subheading,
  .balad-cats--parallax .balad-cc__count { color: rgb(255 255 255 / 0.82); }
  .balad-cats--parallax .balad-cc:hover .balad-cc__arrow,
  .balad-cats--parallax .balad-cc:focus-visible .balad-cc__arrow { background: #ffffff; color: #111111; }

  @media (prefers-reduced-motion: reduce) {
    .balad-cats__bg-img { transform: none; }
    .balad-cc .balad-cc__image { transition: none; }
  }
</style>

<script>
  (function () {
    const section = document.querySelector('[data-cats-section="{{ section.id }}"]');
    if (!section) return;
    const track = section.querySelector('[data-cats-track]');
    const dotsWrap = section.querySelector('[data-cats-dots]');
    if (!track || !dotsWrap) return;
    let dots = [];
    let positions = [];

    const metrics = () => {
      const card = track.querySelector('.balad-cc');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const step = card ? card.getBoundingClientRect().width + gap : track.clientWidth;
      return { step };
    };

    // One dot per snap position: (cards - visible + 1)
    const build = () => {
      const max = track.scrollWidth - track.clientWidth;
      if (max <= 2) {
        dotsWrap.hidden = true;
        dotsWrap.innerHTML = '';
        dots = [];
        return;
      }
      const { step } = metrics();
      const count = Math.round(max / step) + 1;
      positions = Array.from({ length: count }, (_, i) => Math.min(i * step, max));
      dotsWrap.innerHTML = positions
        .map((_, i) => `<button type="button" class="balad-cats__dot" role="tab" aria-label="Go to slide ${i + 1}"></button>`)
        .join('');
      dots = Array.from(dotsWrap.children);
      dots.forEach((dot, i) => dot.addEventListener('click', () => track.scrollTo({ left: positions[i], behavior: 'smooth' })));
      dotsWrap.hidden = false;
      update();
    };

    const update = () => {
      if (!dots.length) return;
      const x = track.scrollLeft;
      let active = 0;
      positions.forEach((pos, i) => { if (Math.abs(pos - x) < Math.abs(positions[active] - x)) active = i; });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
        dot.setAttribute('aria-selected', i === active ? 'true' : 'false');
      });
    };

    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => { update(); ticking = false; });
    }, { passive: true });
    // build() reads scrollWidth/getBoundingClientRect. A ResizeObserver callback runs after the browser has already
    // laid the page out, so those reads are free; calling build() from rAF/load forced an extra full layout.
    if ('ResizeObserver' in window) {
      let lastW = -1;
      new ResizeObserver((entries) => {
        const w = Math.round(entries[0].contentRect.width);
        if (w === lastW) return;
        lastW = w;
        build();
      }).observe(track);
    } else {
      window.addEventListener('resize', build);
      requestAnimationFrame(build);
    }
  })();
</script>

<script>
  (() => {
    const root = document.querySelector('[data-cats-section="{{ section.id }}"][data-cats-parallax]');
    if (!root) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const img = root.querySelector('.balad-cats__bg-img');
    if (!img) return;
    let ticking = false;

    const apply = () => {
      ticking = false;
      const vh = window.innerHeight || 800;
      const rect = root.getBoundingClientRect();
      if (rect.bottom < -200 || rect.top > vh + 200) return;
      const slack = parseFloat(root.dataset.catsParallax || '15') / 100;
      const max = rect.height * slack * 0.95;
      let progress = ((rect.top + rect.height / 2) - vh / 2) / (vh / 2 + rect.height / 2);
      progress = Math.max(-1, Math.min(1, progress));
      img.style.setProperty('--cats-shift', (-progress * max).toFixed(1) + 'px');
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(apply); } };

    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    // First run on window load, not in the next frame: during parsing, innerHeight/getBoundingClientRect
    // force a full-page layout before the first paint. Editor re-renders happen after load, so run then.
    if (document.readyState === 'complete') request();
    else window.addEventListener('load', request);
  })();
</script>

{% schema %}
{
  "name": "Category Scroll",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Browse our curated collections" },
    { "type": "text", "id": "discover_more_label", "label": "Discover More Label", "default": "Discover More" },
    { "type": "url", "id": "discover_more_link", "label": "Discover More Link" },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "info": "Pick the categories to display. If empty, store collections are shown automatically.",
      "limit": 20
    },
    { "type": "checkbox", "id": "hide_empty_collections", "label": "Hide empty collections", "default": false },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Cards per row on desktop",
      "default": 4
    },
    {
