{% if template.name == 'index' %}
<section class="pf-footer-cta color-{{ section.settings.color_scheme }}">
  <div class="pf-footer-cta__shell">
    {% if section.settings.heading != blank %}
      <h2 class="pf-footer-cta__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="pf-footer-cta__card">
      <div class="pf-footer-cta__media">
        {% if section.settings.image != blank %}
          {% assign footer_cta_image_alt = section.settings.image.alt | default: section.settings.card_title %}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              class: 'pf-footer-cta__image',
              widths: '480, 720, 960, 1200, 1600, 1800',
              loading: 'lazy',
              alt: footer_cta_image_alt
          }}
        {% else %}
          <div class="pf-footer-cta__placeholder" aria-hidden="true">
            <span>build room</span>
          </div>
        {% endif %}
      </div>

      <div class="pf-footer-cta__content">
        {% if section.settings.card_title != blank %}
          <h3 class="pf-footer-cta__title">{{ section.settings.card_title | escape }}</h3>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="pf-footer-cta__text rte">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          {% assign is_whatsapp = false %}
          {% if section.settings.button_link contains 'wa.me' or section.settings.button_link contains 'whatsapp.com' %}
            {% assign is_whatsapp = true %}
          {% endif %}
          <a
            class="pf-footer-cta__button"
            href="{{ section.settings.button_link | default: routes.contact_url }}"
            {% if is_whatsapp %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<style>
  .pf-footer-cta {
    background: #ffffff;
    color: #111111;
    max-width: 1440px;
    margin: 0 auto;
  }

  .pf-footer-cta__shell {
    margin: 0 auto;
    padding: 20px clamp(20px, 4vw, 42px) 10px;
  }

  .pf-footer-cta__heading {
    margin-bottom: 15px;
    color: #000000;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 32px;
    line-height: 0.94;
    letter-spacing: 0;
    font-weight: 500;
  }

  .pf-footer-cta__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    max-width: 720px;
  }

  .pf-footer-cta__media {
    position: relative;
    overflow: hidden;
    background: #f4f4f4;
    border: 1px solid rgb(17 17 17 / 0.08);
    box-shadow: 0 10px 24px rgb(17 17 17 / 0.05);
    aspect-ratio: 1.42 / 0.85;
  }

  .pf-footer-cta__image,
  .pf-footer-cta__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .pf-footer-cta__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #d0d0d0, #ececec);
    color: #111111;
    font-size: clamp(1.4rem, 2vw, 2.3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.06em;
  }

  .pf-footer-cta__content {
    display: grid;
    gap: 14px;
  }

  .pf-footer-cta__title {
    margin: 0;
    color: #111111;
    font-size: 18px;
    line-height: 1;
    letter-spacing: 0;
    font-weight: 500;
  }

  .pf-footer-cta__text {
    color: rgb(17 17 17 / 0.72);
    font-size: 16px;
    line-height: 1.65;
  }

  .pf-footer-cta__text :is(p, ul, ol) {
    margin-block: 0;
  }

  .pf-footer-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    width: fit-content;
    padding: 0px 22px;
    border-radius: 14px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .pf-footer-cta__button:hover {
    background: #000000;
    transform: translateY(-1px);
    box-shadow: 0 10px 20px rgba(8, 0, 207, 0.25);
  }

  @media screen and (min-width: 750px) {
    .pf-footer-cta__shell {
      padding-inline: 32px;
    }

    .pf-footer-cta__card {
      max-width: 780px;
      gap: 22px;
    }
  }

  @media screen and (max-width: 749px) {
    .pf-footer-cta__shell {
      padding: 20px 20px 10px;
    }

    .pf-footer-cta__heading {
      margin-bottom: 18px;
      font-size: 24px;
      line-height: 0.94;
      letter-spacing: 0;
      max-width: 10ch;
    }
    .pf-footer-cta__title{
        font-size: 18px;
    }

    .pf-footer-cta__card {
      gap: 14px;
    }

    .pf-footer-cta__media {
      aspect-ratio: 1.3 / 0.86;
    }

    .pf-footer-cta__content {
      gap: 12px;
    }

    .pf-footer-cta__button {
      min-height: 48px;
      width: 100%;
      border-radius: 12px;
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Footer CTA Card",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Top heading",
      "default": "Join the Club."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "The Fitting Room"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Most brands just sell clothes. We craft confidence. Get exclusive early access to upcoming drops, limited edition capsules, and behind-the-scenes fittings.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the Drops"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Footer CTA Card"
    }
  ]
}
{% endschema %}
