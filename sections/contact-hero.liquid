<section
  class="pf-contact-hero color-{{ section.settings.color_scheme }}"
  style="--hero-pt: {{ section.settings.padding_top | default: 24 }}px; --hero-pb: {{ section.settings.padding_bottom | default: 24 }}px;"
>
  {% liquid
    assign hero_image_alt = page.title | default: 'Contact Stag Men Fashion'
    if section.settings.image != blank and section.settings.image.alt != blank
      assign hero_image_alt = section.settings.image.alt
    endif
  %}
  <div class="pf-contact-shell">
    <div class="pf-contact-hero__container pf-contact-hero__container--{{ section.settings.align | default: 'center' }}">
      {% if section.settings.eyebrow != blank %}
        <p class="pf-contact-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="pf-contact-hero__heading">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% else %}
          {{ page.title | default: 'Contact Us' }}
        {% endif %}
      </h1>

      {% if section.settings.subheading != blank %}
        <p class="pf-contact-hero__text">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.image != blank %}
        <div class="pf-contact-hero__image-wrap">
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              class: 'pf-contact-hero__image',
              loading: 'lazy',
              widths: '640, 960, 1200, 1600, 1800',
              alt: hero_image_alt
          }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pf-contact-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
    box-sizing: border-box;
  }

  @media (max-width: 749px) {
    .pf-contact-shell {
      padding: 0 10px;
    }
  }

  .pf-contact-hero {
    padding-top: var(--hero-pt, 64px);
    padding-bottom: var(--hero-pb, 32px);
    position: relative;
  }

  .pf-contact-hero__container {
    max-width: 780px;
    margin: 0 auto;
  }

  .pf-contact-hero__container--center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pf-contact-hero__container--left {
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .pf-contact-hero__eyebrow {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.6;
  }

  .pf-contact-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading, #111111);
  }

  .pf-contact-hero__text {
    margin: 12px 0 0;
    max-width: 58ch;
    font-size: 14px;
    line-height: 1.5;
    color: currentColor;
    opacity: 0.75;
  }

  .pf-contact-hero__image-wrap {
    margin-top: 32px;
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.07);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
  }

  .pf-contact-hero__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 749px) {
    .pf-contact-hero {
      padding-top: calc(var(--hero-pt, 64px) * 0.7);
      padding-bottom: calc(var(--hero-pb, 32px) * 0.7);
    }
  }
</style>

{% schema %}
{
  "name": "Contact hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's start a conversation" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Have a question about sizing, our latest drops, order tracking, or styling advice? Our team is always here to help." },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "image_picker", "id": "image", "label": "Optional hero banner image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 2, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "presets": [{ "name": "Contact hero" }]
}
{% endschema %}
