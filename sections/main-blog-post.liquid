<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }} main-blog-post-section">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <article class="blog-post">
      <header class="blog-post__header">
        <div class="blog-post__top-bar">
          <div class="blog-post__badge-wrap">
            {%- if article.tags.size > 0 -%}
              <span class="blog-post__badge">{{ article.tags | first }}</span>
            {%- elsif blog.title != blank -%}
              <span class="blog-post__badge">{{ blog.title }}</span>
            {%- endif -%}
          </div>

          <a href="{{ blog.url | default: '/blogs/news' }}" class="blog-post__discover-more">
            Back to {{ blog.title | default: 'Updates' }}
          </a>
        </div>

        <h1 class="blog-post__heading">{{ article.title }}</h1>

        <div class="blog-post__meta">
          <span class="blog-post__date">{{ article.published_at | time_tag: format: 'date' }}</span>
          <span class="blog-post__meta-sep" aria-hidden="true">·</span>
          <span class="blog-post__reading-time">
            {%- assign words = article.content | strip_html | split: ' ' | size -%}
            {%- assign read_time = words | divided_by: 200 | at_least: 1 -%}
            {{ read_time }} min read
          </span>
        </div>
      </header>

      {%- if article.image -%}
        <div class="blog-post__image-wrapper">
          {{
            article.image
            | image_url: width: 2400
            | image_tag:
              class: 'blog-post__featured-img',
              widths: '600, 900, 1200, 1600, 2000, 2400',
              loading: 'eager',
              fetchpriority: 'high',
              alt: article.image.alt | default: article.title
          }}
        </div>
      {%- endif -%}
      
      <div class="blog-post__body">
        <div class="blog-post__content rte">
          {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}
        </div>

        {% comment %} Dynamic area for @app blocks only, at the bottom {% endcomment %}
        {% content_for 'blocks' %}

        {%- if article.tags.size > 0 -%}
          <div class="blog-post__tags-row">
            <span class="blog-post__tags-label">Tags:</span>
            <div class="blog-post__tags-list">
              {%- for tag in article.tags -%}
                <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="blog-post__tag-item">{{ tag }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {% if blog.comments_enabled? %}
          <div class="blog-post-comments-container">
            <h2 class="blog-post-comments__heading">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

            <div class="blog-post-comments">
              {% paginate article.comments by 10 %}
                {% for comment in article.comments %}
                  <div class="blog-post-comment">
                    <div class="blog-post-comment__body rte">
                      {{ comment.content }}
                    </div>
                    <div class="blog-post-comment__author">
                      <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                      <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                      <span class="blog-post-comment__date">
                        {{- comment.created_at | time_tag: format: 'date' -}}
                      </span>
                    </div>
                  </div>
                {% endfor %}

                <div class="blog-post-comments-pagination">
                  {{- paginate | default_pagination -}}
                </div>
              {% endpaginate %}
            </div>

            {% render 'blog-comment-form', article: article, section_id: section.id %}
          </div>
        {% endif %}
      </div>
    </article>
  </div>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

<style>
  /* ── Break out of Theme .section Grid to match Home Page Shell & Margins Exactly ── */
  .section.main-blog-post-section,
  .section:has(.blog-post) {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .section.main-blog-post-section > *,
  .section:has(.blog-post) > * {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .section-content-wrapper:has(.blog-post),
  .main-blog-post-section .section-content-wrapper {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* ── Shell & Left-Right Spacing identical to Home Page (36px desktop, 16px mobile) ── */
  .blog-post {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
    padding: 40px 36px 40px;
  }

  /* ── Clean Editorial Header ── */
  .blog-post__header {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgb(17 17 17 / 0.1);
    box-sizing: border-box;
  }

  .blog-post__top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
  }

  .blog-post__badge {
    display: inline-block;
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
    background: rgba(17, 17, 17, 0.06);
    padding: 3px 10px;
    border-radius: 20px;
    line-height: 1.4;
  }

  /* Heading Font Size IDENTICAL to Home Page Section Titles: 18px, font-weight 700, letter-spacing -0.03em */
  .blog-post__heading,
  .blog-post h1,
  .main-blog-post-section h1 {
    margin: 0 0 10px 0 !important;
    padding: 0 !important;
    color: #000000 !important;
    font-family: var(--font-heading--family, 'Manrope', sans-serif) !important;
    font-style: var(--font-heading--style, normal) !important;
    font-size: 18px !important;
    line-height: 1.25 !important;
    letter-spacing: -0.03em !important;
    font-weight: 700 !important;
    text-align: left !important;
    text-transform: capitalize !important;
  }

  .blog-post__meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 13px;
    color: var(--pf-real-life-muted, #6b7280);
    line-height: 1.4;
    font-weight: 400;
  }

  .blog-post__meta-sep {
    color: rgba(17, 17, 17, 0.35);
    font-weight: 600;
  }

  .blog-post__date,
  .blog-post__reading-time {
    color: var(--pf-real-life-muted, #6b7280);
  }

  /* Right-aligned Discover More style Back link */
  .blog-post__discover-more {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #111111;
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 600;
    padding: 0;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.25s ease;
  }

  .blog-post__discover-more:hover {
    color: var(--color-primary, #000000);
  }

  /* ── Featured Image ── */
  .blog-post__image-wrapper {
    width: 100%;
    margin: 0 0 28px 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(17, 17, 17, 0.08);
  }

  .blog-post__image-wrapper img,
  .blog-post__featured-img {
    width: 100%;
    height: auto;
    max-height: 540px;
    object-fit: cover;
    display: block;
  }

  /* ── Body & Content ── */
  .blog-post__body {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .blog-post__content {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 14px;
    line-height: 1.75;
    color: rgb(17 17 17 / 0.85);
    width: 100%;
    max-width: 100%;
  }

  .blog-post__content p {
    font-size: 14px;
    line-height: 1.75;
    color: rgb(17 17 17 / 0.85);
    margin-bottom: 18px;
  }

  .blog-post__content h2 {
    font-family: var(--font-heading--family, 'Manrope', sans-serif);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #000000;
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .blog-post__content h3 {
    font-family: var(--font-heading--family, 'Manrope', sans-serif);
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.35;
    color: #000000;
    margin-top: 24px;
    margin-bottom: 10px;
  }

  .blog-post__content h4 {
    font-family: var(--font-heading--family, 'Manrope', sans-serif);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: #000000;
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .blog-post__content ul,
  .blog-post__content ol {
    font-size: 14px;
    line-height: 1.75;
    color: rgb(17 17 17 / 0.85);
    padding-left: 20px;
    margin-bottom: 20px;
  }

  .blog-post__content li {
    margin-bottom: 6px;
  }

  .blog-post__content blockquote {
    font-size: 14px;
    line-height: 1.7;
    font-style: italic;
    border-left: 3px solid #111111;
    padding: 12px 18px;
    background: rgba(0, 0, 0, 0.02);
    border-radius: 0 4px 4px 0;
    margin: 24px 0;
    color: rgba(17, 17, 17, 0.85);
  }

  .blog-post__content a {
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .blog-post__content a:hover {
    opacity: 0.7;
  }

  .blog-post__content img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 24px 0;
    border: 1px solid rgba(17, 17, 17, 0.06);
    display: block;
  }

  /* ── Tags Row ── */
  .blog-post__tags-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid rgb(17 17 17 / 0.1);
  }

  .blog-post__tags-label {
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 600;
    color: var(--pf-real-life-muted, #6b7280);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-post__tags-list {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .blog-post__tag-item {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    color: #111111;
    background: rgba(17, 17, 17, 0.05);
    padding: 4px 12px;
    border-radius: 16px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .blog-post__tag-item:hover {
    background: #0800CF;
    color: #ffffff;
  }

  /* ── Comments ── */
  .blog-post-comments-container {
    width: 100%;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgb(17 17 17 / 0.1);
  }

  .blog-post-comments__heading {
    font-family: var(--font-heading--family, 'Manrope', sans-serif);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #000000;
    margin-bottom: 20px;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .blog-post-comment {
    background: rgba(17, 17, 17, 0.02);
    border: 1px solid rgba(17, 17, 17, 0.06);
    border-radius: 4px;
    padding: 16px 20px;
  }

  .blog-post-comment__body {
    font-size: 13.5px;
    line-height: 1.65;
    color: rgb(17 17 17 / 0.85);
    margin-bottom: 10px;
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--pf-real-life-muted, #6b7280);
  }

  .blog-post-comment__author-name {
    font-weight: 600;
    color: #000000;
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    margin-top: 16px;
  }

  .blog-post-comments-pagination a,
  .blog-post-comments-pagination .current {
    padding: 6px 12px;
    border-radius: 4px;
    text-decoration: none;
    color: #111111;
  }

  .blog-post-comments-pagination .current {
    background: #0800CF;
    color: #ffffff;
    font-weight: 600;
  }

  @media screen and (max-width: 989px) {
    .blog-post__discover-more {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .blog-post {
      padding: 32px 16px 32px;
    }

    .blog-post__top-bar {
      margin-bottom: 8px;
    }

    .blog-post__heading,
    .blog-post h1,
    .main-blog-post-section h1 {
      font-size: 18px !important;
      line-height: 1.3 !important;
      margin-bottom: 8px !important;
    }

    .blog-post__meta {
      font-size: 12px;
      gap: 6px;
    }
  }
</style>

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
