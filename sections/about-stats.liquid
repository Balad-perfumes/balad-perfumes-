<link rel="stylesheet" href="{{ 'about.css' | asset_url }}">
<script src="{{ 'about.js' | asset_url }}" type="module" fetchpriority="low"></script>

<section class="about-stats color-{{ section.settings.color_scheme }}" {% if section.settings.enable_animations %}data-about-reveal{% endif %}>
  <div class="about-shell">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="about-stats__intro text-center">
        {% if section.settings.eyebrow != blank %}
          <p class="about-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="about-stats__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="about-stats__grid">
      {% for block in section.blocks %}
        <div class="about-stats__card about-reveal-item" {{ block.shopify_attributes }} data-about-reveal>
          <div class="about-stats__card-top">
            <span class="about-stats__badge">0{{ forloop.index }}</span>
            <span class="about-stats__indicator" aria-hidden="true"></span>
          </div>
          <div class="about-stats__card-body">
            <span
              class="about-stats__counter"
              data-stat-value="{{ block.settings.number | escape }}"
            >
              {{ block.settings.number | escape }}
            </span>
            <p class="about-stats__label">{{ block.settings.label | escape }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About stats",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Impact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Numbers that speak for our passion" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable animations", "default": true }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Number/Stat", "default": "50k+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Men Styled Worldwide" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "50k+", "label": "Men Styled Worldwide" } },
        { "type": "stat", "settings": { "number": "100%", "label": "In-House Tailored" } },
        { "type": "stat", "settings": { "number": "250+", "label": "Signature Drops" } },
        { "type": "stat", "settings": { "number": "4.9/5", "label": "Average Fit Rating" } }
      ]
    }
  ]
}
{% endschema %}
