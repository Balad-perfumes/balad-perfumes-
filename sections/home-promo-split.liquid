<section class="pf-home-promo color-{{ section.settings.color_scheme }}">
  <div class="pf-home-promo__shell">
    <div class="pf-home-promo__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="pf-home-promo__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pf-home-promo__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="pf-home-promo__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'pf-home-promo__image',
            widths: '480, 720, 960, 1200, 1600, 1800',
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.heading
        }}
      {% else %}
        <div class="pf-home-promo__placeholder" aria-hidden="true">
          <span>Image</span>
        </div>
      {% endif %}
    </div>

    <div class="pf-home-promo__body">
      {% if section.settings.text != blank %}
        <div class="pf-home-promo__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a class="pf-home-promo__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pf-home-promo {
    background: #fff;
    color: #111111;
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px clamp(20px, 4vw, 42px) 16px;
  }

  .pf-home-promo__shell {
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    border-top: 1px solid rgb(17 17 17 / 0.1);
  }

  .pf-home-promo__intro,
  .pf-home-promo__body {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .pf-home-promo__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #000000;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pf-home-promo__eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 2px;
    background: currentColor;
    flex-shrink: 0;
  }

  .pf-home-promo__heading {
    margin: 0;
    color: #000000;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: clamp(2.2rem, 1.5rem + 2.3vw, 4rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 500;
    text-wrap: balance;
  }

  .pf-home-promo__text {
    font-size: clamp(0.96rem, 0.88rem + 0.5vw, 1.18rem);
    line-height: 1.6;
    color: rgb(17 17 17 / 0.72);
  }

  .pf-home-promo__text :is(p, ul, ol) {
    margin-block: 0;
  }

  .pf-home-promo__button {
    width: 100%;
    min-height: 50px;
    padding: 0 24px;
    border-radius: 8px;
    background: #0800CF;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.22s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
  }

  .pf-home-promo__button::after {
    content: '→';
    font-size: 1em;
    transition: transform 0.25s ease;
  }

  .pf-home-promo__button:hover {
    background: #0600a3;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(8, 0, 207, 0.28);
  }

  .pf-home-promo__button:hover::after {
    transform: translateX(4px);
  }

  .pf-home-promo__media {
    overflow: hidden;
    background: #f3f3f3;
    border-radius: 2px;
  }

  .pf-home-promo__image,
  .pf-home-promo__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s ease;
  }

  .pf-home-promo__media:hover .pf-home-promo__image {
    transform: scale(1.03);
  }

  .pf-home-promo__placeholder {
    min-height: 320px;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #dcdcdc, #f3f3f3);
    color: #111111;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  @media screen and (min-width: 750px) {
    .pf-home-promo__shell {
      padding-inline: 0;
      gap: 28px 40px;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: stretch;
    }

    .pf-home-promo__intro {
      gap: 20px;
      grid-column: 1;
      grid-row: 1;
      align-self: end;
    }

    .pf-home-promo__media {
      grid-column: 2;
      grid-row: 1 / span 2;
      min-height: 0;
      align-self: stretch;
      border-radius: 4px;
    }

    .pf-home-promo__image,
    .pf-home-promo__placeholder {
      width: 100%;
      height: 100%;
      min-height: 580px;
      aspect-ratio: auto;
    }

    .pf-home-promo__eyebrow {
      font-size: 0.8rem;
    }

    .pf-home-promo__heading {
      font-size: 34px;
      line-height: 0.92;
      letter-spacing: -0.03em;
    }

    .pf-home-promo__body {
      gap: 18px;
      max-width: 56ch;
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      padding-top: 10px;
    }

    .pf-home-promo__text {
      font-size: 17px;
      line-height: 1.6;
      max-width: 56ch;
    }

    .pf-home-promo__button {
      min-height: 52px;
      width: fit-content;
      padding-inline: 28px;
      font-size: 0.84rem;
    }
  }

  @media screen and (max-width: 749px) {
    .pf-home-promo {
      padding: 0;
      margin: 0;
    }

    .pf-home-promo__shell {
      gap: 14px;
      padding: 24px 20px 12px;
    }

    .pf-home-promo__intro {
      gap: 12px;
      padding: 0 0 14px;
    }

    .pf-home-promo__heading {
      font-size: 26px;
      line-height: 0.92;
      letter-spacing: -0.02em;
    }

    .pf-home-promo__media {
      width: 100%;
      height: 352px;
    }

    .pf-home-promo__image,
    .pf-home-promo__placeholder {
      width: 100%;
      aspect-ratio: 0.9 / 1;
      min-height: 0;
    }

    .pf-home-promo__body {
      gap: 12px;
      padding: 0 0 14px;
    }

    .pf-home-promo__text {
      font-size: 0.92rem;
      line-height: 1.52;
    }

    .pf-home-promo__button {
      width: 160px;
      min-height: 48px;
      font-size: 0.84rem;
      padding-inline: 20px;
      border-radius: 8px;
    }
  }
</style>

{% schema %}
{
  "name": "Home promo split",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not decor. Objects." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Conceptual pieces for bold spaces." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>These are designed to feel like artful objects, made to stand out and spark conversation in any room.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Home promo split" }]
}
{% endschema %}
