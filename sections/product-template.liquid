  /* ── Desktop & Mobile Structured Minimal Sticky Bottom Bar ────────────── */
  .pf-product-template__sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 999998;
    background: #ffffff;
    border-top: 1px solid #e5e7eb;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(100%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.32s ease, visibility 0.38s;
    will-change: transform, opacity;
  }

  .pf-product-template__sticky-bar[data-visible="true"],
  .pf-product-template__sticky-bar[data-mobile-visible="true"],
  body[data-mobile-nav-hidden="true"] .pf-product-template__sticky-bar {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Instant Complete Hide when Drawer / Story Modal / Cart is open */
  body.pf-drawer-open .pf-product-template__sticky-bar,
  body.story-modal-open .pf-product-template__sticky-bar,
  body:has(.cart-drawer[open]) .pf-product-template__sticky-bar,
  body:has(cart-drawer[open]) .pf-product-template__sticky-bar,
  body:has(.quick-add-modal[open]) .pf-product-template__sticky-bar {
    transform: translateY(100%) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

