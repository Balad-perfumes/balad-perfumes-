{% liquid
  assign selected_product = product
  assign current_variant = selected_product.selected_or_first_available_variant
  assign form_id = 'StagProductForm-' | append: section.id
  assign review_count = selected_product.metafields.reviews.rating_count.value | default: 0 | plus: 0

  # Dynamic Rating Fetch from Judge.me / Shopify Metafields
  assign review_rating = blank

  if selected_product.metafields.reviews.rating.value != blank
    assign review_rating = selected_product.metafields.reviews.rating.value.rating | round: 1
  endif

  if review_rating == blank
    assign jm_badge = selected_product.metafields.judgeme.badge
    if jm_badge != blank and jm_badge contains "data-average-rating='"
      assign review_rating = jm_badge | split: "data-average-rating='" | last | split: "'" | first | round: 1
    endif
  endif

  if review_rating == blank
    assign review_rating = selected_product.metafields.judgeme.rating
  endif

%}

  {% comment %} Product Metafield Image Fetching {% endcomment %}
  {% assign metafield_image = selected_product.metafields.custom.sticky_product_image.value | default: selected_product.metafields.custom.sticky_product_image %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.metafields.custom.sticky_image.value | default: selected_product.metafields.custom.sticky_image %}
  {% endif %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.metafields.custom.product_image.value | default: selected_product.metafields.custom.product_image %}
  {% endif %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.metafields.custom.image.value | default: selected_product.metafields.custom.image %}
  {% endif %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.metafields.custom.main_image.value | default: selected_product.metafields.custom.main_image %}
  {% endif %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.metafields.custom.cover_image.value | default: selected_product.metafields.custom.cover_image %}
  {% endif %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.metafields.custom.featured_image.value | default: selected_product.metafields.custom.featured_image %}
  {% endif %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.metafields.custom.model_image.value | default: selected_product.metafields.custom.model_image %}
  {% endif %}
  {% if metafield_image == blank %}
    {% assign metafield_image = selected_product.featured_media | default: selected_product.media.first %}
  {% endif %}

  {% assign default_product_description = selected_product.metafields.custom.default_description | default: section.settings.default_description | default: section.settings.technical_information | default: '<p>Premium 100% Combed Heavyweight Cotton. Relaxed oversized drape with reinforced ribbed collar, drop shoulders, and anti-pilling finish. Designed for everyday comfort, enduring style, and all-day versatility.</p>' %}
  {% assign product_care_content = selected_product.metafields.custom.product_care | default: section.settings.product_care %}
  {% assign delivery_returns_content = selected_product.metafields.custom.delivery_returns | default: section.settings.delivery_returns | default: section.settings.shipping_information %}

{% assign size_option = blank %}
{% assign color_option = blank %}
{% unless selected_product.has_only_default_variant %}
  {% for product_option in selected_product.options_with_values %}
    {% assign option_name_downcase = product_option.name | downcase %}
    {% if option_name_downcase contains 'size' %}
      {% assign size_option = product_option %}
    {% elsif option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
      {% assign color_option = product_option %}
    {% endif %}
  {% endfor %}
{% endunless %}

{% liquid
  assign related_source = blank
  if selected_product.collections.size > 0 and selected_product.collections.first != blank
    assign related_source = selected_product.collections.first.products
  else
    assign related_source = collections.all.products
  endif

  assign related_products = related_source | reject: 'id', selected_product.id

  if related_products == blank or related_products.size < 3
    assign related_products = collections.all.products | reject: 'id', selected_product.id
  endif
%}

<section class="pf-product-template color-{{ section.settings.color_scheme }} product-{{ selected_product.handle }}" data-pf-product data-money-format="{{ shop.money_format | escape }}">
  <div class="pf-product-template__shell">
    <div class="pf-product-template__media" data-pf-media>
      <div class="pf-product-template__gallery{% if selected_product.media.size == 1 and metafield_image == blank %} is-single-media{% endif %}" data-pf-gallery>
        <div class="pf-gallery-layout{% if selected_product.media.size == 1 and metafield_image == blank %} is-single-media{% endif %}" data-pf-slides>
          <!-- Primary / Sticky Metafield Image -->
          <div class="pf-gallery__primary">
            <article
              class="pf-product-template__slide pf-gallery-card pf-gallery-card--primary is-active"
              data-pf-slide
              data-slide-index="0"
              aria-hidden="false"
            >
              {% if metafield_image != blank %}
                {{
                  metafield_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'pf-product-template__image pf-product-template__image--metafield',
                    widths: '640, 960, 1200, 1600, 1800',
                    loading: 'eager',
                    fetchpriority: 'high',
                    alt: metafield_image.alt | default: selected_product.title
                }}
              {% elsif selected_product.media.size > 0 %}
                {% assign first_media = selected_product.media.first %}
                {% if first_media.media_type == 'image' %}
                  {{
                    first_media
                    | image_url: width: 1800
                    | image_tag:
                      class: 'pf-product-template__image',
                      widths: '640, 960, 1200, 1600, 1800',
                      loading: 'eager',
                      fetchpriority: 'high',
                      alt: first_media.alt | default: selected_product.title
                  }}
                {% elsif first_media.media_type == 'video' or first_media.media_type == 'external_video' %}
                  {% render 'video',
                    video: first_media,
                    video_class: 'pf-product-template__video',
                    video_loop: true,
                    disable_controls: true,
                    loading: 'lazy'
                  %}
                {% else %}
                  {{ first_media | media_tag }}
                {% endif %}
              {% endif %}
            </article>
          </div>

          <!-- Secondary / Product Images (Vertically Scrolling on Desktop) -->
          {% if selected_product.media.size > 0 %}
            <div class="pf-gallery__secondary" data-pf-gallery-secondary>
              {% for media in selected_product.media %}
                <article
                  class="pf-product-template__slide pf-gallery-card pf-gallery-card--secondary{% if forloop.first %} is-active{% endif %}"
                  data-pf-slide
                  data-slide-index="{{ forloop.index }}"
                  data-media-id="{{ media.id }}"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                >
                  {% if media.media_type == 'image' %}
                    {% assign loading = 'lazy' %}
                    {% assign fetchpriority = 'auto' %}
                    {% if forloop.first %}
                      {% assign loading = 'eager' %}
                      {% assign fetchpriority = 'high' %}
                    {% endif %}
                    {{
                      media
                      | image_url: width: 1800
                      | image_tag:
                        class: 'pf-product-template__image',
                        widths: '640, 960, 1200, 1600, 1800',
                        loading: loading,
                        fetchpriority: fetchpriority,
                        alt: media.alt | default: selected_product.title
                    }}
                  {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
                    {% render 'video',
                      video: media,
                      video_class: 'pf-product-template__video',
                      video_loop: true,
                      disable_controls: true,
                      loading: 'lazy'
                    %}
                  {% else %}
                    {{ media | media_tag }}
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {% comment %} Overall Mobile Dots {% endcomment %}
        {% assign total_mobile_dots = selected_product.media.size | plus: 1 %}
        {% if total_mobile_dots > 1 %}
          <div class="pf-product-template__dots" data-pf-dots aria-label="Product image pagination">
            <button
              type="button"
              class="pf-product-template__dot is-active"
              data-pf-dot
              data-slide-index="0"
              aria-label="Go to main image"
            ></button>
            {% for media in selected_product.media %}
              <button
                type="button"
                class="pf-product-template__dot"
                data-pf-dot
                data-slide-index="{{ forloop.index }}"
                aria-label="Go to image {{ forloop.index }}"
              ></button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="pf-product-template__content">
      <!-- Minimal Structured Product Card -->
      <div class="pf-product-card">

        <!-- Top Pill Badges -->
        <div class="pf-buybox__top-tags">
          <span class="pf-top-tag">Lasts 6-8 hours</span>
          <span class="pf-top-tag">Eau De Parfum</span>
        </div>

        <!-- Product Title -->
        <div class="pf-buybox__header">
          <h1 class="pf-buybox__title">{{ selected_product.title }}</h1>
        </div>

        <!-- Fragrance Subtitle Tagline -->
        <p class="pf-buybox__fragrance-subtitle">
          {% assign tags_str = selected_product.tags | join: ' ' | downcase %}
          {% if tags_str contains 'oriental' or tags_str contains 'floral' %}
            Oriental | Floral Musky | Citrus Floral
          {% elsif tags_str contains 'woody' %}
            Woody | Amber Spice | Fresh Cedar
          {% elsif tags_str contains 'fresh' %}
            Fresh Citrus | Aquatic | Green Notes
          {% else %}
            {{ selected_product.vendor | default: 'EAU DE PARFUM' | upcase }}
          {% endif %}
        </p>

        <!-- Rating & Share Row -->
        <div class="pf-buybox__rating-row">
          <div class="pf-buybox__rating-left">
            <div class="pf-buybox__stars" aria-label="{% if review_rating != blank and review_count > 0 %}{{ review_rating }} out of 5 stars{% else %}No reviews yet{% endif %}">
              <span class="pf-star">★</span>
              <span class="pf-star">★</span>
              <span class="pf-star">★</span>
              <span class="pf-star">★</span>
              <span class="pf-star">★</span>
            </div>
            <a class="pf-buybox__reviews-count" href="#pf-product-reviews">
              {{ review_count }} {% if review_count == 1 %}review{% else %}reviews{% endif %}
            </a>
          </div>
          <button type="button" class="pf-buybox__share-btn" data-share-btn aria-label="Share product">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </button>
        </div>

        <!-- Price Block -->
        <div class="pf-buybox__price-block">
          <div class="pf-buybox__price-row">
            <span class="pf-price-main" data-pf-price-main>₹{{ current_variant.price | money_without_currency }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              {% assign save_amt = current_variant.compare_at_price | minus: current_variant.price %}
              <span class="pf-price-compare" data-pf-compare-price>₹{{ current_variant.compare_at_price | money_without_currency }}</span>
              <span class="pf-save-badge" data-pf-save-badge>Save ₹{{ save_amt | money_without_currency }}</span>
            {% endif %}
          </div>
          <span class="pf-tax-label">MRP. (Incl. of all tax)</span>
        </div>

        <!-- Size Pills matching mockup -->
        {% if size_option != blank and size_option.values.size > 0 %}
          <div class="pf-buybox__size-section">
            <span class="pf-buybox__option-label">Size</span>
            <div class="pf-buybox__sizes" data-pf-size-selector>
              {% assign size_pos = size_option.position %}
              {% for val in size_option.values %}
                {% liquid
                  assign val_name = val.name | default: val
                  assign val_lower = val_name | downcase
                %}
                {% unless val_lower contains 'personal' or val_lower contains 'custom' %}
                  {% liquid
                    assign size_variant = blank
                    for v in selected_product.variants
                      if v.option1 == val_name or v.option2 == val_name or v.option3 == val_name
                        assign size_variant = v
                        break
                      endif
                    endfor

                    assign is_selected = false
                    if current_variant != blank and size_variant != blank and current_variant.id == size_variant.id
                      assign is_selected = true
                    elsif forloop.first
                      assign is_selected = true
                    endif

                    assign pill_sub = 'Best Value'
                    if forloop.index == 2
                      assign pill_sub = 'Standard Pack'
                    elsif size_variant != blank and size_variant.price > 0
                      assign pill_sub = 'Standard Pack'
                    else
                      assign pill_sub = 'Standard Pack'
                    endif
                  %}
                  <button
                    type="button"
                    class="pf-size-box{% if is_selected %} is-active{% endif %}"
                    data-pf-size-pill
                    data-value="{{ val_name | escape }}"
                    data-variant-id="{{ size_variant.id | default: current_variant.id }}"
                    aria-label="Size {{ val_name }}"
                  >
                    <span class="pf-size-box__title">{{ val_name }}</span>
                    <span class="pf-size-box__subtitle">{{ pill_sub }}</span>
                  </button>
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        {% elsif selected_product.has_only_default_variant == false and selected_product.variants.size > 1 %}
          <div class="pf-buybox__size-section">
            <span class="pf-buybox__option-label">Size</span>
            <div class="pf-buybox__sizes" data-pf-size-selector>
              {% for variant in selected_product.variants %}
                {% assign v_lower = variant.title | downcase %}
                {% unless v_lower contains 'personal' or v_lower contains 'custom' %}
                  <button
                    type="button"
                    class="pf-size-box{% if variant.id == current_variant.id %} is-active{% endif %}"
                    data-pf-size-pill
                    data-value="{{ variant.title | escape }}"
                    data-variant-id="{{ variant.id }}"
                    aria-label="{{ variant.title }}"
                  >
                    <span class="pf-size-box__title">{{ variant.title }}</span>
                    <span class="pf-size-box__subtitle">{% if forloop.first %}Best Value{% else %}Standard Pack{% endif %}</span>
                  </button>
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- 3 Circular Trust Badges Row -->
        <div class="pf-buybox__trust-row">
          <div class="pf-trust-item">
            <div class="pf-trust-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 3"/>
              </svg>
            </div>
            <span class="pf-trust-text">Farm to<br>Fragrance</span>
          </div>

          <div class="pf-trust-item">
            <div class="pf-trust-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            </div>
            <span class="pf-trust-text">100% Authentic<br>Perfume</span>
          </div>

          <div class="pf-trust-item">
            <div class="pf-trust-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22">
                <rect x="1" y="3" width="15" height="13" rx="2"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            </div>
            <span class="pf-trust-text">Express Shipping<br>& Returns</span>
          </div>
        </div>

        {%- form 'product', selected_product, id: form_id, class: 'pf-buybox__form', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pf-variant-id>
          <input type="hidden" name="quantity" value="1" data-pf-qty-field>

          <button
            type="button"
            class="pf-buy-now-outline-btn"
            data-pf-buy-now
            {% unless current_variant.available %}disabled{% endunless %}
          >
            BUY NOW
          </button>
        {%- endform -%}

        <!-- Clean Divider Line -->
        <div class="pf-product-card__divider"></div>

        <!-- Description & Shipping Tabs Section (media_1789551203248.png) -->
        <div class="pf-tabs__container">
          <div class="pf-tabs__nav" role="tablist">
            <button type="button" class="pf-tabs__tab is-active" data-pf-tab="description" role="tab" aria-selected="true">
              Description
            </button>
            <button type="button" class="pf-tabs__tab" data-pf-tab="shipping" role="tab" aria-selected="false">
              Shipping
            </button>
          </div>

          <div class="pf-tabs__content">
            <!-- Description Pane (Default Open) -->
            <div class="pf-tabs__pane is-active" data-pf-pane="description" role="tabpanel">
              <div class="pf-tabs__section">
                <div class="pf-tabs__description-body rte">
                  {% assign clean_desc = selected_product.description | strip_html | strip %}
                  {% if clean_desc != blank %}
                    {% assign formatted_desc = selected_product.description | replace: 'Ahmed Al Maghribi Bin Shaikh', selected_product.title | replace: 'Ahmed Al Maghribi', 'Balad Perfumes' %}
                    {{ formatted_desc }}
                  {% else %}
                    <p>Experience the beauty of <strong>{{ selected_product.title }}</strong>, a luxury fragrance crafted with fine concentrated oils, luminous florals, and warm amber notes. Sophisticated, elegant, and long-lasting, this captivating scent is designed to evoke confidence and timeless style.</p>
                    <p>Perfect for everyday wear and special occasions, <strong>{{ selected_product.title }}</strong> leaves a graceful and unforgettable impression wherever you go.</p>
                  {% endif %}
                </div>
              </div>
            </div>

            <!-- Shipping Pane -->
            <div class="pf-tabs__pane" data-pf-pane="shipping" role="tabpanel" hidden>
              <div class="pf-tabs__section">
                <div class="pf-tabs__shipping-body rte">
                  {% if selected_product.metafields.custom.delivery_returns != blank %}
                    {{ selected_product.metafields.custom.delivery_returns | metafield_tag }}
                  {% else %}
                    <p>Fast express shipping across India with real-time tracking, Cash on Delivery options, and careful protective packaging.</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Collapsible Accordions List (media_1789551247742.png) -->
        <div class="pf-buybox-accordion-group">
          <!-- Item 1: Occasion -->
          <details class="pf-accordion-item">
            <summary class="pf-accordion-header">
              <div class="pf-accordion-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <span>Occasion</span>
              </div>
              <span class="pf-accordion-icon">+</span>
            </summary>
            <div class="pf-accordion-body">
              {% if selected_product.metafields.custom.occasion != blank %}
                <div class="rte">
                  {{ selected_product.metafields.custom.occasion | metafield_tag }}
                </div>
              {% else %}
                <p>Ideal for daily signature wear, evening events, celebrations, and luxury gifting.</p>
              {% endif %}
            </div>
          </details>

          <!-- Item 2: Wear It Right -->
          <details class="pf-accordion-item" open>
            <summary class="pf-accordion-header">
              <div class="pf-accordion-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                <span>Wear It Right</span>
              </div>
              <span class="pf-accordion-icon">+</span>
            </summary>
            <div class="pf-accordion-body">
              {% if selected_product.metafields.custom.wear_it_right != blank %}
                <div class="rte">
                  {{ selected_product.metafields.custom.wear_it_right | metafield_tag }}
                </div>
              {% else %}
                <ul class="pf-accordion-bullets">
                  <li>Apply on moisturised skin for better longevity.</li>
                  <li>Spray on pulse points — neck, wrists & behind the ears.</li>
                  <li>Hold the bottle 15 cm away when spraying for even application and to help avoid staining.</li>
                  <li>Don't rub after spraying; let it dry naturally.</li>
                  <li>Store your perfume away from heat, sunlight & humidity.</li>
                </ul>
              {% endif %}
            </div>
          </details>
        </div>
        <button type="button" class="pf-btn-write-review pf-buybox__write-review" data-pf-reviews-open>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Write a Review
        </button>
      </div>
    </div>
  </div>



  <script type="application/json" id="VariantData-{{ section.id }}">
    {{ selected_product.variants | json }}
  </script>

  <!-- Desktop Structured Minimal Sticky Bar -->
  <div class="pf-product-template__sticky-bar" data-pf-sticky-bar aria-hidden="true">
    <div class="pf-product-template__sticky-shell">
      <div class="pf-product-template__sticky-info">
        <div class="pf-product-template__sticky-img">
          <img
            src="{{ selected_product.featured_media.preview_image | default: selected_product.featured_image | image_url: width: 160 }}"
            alt="{{ selected_product.title | escape }}"
            width="56"
            height="56"
            loading="lazy"
            data-pf-sticky-image
          >
        </div>
        <div class="pf-product-template__sticky-details">
          <h4 class="pf-product-template__sticky-title">{{ selected_product.title }}</h4>
          <div class="pf-product-template__sticky-price-wrap">
            <span class="pf-product-template__sticky-price" data-pf-sticky-price>
              {{ current_variant.price | money }}
            </span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="pf-product-template__sticky-compare-price" data-pf-sticky-compare-price>
                {{ current_variant.compare_at_price | money }}
              </span>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="pf-product-template__sticky-right">
        <div class="pf-product-template__sticky-actions">
          <button
            type="button"
            class="pf-sticky-wishlist-btn"
            data-pf-sticky-wishlist
            data-wishlist-button
            data-product-handle="{{ selected_product.handle }}"
            data-product-id="{{ selected_product.id }}"
            data-product-title="{{ selected_product.title | escape }}"
            data-product-image="{{ selected_product.featured_media.preview_image | default: selected_product.featured_image | image_url: width: 360 }}"
            data-product-price="{{ selected_product.price | money | strip_html | escape }}"
            aria-label="Add to wishlist"
            aria-pressed="false"
            title="Add to wishlist"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </button>

          <button
            type="button"
            class="pf-btn pf-btn--add-to-bag pf-sticky-btn pf-sticky-btn--add"
            data-pf-sticky-add
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-pf-sticky-add-text>{% if current_variant.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</span>
          </button>

          <button
            type="button"
            class="pf-btn pf-btn--buy-now pf-sticky-btn pf-sticky-btn--buy"
            data-pf-sticky-buy
            {% unless current_variant.available %}disabled{% endunless %}
          >
            BUY NOW
          </button>
        </div>
      </div>
    </div>
  </div>

  </section>

<style>
    /* ---- FAQ Section Styling ---- */
    .pf-product-template__faq-section {
      padding-top: 34px;
      border-top: 1px solid rgb(17 17 17 / 0.12);
      grid-column: 1 / -1;
