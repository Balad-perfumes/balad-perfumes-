      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20,
      "info": "The bar uses your real Shopify inventory (only for products where Shopify tracks stock and overselling is blocked). The fewer bottles left, the shorter the bar. Set 0 to turn off."
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer line (optional)",
      "info": "Example: Extra 5% off on prepaid orders with code PREPAID5. Leave empty to hide. Only add an offer that really works at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_secure_pay",
      "label": "Show 'Secure payments: UPI, Cards, Net Banking'",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cod",
      "label": "Show 'Cash on Delivery available'",
      "default": false,
      "info": "Turn on only if you really offer COD."
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note (optional)",
      "info": "Example: Free shipping on prepaid orders. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "returns_note",
      "label": "Returns note (optional)",
      "info": "Example: Easy 7-day returns. Leave empty to hide."
    }
  ],
  "presets": [
    {
      "name": "Product template"
    }
  ]
}
