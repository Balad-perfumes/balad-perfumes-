{% javascript %}
  (() => {
    const root = document.querySelector('[data-pf-product]');
    if (!root) return;

    const gallery = root.querySelector('[data-pf-gallery]');
    const slidesRail = root.querySelector('[data-pf-slides]');
    const slides = [...root.querySelectorAll('[data-pf-slide]')];
    const dots = [...root.querySelectorAll('[data-pf-dot]')];
    const sizePills = [...root.querySelectorAll('[data-pf-size-pill]')];
    const swatches = [...root.querySelectorAll('[data-pf-swatch]')];
    const variantIdInput = root.querySelector('[data-pf-variant-id]');
    const addToBagBtn = root.querySelector('[data-pf-add-to-bag]');
    const buyNowBtn = root.querySelector('[data-pf-buy-now]');
    const addTextEl = root.querySelector('[data-pf-add-text]');
    const priceEl = root.querySelector('[data-pf-price]');
    const selectedColorLabel = root.querySelector('[data-pf-selected-color]');
    const tabs = [...root.querySelectorAll('[data-pf-tab]')];
    const panes = [...root.querySelectorAll('[data-pf-pane]')];
    const sizeGuideOpenBtn = root.querySelector('[data-pf-size-guide-open]');
    const sizeGuideModal = document.getElementById('pf-size-guide-modal');
    const modalCloseBtns = [...document.querySelectorAll('[data-pf-modal-close]')];
    const wishlist = root.querySelector('[data-pf-wishlist]');
    const navPrev = root.querySelector('[data-pf-nav-prev]');
    const navNext = root.querySelector('[data-pf-nav-next]');

    const stickyBar = root.querySelector('[data-pf-sticky-bar]');
    const stickySizes = [...root.querySelectorAll('[data-pf-sticky-size]')];
    const stickyAddBtn = root.querySelector('[data-pf-sticky-add]');
    const stickyBuyBtn = root.querySelector('[data-pf-sticky-buy]');
    const stickyAddText = root.querySelector('[data-pf-sticky-add-text]');
    const stickyPriceEl = root.querySelector('[data-pf-sticky-price]');
    const buyboxActions = root.querySelector('.pf-buybox__actions');

    const variantDataEl = root.querySelector('[id^="VariantData-"]');
    const variantData = variantDataEl ? JSON.parse(variantDataEl.textContent) : [];
    const variantMap = {};
    if (Array.isArray(variantData)) {
      variantData.forEach((v) => {
        variantMap[v.id] = v;
      });
    }

    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = parseInt(cents, 10);
      let value = '';
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      const cleanFormat = (format || 'RS. {{amount}}').replace(/₹/g, 'RS.');
      const match = cleanFormat.match(placeholderRegex);
      if (!match) return `RS. ${(cents / 100).toLocaleString()}`;

      const placeholder = match[1];
      switch (placeholder) {
        case 'amount':
          value = (cents / 100).toFixed(2);
          break;
        case 'amount_no_decimals':
          value = Math.round(cents / 100).toString();
          break;
        case 'amount_with_comma_separator':
          value = (cents / 100).toFixed(2).replace('.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = Math.round(cents / 100).toString().replace('.', ',');
          break;
        default:
          value = (cents / 100).toFixed(2);
      }

      if (placeholder.includes('comma_separator')) {
        const parts = value.split(',');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        value = parts.join(',');
      } else {
        const parts = value.split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        value = parts.join('.');
      }

      return cleanFormat.replace(placeholderRegex, value);
    }

    const syncVariant = (variantId) => {
      if (variantIdInput && variantId) {
        variantIdInput.value = variantId;
      }

      const v = variantMap[variantId];
      if (v) {
        // Update Add / Buy button state
        const available = v.available;
        if (addToBagBtn) {
          addToBagBtn.disabled = !available;
          if (addTextEl) {
            addTextEl.textContent = available ? 'ADD TO BAG' : 'SOLD OUT';
          }
        }
        if (buyNowBtn) {
          buyNowBtn.disabled = !available;
        }

        if (stickyAddBtn) {
          stickyAddBtn.disabled = !available;
          if (stickyAddText) {
            stickyAddText.textContent = available ? 'ADD TO BAG' : 'SOLD OUT';
          }
        }
        if (stickyBuyBtn) {
          stickyBuyBtn.disabled = !available;
        }

        // Update Price if present
        if (priceEl && v.price) {
          const moneyFormat = root.dataset.moneyFormat || 'RS. {{amount}}';
          const priceText = formatMoney(v.price, moneyFormat);
          const priceValEl = priceEl.querySelector('.price') || priceEl;
          if (priceValEl) priceValEl.textContent = priceText;

          const compareValEl = priceEl.querySelector('.compare-at-price');
          if (compareValEl && v.compare_at_price && v.compare_at_price > v.price) {
            compareValEl.textContent = formatMoney(v.compare_at_price, moneyFormat);
          }

          if (stickyPriceEl) {
            stickyPriceEl.textContent = priceText;
          }

          const stickyCompareEl = root.querySelector('[data-pf-sticky-compare-price]');
          if (stickyCompareEl) {
            if (v.compare_at_price && v.compare_at_price > v.price) {
              stickyCompareEl.textContent = formatMoney(v.compare_at_price, moneyFormat);
              stickyCompareEl.style.display = 'inline';
            } else {
              stickyCompareEl.style.display = 'none';
            }
          }
        }

        if (v.featured_media && v.featured_media.id) {
          goToMediaId(v.featured_media.id);
        }
      }
    };

    // Quantity Selector Minus / Plus
    const qtyInput = root.querySelector('[data-pf-qty-input]');
    const qtyMinus = root.querySelector('[data-pf-qty-minus]');
    const qtyPlus = root.querySelector('[data-pf-qty-plus]');
    const formQtyField = root.querySelector('[data-pf-qty-field]');

    if (qtyInput) {
      if (qtyMinus) {
        qtyMinus.addEventListener('click', (e) => {
          e.preventDefault();
          let currentVal = parseInt(qtyInput.value) || 1;
          if (currentVal > 1) {
            qtyInput.value = currentVal - 1;
            if (formQtyField) formQtyField.value = qtyInput.value;
          }
        });
      }
      if (qtyPlus) {
        qtyPlus.addEventListener('click', (e) => {
          e.preventDefault();
          let currentVal = parseInt(qtyInput.value) || 1;
          qtyInput.value = currentVal + 1;
          if (formQtyField) formQtyField.value = qtyInput.value;
        });
      }
    }

    // Size Pills Selection
    sizePills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        sizePills.forEach((p) => {
          p.classList.remove('is-active');
          p.classList.remove('is-selected');
        });
        pill.classList.add('is-active');
        pill.classList.add('is-selected');

        const pillSize = (pill.dataset.pfSizePill || pill.textContent || '').trim();
        if (wishlist && pillSize) {
          wishlist.dataset.productSize = pillSize;
        }

        // Sync sticky size buttons
        stickySizes.forEach((sb) => {
          const sVal = (sb.dataset.pfStickySize || '').trim().toLowerCase();
          sb.classList.toggle('is-active', sVal === pillSize.toLowerCase());
        });

        const variantId = pill.dataset.variantId;
        if (variantId) {
          syncVariant(variantId);
        }
      });
    });

    // Color Swatches Selection
    swatches.forEach((swatch) => {
      swatch.addEventListener('click', (e) => {
        e.preventDefault();
        swatches.forEach((s) => {
          s.classList.remove('is-active');
          s.setAttribute('aria-pressed', 'false');
        });
        swatch.classList.add('is-active');
        swatch.setAttribute('aria-pressed', 'true');

        if (selectedColorLabel && swatch.dataset.colorName) {
          selectedColorLabel.textContent = swatch.dataset.colorName;
        }

        const variantId = swatch.dataset.variantId;
        if (variantId) {
          syncVariant(variantId);
        }

        const mediaId = swatch.dataset.mediaId;
        if (mediaId) {
          goToMediaId(mediaId);
        }
      });
    });

    // Tabs Switching
    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const target = tab.dataset.pfTab;
        if (!target) return;

        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        panes.forEach((pane) => {
          const active = pane.dataset.pfPane === target;
          pane.classList.toggle('is-active', active);
          if (active) {
            pane.removeAttribute('hidden');
          } else {
            pane.setAttribute('hidden', '');
          }
        });
      });
    });

    // Size Guide Modal Open / Close
    const openSizeGuide = () => {
      if (sizeGuideModal) {
        sizeGuideModal.style.display = 'flex';
        sizeGuideModal.removeAttribute('hidden');
        requestAnimationFrame(() => {
          sizeGuideModal.classList.add('is-open');
          sizeGuideModal.setAttribute('aria-hidden', 'false');
        });
        document.body.style.overflow = 'hidden';
      }
    };

    const closeSizeGuide = () => {
      if (sizeGuideModal) {
        sizeGuideModal.classList.remove('is-open');
        sizeGuideModal.setAttribute('aria-hidden', 'true');
        setTimeout(() => {
          if (!sizeGuideModal.classList.contains('is-open')) {
            sizeGuideModal.style.display = 'none';
            sizeGuideModal.setAttribute('hidden', '');
          }
        }, 220);
        document.body.style.overflow = '';
      }
    };

    if (sizeGuideOpenBtn) {
      sizeGuideOpenBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openSizeGuide();
      });
    }

    // Size Guide Unit Switcher (IN / CM)
    const unitButtons = [...document.querySelectorAll('.pf-unit-btn')];
    const sizeTable = document.querySelector('[data-pf-size-table]');

    unitButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const unit = btn.dataset.unit;
        if (!unit || !sizeTable) return;

        unitButtons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('is-active', isActive);
          b.setAttribute('aria-checked', isActive ? 'true' : 'false');
        });
        sizeTable.dataset.activeUnit = unit;

        const cells = sizeTable.querySelectorAll('td[data-val-cm]');
        cells.forEach((cell) => {
          cell.textContent = unit === 'in' ? cell.dataset.valIn : cell.dataset.valCm;
        });
      });
    });

    modalCloseBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        closeSizeGuide();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sizeGuideModal?.classList.contains('is-open')) {
        closeSizeGuide();
      }
    });

    // Add To Bag Action
    if (addToBagBtn) {
      addToBagBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        const variantId = variantIdInput?.value || root.querySelector('[data-pf-variant-id]')?.value;
        if (!variantId || addToBagBtn.disabled) return;

        const originalText = addTextEl ? addTextEl.textContent : 'ADD TO BAG';
        addToBagBtn.disabled = true;
        if (addTextEl) addTextEl.textContent = 'ADDING...';

        try {
          const cartItemsComponents = document.querySelectorAll('cart-items-component');
          const sectionIds = [];
          cartItemsComponents.forEach((item) => {
            if (item.dataset.sectionId && !sectionIds.includes(item.dataset.sectionId)) {
              sectionIds.push(item.dataset.sectionId);
            }
          });

          const formData = new FormData();
          formData.append('id', variantId);
          formData.append('quantity', 1);
          if (sectionIds.length > 0) {
            formData.append('sections', sectionIds.join(','));
            formData.append('sections_url', window.location.pathname);
          }

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
          });

          if (!response.ok) throw new Error('Add to cart failed');
          const addData = await response.json();

          const cartResponse = await fetch('/cart.js');
          const cartData = await cartResponse.json();

          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: {
              resource: cartData,
              sourceId: 'pf-product-template',
              data: {
                itemCount: cartData.item_count,
                sections: addData.sections
              }
            }
          }));

          const cartDrawer = document.querySelector('cart-drawer, #cart-drawer, [data-cart-drawer], cart-drawer-component');
          if (cartDrawer && typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          } else {
            window.location.href = window.Shopify?.routes?.root ? `${window.Shopify.routes.root}cart` : '/cart';
          }

          if (addTextEl) addTextEl.textContent = 'ADDED!';
          setTimeout(() => {
            if (addTextEl) addTextEl.textContent = originalText;
            addToBagBtn.disabled = false;
          }, 1500);
        } catch (err) {
          if (addTextEl) addTextEl.textContent = 'TRY AGAIN';
          setTimeout(() => {
            if (addTextEl) addTextEl.textContent = originalText;
            addToBagBtn.disabled = false;
          }, 1500);
        }
      });
    }

    // Buy Now Action
    const handleBuyNow = (btn) => {
      const variantId = variantIdInput?.value || root.querySelector('[data-pf-variant-id]')?.value;
      if (!variantId || (btn && btn.disabled)) return;

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'REDIRECTING...';
      }

      const rootUrl = window.Shopify?.routes?.root || '/';
      const cleanRoot = rootUrl.endsWith('/') ? rootUrl : rootUrl + '/';
      window.location.href = `${cleanRoot}cart/${variantId}:1`;
    };

    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', (e) => {
        e.preventDefault();
        handleBuyNow(buyNowBtn);
      });
    }

    if (stickyBuyBtn) {
      stickyBuyBtn.addEventListener('click', (e) => {
        e.preventDefault();
        handleBuyNow(stickyBuyBtn);
      });
    }

    if (stickyAddBtn) {
      stickyAddBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (addToBagBtn) addToBagBtn.click();
      });
    }

    // Share Button Event Listener (Web Share API / Clipboard fallback)
    const shareBtn = root.querySelector('[data-share-btn]');
    if (shareBtn) {
      shareBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        const shareData = {
          title: document.title,
          text: 'Check out this luxury fragrance from Balad Perfumes!',
          url: window.location.href
        };
        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (err) {}
        } else if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const origContent = shareBtn.innerHTML;
            shareBtn.innerHTML = '<span style="font-size: 11px; font-weight: 700; color: #b8860b;">Copied!</span>';
            setTimeout(() => { shareBtn.innerHTML = origContent; }, 2000);
          } catch (err) {}
        }
      });
    }

    // Carousel slides & navigation
    const setActive = (index) => {
      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle('is-active', dotIndex === index);
      });

      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === index);
        slide.setAttribute('aria-hidden', slideIndex === index ? 'false' : 'true');
      });
    };

    const goToSlide = (index) => {
      const slide = slides[index];
      if (!slide) return;
      if (window.innerWidth >= 990) {
        slide.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else if (slidesRail) {
        const targetLeft = slide.offsetLeft - (slidesRail.clientWidth - slide.clientWidth) / 2;
        slidesRail.scrollTo({
          left: Math.max(0, targetLeft),
          behavior: 'smooth'
        });
      }
      setActive(index);
    };

    const goToMediaId = (mediaId) => {
      if (!mediaId) return;
      const index = slides.findIndex((slide) => slide.dataset.mediaId === String(mediaId));
      if (index >= 0) {
        goToSlide(index);
      }
    };

    const getNearestIndex = () => {
      const rail = slidesRail || gallery;
      if (!rail) return 0;
      const rect = rail.getBoundingClientRect();
      const railCenter = rect.left + rect.width / 2;
      let bestIndex = 0;
      let bestDistance = Infinity;

      slides.forEach((slide, index) => {
        const slideRect = slide.getBoundingClientRect();
        const slideCenter = slideRect.left + slideRect.width / 2;
        const distance = Math.abs(slideCenter - railCenter);
        if (distance < bestDistance) {
          bestDistance = distance;
          bestIndex = index;
        }
      });

      return bestIndex;
    };

    if (slidesRail && slides.length) {
      let raf = 0;
      slidesRail.addEventListener('scroll', () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => setActive(getNearestIndex()));
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => goToSlide(index));
      });

      navPrev?.addEventListener('click', () => {
        const current = slides.findIndex((s) => s.classList.contains('is-active'));
        goToSlide(Math.max(0, current - 1));
      });

      navNext?.addEventListener('click', () => {
        const current = slides.findIndex((s) => s.classList.contains('is-active'));
        goToSlide(Math.min(slides.length - 1, current + 1));
      });

      setActive(0);
    }

    // Related & Reallife carousel handlers
    const relatedTrack = root.querySelector('[data-pf-related-track]');
    const relatedPrev = root.querySelector('[data-pf-related-prev]');
    const relatedNext = root.querySelector('[data-pf-related-next]');

    if (relatedTrack && relatedPrev && relatedNext) {
      const getRelatedStep = () => {
        const firstCard = relatedTrack.querySelector('.pf-product-template__related-card');
        if (!firstCard) return relatedTrack.clientWidth;
        const gap = parseFloat(window.getComputedStyle(relatedTrack).columnGap || 0);
        return firstCard.getBoundingClientRect().width + gap;
      };

      const updateRelatedControls = () => {
        const maxScroll = relatedTrack.scrollWidth - relatedTrack.clientWidth;
        const canScroll = maxScroll > 1;
        relatedPrev.disabled = !canScroll || relatedTrack.scrollLeft <= 1;
        relatedNext.disabled = !canScroll || relatedTrack.scrollLeft >= maxScroll - 1;
      };

      relatedPrev.addEventListener('click', () => {
        relatedTrack.scrollBy({ left: -getRelatedStep(), behavior: 'smooth' });
      });

      relatedNext.addEventListener('click', () => {
        relatedTrack.scrollBy({ left: getRelatedStep(), behavior: 'smooth' });
      });

      let relatedRaf = 0;
      relatedTrack.addEventListener('scroll', () => {
        cancelAnimationFrame(relatedRaf);
        relatedRaf = requestAnimationFrame(updateRelatedControls);
      });

      window.addEventListener('resize', updateRelatedControls);
      updateRelatedControls();
    }

    // Sticky Bar Interactions (Desktop Only)
    const stickyWishlistBtn = root.querySelector('[data-pf-sticky-wishlist]');

    if (stickyBar) {
      // Sync wishlist bookmark button states
      const syncAllWishlistStates = () => {
        try {
          const list = JSON.parse(localStorage.getItem('wishlist') || '[]');
          const currentHandle = root.dataset.productHandle || '{{ selected_product.handle }}';
          const isSaved = list.some((i) => i.handle === currentHandle);
          if (wishlist) {
            wishlist.setAttribute('aria-pressed', isSaved.toString());
            wishlist.classList.toggle('is-saved', isSaved);
            wishlist.classList.toggle('is-active', isSaved);
          }
          if (stickyWishlistBtn) {
            stickyWishlistBtn.setAttribute('aria-pressed', isSaved.toString());
            stickyWishlistBtn.classList.toggle('is-saved', isSaved);
            stickyWishlistBtn.classList.toggle('is-active', isSaved);
          }
        } catch (err) {}
      };

      document.addEventListener('wishlist:update', syncAllWishlistStates);
      syncAllWishlistStates();

      // Sticky size buttons click handler
      stickySizes.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetSize = btn.dataset.pfStickySize;
          const matchingPill = sizePills.find((p) => {
            const pillSize = (p.dataset.pfSizePill || p.textContent || '').trim().toLowerCase();
            return pillSize === targetSize.trim().toLowerCase();
          });
          if (matchingPill) {
            matchingPill.click();
          }
        });
      });

      // Delegate sticky add/buy to main buttons
      stickyAddBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        addToBagBtn?.click();
      });

      stickyBuyBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        buyNowBtn?.click();
      });

      // Sticky bar show/hide scroll controller for Mobile Responsive Only
      let stickyTicking = false;

      const updateStickyVisibility = () => {
        const isMobile = window.innerWidth <= 1024;
        if (!isMobile) {
          stickyBar.removeAttribute('data-visible');
          stickyBar.removeAttribute('data-mobile-visible');
          stickyBar.setAttribute('aria-hidden', 'true');
          stickyTicking = false;
          return;
        }

        const currentY = window.scrollY;
        // On mobile, show sticky bar when mobile nav is hidden AND past top scroll threshold
        const isNavHidden =
          document.body.getAttribute('data-mobile-nav-hidden') === 'true' ||
          document.getElementById('stagmenfashion-mobile-nav')?.getAttribute('data-hidden') === 'true';

        if (isNavHidden && currentY > 90) {
          stickyBar.setAttribute('data-mobile-visible', 'true');
          stickyBar.setAttribute('aria-hidden', 'false');
        } else {
          stickyBar.removeAttribute('data-mobile-visible');
          stickyBar.setAttribute('aria-hidden', 'true');
        }

        stickyTicking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!stickyTicking) {
            window.requestAnimationFrame(updateStickyVisibility);
            stickyTicking = true;
          }
        },
        { passive: true }
      );

      window.addEventListener('mobilenav:toggle', (e) => {
        if (window.innerWidth <= 1024) {
          if (e.detail?.hidden && window.scrollY > 90) {
            stickyBar.setAttribute('data-mobile-visible', 'true');
            stickyBar.setAttribute('aria-hidden', 'false');
          } else {
            stickyBar.removeAttribute('data-mobile-visible');
            stickyBar.setAttribute('aria-hidden', 'true');
          }
        }
      });

      window.addEventListener('resize', updateStickyVisibility, { passive: true });
      updateStickyVisibility();
    }

    // Pre-select size from URL query param ?size=... or from saved wishlist item
    const preselectSavedSize = () => {
      const urlParams = new URLSearchParams(window.location.search);
      let targetSize = urlParams.get('size');

      if (!targetSize) {
        try {
          const currentHandle = root.dataset.productHandle || window.location.pathname.split('/products/')[1]?.split('?')[0];
          const list = JSON.parse(localStorage.getItem('wishlist') || '[]');
          const item = list.find((i) => i.handle === currentHandle);
          if (item && item.size && item.size !== 'Default') {
            targetSize = item.size;
          }
        } catch (err) {}
      }

      if (targetSize && sizePills.length > 0) {
        const matchingPill = sizePills.find((p) => {
          const pillSize = (p.dataset.pfSizePill || p.textContent || '').trim().toLowerCase();
          return pillSize === targetSize.trim().toLowerCase();
        });

        if (matchingPill) {
          matchingPill.click();
        }
      }
    };

    // Write a Review Modal & Rating Logic
    const reviewOpenBtns = document.querySelectorAll('[data-pf-reviews-open]');
    const reviewModal = document.getElementById('pf-review-modal');
    const reviewModalCloseBtns = document.querySelectorAll('[data-pf-review-modal-close]');
    const starBtns = document.querySelectorAll('.pf-star-btn');
    const starRatingVal = document.getElementById('pf-review-rating-val');
    const reviewForm = document.getElementById('pf-review-form');
    const reviewSuccess = document.getElementById('pf-review-success');
    const customReviewsList = document.querySelector('[data-pf-custom-reviews-list]');

    const escapeHtml = (str) => {
      return String(str).replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
      );
    };

    reviewOpenBtns.forEach((reviewOpenBtn) => reviewOpenBtn.addEventListener('click', () => {
      const reviewWidget = document.querySelector('.pf-product-template__reviews-widget');
      if (!reviewWidget) return;

      reviewWidget.scrollIntoView({ behavior: 'smooth', block: 'start' });
      let attempts = 0;
      const openJudgeMeForm = () => {
        const judgeMeWriteButton = reviewWidget.querySelector('.jdgm-write-rev-link, .jdgm-rev-widg__write-rev-btn, .jdgm-write-rev-btn');
        if (judgeMeWriteButton) {
          judgeMeWriteButton.click();
          return;
        }
        if (attempts < 15) {
          attempts += 1;
          window.setTimeout(openJudgeMeForm, 200);
        }
      };
      window.setTimeout(openJudgeMeForm, 300);
    }));

    if (reviewOpenBtns.length && reviewModal) {
      reviewOpenBtns.forEach((reviewOpenBtn) => reviewOpenBtn.addEventListener('click', () => {
        const jdgmWriteBtn = document.querySelector('.jdgm-write-rev-link, .jdgm-rev-widg__write-rev-btn');
        if (jdgmWriteBtn) {
          jdgmWriteBtn.click();
        } else {
          reviewModal.classList.add('is-active');
          reviewModal.setAttribute('aria-hidden', 'false');
        }
      }));

      reviewModalCloseBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          reviewModal.classList.remove('is-active');
          reviewModal.setAttribute('aria-hidden', 'true');
        });
      });

      starBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = parseInt(btn.dataset.value, 10);
          if (starRatingVal) starRatingVal.value = val;
          starBtns.forEach((s, idx) => {
            if (idx < val) {
              s.classList.add('is-active');
              s.style.color = '#ffb400';
            } else {
              s.classList.remove('is-active');
              s.style.color = '#ddd';
            }
          });
        });
      });

      if (reviewForm) {
        reviewForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const formData = new FormData(reviewForm);
          const name = formData.get('name') || 'Customer';
          const title = formData.get('title') || 'Verified Review';
          const body = formData.get('body') || '';
          const ratingNum = parseInt(formData.get('rating') || '5', 10);
          const starsStr = '★'.repeat(ratingNum) + '☆'.repeat(5 - ratingNum);

          if (customReviewsList) {
            const newCard = document.createElement('div');
            newCard.className = 'pf-review-card';
            newCard.innerHTML = `
              <div class="pf-review-card__header">
                <div class="pf-review-card__stars">${starsStr}</div>
                <span class="pf-review-card__badge">✓ Pending Verification</span>
              </div>
              <h4 class="pf-review-card__title">${escapeHtml(title)}</h4>
              <p class="pf-review-card__body">${escapeHtml(body)}</p>
              <div class="pf-review-card__meta">
                <span class="pf-review-card__author">${escapeHtml(name)}</span>
                <span class="pf-review-card__date">• Just now</span>
              </div>
            `;
            customReviewsList.prepend(newCard);
          }

          if (reviewSuccess) {
            reviewSuccess.style.display = 'block';
          }

          setTimeout(() => {
            reviewForm.reset();
            if (reviewSuccess) reviewSuccess.style.display = 'none';
            reviewModal.classList.remove('is-active');
            reviewModal.setAttribute('aria-hidden', 'true');
          }, 2000);
        });
      }
    }

    preselectSavedSize();
  })();
{% endjavascript %}

