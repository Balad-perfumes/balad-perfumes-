{% liquid
  assign selected_product = product
  assign current_variant = selected_product.selected_or_first_available_variant
  assign form_id = 'StagProductForm-' | append: section.id
  assign review_count = selected_product.metafields.reviews.rating_count.value | default: selected_product.metafields.reviews.rating_count | default: 0 | plus: 0

  # Rating from Judge.me / Shopify metafields
  assign review_rating = blank
  if selected_product.metafields.reviews.rating.value != blank
    assign review_rating = selected_product.metafields.reviews.rating.value.rating | default: selected_product.metafields.reviews.rating.value | plus: 0
  endif

  assign jm_badge = selected_product.metafields.judgeme.badge
  if jm_badge != blank
    if review_rating == blank or review_rating == 0
      if jm_badge contains "data-average-rating='"
        assign review_rating = jm_badge | split: "data-average-rating='" | last | split: "'" | first | plus: 0
      endif
    endif
    if review_count == 0 and jm_badge contains "data-number-of-reviews='"
      assign review_count = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
    endif
  endif

  if review_rating == blank or review_rating == 0
    if selected_product.metafields.judgeme.rating != blank
      assign review_rating = selected_product.metafields.judgeme.rating | plus: 0
    endif
  endif
  if review_count == 0 and selected_product.metafields.judgeme.review_count != blank
    assign review_count = selected_product.metafields.judgeme.review_count | plus: 0
  endif
  if review_rating != blank and review_rating > 0
    assign review_rating = review_rating | round: 1
  endif

  # Star fill width (rating out of 5, as a percentage)
  assign rating_pct = 0
  if review_rating != blank and review_rating > 0
    assign rating_pct = review_rating | times: 20 | at_most: 100
  endif
  assign has_reviews = false
  if review_count > 0 and rating_pct > 0
    assign has_reviews = true
  endif

  # Optional hero image from metafields
  assign metafield_image = selected_product.metafields.custom.sticky_product_image.value | default: selected_product.metafields.custom.sticky_product_image
  if metafield_image == blank
    assign metafield_image = selected_product.metafields.custom.sticky_image.value | default: selected_product.metafields.custom.sticky_image
  endif
  if metafield_image == blank
    assign metafield_image = selected_product.metafields.custom.product_image.value | default: selected_product.metafields.custom.product_image
  endif
  if metafield_image == blank
    assign metafield_image = selected_product.metafields.custom.main_image.value | default: selected_product.metafields.custom.main_image
  endif

  assign show_meta_slide = false
  if metafield_image != blank
    assign show_meta_slide = true
    if selected_product.media.size > 0 and metafield_image.id == selected_product.media.first.id
      assign show_meta_slide = false
    endif
  endif

  assign gallery_total = selected_product.media.size
  if show_meta_slide
    assign gallery_total = gallery_total | plus: 1
  endif

  # Size option
  assign size_option = blank
  assign size_option_index = 0
  unless selected_product.has_only_default_variant
    for product_option in selected_product.options_with_values
      assign option_name_downcase = product_option.name | downcase
      if option_name_downcase contains 'size'
        assign size_option = product_option
        assign size_option_index = forloop.index0
      endif
    endfor
  endunless

  # Selected size text (shown in "At a glance" and above the size buttons)
  assign selected_size_label = current_variant.title
  if size_option != blank
    assign selected_size_label = current_variant.options[size_option_index]
  endif

  # Discount
  assign has_discount = false
  assign pct_off = 0
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign pct_off = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  # Fragrance notes (from tags)
  assign tags_str = selected_product.tags | join: ' ' | downcase
  assign notes_line = blank
  if tags_str contains 'oriental' or tags_str contains 'floral'
    assign notes_line = 'Oriental|Floral Musky|Citrus Floral'
  elsif tags_str contains 'woody'
    assign notes_line = 'Woody|Amber Spice|Fresh Cedar'
  elsif tags_str contains 'fresh'
    assign notes_line = 'Fresh Citrus|Aquatic|Green Notes'
  endif
  assign notes_list = notes_line | split: '|'
%}


<section class="pf-product-template color-{{ section.settings.color_scheme }} product-{{ selected_product.handle }}" data-pf-product data-product-handle="{{ selected_product.handle }}">
  <div class="pf-product-template__shell">

    <!-- ═════════ GALLERY ═════════ -->
    <div class="pf-product-template__media" data-pf-media>
      <div class="pdp-gallery{% if gallery_total <= 1 %} is-single{% endif %}" data-pf-gallery>

        {%- if gallery_total > 1 -%}
          <div class="pdp-gallery__thumbs" aria-label="Product image thumbnails">
            <div class="pdp-gallery__thumbs-track" data-pf-thumbs>
              {%- assign thumb_index = 0 -%}
              {%- if show_meta_slide -%}
                <button type="button" class="pdp-thumb is-active" data-pf-thumb data-slide-index="0" aria-label="Show image 1" aria-current="true">
                  {{ metafield_image | image_url: width: 200 | image_tag: class: 'pdp-thumb__img', widths: '100, 200', sizes: '84px', loading: 'lazy', alt: '' }}
                </button>
                {%- assign thumb_index = 1 -%}
              {%- endif -%}
              {%- for media in selected_product.media -%}
                {%- assign this_index = forloop.index0 | plus: thumb_index -%}
                {%- assign thumb_src = media.preview_image | default: media -%}
                <button type="button"
                  class="pdp-thumb{% if this_index == 0 %} is-active{% endif %}{% if media.media_type == 'video' or media.media_type == 'external_video' %} is-video{% endif %}"
                  data-pf-thumb data-slide-index="{{ this_index }}" data-media-id="{{ media.id }}"
                  aria-label="Show image {{ this_index | plus: 1 }}"
                  aria-current="{% if this_index == 0 %}true{% else %}false{% endif %}">
                  {{ thumb_src | image_url: width: 200 | image_tag: class: 'pdp-thumb__img', widths: '100, 200', sizes: '84px', loading: 'lazy', alt: '' }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Frame keeps the discount badge fixed while the stage scrolls sideways on mobile -->
        <div class="pdp-gallery__frame">
          <div class="pdp-gallery__stage" data-pf-stage data-pf-slides style="--pdp-rows: {{ gallery_total | minus: 1 | at_least: 1 }}">
            {%- assign slide_offset = 0 -%}
            {%- if show_meta_slide -%}
              <article class="pdp-slide is-active" data-pf-slide data-slide-index="0" aria-hidden="false">
                {{ metafield_image | image_url: width: 1800 | image_tag: class: 'pdp-slide__media', widths: '640, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: metafield_image.alt | default: selected_product.title }}
              </article>
              {%- assign slide_offset = 1 -%}
            {%- endif -%}

            {%- for media in selected_product.media -%}
              {%- assign this_index = forloop.index0 | plus: slide_offset -%}
              <article class="pdp-slide{% if this_index == 0 %} is-active{% endif %}" data-pf-slide data-slide-index="{{ this_index }}" data-media-id="{{ media.id }}" aria-hidden="{% if this_index == 0 %}false{% else %}true{% endif %}">
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    assign fetchpriority = 'auto'
                    if this_index == 0
                      assign loading = 'eager'
                      assign fetchpriority = 'high'
                    endif
                  -%}
                  {{ media | image_url: width: 1800 | image_tag: class: 'pdp-slide__media', widths: '640, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: loading, fetchpriority: fetchpriority, alt: media.alt | default: selected_product.title }}
                {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                  {% render 'video', video: media, video_class: 'pdp-slide__media pf-product-template__video', video_loop: true, disable_controls: true, loading: 'lazy' %}
                {%- else -%}
                  {{ media | media_tag }}
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>

          {%- if has_discount -%}
            <span class="pdp-gallery__badge">{{ pct_off }}% off</span>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- ═════════ INFO ═════════ -->
    <div class="pf-product-template__content">
      <div class="pdp-info pdp-info--v2">
        <!-- Breadcrumb (small line above the main card) -->
        <div class="pdp-topbar pdp-topbar--panel">
            <nav class="pdp-crumbs" aria-label="Breadcrumb">
              <a href="{{ routes.root_url }}">Home</a>
              <span aria-hidden="true">/</span>
              <a href="{{ routes.all_products_collection_url }}">All Products</a>
              <span aria-hidden="true">/</span>
              <span class="pdp-crumbs__current" aria-current="page">{{ selected_product.title }}</span>
            </nav>
        </div>

        <!-- Main card: stock/rating, name, price, size and buy buttons (all above the fold) -->
        <section class="pdp-sc pdp-sc--intro pdp-sc--main pdp-mc">
        {%- liquid
          assign save_amt = 0
          if has_discount
            assign save_amt = current_variant.compare_at_price | minus: current_variant.price
          endif
        -%}

        <!-- Zone 1: identity + price (tinted header) -->
        <header class="pdp-head pdp-mc__head">
          <div class="pdp-mc__top">
            {%- if selected_product.vendor != blank or selected_product.type != blank -%}
              <p class="pdp-eyebrow pdp-mc__eyebrow">{{ selected_product.type | default: selected_product.vendor | escape }}</p>
            {%- endif -%}
            <button type="button" class="pdp-share pdp-mc__share" data-share-btn aria-label="Share product">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="14" height="14" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>

          <h1 class="pdp-title pdp-hd__title">{{ selected_product.title }}</h1>

          <div class="pdp-hd__price">
            <span class="pdp-hd__now" data-pf-price-main>{% render 'format-price', price: current_variant.price %}</span>
            <span class="pdp-hd__was" data-pf-compare-price{% unless has_discount %} hidden{% endunless %}>{% if has_discount %}{% render 'format-price', price: current_variant.compare_at_price %}{% endif %}</span>
            <span class="pdp-hd__off" data-pf-off-badge{% unless has_discount %} hidden{% endunless %}>{{ pct_off }}% OFF</span>
          </div>
          <div class="pdp-hd__sub">
            <p class="pdp-hd__save" data-pf-save{% unless has_discount %} hidden{% endunless %}>You save <strong data-pf-save-amount>{% if has_discount %}{% render 'format-price', price: save_amt %}{% endif %}</strong></p>
            <span class="pdp-hd__tax">Inclusive of all taxes</span>
          </div>
        </header>

        <!-- Zone 2: key facts -->
        <ul class="pdp-hd__facts">
            <li>
              <small><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v3M14 3v3"/><rect x="5" y="6" width="14" height="15" rx="3"/><path d="M9 12h6"/></svg>Type</small>
              <strong>Eau de Parfum</strong>
            </li>
            <li>
              <small><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Lasts</small>
              <strong>6&ndash;8 hours</strong>
            </li>
            {%- unless selected_product.has_only_default_variant -%}
              <li>
                <small><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z"/></svg>Size</small>
                <strong data-pf-glance-size>{{ selected_size_label }}</strong>
              </li>
            {%- endunless -%}
          </ul>

        <!-- Savings, real low-stock and offer line -->
        {%- liquid
          assign inv_map = ''
          for v in selected_product.variants
            if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
              assign inv_map = inv_map | append: v.id | append: ':' | append: v.inventory_quantity | append: ','
            endif
          endfor
          assign low_threshold = section.settings.low_stock_threshold
          assign cur_qty = 0
          if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
            assign cur_qty = current_variant.inventory_quantity
          endif
          assign show_low = false
          if cur_qty > 0 and cur_qty <= low_threshold
            assign show_low = true
          endif
          assign hurry_pct = 0
          if show_low and low_threshold > 0
            assign hurry_pct = cur_qty | times: 100.0 | divided_by: low_threshold | round | at_least: 8 | at_most: 100
          endif
        -%}

        <!-- Size & buy -->
        <div class="pdp-buy">
        <div class="pdp-nudges" data-pf-nudges{% if section.settings.offer_text == blank %} hidden{% endif %}>
          {%- if section.settings.offer_text != blank -%}
            <p class="pdp-offer">{{ section.settings.offer_text | escape }}</p>
          {%- endif -%}
        </div>

        <!-- Size -->
        {%- if size_option != blank and size_option.values.size > 0 -%}
          <div class="pdp-option">
            <span class="pdp-option__label">Select Size: <strong data-pf-selected-size>{{ selected_size_label }}</strong></span>
            <div class="pdp-sizes" data-pf-size-selector>
              {%- for val in size_option.values -%}
                {%- liquid
                  assign val_name = val.name | default: val
                  assign val_lower = val_name | downcase
                -%}
                {%- unless val_lower contains 'personal' or val_lower contains 'custom' -%}
                  {%- liquid
                    assign size_variant = blank
                    for v in selected_product.variants
                      if v.option1 == val_name or v.option2 == val_name or v.option3 == val_name
                        assign size_variant = v
                        break
                      endif
                    endfor
                    assign is_selected = false
                    if current_variant != blank and size_variant != blank and current_variant.id == size_variant.id
                      assign is_selected = true
                    elsif forloop.first
                      assign is_selected = true
                    endif
                    assign sv = size_variant | default: current_variant
                  -%}
                  <button type="button" class="pdp-size{% if is_selected %} is-active{% endif %}{% unless sv.available %} is-out{% endunless %}" data-pf-size-pill data-value="{{ val_name | escape }}" data-variant-id="{{ size_variant.id | default: current_variant.id }}" aria-label="Size {{ val_name }}{% unless sv.available %}, sold out{% endunless %}" aria-pressed="{% if is_selected %}true{% else %}false{% endif %}">{{ val_name }}</button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- elsif selected_product.has_only_default_variant == false and selected_product.variants.size > 1 -%}
          <div class="pdp-option">
            <span class="pdp-option__label">Select Size: <strong data-pf-selected-size>{{ selected_size_label }}</strong></span>
            <div class="pdp-sizes" data-pf-size-selector>
              {%- for variant in selected_product.variants -%}
                {%- assign v_lower = variant.title | downcase -%}
                {%- unless v_lower contains 'personal' or v_lower contains 'custom' -%}
                  <button type="button" class="pdp-size{% if variant.id == current_variant.id %} is-active{% endif %}{% unless variant.available %} is-out{% endunless %}" data-pf-size-pill data-value="{{ variant.title | escape }}" data-variant-id="{{ variant.id }}" aria-label="{{ variant.title }}{% unless variant.available %}, sold out{% endunless %}" aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}">{{ variant.title }}</button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- liquid
          assign eta_dispatch = section.settings.dispatch_days | default: 0
          assign eta_min = section.settings.delivery_min_days | default: 3
          assign eta_max = section.settings.delivery_max_days | default: 7
          assign eta_min_secs = eta_dispatch | plus: eta_min | times: 86400
          assign eta_max_secs = eta_dispatch | plus: eta_max | times: 86400
          assign now_secs = 'now' | date: '%s' | plus: 0
          assign eta_min_date = now_secs | plus: eta_min_secs | date: '%a, %-d %b'
          assign eta_max_date = now_secs | plus: eta_max_secs | date: '%a, %-d %b'
          assign eta_min_month = now_secs | plus: eta_min_secs | date: '%b'
          assign eta_max_month = now_secs | plus: eta_max_secs | date: '%b'
          assign eta_min_day = now_secs | plus: eta_min_secs | date: '%-d'
          assign eta_max_short = now_secs | plus: eta_max_secs | date: '%-d %b'
          if eta_min_month == eta_max_month
            assign eta_short_range = eta_min_day | append: '–' | append: eta_max_short
          else
            assign eta_short_range = now_secs | plus: eta_min_secs | date: '%-d %b' | append: ' – ' | append: eta_max_short
          endif
        -%}

        <!-- Hurry up: driven by real Shopify inventory, only shows when stock is genuinely low -->
        <div class="pdp-hurry" data-pf-lowstock data-threshold="{{ low_threshold }}" data-inv="{{ inv_map }}" style="--pdp-hurry: {{ hurry_pct }}%"{% unless show_low %} hidden{% endunless %}>
          <div class="pdp-hurry__top">
            <span class="pdp-hurry__title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.2 1 2 2 2.5C11 8 11 5 12 3z"/></svg>
              <span>Hurry, only <strong data-pf-lowstock-qty>{% if show_low %}{{ cur_qty }}{% endif %}</strong> left in stock</span>
            </span>
            <span class="pdp-hurry__tag">Selling fast</span>
          </div>
          <div class="pdp-hurry__bar" role="presentation"><span class="pdp-hurry__fill"></span></div>
          <p class="pdp-hurry__sub">Once this batch is gone, restocking may take a few weeks.</p>
        </div>

        <!-- Actions -->
        {%- form 'product', selected_product, id: form_id, class: 'pdp-form', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pf-variant-id>
          <input type="hidden" name="quantity" value="1" data-pf-qty-field>
          <div class="pdp-actions">
            <button type="button" class="pdp-btn pdp-btn--add" data-pf-add-to-bag {% unless current_variant.available %}disabled{% endunless %}>
              <span data-pf-add-text>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
            </button>
            <button type="button" class="pdp-btn pdp-btn--buy" data-pf-buy-now {% unless current_variant.available %}disabled{% endunless %}>
              <span data-pf-buy-label>Buy now</span>
              {% render 'balad-pay-icons-stack', size: 16 %}
            </button>
          </div>
        {%- endform -%}

        <!-- Delivery promise (quick summary; full details in the Delivery card) -->
        <ul class="pdp-promise">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span><strong>{% if section.settings.show_freeship %}Free delivery{% else %}Fast delivery{% endif %}</strong><small data-pf-promise-range data-dispatch="{{ eta_dispatch }}" data-min="{{ eta_min }}" data-max="{{ eta_max }}">Arrives {{ eta_short_range }}</small></span>
          </li>
          {%- if section.settings.show_cod -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>
              <span><strong>Cash on delivery</strong><small>Pay when it arrives</small></span>
            </li>
          {%- endif -%}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            <span><strong>100% authentic</strong><small>Sealed &amp; genuine</small></span>
          </li>
        </ul>

        <!-- Payment icons & guaranteed safe checkout under Buy Now button -->
        {%- if section.settings.show_secure_pay -%}
          <div class="pdp-payment-methods">
            <div class="pdp-payment-methods__inner">
              <p class="pdp-payment-methods__sub">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <span>100% secure payments</span>
              </p>
              <div class="pdp-payment-methods__badges" aria-label="Accepted payment methods">
                {% render 'payment-icons' %}
              </div>
            </div>
          </div>
        {%- endif -%}
        </div>
        </section>

        <!-- 4. Fragrance profile -->
        <section class="pdp-sc pdp-sc--profile">
          <p class="pdp-sc__label">Fragrance profile</p>
          {%- if notes_list.size > 0 -%}
            <ul class="pdp-notes" aria-label="Fragrance notes">
              {%- for note in notes_list -%}
                <li>{{ note | escape }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- assign pdp_excerpt = selected_product.description | strip_html | strip -%}
        {%- assign pdp_excerpt = pdp_excerpt | replace: 'Ahmed Al Maghribi Bin Shaikh', selected_product.title -%}
        {%- assign pdp_excerpt = pdp_excerpt | replace: 'Ahmed Al Maghribi', 'Balad Perfumes' | truncatewords: 32 -%}
        {%- if pdp_excerpt != blank -%}
          <p class="pdp-excerpt">{{ pdp_excerpt }}</p>
        {%- else -%}
          <p class="pdp-excerpt">Experience the beauty of <strong>{{ selected_product.title }}</strong>, a luxury fragrance crafted with fine concentrated oils, luminous florals, and warm amber notes. Sophisticated, elegant, and long-lasting.</p>
        {%- endif -%}
        </section>

        <!-- 6. Delivery & trust -->
        <section class="pdp-sc pdp-perks">
          <p class="pdp-sc__label">Delivery &amp; trust</p>
        {%- if section.settings.show_freeship -%}
          <div class="pdp-freeship" role="note">
            <span class="pdp-freeship__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            <span class="pdp-freeship__text">
              <strong>{{ section.settings.freeship_text | default: 'Free delivery across India' | escape }}</strong>
              {%- if section.settings.freeship_sub != blank -%}
                <span>{{ section.settings.freeship_sub | escape }}</span>
              {%- endif -%}
              <span class="pdp-freeship__eta" data-pf-delivery
                data-dispatch="{{ section.settings.dispatch_days | default: 0 }}"
                data-min="{{ section.settings.delivery_min_days | default: 3 }}"
                data-max="{{ section.settings.delivery_max_days | default: 7 }}"
                {% unless current_variant.available %}hidden{% endunless %}>
                Estimated delivery: <b data-pf-delivery-range>{{ eta_min_date }} to {{ eta_max_date }}</b>
              </span>
            </span>
          </div>
        {%- endif -%}

        {%- unless section.settings.show_freeship -%}
          <div class="pdp-meta-row">
            <p class="pdp-delivery" data-pf-delivery
               data-dispatch="{{ section.settings.dispatch_days | default: 0 }}"
               data-min="{{ section.settings.delivery_min_days | default: 3 }}"
               data-max="{{ section.settings.delivery_max_days | default: 7 }}"
               {% unless current_variant.available %}hidden{% endunless %}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span class="pdp-meta__text"><small>Estimated delivery</small><strong data-pf-delivery-range>{{ eta_min_date }} to {{ eta_max_date }}</strong></span>
            </p>
          </div>
        {%- endunless -%}

        <!-- Purchase assurance (edit in the theme editor) -->
        {%- if section.settings.show_cod or section.settings.shipping_note != blank or section.settings.returns_note != blank -%}
          <ul class="pdp-assure">
            {%- if section.settings.show_cod -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg><span>Cash on Delivery available</span></li>
            {%- endif -%}
            {%- if section.settings.shipping_note != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg><span>{{ section.settings.shipping_note | escape }}</span></li>
            {%- endif -%}
            {%- if section.settings.returns_note != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg><span>{{ section.settings.returns_note | escape }}</span></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

          <ul class="pdp-trust">
          <li class="pdp-trust__item">
            <span class="pdp-trust__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/></svg>
            </span>
            <span class="pdp-trust__text">
              <strong>Farm to fragrance</strong>
              <small>Fine natural oils</small>
            </span>
          </li>
          <li class="pdp-trust__item">
            <span class="pdp-trust__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            </span>
            <span class="pdp-trust__text">
              <strong>100% authentic</strong>
              <small>Sealed and genuine</small>
            </span>
          </li>
          <li class="pdp-trust__item">
            <span class="pdp-trust__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            <span class="pdp-trust__text">
              <strong>Express shipping</strong>
              <small>Tracked to your door</small>
            </span>
          </li>
        </ul>
        </section>

        <!-- 7. Product details -->
        <section class="pdp-sc pdp-sc--info">
          <p class="pdp-sc__label">Product details</p>
        <div class="pf-accordions">
          <details class="pf-accordion-item" name="pdp-info">
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Description</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body rte">
              {% assign clean_desc = selected_product.description | strip_html | strip %}
              {% if clean_desc != blank %}
                {% assign formatted_desc = selected_product.description | replace: 'Ahmed Al Maghribi Bin Shaikh', selected_product.title | replace: 'Ahmed Al Maghribi', 'Balad Perfumes' %}
                {{ formatted_desc }}
              {% else %}
                <p>Experience the beauty of <strong>{{ selected_product.title }}</strong>, a luxury fragrance crafted with fine concentrated oils, luminous florals, and warm amber notes. Sophisticated, elegant, and long-lasting.</p>
              {% endif %}
            </div>
          </details>

          <details class="pf-accordion-item" name="pdp-info">
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Wear it right</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body">
              {% if selected_product.metafields.custom.wear_it_right != blank %}
                <div class="rte">{{ selected_product.metafields.custom.wear_it_right | metafield_tag }}</div>
              {% else %}
                <ul class="pf-accordion-bullets">
                  <li>Apply on moisturised skin for better longevity.</li>
                  <li>Spray on pulse points: neck, wrists and behind the ears.</li>
                  <li>Hold the bottle 15 cm away for even application.</li>
                  <li>Don't rub after spraying; let it dry naturally.</li>
                  <li>Store away from heat, sunlight and humidity.</li>
                </ul>
              {% endif %}
            </div>
          </details>

          <details class="pf-accordion-item" name="pdp-info">
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Occasion</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body">
              {% if selected_product.metafields.custom.occasion != blank %}
                <div class="rte">{{ selected_product.metafields.custom.occasion | metafield_tag }}</div>
              {% else %}
                <p>Ideal for daily signature wear, evening events, celebrations, and luxury gifting.</p>
              {% endif %}
            </div>
          </details>

          <details class="pf-accordion-item" name="pdp-info">
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Shipping</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body rte">
              {% if selected_product.metafields.custom.delivery_returns != blank %}
                {{ selected_product.metafields.custom.delivery_returns | metafield_tag }}
              {% else %}
                <p>Fast express shipping across India with real-time tracking, Cash on Delivery options, and careful protective packaging.</p>
              {% endif %}
            </div>
          </details>
        </div>

        </section>

        <button type="button" class="pf-buybox__write-review" data-pf-reviews-open>Write a review</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="VariantData-{{ section.id }}">
    {{ selected_product.variants | json }}
  </script>

  <!-- Sticky bar -->
  <div class="pf-product-template__sticky-bar" data-pf-sticky-bar aria-hidden="true">
    <button type="button" class="pf-product-template__sticky-close" data-pf-sticky-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="pf-product-template__sticky-shell">
      <div class="pf-product-template__sticky-info">
        {%- assign sticky_img = selected_product.featured_media | default: selected_product.media.first -%}
        {%- if sticky_img != blank -%}
          <div class="pf-product-template__sticky-img">
            {{ sticky_img | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '52px', loading: 'lazy', alt: selected_product.title }}
          </div>
        {%- endif -%}
        <div class="pf-product-template__sticky-text">
          <span class="pf-product-template__sticky-title">{{ selected_product.title }}</span>
          {%- assign sticky_has_variants = false -%}
          {%- unless selected_product.has_only_default_variant -%}{%- assign sticky_has_variants = true -%}{%- endunless -%}
          <span class="pf-product-template__sticky-variant" data-pf-sticky-variant{% unless sticky_has_variants %} hidden{% endunless %}>{% if sticky_has_variants %}{{ current_variant.title }}{% endif %}</span>
          <span class="pf-product-template__sticky-price-wrap">
            <span class="pf-product-template__sticky-price" data-pf-sticky-price>{% render 'format-price', price: current_variant.price %}</span>
            <span class="pf-product-template__sticky-compare-price" data-pf-sticky-compare-price{% unless has_discount %} style="display:none"{% endunless %}>{% if has_discount %}{% render 'format-price', price: current_variant.compare_at_price %}{% endif %}</span>
            <span class="pf-product-template__sticky-off" data-pf-sticky-off{% unless has_discount %} hidden{% endunless %}>{% if has_discount %}{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% OFF{% endif %}</span>
          </span>
        </div>
      </div>
      <div class="pf-product-template__sticky-actions">
        <button type="button" class="pf-sticky-btn pf-sticky-btn--add" data-pf-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
          <span class="pf-sticky-btn__main">
            <svg class="pf-sticky-btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.75 9.25A2.25 2.25 0 0 1 7 7h10a2.25 2.25 0 0 1 2.25 2.25V17.5A3.5 3.5 0 0 1 15.75 21h-7.5a3.5 3.5 0 0 1-3.5-3.5z"/><path d="M8.75 7V6.25a3.25 3.25 0 0 1 6.5 0V7"/><path d="M9.25 11.25a2.75 2.75 0 0 0 5.5 0"/></svg>
            <span class="pf-sticky-btn__label" data-pf-sticky-add-text>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
          </span>
          <span class="pf-sticky-btn__price" data-pf-sticky-btn-price>{% render 'format-price', price: current_variant.price %}</span>
        </button>
        <button type="button" class="pf-sticky-btn pf-sticky-btn--buy" data-pf-sticky-buy {% unless current_variant.available %}disabled{% endunless %}>
          <span data-pf-buy-label>Buy now</span>
          {% render 'balad-pay-icons-stack', size: 15 %}
        </button>
      </div>
      <p class="pf-product-template__sticky-note">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        100% secure checkout &middot; UPI, Cards &amp; Net Banking
      </p>
    </div>
  </div>
</section>

<style>
  .pf-product-template {
    --pf-bg: #ffffff;
    --pf-ink: #151515;
    --pf-text: #4b4b4b;
    --pf-muted: #7a7a7a;
    --pf-line: #ececec;
    --pf-soft: #f7f5f1;
    --pf-gold: #a37b35;
    --pf-gold-soft: #f4ecdb;

    /* Border radius scale: one value per level so every card follows the same rule */
    --pf-radius: 16px;      /* outer surfaces: photos, info panel */
    --pf-radius-md: 12px;   /* cards and buttons: free delivery, trust strip, buttons, sticky card */
    --pf-radius-sm: 8px;    /* small items: size boxes, thumbnails, small images */

    background: var(--pf-bg);
    color: var(--pf-ink);
    margin: 0;
    padding: 0;
  }

  .pf-product-template *,
  .pf-product-template *::before,
  .pf-product-template *::after { box-sizing: border-box; }

  .pf-product-template__shell {
    width: min(100%, 1520px);
    margin: 0 auto;
    padding: 8px 12px 8px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .pf-product-template__media,
  .pf-product-template__content { min-width: 0; }

  /* ───────── Gallery ───────── */
  .pdp-gallery { display: flex; flex-direction: column; gap: 10px; width: 100%; min-width: 0; }

  /* Frame holds the stage and the badge, so the badge does not scroll away with the slides */
  .pdp-gallery__frame { position: relative; min-width: 0; }

  .pdp-gallery__stage {
    position: relative;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    aspect-ratio: 2 / 3;
    max-height: 78vh;
    max-height: 78svh;
    background: #f1ede6;
    border-radius: var(--pf-radius);
  }

  .pdp-gallery__stage::-webkit-scrollbar,
  .pdp-gallery__thumbs-track::-webkit-scrollbar { display: none; }

  .pdp-slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
    overflow: hidden;
    background: #f1ede6;
    border-radius: var(--pf-radius);
  }

  .pdp-slide img, .pdp-slide video, .pdp-slide iframe, .pdp-slide picture, .pdp-slide__media {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: center;
  }

  .pdp-gallery__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 6px 12px;
    background: var(--pf-ink);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    border-radius: 999px; /* small tag stays a pill on purpose */
    pointer-events: none;
  }

  .pdp-gallery__thumbs { order: 2; min-width: 0; }
  .pdp-gallery__thumbs-track { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px; }

  .pdp-thumb {
    position: relative;
    flex: 0 0 56px;
    width: 56px;
    height: 70px;
    padding: 0;
    border: 1.5px solid transparent;
    border-radius: var(--pf-radius-sm);
    background: #f1ede6;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .pdp-thumb:hover, .pdp-thumb.is-active { opacity: 1; }
  .pdp-thumb.is-active { border-color: var(--pf-ink); }
  .pdp-thumb:focus-visible { outline: 2px solid var(--pf-ink); outline-offset: 2px; }
  .pdp-thumb__img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .pdp-thumb.is-video::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-30%, -50%);
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent #fff;
    filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.5));
  }

  /* ───────── Product details (sections separated by thin bottom borders) ───────── */
  .pdp-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 22px 18px 20px;
    background: #fff;
    border: 1px solid #ebe8e2;
    border-radius: var(--pf-radius);
  }

  /* ───── Top bar: breadcrumb on the left, stock pill + share on the right ───── */
  .pdp-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .pdp-topbar__end { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }

  .pdp-crumbs {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 7px;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.2;
    color: var(--pf-muted);
  }
  .pdp-crumbs a { flex-shrink: 0; color: inherit; text-decoration: none; transition: color 0.2s ease; }
  .pdp-crumbs a:hover { color: var(--pf-ink); }
  .pdp-crumbs a:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; border-radius: 2px; }
  .pdp-crumbs > span[aria-hidden] { flex-shrink: 0; color: #c9c4b8; }
  .pdp-crumbs__current { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; color: var(--pf-ink); }

  /* Phones: breadcrumb gets its own row (long names cut with ...), stock and share sit below it */
  @media screen and (max-width: 600px) {
    .pdp-topbar { flex-wrap: wrap; row-gap: 10px; margin-bottom: 14px; }
    .pdp-crumbs { flex: 1 1 100%; }
    .pdp-topbar__end { width: 100%; justify-content: space-between; }
    .pdp-share { width: 34px; height: 34px; }
  }

  .pdp-share {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid #e3dfd7;
    border-radius: 50%;
    background: #fff;
    color: var(--pf-ink);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, transform 0.12s ease;
  }
  .pdp-share:hover { color: #fff; background: var(--pf-ink); border-color: var(--pf-ink); }
  .pdp-share:active { transform: scale(0.95); }
  .pdp-share:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; }

  /* ───── Head: eyebrow, name, specs, rating and note chips (stacked) ───── */
  .pdp-head { padding-bottom: 0; }
  .pdp-eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pf-gold);
  }

  .pdp-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--pf-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .pdp-specs { margin: 8px 0 0; font-size: 13px; line-height: 1.4; color: var(--pf-muted); }

  /* Fragrance notes as soft gold chips */
  .pdp-notes { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 0; padding: 0; list-style: none; }
  .pdp-notes li {
    padding: 5px 11px;
    border: 1px solid rgba(163, 123, 53, 0.28);
    border-radius: 999px;
    background: var(--pf-gold-soft);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: #7d5c22;
  }

  /* Stars (used by the rating line under the title) */
  .pdp-stars {
    position: relative;
    display: inline-block;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 2px;
    white-space: nowrap;
    color: #ddd6c6;
  }
  .pdp-stars__fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--pf-gold);
  }

  .pdp-rating { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 13px; color: var(--pf-text); text-decoration: none; }
  .pdp-rating:hover .pdp-rating__text { text-decoration: underline; }
  .pdp-rating__text strong { font-weight: 700; color: var(--pf-ink); }

  /* Name on the left, price on the right (same row) */
  .pdp-head__row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
  .pdp-head__main { flex: 1 1 auto; min-width: 0; }
  .pdp-head__main .pdp-specs { margin-top: 6px; }

  /* Price block: right-aligned, plain (no box) */
  .pdp-price__info {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    margin: 0;
    padding: 0;
    text-align: right;
  }
  .pdp-price__row { display: flex; align-items: baseline; justify-content: flex-end; flex-wrap: wrap; gap: 4px 10px; }
  .pdp-price__main { font-size: 28px; font-weight: 700; line-height: 1; letter-spacing: -0.015em; color: var(--pf-ink); }
  .pdp-price__compare { font-size: 15px; color: #a3a3a3; text-decoration: line-through; }
  .pdp-price__off {
    padding: 4px 9px;
    border-radius: 999px;
    background: #b4501e;
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }
  .pdp-price__compare[hidden], .pdp-price__off[hidden] { display: none; }
  .pdp-price__tax { display: block; margin: 0; font-size: 11.5px; color: var(--pf-muted); white-space: nowrap; }

  /* At a glance: three soft tiles with an icon each */
  .pdp-glance {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 8px;
    margin: 18px 0 0;
    padding: 0 0 18px;
    border-bottom: 1px solid #ebe8e2;
    list-style: none;
  }
  .pdp-glance li {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid #ebe8e2;
    border-radius: var(--pf-radius-md);
    background: #fff;
  }
  .pdp-glance__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--pf-gold-soft);
    color: var(--pf-gold);
  }
  .pdp-glance__icon svg { width: 17px; height: 17px; }
  .pdp-glance__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pdp-glance small { font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.2; color: var(--pf-muted); }
  .pdp-glance strong { font-size: 13px; font-weight: 600; line-height: 1.3; color: var(--pf-ink); overflow-wrap: anywhere; }
  /* Phones: icon sits above the text so three tiles still fit in one row */
  @media screen and (max-width: 520px) {
    .pdp-glance { gap: 6px; }
    .pdp-glance li { flex-direction: column; align-items: flex-start; gap: 8px; padding: 10px; }
    .pdp-glance__icon { width: 30px; height: 30px; }
    .pdp-glance__icon svg { width: 15px; height: 15px; }
    .pdp-glance strong { font-size: 12.5px; }
  }

  /* Section 4: size. The selected size uses a gold outline, soft gold fill and a tick,
     so it never looks like the solid black Buy Now button. A single size stays a compact box. */
  .pdp-option { margin: 0; padding: 16px 0; border-bottom: 1px solid #ebe8e2; }
  .pdp-sizes[hidden] { display: none; }
  .pdp-option__label { display: block; margin-bottom: 12px; font-size: 13px; font-weight: 500; color: var(--pf-ink); }
  .pdp-option__label strong { font-weight: 700; color: var(--pf-gold); }
  .pdp-sizes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 132px));
    gap: 10px;
  }
  .pdp-size {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 16px;
    border: 1.5px solid #e3dfd7;
    border-radius: var(--pf-radius-sm);
    background: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--pf-ink);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.12s ease;
  }
  .pdp-size:hover { border-color: var(--pf-gold); }
  .pdp-size:active { transform: scale(0.97); }

  /* Selected size: gold outline + soft gold fill + tick (clearly different from the black Buy Now button) */
  .pdp-size.is-active {
    background: var(--pf-gold-soft);
    border-color: var(--pf-gold);
    color: var(--pf-ink);
    font-weight: 700;
  }
  .pdp-size.is-active::before {
    content: '';
    width: 5px;
    height: 9px;
    margin-top: -2px;
    border: solid var(--pf-gold);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .pdp-size.is-out { color: #a3a3a3; text-decoration: line-through; background: #faf9f7; }
  .pdp-size.is-out.is-active { color: #a3a3a3; background: #faf9f7; border-color: var(--pf-gold); }
  .pdp-size.is-out.is-active::before { border-color: #c9c4b8; }
  .pdp-size:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; }

  .pdp-stock { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 7px; margin: 0; padding: 6px 12px; border-radius: 999px; font-size: 11.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.2; white-space: nowrap; }
  .pdp-stock__dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .pdp-stock.is-in { color: #1d7a45; background: #eaf6ee; }
  .pdp-stock.is-in .pdp-stock__dot { background: #1d7a45; }
  .pdp-stock.is-out { color: #b42318; background: #fdecea; }
  .pdp-stock.is-out .pdp-stock__dot { background: #b42318; }

  /* Hurry up: stock progress bar (width follows real inventory) */
  .pdp-hurry {
    margin: 16px 0 0;
    padding: 12px 14px;
    background: #fff6f0;
    border: 1px solid #f1d3bf;
    border-radius: var(--pf-radius-md);
  }
  .pdp-hurry[hidden] { display: none; }
  .pdp-hurry__top { display: flex; flex-wrap: wrap; row-gap: 6px; align-items: center; justify-content: space-between; gap: 10px; font-size: 13px; font-weight: 600; color: #b4501e; }
  .pdp-hurry__title { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .pdp-hurry__title svg { flex-shrink: 0; width: 17px; height: 17px; }
  .pdp-hurry__title strong { font-weight: 800; }
  .pdp-hurry__tag { flex-shrink: 0; padding: 3px 9px; border-radius: 999px; background: #b4501e; color: #fff; font-size: 11px; font-weight: 600; letter-spacing: 0.02em; }
  .pdp-hurry__bar { margin-top: 10px; height: 8px; overflow: hidden; border-radius: 999px; background: #f5ddcd; }
  .pdp-hurry__fill {
    display: block;
    height: 100%;
    width: var(--pdp-hurry, 100%);
    border-radius: inherit;
    background: linear-gradient(90deg, #e2703a, #b4501e);
    transition: width 0.5s ease;
  }
  .pdp-hurry__sub { margin: 8px 0 0; font-size: 12px; line-height: 1.4; color: var(--pf-text); }

  /* Buttons */
  .pdp-form { margin: 0; }
  .pdp-actions { display: flex; gap: 10px; margin-top: 16px; }

  .pdp-btn {
    flex: 1 1 0;
    height: 48px;
    margin: 0;
    padding: 0 14px;
    border: 1.5px solid var(--pf-ink);
    border-radius: var(--pf-radius-md);
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.12s ease, box-shadow 0.2s ease;
  }

  .pdp-btn:active:not(:disabled) { transform: scale(0.985); }
  .pdp-btn:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 3px; }
  /* Same look as the sticky card: light outlined Add to bag, wider dark Buy now */
  .pdp-btn--add { flex: 0.85 1 0; background: #fff; color: var(--pf-ink); border-color: #d9d4ca; }
  .pdp-btn--add:hover:not(:disabled) { border-color: var(--pf-ink); background: var(--pf-soft); }
  .pdp-btn--buy {
    flex: 1.3 1 0;
    background: linear-gradient(180deg, #2a2a2a, var(--pf-ink));
    color: #fff;
  }
  .pdp-btn--buy:hover:not(:disabled) { background: #000; box-shadow: 0 10px 22px -6px rgba(0, 0, 0, 0.55); }
  /* Buy now: label + round payment icons side by side */
  .pdp-btn--buy,
  .pf-sticky-btn--buy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .pdp-btn--buy .balad-pay-stack,
  .pf-sticky-btn--buy .balad-pay-stack { position: relative; z-index: 1; }
  .pdp-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  /* Payment methods under the buttons: one quiet line, lock + text on the left, small logos on the right */
  .pdp-payment-methods {
    container-type: inline-size;
    width: 100%;
    margin: 12px 0 0;
    padding: 10px 0 0;
    border-top: 1px dashed #e3dfd7;
  }
  .pdp-payment-methods__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .pdp-payment-methods__sub {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--pf-muted);
  }
  .pdp-payment-methods__sub svg { flex-shrink: 0; color: #1f7a3d; }
  .pdp-payment-methods__badges {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    gap: 4px;
    margin: 0;
  }
  .pdp-payment-methods__badges .balad-payment-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 20px;
    padding: 2px 3px;
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 1px #ebe8e2;
    flex-shrink: 0;
  }
  .pdp-payment-methods__badges .balad-payment-badge svg { display: block; width: 100%; height: 100%; }
  /* The tile draws the border, so drop the outlines some icons carry in their artwork */
  .pdp-payment-methods__badges .balad-payment-badge svg path[opacity],
  .pdp-payment-methods__badges .balad-payment-badge svg rect[stroke-opacity] { display: none; }

  /* Not enough room beside the text: logos take a full-width row of their own, flush to both edges */
  @container (max-width: 479px) {
    .pdp-payment-methods__inner { flex-direction: column; align-items: stretch; gap: 8px; }
    .pdp-payment-methods__badges {
      display: grid;
      grid-template-columns: repeat(9, minmax(0, 40px));
      justify-content: space-between;
    }
    .pdp-payment-methods__badges .balad-payment-badge { width: auto; height: auto; aspect-ratio: 38 / 24; }
  }

  /* Estimated delivery + secure payments (already has top and bottom borders) */
  .pdp-meta-row {
    display: flex;
    align-items: stretch;
    margin: 16px 0 0;
    padding: 14px 0;
    border-top: 1px solid #ebe8e2;
    border-bottom: 1px solid #ebe8e2;
  }
  .pdp-delivery,
  .pdp-secure {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0 14px;
    background: none;
    border: 0;
    border-radius: 0;
    line-height: 1.3;
    color: var(--pf-text);
  }
  .pdp-delivery { padding-left: 0; }
  .pdp-delivery + .pdp-secure { border-left: 1px solid #ebe8e2; }
  .pdp-delivery[hidden] { display: none; }
  .pdp-delivery[hidden] + .pdp-secure { border-left: 0; padding-left: 0; }
  .pdp-delivery svg, .pdp-secure svg { flex-shrink: 0; width: 22px; height: 22px; color: var(--pf-ink); }
  .pdp-secure svg { color: #1f7a3d; }
  .pdp-meta__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pdp-meta__text small { font-size: 11px; color: var(--pf-muted); letter-spacing: 0.01em; }
  .pdp-meta__text strong { font-size: 12.5px; font-weight: 600; color: var(--pf-ink); }
  /* Stack earlier (520px) so the two items are not squeezed on normal phones */
  @media screen and (max-width: 520px) {
    .pdp-meta-row { flex-direction: column; gap: 12px; }
    .pdp-delivery, .pdp-secure { padding: 0; }
    .pdp-delivery + .pdp-secure { border-left: 0; }
  }

  /* Section 3: buying nudges (all genuine: real discount, real offer). Hidden with its border when empty. */
  .pdp-nudges { display: grid; gap: 8px; margin: 0; padding: 14px 0; border-bottom: 1px solid #ebe8e2; }
  .pdp-nudges[hidden] { display: none; }
  .pdp-nudges:not(:has(> :not([hidden]))) { display: none; }
  .pdp-nudges:empty { display: none; }
  .pdp-save, .pdp-offer { margin: 0; font-size: 13px; line-height: 1.4; }
  .pdp-save { color: #1f7a3d; }
  .pdp-save strong { font-weight: 700; }
  .pdp-save[hidden] { display: none; }
  .pdp-offer { padding: 9px 12px; border: 1px dashed rgba(0, 0, 0, 0.35); border-radius: var(--pf-radius-md); font-weight: 600; color: var(--pf-ink); background: rgba(0, 0, 0, 0.03); }

  /* Assurance list */
  .pdp-assure { display: grid; gap: 8px; margin: 0; padding: 14px 0; border-bottom: 1px solid #ebe8e2; list-style: none; }
  .pdp-assure li { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--pf-text); }
  .pdp-assure svg { flex-shrink: 0; width: 18px; height: 18px; color: #1f7a3d; }

  /* Free delivery highlight */
  .pdp-freeship {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 16px 0 0;
    padding: 12px 14px;
    background: linear-gradient(135deg, #effaf2 0%, #e4f5ea 100%);
    border: 1px solid #c6e6d0;
    border-radius: var(--pf-radius-md);
    color: #14532d;
  }
  .pdp-freeship__icon {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #1f7a3d;
    color: #fff;
  }
  .pdp-freeship__icon svg { width: 19px; height: 19px; }
  .pdp-freeship__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #1f7a3d;
    opacity: 0;
    animation: pdpPulse 2.6s ease-out infinite;
  }
  .pdp-freeship__text { display: flex; flex-direction: column; gap: 1px; min-width: 0; line-height: 1.3; }
  .pdp-freeship__text strong { font-size: 14px; font-weight: 700; letter-spacing: 0.01em; }
  .pdp-freeship__text span { font-size: 12px; color: #2f6b45; }
  .pdp-freeship__text .pdp-freeship__eta {
    display: block;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px dashed #a9d4b7;
    font-size: 12px;
    line-height: 1.4;
    color: #14532d;
  }
  .pdp-freeship__text .pdp-freeship__eta[hidden] { display: none; }
  .pdp-freeship__eta b { font-weight: 700; }
  .pdp-secure:first-child { padding-left: 0; }
  .pdp-secure { flex-wrap: wrap; }
  .pdp-secure .pdp-meta__text { flex: 1 1 0; gap: 3px; }
  .pdp-secure .pdp-meta__text strong { font-size: 13.5px; }
  .pdp-secure .pdp-meta__text small { font-size: 12px; color: var(--pf-text); }
  .pdp-secure__chips { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; margin-left: auto; }
  .pdp-secure__chips span {
    padding: 4px 10px;
    border: 1px solid #ebe8e2;
    border-radius: 999px;
    background: var(--pf-soft);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--pf-ink);
  }
  /* When it shares the row with the delivery item (free delivery box off), keep it compact */
  .pdp-delivery ~ .pdp-secure .pdp-secure__chips { display: none; }
  @media screen and (max-width: 520px) {
    .pdp-secure__chips { flex: 1 1 100%; justify-content: flex-start; margin-left: 32px; }
  }

  @keyframes pdpPulse {
    0% { transform: scale(1); opacity: 0.55; }
    70%, 100% { transform: scale(1.7); opacity: 0; }
  }

  /* Trust strip: one soft container, three cells with thin dividers */
  .pdp-trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 16px 0;
    padding: 0;
    list-style: none;
    background: var(--pf-soft);
    border: 1px solid #ebe8e2;
    border-radius: var(--pf-radius-md);
    overflow: hidden;
  }

  .pdp-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 14px 8px;
    text-align: center;
  }
  .pdp-trust__item + .pdp-trust__item { border-left: 1px solid #ebe8e2; }

  .pdp-trust__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #ebe8e2;
    color: var(--pf-gold);
  }
  .pdp-trust__icon svg { width: 19px; height: 19px; }

  .pdp-trust__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pdp-trust__text strong { font-size: 12.5px; font-weight: 600; line-height: 1.25; color: var(--pf-ink); }
  .pdp-trust__text small { font-size: 11px; line-height: 1.3; color: var(--pf-muted); }

  @media screen and (max-width: 400px) {
    .pdp-trust__item { padding: 12px 4px; gap: 6px; }
    .pdp-trust__icon { width: 34px; height: 34px; }
    .pdp-trust__icon svg { width: 17px; height: 17px; }
    .pdp-trust__text strong { font-size: 11.5px; }
    .pdp-trust__text small { font-size: 10.5px; }
  }

  /* Buy now: soft shine so the main button is the first thing noticed */
  .pdp-btn--buy { position: relative; overflow: hidden; box-shadow: 0 8px 18px -6px rgba(0, 0, 0, 0.45); }
  .pdp-btn--buy:not(:disabled)::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 40%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.28), transparent);
    transform: skewX(-20deg);
    animation: pdpShine 4.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes pdpShine {
    0%, 55% { left: -60%; }
    100% { left: 130%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pdp-freeship__icon::after, .pdp-btn--buy::after { animation: none !important; display: none; }
  }

  /* One accordion for all information (the trust strip above sits right before it) */
  .pf-accordions { margin-top: 0; border-top: 1px solid #ebe8e2; }
  .pf-accordion-item { border-bottom: 1px solid #ebe8e2; }

  .pf-accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .pf-accordion-header::-webkit-details-marker { display: none; }
  .pf-accordion-header:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; }
  .pf-accordion-title { font-size: 14px; font-weight: 500; color: var(--pf-ink); }

  .pf-accordion-icon { position: relative; width: 12px; height: 12px; flex-shrink: 0; }

  .pf-accordion-icon::before,
  .pf-accordion-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--pf-ink);
    transition: transform 0.25s ease;
  }

  .pf-accordion-icon::after { transform: rotate(90deg); }
  .pf-accordion-item[open] .pf-accordion-icon::after { transform: rotate(0deg); }

  .pf-accordion-body { padding: 0 0 18px; font-size: 13.5px; line-height: 1.7; color: var(--pf-text); overflow-wrap: anywhere; }
  .pf-accordion-body :is(p, ul, ol) { margin: 0 0 10px; }
  .pf-accordion-body :is(p, ul, ol):last-child { margin-bottom: 0; }
  /* Description comes from Shopify, so keep wide content inside the card on phones */
  .pf-accordion-body img, .pf-accordion-body video, .pf-accordion-body iframe { max-width: 100%; height: auto; }
  .pf-accordion-body table { display: block; max-width: 100%; overflow-x: auto; }
  .pf-accordion-bullets { padding-left: 18px; }
  .pf-accordion-bullets li { margin-bottom: 6px; }
  .pf-accordion-bullets li:last-child { margin-bottom: 0; }

  /* Write a review as a button */
  .pf-buybox__write-review[hidden] { display: none !important; }
  .pf-buybox__write-review {
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 46px;
    margin-top: 18px;
    padding: 0 18px;
    border: 1px solid var(--pf-ink);
    border-radius: var(--pf-radius-md);
    background: #fff;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pf-ink);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.12s ease;
  }

  .pf-buybox__write-review:hover { background: var(--pf-ink); color: #fff; }
  .pf-buybox__write-review:active { transform: scale(0.985); }
  .pf-buybox__write-review:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 3px; }

  /* ───────── Judge.me tweaks ───────── */
  #judgeme_product_reviews.jdgm-form-open,
  .jm-review-widget.jdgm-form-open,
  .jdgm-widget.jdgm-form-open { display: block !important; height: auto !important; min-height: auto !important; }

  .jdgm-write-rev-form, .jm-write-rev-form, .jm-form {
    border: 1px solid #e8e4dc !important;
    border-radius: 12px !important; /* keep in sync with --pf-radius-md (Judge.me sits outside the section scope) */
    padding: 20px !important;
    margin-top: 16px !important;
    background: #fff !important;
  }

  .jdgm-submit-rev-btn, .jm-submit-rev-btn {
    background-color: #151515 !important;
    color: #fff !important;
    border-radius: 12px !important; /* keep in sync with --pf-radius-md */
    font-weight: 600 !important;
    border: none !important;
    padding: 12px 24px !important;
    cursor: pointer !important;
  }

  .jdgm-star, .jm-star { color: #a37b35 !important; }

  /* ───────── Sticky card (bottom-right on desktop, slim bottom bar on phones) ───────── */
  #balad-mobile-nav { display: none !important; }

  .pf-product-template__sticky-bar {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 999998;
    width: 360px;
    max-width: calc(100vw - 32px);
    padding: 16px;
    background: rgba(255, 255, 255, 0.97);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    backdrop-filter: saturate(160%) blur(14px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--pf-radius);
    box-shadow: 0 24px 48px -12px rgba(30, 24, 12, 0.28), 0 4px 12px rgba(30, 24, 12, 0.06);
    overflow: hidden;
    transform: translateY(24px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.35s;
  }

  .pf-product-template__sticky-bar[data-visible="true"] { transform: translateY(0); opacity: 1; visibility: visible; pointer-events: auto; }

  body.pf-drawer-open .pf-product-template__sticky-bar,
  body.story-modal-open .pf-product-template__sticky-bar,
  body:has(.cart-drawer[open]) .pf-product-template__sticky-bar,
  body:has(cart-drawer[open]) .pf-product-template__sticky-bar,
  body:has(.quick-add-modal[open]) .pf-product-template__sticky-bar {
    transform: translateY(24px) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .pf-product-template__sticky-shell { display: flex; flex-direction: column; gap: 14px; }

  .pf-product-template__sticky-info { display: flex; align-items: center; gap: 14px; min-width: 0; padding-right: 28px; }

  .pf-product-template__sticky-img {
    flex: 0 0 60px;
    width: 60px;
    height: 72px;
    border-radius: var(--pf-radius-sm);
    overflow: hidden;
    background: linear-gradient(160deg, #faf6ee, var(--pf-gold-soft));
    box-shadow: inset 0 0 0 1px rgba(163, 123, 53, 0.15);
  }

  .pf-product-template__sticky-img img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .pf-product-template__sticky-text { display: flex; flex-direction: column; gap: 5px; min-width: 0; }

  .pf-product-template__sticky-title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--pf-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pf-product-template__sticky-variant {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--pf-soft);
    border: 1px solid var(--pf-line);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--pf-muted);
    white-space: nowrap;
  }

  .pf-product-template__sticky-price-wrap { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; }
  .pf-product-template__sticky-price { font-size: 18px; font-weight: 700; line-height: 1.1; color: var(--pf-ink); }
  .pf-product-template__sticky-compare-price { font-size: 13px; color: #a3a3a3; text-decoration: line-through; }
  .pf-product-template__sticky-off {
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--pf-gold-soft);
    color: var(--pf-gold);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .pf-product-template__sticky-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--pf-soft);
    color: var(--pf-muted);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .pf-product-template__sticky-close svg { width: 12px; height: 12px; }
  .pf-product-template__sticky-close:hover { background: var(--pf-ink); color: #fff; }
  .pf-product-template__sticky-close:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; }

  .pf-product-template__sticky-actions { display: flex; gap: 8px; }

  .pf-sticky-btn {
    flex: 1 1 0;
    height: 46px;
    padding: 0 12px;
    border: 1.5px solid var(--pf-ink);
    border-radius: var(--pf-radius-md);
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.12s ease, box-shadow 0.2s ease;
  }

  .pf-sticky-btn:active:not(:disabled) { transform: scale(0.985); }
  .pf-sticky-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .pf-sticky-btn:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 3px; }
  .pf-sticky-btn--add { flex: 0.85 1 0; background: #fff; color: var(--pf-ink); border-color: #d9d4ca; }
  .pf-sticky-btn--add:hover:not(:disabled) { border-color: var(--pf-ink); background: var(--pf-soft); }
  /* Icon + price inside the button are phone-only (see mobile rules) */
  .pf-sticky-btn__icon,
  .pf-sticky-btn__price { display: none; }
  .pf-sticky-btn--buy {
    flex: 1.3 1 0;
    background: linear-gradient(180deg, #2a2a2a, var(--pf-ink));
    color: #fff;
    box-shadow: 0 8px 18px -6px rgba(0, 0, 0, 0.45);
  }
  .pf-sticky-btn--buy:hover:not(:disabled) { background: #000; box-shadow: 0 10px 22px -6px rgba(0, 0, 0, 0.55); }

  /* Loading state for Add to bag / Buy now (main + sticky): label hidden, spinner in its place.
     Uses ::before because .pdp-btn--buy's shine already uses ::after. */
  .pf-product-template .pf-btn-loading {
    position: relative;
    cursor: progress;
    opacity: 1 !important;
  }
  .pf-product-template .pf-btn-loading > * { visibility: hidden; }
  .pf-product-template .pf-btn-loading::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: pfBtnSpin 0.7s linear infinite;
  }
  @keyframes pfBtnSpin { to { transform: rotate(360deg); } }

  .pf-product-template__sticky-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: -4px 0 0;
    font-size: 11px;
    color: var(--pf-muted);
    letter-spacing: 0.02em;
  }
  .pf-product-template__sticky-note svg { color: var(--pf-gold); flex-shrink: 0; }

  /* Phones: slim one-row bar at the bottom edge. It only appears after the main buttons scroll out of view (see script). */
  @media screen and (max-width: 749px) {
    .pf-product-template__sticky-bar {
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-width: none;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
      border-width: 1px 0 0;
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -10px 30px -8px rgba(30, 24, 12, 0.22);
    }
    /* Phones, two rows:
         [ NAME  (100 ML)                 ₹3,999  ₹4,500  10% OFF ]
         [ ───────────── bag icon  ADD TO CART (full width) ───── ] */
    .pf-product-template__sticky-shell { flex-direction: column; align-items: stretch; gap: 10px; }
    .pf-product-template .pf-product-template__sticky-img { display: none !important; }
    .pf-product-template .pf-product-template__sticky-info { flex: none; width: 100%; max-width: none; min-width: 0; gap: 0; padding: 0 2px; }
    .pf-product-template .pf-product-template__sticky-text { display: flex; flex-flow: row nowrap; align-items: center; gap: 8px; min-width: 0; width: 100%; }
    .pf-product-template .pf-product-template__sticky-title {
      display: block;
      flex: 0 1 auto;
      min-width: 0;
      font-size: 13px;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pf-product-template .pf-product-template__sticky-variant { flex: none; align-self: center; padding: 2px 8px; font-size: 10px; line-height: 1.3; }
    .pf-product-template .pf-product-template__sticky-price-wrap {
      display: flex;
      flex: none;
      flex-wrap: nowrap;
      align-items: baseline;
      gap: 6px;
      margin-left: auto;
      padding-left: 6px;
    }
    .pf-product-template .pf-product-template__sticky-price { font-size: 16px; line-height: 1; }
    .pf-product-template .pf-product-template__sticky-compare-price { font-size: 12px; }
    .pf-product-template .pf-product-template__sticky-off { align-self: center; padding: 2px 7px; font-size: 9.5px; line-height: 1.3; }
    .pf-product-template .pf-product-template__sticky-variant[hidden],
    .pf-product-template .pf-product-template__sticky-off[hidden] { display: none; }

    .pf-product-template .pf-product-template__sticky-actions { width: 100%; min-width: 0; display: flex; }
    /* Phones: one full-width Add to cart button (no Buy now); the price sits in the row above */
    .pf-product-template .pf-sticky-btn--buy { display: none !important; }
    .pf-product-template .pf-sticky-btn--add {
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-width: 0;
      height: 48px;
      padding: 0 16px;
      border: 0;
      border-radius: 12px;
      background: linear-gradient(180deg, #2a2a2a, var(--pf-ink));
      color: #fff;
      box-shadow: 0 8px 18px -6px rgba(0, 0, 0, 0.45);
      font-size: 12.5px;
      letter-spacing: 0.1em;
      line-height: 1;
      white-space: nowrap;
    }
    .pf-product-template .pf-sticky-btn--add:hover:not(:disabled) { background: #000; }
    .pf-product-template .pf-sticky-btn__main { display: inline-flex; align-items: center; gap: 10px; min-width: 0; }
    .pf-product-template .pf-sticky-btn__icon { display: block; position: static; flex: 0 0 18px; width: 18px; height: 18px; margin: 0; }
    .pf-product-template .pf-sticky-btn__label { display: inline-block; }
    .pf-product-template .pf-sticky-btn__price { display: none; }
    /* Very narrow phones: drop the struck-through price before the name gets squeezed */
    @media (max-width: 374px) {
      .pf-product-template .pf-product-template__sticky-compare-price { display: none !important; }
    }
    .pf-product-template__sticky-close,
    .pf-product-template__sticky-note { display: none; }
  }

  /* ───────── Desktop: photos two per row, pinned; details card pinned beside them ───────── */
  @media screen and (min-width: 990px) {
    .pf-product-template__shell {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 20px;
      align-items: start;
      padding: 20px 28px 20px;
    }

    /* Stretch to the full row height (same as the details column) so the photos have room to stay pinned while long details scroll */
    .pf-product-template__media { grid-column: 1; grid-row: 1; align-self: stretch; }

    .pdp-gallery {
      --pdp-frame-h: clamp(420px, calc(100vh - var(--header-group-height, var(--header-height, 66px)) - 32px), 780px);
      display: block;
      /* Photos stay in view while the details scroll. If the photos are taller than the window, they scroll until their end shows, then stay.
         The exact top value is set by the script below (--pdp-gallery-top). */
      position: sticky;
      top: var(--pdp-gallery-top, calc(var(--header-group-height, var(--header-height, 66px)) + 12px));
    }

    .pdp-gallery__thumbs { display: none; }

    .pdp-gallery__stage {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      align-items: start;
      overflow: visible;
      scroll-snap-type: none;
      aspect-ratio: auto;
      max-height: none;
      background: transparent;
      border-radius: 0;
    }

    .pdp-gallery.is-single .pdp-gallery__stage { grid-template-columns: minmax(0, 1fr); max-width: 560px; }

    /* First photo stays pinned on the left; the other photos stack on the right and scroll past it */
    .pdp-gallery:not(.is-single) .pdp-slide:first-child {
      grid-column: 1;
      grid-row: 1 / span var(--pdp-rows, 1);
      position: sticky;
      top: calc(var(--header-group-height, var(--header-height, 66px)) + 12px);
    }

    .pdp-gallery:not(.is-single) .pdp-slide:not(:first-child) {
      grid-column: 2;
    }

    /* Height fits the window (below the header), so both photos stay fully visible while the details scroll */
    .pdp-slide {
      flex: none;
      aspect-ratio: auto;
      height: var(--pdp-frame-h);
      border-radius: var(--pf-radius);
    }

    .pdp-gallery__badge { top: 14px; left: 14px; }

    /* Content column matches the photos' height, so the details panel stays in view while they scroll */
    .pf-product-template__content { grid-column: 2; grid-row: 1; align-self: stretch; }

    .pdp-info {
      position: sticky;
      top: var(--pdp-info-top, calc(var(--header-group-height, var(--header-height, 66px)) + 12px));
      padding: 28px 28px 24px;
    }

    .pdp-title { font-size: 26px; }
  }

  @media screen and (max-width: 749px) {
    .pdp-title { font-size: 21px; }
  }

  /* Phones: slightly tighter price panel */
  @media screen and (max-width: 480px) {
    .pdp-head__row { gap: 12px; }
    .pdp-price__info { max-width: 46%; gap: 5px; }
    .pdp-price__row { gap: 2px 8px; }
    .pdp-price__main { font-size: 21px; }
    .pdp-price__compare { font-size: 12.5px; }
    .pdp-price__tax { font-size: 10.5px; white-space: normal; }
    .pdp-price__off { font-size: 10.5px; }
    .pdp-price__tax { font-size: 11px; }
    .pdp-notes li { font-size: 11px; padding: 4px 10px; }
  }

  @media screen and (max-width: 380px) {
    .pdp-stock { padding: 5px 10px; font-size: 10.5px; letter-spacing: 0.04em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-product-template *,
    .pf-product-template__sticky-bar { transition: none !important; animation: none !important; }
  }

  /* =================================================================
     PRODUCT DETAILS v3 — editorial, focused column
     header / price / excerpt / key facts / size / buy / delivery / trust / info
     ================================================================= */
  .pf-product-template {
    --pf-head-font: var(--font-heading--family, 'Manrope'), var(--font-body--family, sans-serif);
    --pf-hair: #ebe5db;
    --pf-cream: #f7f3ec;
    --pf-green: #2f7a4b;
  }

  .pdp-info.pdp-info--v2 {
    width: 100%;
    max-width: 540px;
    gap: 0;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }
  .pdp-info--v2 > [hidden] { display: none !important; }

  /* ---------- Breadcrumb ---------- */
  .pdp-info--v2 .pdp-topbar { margin: 0 0 28px; flex-wrap: nowrap; }
  .pdp-info--v2 .pdp-crumbs { flex: 1 1 auto; font-size: 12px; }
  .pdp-info--v2 .pdp-share { width: 36px; height: 36px; border-color: var(--pf-hair); }

  /* ---------- Header ---------- */
  .pdp-info--v2 .pdp-head { margin: 0; }
  .pdp-info--v2 .pdp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-size: 11px;
    letter-spacing: 0.22em;
  }
  .pdp-info--v2 .pdp-eyebrow::before { content: ''; width: 22px; height: 1px; background: currentColor; }
  .pdp-info--v2 .pdp-title {
    font-family: var(--pf-head-font);
    font-size: clamp(30px, 2.6vw, 40px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .pdp-head__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 14px; }
  .pdp-head__meta .pdp-stock { margin: 0; }
  .pdp-head__meta .pdp-rating { margin: 0; }
  .pdp-head__meta .pdp-specs { margin: 0; font-size: 13px; color: var(--pf-muted); }
  .pdp-head__meta > * + .pdp-specs::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 12px 3px 0;
    border-radius: 50%;
    background: #c9c0b2;
    vertical-align: middle;
  }
  .pdp-info--v2 .pdp-notes { margin-top: 16px; }

  /* ---------- Price: one clean row, no box ---------- */
  .pdp-info--v2 .pdp-deal {
    margin: 24px 0 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    overflow: visible;
  }
  .pdp-deal .pdp-price__info {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 0;
    text-align: left;
  }
  .pdp-deal .pdp-price__row { flex: 1 1 100%; justify-content: flex-start; align-items: baseline; gap: 4px 12px; }
  .pdp-deal .pdp-price__main {
    font-family: var(--pf-head-font);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .pdp-deal .pdp-price__compare { font-size: 16px; color: #a8a095; }
  .pdp-deal .pdp-price__off {
    align-self: center;
    padding: 5px 10px;
    border-radius: 999px;
    background: #f3e9d6;
    color: #8a6424;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .pdp-deal .pdp-save {
    display: inline;
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    color: var(--pf-green);
  }
  .pdp-deal .pdp-save[hidden] { display: none; }
  .pdp-deal .pdp-save::before { content: none; }
  .pdp-deal .pdp-price__tax { font-size: 12.5px; color: var(--pf-muted); }
  .pdp-deal .pdp-save:not([hidden]) + .pdp-price__tax::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin: 0 10px 3px;
    border-radius: 50%;
    background: #c9c0b2;
    vertical-align: middle;
  }

  /* ---------- Excerpt ---------- */
  .pdp-excerpt strong { font-weight: 600; color: var(--pf-ink); }
  .pdp-excerpt {
    margin: 20px 0 0;
    font-size: 14.5px;
    line-height: 1.7;
    color: #4a453e;
  }

  /* ---------- Key facts: minimal row between hairlines ---------- */
  .pdp-info--v2 .pdp-glance {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0;
    margin: 24px 0 0;
    padding: 16px 0;
    border: 0;
    border-top: 1px solid var(--pf-hair);
    border-bottom: 1px solid var(--pf-hair);
    border-radius: 0;
    background: none;
    overflow: visible;
  }
  .pdp-info--v2 .pdp-glance li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    border: 0;
    border-radius: 0;
    background: none;
  }
  .pdp-info--v2 .pdp-glance li:first-child { padding-left: 0; }
  .pdp-info--v2 .pdp-glance li + li { border-left: 1px solid var(--pf-hair); }
  .pdp-info--v2 .pdp-glance__icon { width: 34px; height: 34px; background: var(--pf-cream); color: var(--pf-gold); box-shadow: none; }
  .pdp-info--v2 .pdp-glance small { font-size: 10px; letter-spacing: 0.12em; }
  .pdp-info--v2 .pdp-glance strong { font-size: 13px; }

  /* Offer line */
  .pdp-info--v2 .pdp-nudges { margin: 18px 0 0; padding: 0; border: 0; }

  /* ---------- Size ---------- */
  .pdp-info--v2 .pdp-option { margin: 24px 0 0; padding: 0; border: 0; }
  .pdp-info--v2 .pdp-option__label {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pf-muted);
  }
  .pdp-info--v2 .pdp-option__label strong { font-size: 13px; letter-spacing: 0; text-transform: none; color: var(--pf-ink); }
  .pdp-info--v2 .pdp-size {
    height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
  }

  /* ---------- Low stock ---------- */
  .pdp-info--v2 .pdp-hurry { margin: 20px 0 0; }

  /* ---------- Buy ---------- */
  .pdp-info--v2 .pdp-form { margin: 24px 0 0; }
  .pdp-info--v2 .pdp-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0; }
  .pdp-info--v2 .pdp-btn {
    height: 50px;
    min-height: 50px;
    padding: 0 18px;
    border-radius: 999px;
    font-family: var(--pf-head-font);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    box-shadow: none;
  }
  .pdp-info--v2 .pdp-btn--add { border-width: 1px; border-color: #15130f; }
  .pdp-info--v2 .pdp-btn--add:hover:not(:disabled) { background: #15130f; color: #ffffff; }
  .pdp-info--v2 .pdp-btn--buy { box-shadow: 0 12px 24px -14px rgba(21, 19, 15, 0.65); }
  .pdp-info--v2 .pdp-btn .balad-pay-stack { --balad-pay-size: 15px !important; }
  .pdp-info--v2 .pdp-payment-methods { margin: 14px 0 0; padding: 0; border: 0; }

  /* ---------- Delivery + trust ---------- */
  .pdp-perks { margin: 24px 0 0; padding: 0; background: none; border-radius: 0; }
  .pdp-perks > * { margin: 0 !important; }

  .pdp-perks .pdp-freeship {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid var(--pf-hair);
    border-radius: 14px;
    background: #ffffff;
    color: var(--pf-ink);
    box-shadow: none;
  }
  .pdp-perks .pdp-freeship__icon { width: 38px; height: 38px; background: var(--pf-cream); color: var(--pf-gold); }
  .pdp-perks .pdp-freeship__icon::after { border-color: var(--pf-gold); }
  .pdp-perks .pdp-freeship__text strong { font-size: 13.5px; font-weight: 700; color: var(--pf-ink); }
  .pdp-perks .pdp-freeship__text span { font-size: 12.5px; color: var(--pf-muted); }
  .pdp-perks .pdp-freeship__text .pdp-freeship__eta {
    margin-top: 4px;
    padding-top: 0;
    border-top: 0;
    font-size: 12.5px;
    color: var(--pf-muted);
