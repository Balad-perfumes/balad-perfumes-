{% liquid
  assign selected_product = product
  assign current_variant = selected_product.selected_or_first_available_variant
  assign form_id = 'StagProductForm-' | append: section.id
  assign review_count = selected_product.metafields.reviews.rating_count.value | default: selected_product.metafields.reviews.rating_count | default: 0 | plus: 0

  # Rating from Judge.me / Shopify metafields
  assign review_rating = blank
  if selected_product.metafields.reviews.rating.value != blank
    assign review_rating = selected_product.metafields.reviews.rating.value.rating | default: selected_product.metafields.reviews.rating.value | plus: 0
  endif

  assign jm_badge = selected_product.metafields.judgeme.badge
  if jm_badge != blank
    if review_rating == blank or review_rating == 0
      if jm_badge contains "data-average-rating='"
        assign review_rating = jm_badge | split: "data-average-rating='" | last | split: "'" | first | plus: 0
      endif
    endif
    if review_count == 0 and jm_badge contains "data-number-of-reviews='"
      assign review_count = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
    endif
  endif

  if review_rating == blank or review_rating == 0
    if selected_product.metafields.judgeme.rating != blank
      assign review_rating = selected_product.metafields.judgeme.rating | plus: 0
    endif
  endif
  if review_count == 0 and selected_product.metafields.judgeme.review_count != blank
    assign review_count = selected_product.metafields.judgeme.review_count | plus: 0
  endif
  if review_rating != blank and review_rating > 0
    assign review_rating = review_rating | round: 1
  endif

  # Star fill width (rating out of 5, as a percentage)
  assign rating_pct = 0
  if review_rating != blank and review_rating > 0
    assign rating_pct = review_rating | times: 20 | at_most: 100
  endif
  assign has_reviews = false
  if review_count > 0 and rating_pct > 0
    assign has_reviews = true
  endif

  # Optional hero image from metafields
  assign metafield_image = selected_product.metafields.custom.sticky_product_image.value | default: selected_product.metafields.custom.sticky_product_image
  if metafield_image == blank
    assign metafield_image = selected_product.metafields.custom.sticky_image.value | default: selected_product.metafields.custom.sticky_image
  endif
  if metafield_image == blank
    assign metafield_image = selected_product.metafields.custom.product_image.value | default: selected_product.metafields.custom.product_image
  endif
  if metafield_image == blank
    assign metafield_image = selected_product.metafields.custom.main_image.value | default: selected_product.metafields.custom.main_image
  endif

  assign show_meta_slide = false
  if metafield_image != blank
    assign show_meta_slide = true
    if selected_product.media.size > 0 and metafield_image.id == selected_product.media.first.id
      assign show_meta_slide = false
    endif
  endif

  assign gallery_total = selected_product.media.size
  if show_meta_slide
    assign gallery_total = gallery_total | plus: 1
  endif

  # Size option
  assign size_option = blank
  assign size_option_index = 0
  unless selected_product.has_only_default_variant
    for product_option in selected_product.options_with_values
      assign option_name_downcase = product_option.name | downcase
      if option_name_downcase contains 'size'
        assign size_option = product_option
        assign size_option_index = forloop.index0
      endif
    endfor
  endunless

  # Selected size text (shown in "At a glance" and above the size buttons)
  assign selected_size_label = current_variant.title
  if size_option != blank
    assign selected_size_label = current_variant.options[size_option_index]
  endif

  # Discount
  assign has_discount = false
  assign pct_off = 0
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign pct_off = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  # Fragrance notes (from tags)
  assign tags_str = selected_product.tags | join: ' ' | downcase
  assign notes_line = blank
  if tags_str contains 'oriental' or tags_str contains 'floral'
    assign notes_line = 'Oriental|Floral Musky|Citrus Floral'
  elsif tags_str contains 'woody'
    assign notes_line = 'Woody|Amber Spice|Fresh Cedar'
  elsif tags_str contains 'fresh'
    assign notes_line = 'Fresh Citrus|Aquatic|Green Notes'
  endif
  assign notes_list = notes_line | split: '|'
%}


<section class="pf-product-template color-{{ section.settings.color_scheme }} product-{{ selected_product.handle }}" data-pf-product data-product-handle="{{ selected_product.handle }}">
  <div class="pf-product-template__shell">

    <!-- ═════════ GALLERY ═════════ -->
    <div class="pf-product-template__media" data-pf-media>
      <div class="pdp-gallery{% if gallery_total <= 1 %} is-single{% endif %}" data-pf-gallery>

        {%- if gallery_total > 1 -%}
          <div class="pdp-gallery__thumbs" aria-label="Product image thumbnails">
            <div class="pdp-gallery__thumbs-track" data-pf-thumbs>
              {%- assign thumb_index = 0 -%}
              {%- if show_meta_slide -%}
                <button type="button" class="pdp-thumb is-active" data-pf-thumb data-slide-index="0" aria-label="Show image 1" aria-current="true">
                  {{ metafield_image | image_url: width: 200 | image_tag: class: 'pdp-thumb__img', widths: '100, 200', sizes: '84px', loading: 'lazy', alt: '' }}
                </button>
                {%- assign thumb_index = 1 -%}
              {%- endif -%}
              {%- for media in selected_product.media -%}
                {%- assign this_index = forloop.index0 | plus: thumb_index -%}
                {%- assign thumb_src = media.preview_image | default: media -%}
                <button type="button"
                  class="pdp-thumb{% if this_index == 0 %} is-active{% endif %}{% if media.media_type == 'video' or media.media_type == 'external_video' %} is-video{% endif %}"
                  data-pf-thumb data-slide-index="{{ this_index }}" data-media-id="{{ media.id }}"
                  aria-label="Show image {{ this_index | plus: 1 }}"
                  aria-current="{% if this_index == 0 %}true{% else %}false{% endif %}">
                  {{ thumb_src | image_url: width: 200 | image_tag: class: 'pdp-thumb__img', widths: '100, 200', sizes: '84px', loading: 'lazy', alt: '' }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Frame keeps the discount badge fixed while the stage scrolls sideways on mobile -->
        <div class="pdp-gallery__frame">
          <div class="pdp-gallery__stage" data-pf-stage data-pf-slides style="--pdp-rows: {{ gallery_total | minus: 1 | at_least: 1 }}">
            {%- assign slide_offset = 0 -%}
            {%- if show_meta_slide -%}
              <article class="pdp-slide is-active" data-pf-slide data-slide-index="0" aria-hidden="false">
                {{ metafield_image | image_url: width: 1800 | image_tag: class: 'pdp-slide__media', widths: '640, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: metafield_image.alt | default: selected_product.title }}
              </article>
              {%- assign slide_offset = 1 -%}
            {%- endif -%}

            {%- for media in selected_product.media -%}
              {%- assign this_index = forloop.index0 | plus: slide_offset -%}
              <article class="pdp-slide{% if this_index == 0 %} is-active{% endif %}" data-pf-slide data-slide-index="{{ this_index }}" data-media-id="{{ media.id }}" aria-hidden="{% if this_index == 0 %}false{% else %}true{% endif %}">
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    assign fetchpriority = 'auto'
                    if this_index == 0
                      assign loading = 'eager'
                      assign fetchpriority = 'high'
                    endif
                  -%}
                  {{ media | image_url: width: 1800 | image_tag: class: 'pdp-slide__media', widths: '640, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: loading, fetchpriority: fetchpriority, alt: media.alt | default: selected_product.title }}
                {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                  {% render 'video', video: media, video_class: 'pdp-slide__media pf-product-template__video', video_loop: true, disable_controls: true, loading: 'lazy' %}
                {%- else -%}
                  {{ media | media_tag }}
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>

          {%- if has_discount -%}
            <span class="pdp-gallery__badge">{{ pct_off }}% off</span>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- ═════════ INFO ═════════ -->
    <div class="pf-product-template__content">
      <div class="pdp-info">

        <div class="pdp-topbar">
          <nav class="pdp-crumbs" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a>
            <span aria-hidden="true">/</span>
            <a href="{{ routes.all_products_collection_url }}">All Products</a>
            <span aria-hidden="true">/</span>
            <span class="pdp-crumbs__current" aria-current="page">{{ selected_product.title }}</span>
          </nav>
          <div class="pdp-topbar__end">
            <p class="pdp-stock{% if current_variant.available %} is-in{% else %} is-out{% endif %}" data-pf-stock>
              <span class="pdp-stock__dot" aria-hidden="true"></span>
              <span data-pf-stock-text>{% if current_variant.available %}In stock, ready to ship{% else %}Sold out{% endif %}</span>
            </p>
            <button type="button" class="pdp-share" data-share-btn aria-label="Share product">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="15" height="15" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>

        <header class="pdp-head">
          <div class="pdp-head__row">
            <div class="pdp-head__main">
              <h1 class="pdp-title">{{ selected_product.title }}</h1>
              <p class="pdp-specs">Eau de Parfum, lasts 6 to 8 hours</p>
              {%- if notes_list.size > 0 -%}
                <p class="pdp-notes">Notes: {{ notes_list | join: ', ' }}</p>
              {%- endif -%}
              {%- if has_reviews -%}
                <a class="pdp-rating" href="#judgeme_product_reviews" data-pf-reviews-scroll aria-label="Rated {{ review_rating }} out of 5 from {{ review_count }} reviews">
                  <span class="pdp-stars" aria-hidden="true">★★★★★<span class="pdp-stars__fill" style="width: {{ rating_pct }}%">★★★★★</span></span>
                  <span class="pdp-rating__text"><strong>{{ review_rating }}</strong> ({{ review_count }} review{% if review_count != 1 %}s{% endif %})</span>
                </a>
              {%- endif -%}
            </div>

            <div class="pdp-price__info">
              <div class="pdp-price__row">
                <span class="pdp-price__main" data-pf-price-main>{% render 'format-price', price: current_variant.price %}</span>
                <span class="pdp-price__compare" data-pf-compare-price{% unless has_discount %} hidden{% endunless %}>{% if has_discount %}{% render 'format-price', price: current_variant.compare_at_price %}{% endif %}</span>
                <span class="pdp-price__off" data-pf-off-badge{% unless has_discount %} hidden{% endunless %}>({{ pct_off }}% OFF)</span>
              </div>
              <span class="pdp-price__tax">Inclusive of all taxes</span>
            </div>
          </div>
        </header>

        <!-- At a glance -->
        <ul class="pdp-glance">
          <li><small>Type</small><strong>Eau de Parfum</strong></li>
          <li><small>Lasts</small><strong>6 to 8 hours</strong></li>
          {%- unless selected_product.has_only_default_variant -%}
            <li><small>Size</small><strong data-pf-glance-size>{{ selected_size_label }}</strong></li>
          {%- endunless -%}
        </ul>

        <!-- Savings, real low-stock and offer line -->
        {%- liquid
          assign save_amt = 0
          if has_discount
            assign save_amt = current_variant.compare_at_price | minus: current_variant.price
          endif
          assign inv_map = ''
          for v in selected_product.variants
            if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
              assign inv_map = inv_map | append: v.id | append: ':' | append: v.inventory_quantity | append: ','
            endif
          endfor
          assign low_threshold = section.settings.low_stock_threshold
          assign cur_qty = 0
          if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
            assign cur_qty = current_variant.inventory_quantity
          endif
          assign show_low = false
          if cur_qty > 0 and cur_qty <= low_threshold
            assign show_low = true
          endif
          assign hurry_pct = 0
          if show_low and low_threshold > 0
            assign hurry_pct = cur_qty | times: 100.0 | divided_by: low_threshold | round | at_least: 8 | at_most: 100
          endif
        -%}
        <div class="pdp-nudges" data-pf-nudges{% unless has_discount or section.settings.offer_text != blank %} hidden{% endunless %}>
          <p class="pdp-save" data-pf-save{% unless has_discount %} hidden{% endunless %}>You save <strong data-pf-save-amount>{% if has_discount %}{% render 'format-price', price: save_amt %}{% endif %}</strong> on this perfume</p>
          {%- if section.settings.offer_text != blank -%}
            <p class="pdp-offer">{{ section.settings.offer_text | escape }}</p>
          {%- endif -%}
        </div>

        <!-- Size -->
        {%- if size_option != blank and size_option.values.size > 0 -%}
          <div class="pdp-option">
            <span class="pdp-option__label">Select Size: <strong data-pf-selected-size>{{ selected_size_label }}</strong></span>
            <div class="pdp-sizes" data-pf-size-selector>
              {%- for val in size_option.values -%}
                {%- liquid
                  assign val_name = val.name | default: val
                  assign val_lower = val_name | downcase
                -%}
                {%- unless val_lower contains 'personal' or val_lower contains 'custom' -%}
                  {%- liquid
                    assign size_variant = blank
                    for v in selected_product.variants
                      if v.option1 == val_name or v.option2 == val_name or v.option3 == val_name
                        assign size_variant = v
                        break
                      endif
                    endfor
                    assign is_selected = false
                    if current_variant != blank and size_variant != blank and current_variant.id == size_variant.id
                      assign is_selected = true
                    elsif forloop.first
                      assign is_selected = true
                    endif
                    assign sv = size_variant | default: current_variant
                  -%}
                  <button type="button" class="pdp-size{% if is_selected %} is-active{% endif %}{% unless sv.available %} is-out{% endunless %}" data-pf-size-pill data-value="{{ val_name | escape }}" data-variant-id="{{ size_variant.id | default: current_variant.id }}" aria-label="Size {{ val_name }}{% unless sv.available %}, sold out{% endunless %}" aria-pressed="{% if is_selected %}true{% else %}false{% endif %}">{{ val_name }}</button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- elsif selected_product.has_only_default_variant == false and selected_product.variants.size > 1 -%}
          <div class="pdp-option">
            <span class="pdp-option__label">Select Size: <strong data-pf-selected-size>{{ selected_size_label }}</strong></span>
            <div class="pdp-sizes" data-pf-size-selector>
              {%- for variant in selected_product.variants -%}
                {%- assign v_lower = variant.title | downcase -%}
                {%- unless v_lower contains 'personal' or v_lower contains 'custom' -%}
                  <button type="button" class="pdp-size{% if variant.id == current_variant.id %} is-active{% endif %}{% unless variant.available %} is-out{% endunless %}" data-pf-size-pill data-value="{{ variant.title | escape }}" data-variant-id="{{ variant.id }}" aria-label="{{ variant.title }}{% unless variant.available %}, sold out{% endunless %}" aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}">{{ variant.title }}</button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- liquid
          assign eta_dispatch = section.settings.dispatch_days | default: 2
          assign eta_min = section.settings.delivery_min_days | default: 3
          assign eta_max = section.settings.delivery_max_days | default: 6
          assign eta_min_secs = eta_dispatch | plus: eta_min | times: 86400
          assign eta_max_secs = eta_dispatch | plus: eta_max | times: 86400
          assign now_secs = 'now' | date: '%s' | plus: 0
          assign eta_min_date = now_secs | plus: eta_min_secs | date: '%a, %-d %b'
          assign eta_max_date = now_secs | plus: eta_max_secs | date: '%a, %-d %b'
        -%}

        {%- if section.settings.show_freeship -%}
          <div class="pdp-freeship" role="note">
            <span class="pdp-freeship__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            <span class="pdp-freeship__text">
              <strong>{{ section.settings.freeship_text | default: 'Free delivery across India' | escape }}</strong>
              {%- if section.settings.freeship_sub != blank -%}
                <span>{{ section.settings.freeship_sub | escape }}</span>
              {%- endif -%}
              <span class="pdp-freeship__eta" data-pf-delivery
                data-dispatch="{{ section.settings.dispatch_days | default: 2 }}"
                data-min="{{ section.settings.delivery_min_days | default: 3 }}"
                data-max="{{ section.settings.delivery_max_days | default: 6 }}"
                {% unless current_variant.available %}hidden{% endunless %}>
                Estimated delivery: <b data-pf-delivery-range>{{ eta_min_date }} to {{ eta_max_date }}</b>
              </span>
            </span>
          </div>
        {%- endif -%}

        <!-- Hurry up: driven by real Shopify inventory, only shows when stock is genuinely low -->
        <div class="pdp-hurry" data-pf-lowstock data-threshold="{{ low_threshold }}" data-inv="{{ inv_map }}" style="--pdp-hurry: {{ hurry_pct }}%"{% unless show_low %} hidden{% endunless %}>
          <div class="pdp-hurry__top">
            <span class="pdp-hurry__title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.2 1 2 2 2.5C11 8 11 5 12 3z"/></svg>
              <span>Hurry, only <strong data-pf-lowstock-qty>{% if show_low %}{{ cur_qty }}{% endif %}</strong> left in stock</span>
            </span>
            <span class="pdp-hurry__tag">Selling fast</span>
          </div>
          <div class="pdp-hurry__bar" role="presentation"><span class="pdp-hurry__fill"></span></div>
          <p class="pdp-hurry__sub">Once this batch is gone, restocking may take a few weeks.</p>
        </div>

        <!-- Actions -->
        {%- form 'product', selected_product, id: form_id, class: 'pdp-form', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pf-variant-id>
          <input type="hidden" name="quantity" value="1" data-pf-qty-field>
          <div class="pdp-actions">
            <button type="button" class="pdp-btn pdp-btn--add" data-pf-add-to-bag {% unless current_variant.available %}disabled{% endunless %}>
              <span data-pf-add-text>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
            </button>
            <button type="button" class="pdp-btn pdp-btn--buy" data-pf-buy-now {% unless current_variant.available %}disabled{% endunless %}>Buy now</button>
          </div>
        {%- endform -%}

        <!-- Secure payments (the delivery date now lives in the free delivery box; it only shows here if that box is turned off) -->
        {%- if section.settings.show_secure_pay or section.settings.show_freeship == false -%}
        <div class="pdp-meta-row">
          {%- unless section.settings.show_freeship -%}
            <p class="pdp-delivery" data-pf-delivery
               data-dispatch="{{ section.settings.dispatch_days | default: 2 }}"
               data-min="{{ section.settings.delivery_min_days | default: 3 }}"
               data-max="{{ section.settings.delivery_max_days | default: 6 }}"
               {% unless current_variant.available %}hidden{% endunless %}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span class="pdp-meta__text"><small>Estimated delivery</small><strong data-pf-delivery-range>{{ eta_min_date }} to {{ eta_max_date }}</strong></span>
            </p>
          {%- endunless -%}
          {%- if section.settings.show_secure_pay -%}
            <div class="pdp-secure">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
              <span class="pdp-meta__text">
                <strong>100% secure payments</strong>
                <small>Pay safely with UPI, Cards or Net Banking</small>
              </span>
              <span class="pdp-secure__chips" aria-hidden="true">
                <span>UPI</span><span>Cards</span><span>Net Banking</span>
              </span>
            </div>
          {%- endif -%}
        </div>
        {%- endif -%}

        <!-- Purchase assurance (edit in the theme editor) -->
        {%- if section.settings.show_cod or section.settings.shipping_note != blank or section.settings.returns_note != blank -%}
          <ul class="pdp-assure">
            {%- if section.settings.show_cod -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg><span>Cash on Delivery available</span></li>
            {%- endif -%}
            {%- if section.settings.shipping_note != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg><span>{{ section.settings.shipping_note | escape }}</span></li>
            {%- endif -%}
            {%- if section.settings.returns_note != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg><span>{{ section.settings.returns_note | escape }}</span></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        <!-- Assurances -->
        <ul class="pdp-trust">
          <li class="pdp-trust__item">
            <span class="pdp-trust__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/></svg>
            </span>
            <span class="pdp-trust__text">
              <strong>Farm to fragrance</strong>
              <small>Fine natural oils</small>
            </span>
          </li>
          <li class="pdp-trust__item">
            <span class="pdp-trust__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            </span>
            <span class="pdp-trust__text">
              <strong>100% authentic</strong>
              <small>Sealed and genuine</small>
            </span>
          </li>
          <li class="pdp-trust__item">
            <span class="pdp-trust__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            <span class="pdp-trust__text">
              <strong>Express shipping</strong>
              <small>Tracked to your door</small>
            </span>
          </li>
        </ul>

        <!-- Information (one accordion, one open at a time) -->
        <div class="pf-accordions">
          <details class="pf-accordion-item" name="pdp-info" open>
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Description</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body rte">
              {% assign clean_desc = selected_product.description | strip_html | strip %}
              {% if clean_desc != blank %}
                {% assign formatted_desc = selected_product.description | replace: 'Ahmed Al Maghribi Bin Shaikh', selected_product.title | replace: 'Ahmed Al Maghribi', 'Balad Perfumes' %}
                {{ formatted_desc }}
              {% else %}
                <p>Experience the beauty of <strong>{{ selected_product.title }}</strong>, a luxury fragrance crafted with fine concentrated oils, luminous florals, and warm amber notes. Sophisticated, elegant, and long-lasting.</p>
              {% endif %}
            </div>
          </details>

          <details class="pf-accordion-item" name="pdp-info">
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Wear it right</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body">
              {% if selected_product.metafields.custom.wear_it_right != blank %}
                <div class="rte">{{ selected_product.metafields.custom.wear_it_right | metafield_tag }}</div>
              {% else %}
                <ul class="pf-accordion-bullets">
                  <li>Apply on moisturised skin for better longevity.</li>
                  <li>Spray on pulse points: neck, wrists and behind the ears.</li>
                  <li>Hold the bottle 15 cm away for even application.</li>
                  <li>Don't rub after spraying; let it dry naturally.</li>
                  <li>Store away from heat, sunlight and humidity.</li>
                </ul>
              {% endif %}
            </div>
          </details>

          <details class="pf-accordion-item" name="pdp-info">
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Occasion</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body">
              {% if selected_product.metafields.custom.occasion != blank %}
                <div class="rte">{{ selected_product.metafields.custom.occasion | metafield_tag }}</div>
              {% else %}
                <p>Ideal for daily signature wear, evening events, celebrations, and luxury gifting.</p>
              {% endif %}
            </div>
          </details>

          <details class="pf-accordion-item" name="pdp-info">
            <summary class="pf-accordion-header">
              <span class="pf-accordion-title">Shipping</span>
              <span class="pf-accordion-icon" aria-hidden="true"></span>
            </summary>
            <div class="pf-accordion-body rte">
              {% if selected_product.metafields.custom.delivery_returns != blank %}
                {{ selected_product.metafields.custom.delivery_returns | metafield_tag }}
              {% else %}
                <p>Fast express shipping across India with real-time tracking, Cash on Delivery options, and careful protective packaging.</p>
              {% endif %}
            </div>
          </details>
        </div>

        <button type="button" class="pf-buybox__write-review" data-pf-reviews-open>Write a review</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="VariantData-{{ section.id }}">
    {{ selected_product.variants | json }}
  </script>

  <!-- Sticky bar -->
  <div class="pf-product-template__sticky-bar" data-pf-sticky-bar aria-hidden="true">
    <button type="button" class="pf-product-template__sticky-close" data-pf-sticky-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="pf-product-template__sticky-shell">
      <div class="pf-product-template__sticky-info">
        {%- assign sticky_img = selected_product.featured_media | default: selected_product.media.first -%}
        {%- if sticky_img != blank -%}
          <div class="pf-product-template__sticky-img">
            {{ sticky_img | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '52px', loading: 'lazy', alt: selected_product.title }}
          </div>
        {%- endif -%}
        <div class="pf-product-template__sticky-text">
          <span class="pf-product-template__sticky-title">{{ selected_product.title }}</span>
          <span class="pf-product-template__sticky-price-wrap">
            <span class="pf-product-template__sticky-price" data-pf-sticky-price>{% render 'format-price', price: current_variant.price %}</span>
            <span class="pf-product-template__sticky-compare-price" data-pf-sticky-compare-price{% unless has_discount %} style="display:none"{% endunless %}>{% if has_discount %}{% render 'format-price', price: current_variant.compare_at_price %}{% endif %}</span>
          </span>
        </div>
      </div>
      <div class="pf-product-template__sticky-actions">
        <button type="button" class="pf-sticky-btn pf-sticky-btn--add" data-pf-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
          <span data-pf-sticky-add-text>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
        </button>
        <button type="button" class="pf-sticky-btn pf-sticky-btn--buy" data-pf-sticky-buy {% unless current_variant.available %}disabled{% endunless %}>Buy now</button>
      </div>
    </div>
  </div>
</section>

<style>
  .pf-product-template {
    --pf-bg: #ffffff;
    --pf-ink: #151515;
    --pf-text: #4b4b4b;
    --pf-muted: #7a7a7a;
    --pf-line: #ececec;
    --pf-soft: #f7f5f1;
    --pf-gold: #a37b35;
    --pf-gold-soft: #f4ecdb;

    /* Border radius scale: one value per level so every card follows the same rule */
    --pf-radius: 16px;      /* outer surfaces: photos, info panel */
    --pf-radius-md: 12px;   /* cards and buttons: free delivery, trust strip, buttons, sticky card */
    --pf-radius-sm: 8px;    /* small items: size boxes, thumbnails, small images */

    background: var(--pf-bg);
    color: var(--pf-ink);
    margin: 0;
    padding: 0;
  }

  .pf-product-template *,
  .pf-product-template *::before,
  .pf-product-template *::after { box-sizing: border-box; }

  .pf-product-template__shell {
    width: min(100%, 1520px);
    margin: 0 auto;
    padding: 8px 12px 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .pf-product-template__media,
  .pf-product-template__content { min-width: 0; }

  /* ───────── Gallery ───────── */
  .pdp-gallery { display: flex; flex-direction: column; gap: 10px; width: 100%; min-width: 0; }

  /* Frame holds the stage and the badge, so the badge does not scroll away with the slides */
  .pdp-gallery__frame { position: relative; min-width: 0; }

  .pdp-gallery__stage {
    position: relative;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    aspect-ratio: 2 / 3;
    max-height: 78vh;
    max-height: 78svh;
    background: #f1ede6;
    border-radius: var(--pf-radius);
  }

  .pdp-gallery__stage::-webkit-scrollbar,
  .pdp-gallery__thumbs-track::-webkit-scrollbar { display: none; }

  .pdp-slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
    overflow: hidden;
    background: #f1ede6;
    border-radius: var(--pf-radius);
  }

  .pdp-slide img, .pdp-slide video, .pdp-slide iframe, .pdp-slide picture, .pdp-slide__media {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: center;
  }

  .pdp-gallery__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 6px 12px;
    background: var(--pf-ink);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    border-radius: 999px; /* small tag stays a pill on purpose */
    pointer-events: none;
  }

  .pdp-gallery__thumbs { order: 2; min-width: 0; }
  .pdp-gallery__thumbs-track { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px; }

  .pdp-thumb {
    position: relative;
    flex: 0 0 56px;
    width: 56px;
    height: 70px;
    padding: 0;
    border: 1.5px solid transparent;
    border-radius: var(--pf-radius-sm);
    background: #f1ede6;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .pdp-thumb:hover, .pdp-thumb.is-active { opacity: 1; }
  .pdp-thumb.is-active { border-color: var(--pf-ink); }
  .pdp-thumb:focus-visible { outline: 2px solid var(--pf-ink); outline-offset: 2px; }
  .pdp-thumb__img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .pdp-thumb.is-video::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-30%, -50%);
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent #fff;
    filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.5));
  }

  /* ───────── Product details (sections separated by thin bottom borders) ───────── */
  .pdp-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 22px 18px 20px;
    background: #fff;
    border: 1px solid #ebe8e2;
    border-radius: var(--pf-radius);
  }

  /* ───── Top bar: breadcrumb on the left, stock pill + share on the right ───── */
  .pdp-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .pdp-topbar__end { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }

  .pdp-crumbs {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 7px;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.2;
    color: var(--pf-muted);
  }
  .pdp-crumbs a { flex-shrink: 0; color: inherit; text-decoration: none; transition: color 0.2s ease; }
  .pdp-crumbs a:hover { color: var(--pf-ink); }
  .pdp-crumbs a:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; border-radius: 2px; }
  .pdp-crumbs > span[aria-hidden] { flex-shrink: 0; color: #c9c4b8; }
  .pdp-crumbs__current { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; color: var(--pf-ink); }

  /* Phones: breadcrumb gets its own row (long names cut with ...), stock and share sit below it */
  @media screen and (max-width: 600px) {
    .pdp-topbar { flex-wrap: wrap; row-gap: 10px; margin-bottom: 14px; }
    .pdp-crumbs { flex: 1 1 100%; }
    .pdp-topbar__end { width: 100%; justify-content: space-between; }
    .pdp-share { width: 34px; height: 34px; }
  }

  .pdp-share {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid #e3dfd7;
    border-radius: 50%;
    background: #fff;
    color: var(--pf-ink);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, transform 0.12s ease;
  }
  .pdp-share:hover { color: #fff; background: var(--pf-ink); border-color: var(--pf-ink); }
  .pdp-share:active { transform: scale(0.95); }
  .pdp-share:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; }

  /* ───── Head: name, details and rating on the left, price on the right ───── */
  .pdp-head { padding-bottom: 18px; border-bottom: 1px solid #ebe8e2; }
  .pdp-head__row { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
  .pdp-head__main { flex: 1 1 auto; min-width: 0; }

  .pdp-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--pf-ink);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .pdp-specs { margin: 8px 0 0; font-size: 13px; line-height: 1.4; color: var(--pf-muted); }
  .pdp-notes { margin: 3px 0 0; font-size: 13px; line-height: 1.4; color: var(--pf-gold); font-weight: 500; }

  /* Stars (used by the rating line under the title) */
  .pdp-stars {
    position: relative;
    display: inline-block;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 2px;
    white-space: nowrap;
    color: #ddd6c6;
  }
  .pdp-stars__fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--pf-gold);
  }

  .pdp-rating { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 13px; color: var(--pf-text); text-decoration: none; }
  .pdp-rating:hover .pdp-rating__text { text-decoration: underline; }
  .pdp-rating__text strong { font-weight: 700; color: var(--pf-ink); }

  /* Price block, right-aligned: big price, old price, discount, tax note */
  .pdp-price__info { flex: 0 0 auto; text-align: right; }
  .pdp-price__row { display: flex; align-items: baseline; justify-content: flex-end; flex-wrap: wrap; gap: 4px 10px; }
  .pdp-price__main { font-size: 26px; font-weight: 600; line-height: 1; letter-spacing: -0.01em; color: var(--pf-ink); }
  .pdp-price__compare { font-size: 14px; color: #a3a3a3; text-decoration: line-through; }
  .pdp-price__off { font-size: 12.5px; font-weight: 700; letter-spacing: 0.01em; color: #b4501e; }
  .pdp-price__compare[hidden], .pdp-price__off[hidden] { display: none; }
  .pdp-price__tax { display: block; margin-top: 6px; font-size: 12px; color: var(--pf-muted); }

  /* At a glance: minimal row, no boxes, just thin dividers between the facts */
  .pdp-glance {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    margin: 0;
    padding: 16px 0;
    border-bottom: 1px solid #ebe8e2;
    list-style: none;
  }
  .pdp-glance li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 0 18px;
    border-left: 1px solid #ebe8e2;
  }
  .pdp-glance li:first-child { padding-left: 0; border-left: 0; }
  .pdp-glance li:last-child { padding-right: 0; }
  .pdp-glance small { font-size: 12px; line-height: 1.2; color: var(--pf-muted); }
  .pdp-glance strong { font-size: 14px; font-weight: 600; line-height: 1.3; color: var(--pf-ink); overflow-wrap: anywhere; }
  @media screen and (max-width: 420px) {
    .pdp-glance li { padding: 0 12px; }
    .pdp-glance strong { font-size: 13px; }
  }

  /* Section 4: size. The selected size uses a gold outline, soft gold fill and a tick,
     so it never looks like the solid black Buy Now button. A single size stays a compact box. */
  .pdp-option { margin: 0; padding: 16px 0; border-bottom: 1px solid #ebe8e2; }
  .pdp-sizes[hidden] { display: none; }
  .pdp-option__label { display: block; margin-bottom: 12px; font-size: 13px; font-weight: 500; color: var(--pf-ink); }
  .pdp-option__label strong { font-weight: 700; color: var(--pf-gold); }
  .pdp-sizes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 132px));
    gap: 10px;
  }
  .pdp-size {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 16px;
    border: 1.5px solid #e3dfd7;
    border-radius: var(--pf-radius-sm);
    background: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--pf-ink);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.12s ease;
  }
  .pdp-size:hover { border-color: var(--pf-gold); }
  .pdp-size:active { transform: scale(0.97); }

  /* Selected size: gold outline + soft gold fill + tick (clearly different from the black Buy Now button) */
  .pdp-size.is-active {
    background: var(--pf-gold-soft);
    border-color: var(--pf-gold);
    color: var(--pf-ink);
    font-weight: 700;
  }
  .pdp-size.is-active::before {
    content: '';
    width: 5px;
    height: 9px;
    margin-top: -2px;
    border: solid var(--pf-gold);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .pdp-size.is-out { color: #a3a3a3; text-decoration: line-through; background: #faf9f7; }
  .pdp-size.is-out.is-active { color: #a3a3a3; background: #faf9f7; border-color: var(--pf-gold); }
  .pdp-size.is-out.is-active::before { border-color: #c9c4b8; }
  .pdp-size:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 2px; }

  .pdp-stock { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 7px; margin: 0; padding: 6px 11px; border-radius: 999px; font-size: 12px; font-weight: 500; line-height: 1.2; white-space: nowrap; }
  .pdp-stock__dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .pdp-stock.is-in { color: #1d7a45; background: #eaf6ee; }
  .pdp-stock.is-in .pdp-stock__dot { background: #1d7a45; }
  .pdp-stock.is-out { color: #b42318; background: #fdecea; }
  .pdp-stock.is-out .pdp-stock__dot { background: #b42318; }

  /* Hurry up: stock progress bar (width follows real inventory) */
  .pdp-hurry {
    margin: 16px 0 0;
    padding: 12px 14px;
    background: #fff6f0;
    border: 1px solid #f1d3bf;
    border-radius: var(--pf-radius-md);
  }
  .pdp-hurry[hidden] { display: none; }
  .pdp-hurry__top { display: flex; flex-wrap: wrap; row-gap: 6px; align-items: center; justify-content: space-between; gap: 10px; font-size: 13px; font-weight: 600; color: #b4501e; }
  .pdp-hurry__title { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .pdp-hurry__title svg { flex-shrink: 0; width: 17px; height: 17px; }
  .pdp-hurry__title strong { font-weight: 800; }
  .pdp-hurry__tag { flex-shrink: 0; padding: 3px 9px; border-radius: 999px; background: #b4501e; color: #fff; font-size: 11px; font-weight: 600; letter-spacing: 0.02em; }
  .pdp-hurry__bar { margin-top: 10px; height: 8px; overflow: hidden; border-radius: 999px; background: #f5ddcd; }
  .pdp-hurry__fill {
    display: block;
    height: 100%;
    width: var(--pdp-hurry, 100%);
    border-radius: inherit;
    background: linear-gradient(90deg, #e2703a, #b4501e);
    transition: width 0.5s ease;
  }
  .pdp-hurry__sub { margin: 8px 0 0; font-size: 12px; line-height: 1.4; color: var(--pf-text); }

  /* Buttons */
  .pdp-form { margin: 0; }
  .pdp-actions { display: flex; gap: 10px; margin-top: 16px; }

  .pdp-btn {
    flex: 1 1 0;
    height: 48px;
    margin: 0;
    padding: 0 14px;
    border: 1px solid var(--pf-ink);
    border-radius: var(--pf-radius-md);
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.12s ease;
  }

  .pdp-btn:active:not(:disabled) { transform: scale(0.985); }
  .pdp-btn:focus-visible { outline: 2px solid var(--pf-gold); outline-offset: 3px; }
  .pdp-btn--add { background: #fff; color: var(--pf-ink); }
  .pdp-btn--add:hover:not(:disabled) { background: var(--pf-soft); }
  .pdp-btn--buy { background: var(--pf-ink); color: #fff; }
  .pdp-btn--buy:hover:not(:disabled) { background: #000; }
  .pdp-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  /* Estimated delivery + secure payments (already has top and bottom borders) */
  .pdp-meta-row {
    display: flex;
    align-items: stretch;
    margin: 16px 0 0;
    padding: 14px 0;
    border-top: 1px solid #ebe8e2;
    border-bottom: 1px solid #ebe8e2;
  }
  .pdp-delivery,
  .pdp-secure {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0 14px;
    background: none;
    border: 0;
    border-radius: 0;
    line-height: 1.3;
    color: var(--pf-text);
  }
  .pdp-delivery { padding-left: 0; }
  .pdp-delivery + .pdp-secure { border-left: 1px solid #ebe8e2; }
  .pdp-delivery[hidden] { display: none; }
  .pdp-delivery[hidden] + .pdp-secure { border-left: 0; padding-left: 0; }
  .pdp-delivery svg, .pdp-secure svg { flex-shrink: 0; width: 22px; height: 22px; color: var(--pf-ink); }
  .pdp-secure svg { color: #1f7a3d; }
  .pdp-meta__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
