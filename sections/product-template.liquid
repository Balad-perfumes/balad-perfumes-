{% javascript %}
  (() => {
    const root = document.querySelector('[data-pf-product]');
    if (!root) return;

    const slidesRail = root.querySelector('[data-pf-slides]');
    const slides = [...root.querySelectorAll('[data-pf-slide]')];
    const thumbs = [...root.querySelectorAll('[data-pf-thumb]')];
    const thumbsTrack = root.querySelector('[data-pf-thumbs]');
    const sizePills = [...root.querySelectorAll('[data-pf-size-pill]')];
    const variantIdInput = root.querySelector('[data-pf-variant-id]');
    const qtyField = root.querySelector('[data-pf-qty-field]');
    const addToBagBtn = root.querySelector('[data-pf-add-to-bag]');
    const buyNowBtn = root.querySelector('[data-pf-buy-now]');
    const addTextEl = root.querySelector('[data-pf-add-text]');
    const priceMainEl = root.querySelector('[data-pf-price-main]');
    const compareEl = root.querySelector('[data-pf-compare-price]');
    const offEl = root.querySelector('[data-pf-off-badge]');
    const stockEl = root.querySelector('[data-pf-stock]');
    const stockTextEl = root.querySelector('[data-pf-stock-text]');
    const deliveryEl = root.querySelector('[data-pf-delivery]');
    const stickyBar = root.querySelector('[data-pf-sticky-bar]');
    const stickyAddBtn = root.querySelector('[data-pf-sticky-add]');
    const stickyBuyBtn = root.querySelector('[data-pf-sticky-buy]');
    const stickyClose = root.querySelector('[data-pf-sticky-close]');
    const stickyAddText = root.querySelector('[data-pf-sticky-add-text]');
    const stickyPriceEl = root.querySelector('[data-pf-sticky-price]');
    const stickyCompareEl = root.querySelector('[data-pf-sticky-compare-price]');

    const variantDataEl = root.querySelector('[id^="VariantData-"]');
    const variantData = variantDataEl ? JSON.parse(variantDataEl.textContent) : [];
    const variantMap = {};
    if (Array.isArray(variantData)) variantData.forEach((v) => { variantMap[v.id] = v; });

    const formatMoney = (cents) => {
      const rupees = (Number(cents) || 0) / 100;
      return '\u20B9' + rupees.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    };

    // ── Gallery ──
    const desktopQuery = window.matchMedia('(min-width: 990px)');
    let lockUntil = 0; // while a thumbnail-triggered smooth scroll runs, ignore scroll events so the thumbs do not flicker

    const revealThumb = (thumb) => {
      if (!thumbsTrack || !thumb) return;
      const tr = thumbsTrack.getBoundingClientRect();
      const r = thumb.getBoundingClientRect();
      if (r.top < tr.top) thumbsTrack.scrollTop += r.top - tr.top;
      else if (r.bottom > tr.bottom) thumbsTrack.scrollTop += r.bottom - tr.bottom;
      if (r.left < tr.left) thumbsTrack.scrollLeft += r.left - tr.left;
      else if (r.right > tr.right) thumbsTrack.scrollLeft += r.right - tr.right;
    };

    const setActive = (index) => {
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        slide.querySelectorAll('video').forEach((video) => {
          if (!active) video.pause();
          else if (video.autoplay) video.play().catch(() => {});
        });
      });
      thumbs.forEach((thumb, i) => {
        const active = i === index;
        thumb.classList.toggle('is-active', active);
        thumb.setAttribute('aria-current', active ? 'true' : 'false');
      });
      revealThumb(thumbs[index]);
    };

    const goToSlide = (index) => {
      const slide = slides[index];
      if (!slide) return;
      if (!desktopQuery.matches && slidesRail) {
        lockUntil = Date.now() + 600;
        slidesRail.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      }
      setActive(index);
    };

    const goToMediaId = (mediaId) => {
      if (!mediaId) return;
      const index = slides.findIndex((s) => s.dataset.mediaId === String(mediaId));
      if (index >= 0) goToSlide(index);
    };

    if (slides.length) {
      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => goToSlide(parseInt(thumb.dataset.slideIndex, 10) || 0));
      });

      if (slidesRail) {
        let raf = 0;
        slidesRail.addEventListener('scroll', () => {
          if (desktopQuery.matches) return;
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            if (Date.now() < lockUntil) return;
            const width = slidesRail.clientWidth || 1;
            const index = Math.max(0, Math.min(slides.length - 1, Math.round(slidesRail.scrollLeft / width)));
            setActive(index);
          });
        }, { passive: true });
      }
      setActive(0);
    }

    // ── Desktop: keep the details panel in view (and its bottom reachable if it is taller than the window) ──
    const infoPanel = root.querySelector('.pdp-info');
    if (infoPanel) {
      const placeInfo = () => {
        if (!desktopQuery.matches) { infoPanel.style.removeProperty('--pdp-info-top'); return; }
        const header = parseFloat(getComputedStyle(root).getPropertyValue('--header-group-height')) || 66;
        const base = header + 12;
        const fit = window.innerHeight - infoPanel.offsetHeight - 16;
        infoPanel.style.setProperty('--pdp-info-top', Math.min(base, fit) + 'px');
      };
      placeInfo();
      window.addEventListener('resize', placeInfo);
      if ('ResizeObserver' in window) new ResizeObserver(placeInfo).observe(infoPanel);
    }

    // ── Desktop: pin the photo block too. When the details are taller than the photos, the photos stay in view
    //    (at the top, or at the bottom edge if they are taller than the window) until the details end. ──
    const galleryEl = root.querySelector('[data-pf-gallery]');
    if (galleryEl) {
      const placeGallery = () => {
        if (!desktopQuery.matches) { galleryEl.style.removeProperty('--pdp-gallery-top'); return; }
        const header = parseFloat(getComputedStyle(root).getPropertyValue('--header-group-height')) || 66;
        const base = header + 12;
        const fit = window.innerHeight - galleryEl.offsetHeight - 16;
        galleryEl.style.setProperty('--pdp-gallery-top', Math.min(base, fit) + 'px');
      };
      placeGallery();
      window.addEventListener('resize', placeGallery);
      window.addEventListener('load', placeGallery);
      if ('ResizeObserver' in window) new ResizeObserver(placeGallery).observe(galleryEl);
    }

    // ── Estimated delivery date (calculated from today in the visitor's browser) ──
    if (deliveryEl) {
      const dispatch = parseInt(deliveryEl.dataset.dispatch, 10) || 0;
      const minDays = dispatch + (parseInt(deliveryEl.dataset.min, 10) || 3);
      const maxDays = dispatch + (parseInt(deliveryEl.dataset.max, 10) || 7);
      const rangeEl = deliveryEl.querySelector('[data-pf-delivery-range]');
      const fmt = (days) => {
        const d = new Date();
        d.setDate(d.getDate() + days);
        return d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
      };
      if (rangeEl) rangeEl.textContent = fmt(minDays) + ' to ' + fmt(maxDays);
    }

    // Short "Arrives 14–18 Nov" range in the delivery promise row
    const promiseRangeEl = root.querySelector('[data-pf-promise-range]');
    if (promiseRangeEl) {
      const dispatch = parseInt(promiseRangeEl.dataset.dispatch, 10) || 0;
      const at = (n) => { const d = new Date(); d.setDate(d.getDate() + dispatch + n); return d; };
      const a = at(parseInt(promiseRangeEl.dataset.min, 10) || 3);
      const b = at(parseInt(promiseRangeEl.dataset.max, 10) || 7);
      const mon = (d) => d.toLocaleDateString('en-IN', { month: 'short' });
      promiseRangeEl.textContent = 'Arrives ' + (a.getMonth() === b.getMonth()
        ? a.getDate() + '–' + b.getDate() + ' ' + mon(b)
        : a.getDate() + ' ' + mon(a) + ' – ' + b.getDate() + ' ' + mon(b));
    }

    // ── Variant sync ──
    const syncVariant = (variantId) => {
      if (variantIdInput && variantId) variantIdInput.value = variantId;
      const v = variantMap[variantId];
      if (!v) return;

      const available = v.available;
      [addToBagBtn, buyNowBtn, stickyAddBtn, stickyBuyBtn].forEach((b) => { if (b) b.disabled = !available; });
      if (addTextEl) addTextEl.textContent = available ? 'Add to bag' : 'Sold out';
      if (stickyAddText) stickyAddText.textContent = available ? 'Add to cart' : 'Sold out';

      if (deliveryEl) deliveryEl.hidden = !available;
      if (stockEl) {
        stockEl.classList.toggle('is-in', !!available);
        stockEl.classList.toggle('is-out', !available);
      }
      if (stockTextEl) stockTextEl.textContent = available ? 'In Stock' : 'Sold Out';

      if (v.price != null) {
        const priceText = formatMoney(v.price);
        const hasDiscount = v.compare_at_price && v.compare_at_price > v.price;

        if (priceMainEl) priceMainEl.textContent = priceText;
        if (compareEl) {
          compareEl.textContent = hasDiscount ? formatMoney(v.compare_at_price) : '';
          compareEl.hidden = !hasDiscount;
        }
        if (offEl) {
          if (hasDiscount) {
            const pct = Math.round(((v.compare_at_price - v.price) / v.compare_at_price) * 100);
            offEl.textContent = pct + '% OFF';
          }
          offEl.hidden = !hasDiscount;
        }
        if (stickyPriceEl) stickyPriceEl.textContent = priceText;
        const stickyBtnPriceEl = root.querySelector('[data-pf-sticky-btn-price]');
        if (stickyBtnPriceEl) stickyBtnPriceEl.textContent = priceText;
        if (stickyCompareEl) {
          stickyCompareEl.textContent = hasDiscount ? formatMoney(v.compare_at_price) : '';
          stickyCompareEl.style.display = hasDiscount ? 'inline' : 'none';
        }
        const stickyOffEl = root.querySelector('[data-pf-sticky-off]');
        if (stickyOffEl) {
          stickyOffEl.textContent = hasDiscount ? Math.round(((v.compare_at_price - v.price) / v.compare_at_price) * 100) + '% OFF' : '';
          stickyOffEl.hidden = !hasDiscount;
        }
        const stickyVariantEl = root.querySelector('[data-pf-sticky-variant]');
        if (stickyVariantEl && v.title && v.title !== 'Default Title') {
          stickyVariantEl.textContent = v.title;
          stickyVariantEl.hidden = false;
        }
      }

      const saveEl = root.querySelector('[data-pf-save]');
      if (saveEl) {
        const diff = v.compare_at_price && v.compare_at_price > v.price ? v.compare_at_price - v.price : 0;
        saveEl.hidden = !diff;
        const amtEl = saveEl.querySelector('[data-pf-save-amount]');
        if (amtEl && diff) amtEl.textContent = formatMoney(diff);
      }

      // Hide the whole nudges row (and its border) when nothing inside it is visible
      const nudgesEl = root.querySelector('[data-pf-nudges]');
      if (nudgesEl) nudgesEl.hidden = ![...nudgesEl.children].some((c) => !c.hidden);

      // Hurry up bar: uses the real inventory of the selected size
      const lowEl = root.querySelector('[data-pf-lowstock]');
      if (lowEl) {
        const threshold = parseInt(lowEl.dataset.threshold, 10) || 0;
        const match = (lowEl.dataset.inv || '').split(',').find((pair) => pair.split(':')[0] === String(v.id));
        const qty = match ? parseInt(match.split(':')[1], 10) : 0;
        const show = threshold > 0 && !!available && qty > 0 && qty <= threshold;
        lowEl.hidden = !show;
        const qtyEl = lowEl.querySelector('[data-pf-lowstock-qty]');
        if (qtyEl) qtyEl.textContent = show ? qty : '';
        if (show) {
          const pct = Math.max(8, Math.min(100, Math.round((qty / threshold) * 100)));
          lowEl.style.setProperty('--pdp-hurry', pct + '%');
        }
      }

      if (v.featured_media && v.featured_media.id) goToMediaId(v.featured_media.id);
    };

    sizePills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        sizePills.forEach((p) => {
          p.classList.remove('is-active');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('is-active');
        pill.setAttribute('aria-pressed', 'true');

        // Show the selected size in the "At a glance" row and in the "Select Size" label
        root.querySelectorAll('[data-pf-glance-size], [data-pf-selected-size]').forEach((el) => {
          el.textContent = pill.dataset.value;
        });

        if (pill.dataset.variantId) syncVariant(pill.dataset.variantId);
      });
    });

    // Spinner in place of the label while a request runs (CSS: .pf-btn-loading)
    const setBtnLoading = (btn, loading) => {
      if (!btn) return;
      btn.disabled = loading;
      btn.classList.toggle('pf-btn-loading', loading);
      if (loading) btn.setAttribute('aria-busy', 'true');
      else btn.removeAttribute('aria-busy');
    };

    // ── Add to bag ──
    const handleAddToBag = async (btn) => {
      const variantId = variantIdInput?.value;
      if (!variantId || (btn && btn.disabled)) return;

      const textEl = btn?.querySelector('[data-pf-sticky-add-text], [data-pf-add-text]') || btn;
      const originalText = textEl ? textEl.textContent : 'Add to bag';
      setBtnLoading(btn, true);

      try {
        const sectionIds = [];
        document.querySelectorAll('cart-items-component').forEach((item) => {
          if (item.dataset.sectionId && !sectionIds.includes(item.dataset.sectionId)) sectionIds.push(item.dataset.sectionId);
        });

        const formData = new FormData();
        formData.append('id', variantId);
        formData.append('quantity', 1);
        if (sectionIds.length > 0) {
          formData.append('sections', sectionIds.join(','));
          formData.append('sections_url', window.location.pathname);
        }

        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          body: formData
        });
        if (!response.ok) throw new Error('Add to cart failed');
        const addData = await response.json();

        const cartResponse = await fetch('/cart.js');
        const cartData = await cartResponse.json();

        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            resource: cartData,
            sourceId: 'pf-product-template',
            data: { itemCount: cartData.item_count, sections: addData.sections }
          }
        }));

        const cartDrawer = document.getElementById('cart-drawer') || document.querySelector('cart-drawer, cart-drawer-component');
        if (cartDrawer && typeof cartDrawer.open === 'function') {
          cartDrawer.open();
        } else if (cartDrawer && typeof cartDrawer.showDialog === 'function') {
          cartDrawer.showDialog();
        } else {
          const trigger = document.querySelector('[data-testid="cart-drawer-trigger"], [data-cart-drawer-trigger], .header__icon--cart, #cart-icon-bubble');
          if (trigger) trigger.click();
          else window.location.href = window.Shopify?.routes?.root ? `${window.Shopify.routes.root}cart` : '/cart';
        }

        setBtnLoading(btn, false);
      } catch (err) {
        console.error('Add to cart error:', err);
        setBtnLoading(btn, false);
        if (btn) btn.disabled = true;
        if (textEl) textEl.textContent = 'Try again';
        setTimeout(() => {
          if (textEl) textEl.textContent = originalText;
          if (btn) btn.disabled = false;
        }, 1200);
      }
    };

    [addToBagBtn, stickyAddBtn].forEach((btn) => {
      if (!btn) return;
      btn.addEventListener('click', (e) => { e.preventDefault(); handleAddToBag(btn); });
    });

    // ── Buy now (main button + card button) ──
    const handleBuyNow = async (btn) => {
      const variantId = variantIdInput?.value;
      if (!variantId || !btn || btn.disabled) return;

      setBtnLoading(btn, true);

      try {
        const formData = new FormData();
        formData.append('id', variantId);
        formData.append('quantity', Math.max(1, parseInt(qtyField?.value, 10) || 1));
        const response = await fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js`, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          body: formData
        });
        if (!response.ok) throw new Error('Could not add this item to the cart');
        window.location.assign(`${window.Shopify?.routes?.root || '/'}checkout`);
      } catch (err) {
        console.error('Buy Now error:', err);
        setBtnLoading(btn, false);
        alert('We could not start checkout. Please try again.');
      }
    };

    [buyNowBtn, stickyBuyBtn].forEach((btn) => {
      if (!btn) return;
      btn.addEventListener('click', (e) => { e.preventDefault(); handleBuyNow(btn); });
    });
    // Back from checkout restores this page from the back/forward cache with Buy now still spinning
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) root.querySelectorAll('.pf-btn-loading').forEach((b) => setBtnLoading(b, false));
    });

    // ── Share ──
    const shareBtn = root.querySelector('[data-share-btn]');
    if (shareBtn) {
      shareBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        const shareData = {
          title: document.title,
          text: 'Check out this fragrance from Balad Perfumes',
          url: window.location.href
        };
        if (navigator.share) {
          try { await navigator.share(shareData); } catch (err) {}
        } else if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const orig = shareBtn.innerHTML;
            shareBtn.innerHTML = '<span style="font-size:10px;font-weight:600;">Copied</span>';
            setTimeout(() => { shareBtn.innerHTML = orig; }, 2000);
          } catch (err) {}
        }
      });
    }

    // ── Detail card (desktop): if taller than the window, offset it so its end can be reached ──
    const pinned = [root.querySelector('.pdp-info')].filter(Boolean); // photos stay pinned by CSS only
    const readPx = (name) => parseFloat(getComputedStyle(document.documentElement).getPropertyValue(name)) || 0;
    const updatePinned = () => {
      pinned.forEach((el) => {
        if (!desktopQuery.matches) { el.style.removeProperty('top'); return; }
        const header = readPx('--header-group-height') || readPx('--header-height') || 66;
        el.style.top = Math.min(header + 12, window.innerHeight - el.offsetHeight - 24) + 'px';
      });
    };
    updatePinned();
    window.addEventListener('resize', updatePinned, { passive: true });
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(updatePinned);
      pinned.forEach((el) => ro.observe(el));
    }

    // ── Sticky card: bottom-right card on desktop, slim bar on phones (always shown until closed) ──
    if (stickyBar) {
      let dismissed = false;
      let cardOn = false;

      const mobileQuery = window.matchMedia('(max-width: 749px)');

      // Find the floating WhatsApp button (the fixed-position element that holds a WhatsApp link)
      const findWhatsApp = () => {
        const found = new Set();
        document.querySelectorAll('a[href*="wa.me"], a[href*="whatsapp.com"], [class*="whatsapp" i], [id*="whatsapp" i], [aria-label*="whatsapp" i]').forEach((node) => {
          if (root.contains(node)) return;
          let el = node;
          while (el && el !== document.body && el !== document.documentElement) {
            if (getComputedStyle(el).position === 'fixed') { found.add(el); break; }
            el = el.parentElement;
          }
        });
        return [...found];
      };

      const liftWhatsApp = () => {
        const cardBottom = parseFloat(getComputedStyle(stickyBar).bottom) || 0;
        // The close button sticks out above the card, so clear it too, plus a small gap
        const closeTop = stickyClose ? parseFloat(getComputedStyle(stickyClose).top) || 0 : 0;
        const closeOverhang = closeTop < 0 ? Math.abs(closeTop) : 0;
        const lift = cardBottom + stickyBar.offsetHeight + closeOverhang + 14;
        findWhatsApp().forEach((el) => {
          if (el.dataset.pfOrigBottom === undefined) {
            el.dataset.pfOrigBottom = getComputedStyle(el).bottom;
            el.style.transition = 'bottom 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease';
          }
          el.style.bottom = cardOn ? lift + 'px' : el.dataset.pfOrigBottom;
        });
      };

      const update = () => {
        // Always shown (phones and desktop), including while the product details are on screen, until closed.
        cardOn = !dismissed;
        if (cardOn) stickyBar.setAttribute('data-visible', 'true');
        else stickyBar.removeAttribute('data-visible');
        stickyBar.setAttribute('aria-hidden', cardOn ? 'false' : 'true');
        // Phones: the full-width bar would cover the footer's last line, so reserve its height at the very end of the page
        document.body.style.paddingBottom = cardOn && mobileQuery.matches ? stickyBar.offsetHeight + 'px' : '';
        liftWhatsApp();
      };


      if (stickyClose) {
        stickyClose.addEventListener('click', () => {
          dismissed = true;
          update();
        });
      }

      window.addEventListener('resize', update, { passive: true });
      if (mobileQuery.addEventListener) mobileQuery.addEventListener('change', update);
      if ('ResizeObserver' in window) new ResizeObserver(liftWhatsApp).observe(stickyBar);

      // The WhatsApp widget may be injected a moment after load, so keep looking for a few seconds
      let tries = 0;
      const retry = () => { liftWhatsApp(); if (++tries < 20) window.setTimeout(retry, 500); };
      update();
      retry();
    }

    // ── Preselect size from ?size= ──
    const targetSize = new URLSearchParams(window.location.search).get('size');
    if (targetSize && sizePills.length) {
      const match = sizePills.find((p) => (p.dataset.value || p.textContent || '').trim().toLowerCase() === targetSize.trim().toLowerCase());
      if (match) match.click();
    }

    // ── Rating line: scroll to the Judge.me widget when it exists on the page ──
    root.querySelectorAll('[data-pf-reviews-scroll]').forEach((el) => {
      el.addEventListener('click', (e) => {
        const widget = document.querySelector('#judgeme_product_reviews') || document.querySelector('[data-bcs]');
        if (!widget) return;
        e.preventDefault();
        widget.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // ── Write a review → opens Judge.me form ──
    const initJudgeMe = () => {
      if (window.jdgm && typeof window.jdgm.initializeWidgets === 'function') window.jdgm.initializeWidgets();
    };

    // Hide "Write a review" when the Judge.me reviews section isn't on this page
    const hasReviewsSection = !!document.querySelector('.pf-product-template__reviews, #judgeme_product_reviews');
    root.querySelectorAll('[data-pf-reviews-open]').forEach((btn) => {
      if (!hasReviewsSection) { btn.hidden = true; return; }
      btn.addEventListener('click', () => {
        let attempts = 0;
        const open = () => {
          const widget = document.querySelector('#judgeme_product_reviews');
          const writeBtn = widget?.querySelector('.jdgm-write-rev-link, .jdgm-rev-widg__write-rev-btn, .jdgm-write-rev-btn')
            || [...(widget?.querySelectorAll('button, a, [role="button"]') || [])].find((b) =>
              /write\s+a?\s*review/i.test(`${b.textContent} ${b.getAttribute('aria-label') || ''}`));
          if (writeBtn) { writeBtn.click(); return; }
          if (attempts < 60) {
            attempts += 1;
            if (attempts % 4 === 0) initJudgeMe();
            window.setTimeout(open, 250);
          }
        };
        initJudgeMe();
        open();
      });
    });
  })();
{% endjavascript %}

