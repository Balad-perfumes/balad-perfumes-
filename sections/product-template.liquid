      "type": "richtext",
      "id": "delivery_returns",
      "label": "Default Delivery and returns",
      "default": "<p>Fast dispatch within 24-48 business hours. Free shipping across India on prepaid orders. 7-day hassle-free returns and exchanges.</p>"
    },
    {
      "type": "header",
      "content": "Estimated delivery"
