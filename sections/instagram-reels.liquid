</style>

<script>
  (() => {
    let currentReelIndex = 0;
    let reelCardsList = [];

    const initArrowBtn = () => {
      const nextBtn = document.querySelector('[data-ig-next-btn]');
      if (!nextBtn || nextBtn.dataset.ready === 'true') return;
      nextBtn.dataset.ready = 'true';

      nextBtn.addEventListener('click', () => {
        const scrollContainer = document.querySelector('[data-ig-scroll-track]') || document.querySelector('.pf-ig-reels-container [class*="instareel"]');
        if (scrollContainer) {
          scrollContainer.scrollBy({ left: 230, behavior: 'smooth' });
        }
      });
    };

    const initReelModal = () => {
      const modal = document.querySelector('[data-ig-modal]');
      const modalVideo = document.querySelector('[data-ig-modal-video]');
      const modalCaption = document.querySelector('[data-ig-modal-caption]');
      const modalCta = document.querySelector('[data-ig-modal-cta]');
      const closeBtn = document.querySelector('[data-ig-modal-close]');
      const prevBtn = document.querySelector('[data-ig-modal-prev]');
      const nextBtn = document.querySelector('[data-ig-modal-next]');
      const muteBtn = document.querySelector('[data-ig-mute-btn]');
      const soundOn = document.querySelector('.pf-ig-sound-on');
      const soundOff = document.querySelector('.pf-ig-sound-off');

      if (!modal || !modalVideo) return;

      reelCardsList = Array.from(document.querySelectorAll('[data-ig-reel-card]'));

      const openReelAt = (index) => {
        if (index < 0) index = reelCardsList.length - 1;
        if (index >= reelCardsList.length) index = 0;
        currentReelIndex = index;

        const card = reelCardsList[currentReelIndex];
        if (!card) return;

        const videoSrc = card.dataset.videoSrc || (card.querySelector('video') ? card.querySelector('video').src : '');
        const caption = card.dataset.caption || 'Shop our Instagram collection @baladperfume';
        const igLink = card.dataset.igLink || 'https://www.instagram.com/baladperfume/';

        modalVideo.src = videoSrc;
        modalVideo.currentTime = 0;
        modalVideo.muted = false;
        if (soundOn && soundOff) {
          soundOn.style.display = 'block';
          soundOff.style.display = 'none';
        }

        if (modalCaption) modalCaption.textContent = caption;
        if (modalCta) modalCta.href = igLink;

        modal.classList.add('is-open');
        modalVideo.play().catch(() => {
          modalVideo.muted = true;
          if (soundOn && soundOff) {
            soundOn.style.display = 'none';
            soundOff.style.display = 'block';
          }
          modalVideo.play();
        });
      };

      const closeModal = () => {
        modal.classList.remove('is-open');
        modalVideo.pause();
        modalVideo.src = '';
      };

      reelCardsList.forEach((card, idx) => {
        card.addEventListener('click', (e) => {
          e.preventDefault();
          openReelAt(idx);
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      if (prevBtn) prevBtn.addEventListener('click', () => openReelAt(currentReelIndex - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => openReelAt(currentReelIndex + 1));

      if (muteBtn) {
        muteBtn.addEventListener('click', () => {
          modalVideo.muted = !modalVideo.muted;
          if (soundOn && soundOff) {
            soundOn.style.display = modalVideo.muted ? 'none' : 'block';
            soundOff.style.display = modalVideo.muted ? 'block' : 'none';
          }
        });
      }
    };

    const cleanInstaReelsJsonLeak = () => {
      const walker = document.createTreeWalker(
        document.body,
        NodeFilter.SHOW_TEXT,
        null,
        false
      );
      let node;
      const textNodesToRemove = [];
      while ((node = walker.nextNode())) {
        const val = node.nodeValue || '';
        if (val.includes('reels"') || val.includes('"VideoUrl"') || val.includes('tikfeed-cdn') || val.includes('DisplayType') || val.includes('ProviderVideoId')) {
          textNodesToRemove.push(node);
        }
      }
      textNodesToRemove.forEach((tn) => {
        tn.nodeValue = '';
      });

      document.querySelectorAll('.pf-ig-reels-container *').forEach((el) => {
        if (el.children.length === 0) {
          const txt = el.textContent || '';
          if (txt.includes('reels"') || txt.includes('"VideoUrl"') || txt.includes('tikfeed-cdn') || txt.includes('DisplayType')) {
            el.style.display = 'none';
          }
        }
      });
    };

    document.addEventListener('DOMContentLoaded', () => {
      initArrowBtn();
      initReelModal();
      cleanInstaReelsJsonLeak();
    });
    window.addEventListener('load', () => {
      initArrowBtn();
      initReelModal();
      cleanInstaReelsJsonLeak();
    });
    setInterval(cleanInstaReelsJsonLeak, 400);
  })();
</script>

{% schema %}
{
  "name": "Shop our Instagram",
  "tag": "section",
  "class": "section-instagram-reels",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our Instagram"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Follow us on Instagram for exciting content"
    },
