  }

  .pf-ig-modal-top-bar {
    position: absolute;
    top: 16px;
    left: 16px;
    right: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
  }

  .pf-ig-modal-mute-btn {
    background: rgba(0, 0, 0, 0.45);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
