  .pf-ig-reel-card:hover .pf-ig-reel-play-icon {
    transform: scale(1.1) !important;
    background: rgba(0, 0, 0, 0.7) !important;
  }

  .pf-ig-reel-media {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  /* Floating White Arrow Button (Matching media_1789990126218.png) */
  .pf-ig-reels-arrow-btn {
    position: absolute !important;
    right: clamp(16px, 3vw, 40px) !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
    border: none !important;
    color: #111111 !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    z-index: 10 !important;
    transition: transform 0.2s ease, background 0.2s ease !important;
  }

  .pf-ig-reels-arrow-btn:hover {
    transform: translateY(-50%) scale(1.06) !important;
    background: #fcfcfc !important;
  }

  /* Fullscreen Video Player Modal */
  .pf-ig-modal-backdrop {
    position: fixed;
