<div class="pf-ig-reels-section spacing-style">
  <div class="pf-ig-reels-header">
    <h2 class="pf-ig-reels-title">{{ section.settings.heading | default: "Shop our Instagram" }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="pf-ig-reels-sub">{{ section.settings.subheading }}</p>
    {% else %}
      <p class="pf-ig-reels-sub">Follow us on Instagram for exciting content</p>
    {% endif %}
  </div>

  <div class="pf-ig-reels-wrapper">
    <div class="pf-ig-reels-container" data-ig-reels-track>
      {%- content_for 'blocks' -%}

      {%- if section.blocks.size == 0 or section.settings.show_fallback_reels -%}
        <div class="pf-ig-reels-scroll" data-ig-scroll-track>
          {% assign reel_videos = "https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3986519821839708806_video.mp4,https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3983616075702959038_video.mp4,https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3979993690839627269_video.mp4,https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3978544012566563397_video.mp4" | split: "," %}
          {% assign reel_posters = "https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3986519821839708806_thumbnail.jpeg,https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3983616075702959038_thumbnail.jpeg,https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3979993690839627269_thumbnail.jpeg,https://tikfeed-cdn.neomega.tools/hcfxwy-gs.myshopify.com/ig/3978544012566563397_thumbnail.jpeg" | split: "," %}
          {% assign reel_captions = "Discover Balad Signature Fragrances ✨,Handcrafted Luxury Oils & Oud Blends,Balad Perfumes Flagship Store Experience,Unboxing Premium Perfumes by Balad" | split: "," %}

          {% for vid in reel_videos %}
            {% assign idx = forloop.index0 %}
            {% assign poster_url = reel_posters[idx] %}
            {% assign caption_txt = reel_captions[idx] %}

            <div
              class="pf-ig-reel-card"
              data-ig-reel-card
              data-video-src="{{ vid }}"
              data-poster="{{ poster_url }}"
              data-caption="{{ caption_txt }}"
              data-ig-link="https://www.instagram.com/baladperfume/"
            >
              <video
                src="{{ vid }}"
                poster="{{ poster_url }}"
                playsinline
                loop
                muted
                preload="metadata"
                class="pf-ig-reel-media"
                onmouseover="this.play()"
                onmouseout="this.pause()"
              ></video>
              <div class="pf-ig-reel-top-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
                <span>baladperfume</span>
              </div>
              <div class="pf-ig-reel-play-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </div>
            </div>
          {% endfor %}
        </div>
      {%- endif -%}
    </div>

    <!-- Floating Circular Right Arrow Button matching media_1789990126218.png -->
    <button type="button" class="pf-ig-reels-arrow-btn" data-ig-next-btn aria-label="Next Instagram reels">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>

<!-- Instagram Reel Fullscreen Modal Player -->
<div class="pf-ig-modal-backdrop" data-ig-modal>
  <div class="pf-ig-modal-content">
    <button type="button" class="pf-ig-modal-close" data-ig-modal-close aria-label="Close video player">&times;</button>
    <div class="pf-ig-modal-video-wrapper">
      <video class="pf-ig-modal-video" data-ig-modal-video loop playsinline></video>

      <!-- Video Controls Overlay -->
      <div class="pf-ig-modal-top-bar">
        <div class="pf-ig-reel-top-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>baladperfume</span>
        </div>
        <button type="button" class="pf-ig-modal-mute-btn" data-ig-mute-btn aria-label="Toggle Mute">
          <svg class="pf-ig-sound-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
          <svg class="pf-ig-sound-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>
      </div>

      <div class="pf-ig-modal-bottom-bar">
        <p class="pf-ig-modal-caption" data-ig-modal-caption></p>
        <a href="https://www.instagram.com/baladperfume/" target="_blank" rel="noopener" class="pf-ig-modal-cta" data-ig-modal-cta>
          Shop on Instagram
        </a>
      </div>
    </div>

    <!-- Prev/Next Navigation Controls inside Modal -->
    <button type="button" class="pf-ig-modal-nav pf-ig-modal-prev" data-ig-modal-prev aria-label="Previous Reel">&#10094;</button>
    <button type="button" class="pf-ig-modal-nav pf-ig-modal-next" data-ig-modal-next aria-label="Next Reel">&#10095;</button>
  </div>
</div>

<style>
