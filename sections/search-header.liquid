{{ 'balad-product-card.css' | asset_url | stylesheet_tag }}

<section class="balad-search-header color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="balad-search-header__shell">
    <nav class="balad-search-header__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="balad-search-header__crumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">Search</span>
    </nav>

    <div class="balad-search-header__inner">
      <form action="{{ routes.search_url }}" method="get" role="search" class="balad-search-bar">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <div class="balad-search-bar__box">
          <span class="balad-search-bar__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search perfumes, notes, collections..."
            class="balad-search-bar__input"
            autocomplete="off"
            aria-label="Search perfumes"
          >
          {%- if search.terms != blank -%}
            <a href="{{ routes.search_url }}" class="balad-search-bar__clear" aria-label="Clear search" title="Clear search">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </a>
          {%- endif -%}
          <button type="submit" class="balad-search-bar__btn" aria-label="Submit search">
            <span>Search</span>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .balad-search-header {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #f0eee9;
  }

  .balad-search-header__shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: clamp(14px, 2vw, 22px) 36px clamp(14px, 2vw, 20px);
    box-sizing: border-box;
  }

  .balad-search-header__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 500;
    color: #888888;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .balad-search-header__crumbs a {
    color: #888888;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .balad-search-header__crumbs a:hover {
    color: #111111;
  }

  .balad-search-header__crumb-sep {
    color: #cccccc;
  }

  .balad-search-header__inner {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
  }

  .balad-search-bar {
    width: 100%;
    max-width: 680px;
  }

  .balad-search-bar__box {
    display: flex;
    align-items: center;
    position: relative;
    background: #f7f6f2;
    border: 1px solid #e5e2da;
    border-radius: 999px;
    padding: 4px 5px 4px 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .balad-search-bar__box:focus-within {
    background: #ffffff;
    border-color: #111111;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
  }

  .balad-search-bar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #777777;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .balad-search-bar__input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    background: transparent;
    font-size: 14px;
    color: #111111;
    font-family: inherit;
    padding: 8px 4px;
    outline: none;
  }

  .balad-search-bar__input::placeholder {
    color: #999999;
  }

  .balad-search-bar__clear {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: #777777;
    text-decoration: none;
    margin-right: 6px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .balad-search-bar__clear:hover {
    background: #e8e5dc;
    color: #111111;
  }

  .balad-search-bar__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #111111;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.12s ease;
  }

  .balad-search-bar__btn:hover {
    background: #2a2a2a;
  }

  .balad-search-bar__btn:active {
    transform: scale(0.98);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .balad-search-header__shell {
      padding: 12px 20px 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .balad-search-header__shell {
      padding: 10px 10px 12px;
    }
    .balad-search-header__crumbs {
      margin-bottom: 8px;
      font-size: 11px;
    }
    .balad-search-bar {
      max-width: 100%;
    }
    .balad-search-bar__box {
      padding: 3px 4px 3px 12px;
    }
    .balad-search-bar__input {
      font-size: 13px;
      padding: 6px 2px;
    }
    .balad-search-bar__btn {
      padding: 7px 14px;
      font-size: 11px;
    }
    .balad-search-bar__btn svg {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Search header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Search header"
    }
  ]
}
{% endschema %}
