<section class="stagmenfashion-home-service-points color-{{ section.settings.color_scheme }}">
  <div class="stagmenfashion-home-service-points__inner">
    <div class="stagmenfashion-home-service-points__grid" role="list" aria-label="Service benefits">
      {% for block in section.blocks %}
        <div class="stagmenfashion-home-service-points__card" role="listitem" {{ block.shopify_attributes }}>
          <span class="stagmenfashion-home-service-points__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'returns' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7.8 7.6c-1.9 0-3.4 1.5-3.4 3.4v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10 6.6 7.4 9.2 10 11.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16.2 16.4c1.9 0 3.4-1.5 3.4-3.4v-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14 17.4 16.6 14.8 14 12.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'shipping' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 8.6h8v7.2H4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M12 10.6H15.5l2.5 3v2h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="8" cy="17" r="1.55" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="17" cy="17" r="1.55" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M17.4 15.4c-1 2.1-2.8 3.4-5.4 3.4-4.1 0-6.9-3.1-6.9-7.1s2.8-7.1 6.9-7.1 6.9 3.1 6.9 7.1c0 .9-.2 1.7-.5 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14.2 15.4c.8 0 1.5-.7 1.5-1.5s-.7-1.5-1.5-1.5c-.5 0-1 .2-1.3.6l-2 2.2c-.3.3-.7.5-1.1.5H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'discount' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M8.5 7.5h7c.8 0 1.5.7 1.5 1.5v7c0 .8-.7 1.5-1.5 1.5h-7C7.7 17.5 7 16.8 7 16V9c0-.8.7-1.5 1.5-1.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M9.4 14.6 14.6 9.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <circle cx="9.8" cy="9.8" r=".8" fill="currentColor"/>
                  <circle cx="14.2" cy="14.2" r=".8" fill="currentColor"/>
                </svg>
            {% endcase %}
          </span>

          <h3 class="stagmenfashion-home-service-points__card-title">{{ block.settings.heading }}</h3>
          <p class="stagmenfashion-home-service-points__card-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.notice_text != blank %}
      <div class="stagmenfashion-home-service-points__notice" role="note" aria-label="{{ section.settings.notice_label | escape }}">
        <span class="stagmenfashion-home-service-points__notice-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 5v14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M5 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M6.5 9.2c2 0 3.8-.9 5.1-2.5-.3 2.1-1.7 3.6-3.7 3.6H6.5V9.2Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M17.5 9.2c-2 0-3.8-.9-5.1-2.5.3 2.1 1.7 3.6 3.7 3.6h1.4V9.2Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <p class="stagmenfashion-home-service-points__notice-text">{{ section.settings.notice_text }}</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .stagmenfashion-home-service-points {
    --stagmenfashion-benefits-ink: #1f1f1f;
    --stagmenfashion-benefits-muted: rgb(31 31 31 / 0.58);
    --stagmenfashion-benefits-line: rgb(31 31 31 / 0.09);
    --stagmenfashion-benefits-accent: #e97895;
    background: #ffffff;
    color: var(--stagmenfashion-benefits-ink);
    padding: clamp(28px, 4vw, 56px) 0;
  }

  .stagmenfashion-home-service-points__inner {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
  }

  .stagmenfashion-home-service-points__header {
    display: none;
  }

  .stagmenfashion-home-service-points__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--stagmenfashion-benefits-line);
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 45px rgb(0 0 0 / 0.04);
  }

  .stagmenfashion-home-service-points__card {
    display: flex;
    min-height: 220px;
    padding: clamp(22px, 2.8vw, 34px);
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 18px;
    text-align: left;
  }

  .stagmenfashion-home-service-points__card:not(:first-child) {
    border-left: 1px solid var(--stagmenfashion-benefits-line);
  }

  .stagmenfashion-home-service-points__icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 6px;
    color: #111111;
    background: #ffffff;
    border: 1px solid rgb(17 17 17 / 0.12);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.08);
  }

  .stagmenfashion-home-service-points__icon svg {
    width: 28px;
    height: 28px;
  }

  .stagmenfashion-home-service-points__card-title {
    margin: 0;
    font-size: clamp(1.05rem, 1.35vw, 1.15rem);
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .stagmenfashion-home-service-points__card-text {
    margin: 0;
    color: rgb(31 31 31 / 0.58);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .stagmenfashion-home-service-points__notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 14px;
    padding: 14px 18px;
    background: #111111;
    color: #ffffff;
  }

  .stagmenfashion-home-service-points__notice-icon {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .stagmenfashion-home-service-points__notice-icon svg {
    width: 18px;
    height: 18px;
  }

  .stagmenfashion-home-service-points__notice-text {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.45;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .stagmenfashion-home-service-points__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stagmenfashion-home-service-points__card:nth-child(2n) {
      border-left: 1px solid var(--stagmenfashion-benefits-line);
    }

    .stagmenfashion-home-service-points__card:nth-child(n + 3) {
      border-top: 1px solid var(--stagmenfashion-benefits-line);
    }
  }

  @media screen and (max-width: 599px) {
    .stagmenfashion-home-service-points__inner {
      width: min(100% - 20px, 1440px);
    }

    .stagmenfashion-home-service-points__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-radius: 18px;
    }

    .stagmenfashion-home-service-points__card {
      min-height: 220px;
      padding: 22px 10px 18px;
      align-items: center;
      justify-content: flex-start;
      text-align: center;
      gap: 14px;
    }

    .stagmenfashion-home-service-points__card:nth-child(2n) {
      border-left: 1px solid var(--stagmenfashion-benefits-line);
    }

    .stagmenfashion-home-service-points__card:nth-child(n + 3) {
      border-top: 1px solid var(--stagmenfashion-benefits-line);
    }

    .stagmenfashion-home-service-points__card-title {
      font-size: 1rem;
      line-height: 1.1;
    }

    .stagmenfashion-home-service-points__card-text {
      font-size: 0.85rem;
      line-height: 1.45;
      max-width: 18ch;
    }

    .stagmenfashion-home-service-points__notice {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Stag Return Cards",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "notice_label",
      "label": "Notice label",
      "default": "Bulk order note"
    },
    {
      "type": "textarea",
      "id": "notice_text",
      "label": "Notice text",
      "default": "For Bulk Orders — WhatsApp us at +123455 or email bulkorders@stagmenfashion.com"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "returns",
          "options": [
            { "value": "returns", "label": "Returns" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "support", "label": "Support" },
            { "value": "discount", "label": "Discount" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "14-day returns"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Simple returns if a piece doesn’t fit your space."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stag Return Cards",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "heading": "14-day returns",
            "text": "Risk-free shopping, easy returns."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "heading": "Free shipping",
            "text": "No hidden fees, ever."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "24/7 support",
            "text": "Always here when you need us."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "discount",
            "heading": "Member discounts",
            "text": "Exclusive prices for loyal buyers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
