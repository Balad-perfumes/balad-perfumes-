<script src="{{ 'cart-drawer.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'component-cart-items.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% capture empty_cart_drawer_content %}
  <div class="pf-cart-drawer__header">
    <div class="pf-cart-drawer__title-wrap">
      <h2 class="pf-cart-drawer__heading">Shopping Bag</h2>
      <span class="pf-cart-drawer__count">(0)</span>
    </div>
    <button
      ref="closeButton"
      on:click="cart-drawer-component/close"
      class="button button-unstyled pf-cart-drawer__close"
      aria-label="{{ 'actions.close_dialog' | t }}"
      type="button"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="pf-cart-drawer__content pf-cart-drawer__content--empty" aria-label="{{ 'accessibility.cart' | t }}">
    <div class="pf-cart-drawer__empty-wrap">
      <p class="pf-cart-drawer__empty-title">Your shopping bag is empty</p>
      <p class="pf-cart-drawer__empty-sub">Explore our collection and discover your favourite pieces.</p>
      <a href="{{ routes.all_products_collection_url }}" class="pf-cart-drawer__empty-cta">
        Explore Collection
      </a>
    </div>
  </div>
{% endcapture %}

<cart-drawer-component
  id="cart-drawer"
  class="pf-cart-drawer color-{{ settings.drawer_color_scheme }}"
  {% if section.settings.auto_open %}
    auto-open
  {% endif %}
>
  <button
    class="pf-cart-drawer__trigger visually-hidden"
    on:click="/open"
    aria-haspopup="dialog"
    aria-label="{{ 'accessibility.cart' | t }}"
    type="button"
  >
    {{ cart.items.size }}
  </button>

  <template id="empty-cart-template">
    {{ empty_cart_drawer_content }}
  </template>

  <dialog
    ref="dialog"
    class="pf-cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} pf-cart-drawer--empty{% endif %}"
    aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
    scroll-lock
    cart-summary-sticky="true"
  >
    <span ref="liveRegion" class="visually-hidden" role="status"></span>

    <div class="pf-cart-drawer__inner" data-hydration-key="cart-drawer-inner">
      {% capture cart_items_children %}
        {%- if cart.empty? -%}
          {{ empty_cart_drawer_content }}
        {%- else -%}
          <div class="pf-cart-drawer__header" id="cart-drawer-header">
            <div class="pf-cart-drawer__title-wrap">
              <button
                ref="closeButton"
                on:click="cart-drawer-component/close"
                class="button button-unstyled pf-cart-drawer__back-btn"
                aria-label="{{ 'actions.close_dialog' | t }}"
                type="button"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <h2 class="pf-cart-drawer__heading" id="cart-drawer-heading">
                CART
              </h2>
            </div>
          </div>

          <div class="pf-cart-drawer__body" aria-label="{{ 'accessibility.cart' | t }}">
            <div class="pf-cart-drawer__items-scroll">
              {% render 'cart-products' %}
            </div>

            <div class="pf-cart-drawer__summary">
              <!-- Limited Time Offers Section (Bottom Slider) -->
              <div class="pf-cart-drawer__offers">
                <div class="pf-cart-drawer__offers-head">
                  <div class="pf-cart-drawer__offers-title-wrap">
                    <span class="pf-cart-drawer__offers-title">LIMITED TIME OFFERS</span>
                    <span class="pf-cart-drawer__offers-badge">Upto 69% OFF</span>
                  </div>
                  <div class="pf-cart-drawer__offers-nav">
                    <button type="button" class="pf-offers-nav-btn pf-offers-prev" aria-label="Previous offer" onclick="scrollPfOffers(-1)">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <button type="button" class="pf-offers-nav-btn pf-offers-next" aria-label="Next offer" onclick="scrollPfOffers(1)">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                  </div>
                </div>
                <div class="pf-cart-drawer__offers-scroll">
                  {% for offer_prod in collections.all.products limit: 6 %}
                    {% assign offer_variant = offer_prod.selected_or_first_available_variant %}
                    <div class="pf-offer-card">
                      <img
                        src="{{ offer_prod.featured_media.preview_image | default: offer_prod.featured_image | image_url: width: 120 }}"
                        alt="{{ offer_prod.title | escape }}"
                        width="44"
                        height="44"
                        loading="lazy"
                        class="pf-offer-img"
                      >
                      <div class="pf-offer-info">
                        <span class="pf-offer-name">{{ offer_prod.title | truncate: 20 }}</span>
                        <div class="pf-offer-price-row">
                          {% if offer_prod.compare_at_price_max > offer_prod.price_min %}
                            <span class="pf-offer-compare">{{ offer_prod.compare_at_price_max | money }}</span>
                          {% endif %}
                          <span class="pf-offer-price">{{ offer_prod.price_min | money }}</span>
                        </div>
                      </div>
                      <button
                        type="button"
                        class="pf-offer-add-btn"
                        data-pf-offer-variant-id="{{ offer_variant.id }}"
                      >
                        Add
                      </button>
                    </div>
                  {% endfor %}
                </div>
                <!-- Pagination Dots (Matching media_1789986428825.png) -->
                <div class="pf-offers-dots">
                  <span class="pf-offers-dot is-active"></span>
                  <span class="pf-offers-dot"></span>
                  <span class="pf-offers-dot"></span>
                  <span class="pf-offers-dot"></span>
                  <span class="pf-offers-dot"></span>
                  <span class="pf-offers-dot"></span>
              </div>

              {% render 'cart-summary', section_id: section.id, show_view_cart_button: false %}
              <button
                type="button"
                class="pf-cart-drawer__continue-btn"
                on:click="cart-drawer-component/close"
              >
                Continue Shopping
              </button>
            </div>
          </div>
        {%- endif -%}
      {% endcapture %}

      {% render 'cart-items-component', children: cart_items_children, is_drawer: true, section_id: section.id %}
    </div>
  </dialog>
</cart-drawer-component>

<script>
  window.scrollPfOffers = function(direction) {
    const container = document.querySelector('.pf-cart-drawer__offers-scroll');
    if (container) {
      container.scrollBy({ left: direction * 215, behavior: 'smooth' });
    }
  };

  (function() {
    if (window.__pfOfferListenerAdded) return;
    window.__pfOfferListenerAdded = true;
    document.addEventListener('click', function(e) {
      const offerBtn = e.target.closest('[data-pf-offer-variant-id]');
      if (!offerBtn) return;
      const variantId = offerBtn.getAttribute('data-pf-offer-variant-id');
      if (!variantId) return;

      offerBtn.disabled = true;
      offerBtn.textContent = '...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(variantId), quantity: 1 })
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        offerBtn.textContent = 'Added';
        setTimeout(function() { offerBtn.textContent = 'Add'; offerBtn.disabled = false; }, 1800);
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
        const drawer = document.querySelector('cart-drawer-component');
        if (drawer && typeof drawer.fetchCart === 'function') {
          drawer.fetchCart();
        } else {
          window.location.reload();
        }
      })
      .catch(function(err) {
        console.error('Add offer failed', err);
        offerBtn.disabled = false;
        offerBtn.textContent = 'Add';
      });
    });
  })();
</script>

