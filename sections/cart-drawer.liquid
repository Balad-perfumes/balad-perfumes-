<script src="{{ 'cart-drawer.js' | asset_url }}" type="module" fetchpriority="low"></script>
{%- if template.name == 'index' -%}
  {%- comment -%} Homepage: loaded after page load or on first tap (deferred-modules in layout/theme.liquid) {%- endcomment -%}
  <script type="module-deferred" data-src="{{ 'component-cart-items.js' | asset_url }}"></script>
{%- else -%}
<script src="{{ 'component-cart-items.js' | asset_url }}" type="module" fetchpriority="low"></script>
{%- endif -%}

{%- liquid
  assign free_ship_threshold = section.settings.free_shipping_threshold | default: 0
  assign free_ship_cents = free_ship_threshold | times: 100
  assign offers_source = section.settings.offers_collection | default: collections.all
  assign cart_product_ids = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ','

  assign cart_savings = 0
  for item in cart.items
    assign line_compare = item.variant.compare_at_price | default: 0 | times: item.quantity
    if line_compare > item.final_line_price
      assign line_saving = line_compare | minus: item.final_line_price
      assign cart_savings = cart_savings | plus: line_saving
    endif
  endfor
  for discount in cart.cart_level_discount_applications
    assign cart_savings = cart_savings | plus: discount.total_allocated_amount
  endfor

  assign ship_ts = 'now' | date: '%s' | plus: 86400
  assign ship_wd = ship_ts | date: '%w'
  if ship_wd == '0'
    assign ship_ts = ship_ts | plus: 86400
  endif
  assign ship_date = ship_ts | date: '%a, %-d %b'
-%}

{% capture pf_close_button %}
  <button
    ref="closeButton"
    on:click="cart-drawer-component/close"
    class="pf-drawer-close"
    aria-label="{{ 'actions.close_dialog' | t }}"
    type="button"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <line x1="17.5" y1="6.5" x2="6.5" y2="17.5"></line>
      <line x1="6.5" y1="6.5" x2="17.5" y2="17.5"></line>
    </svg>
  </button>
{% endcapture %}

{% capture empty_cart_drawer_content %}
  <div class="pf-cart-drawer__header">
    <div class="pf-cart-drawer__title-wrap">
      <h2 class="pf-cart-drawer__heading" id="cart-drawer-heading-empty">Shopping Bag</h2>
    </div>
    {{ pf_close_button }}
  </div>

  <div class="pf-cart-drawer__empty">
    <span class="pf-cart-drawer__empty-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5.5 7.5h13l-1 12.2a1.5 1.5 0 0 1-1.5 1.3H8a1.5 1.5 0 0 1-1.5-1.3l-1-12.2z"/>
        <path d="M9 9.5V6a3 3 0 0 1 6 0v3.5"/>
      </svg>
    </span>
    <p class="pf-cart-drawer__empty-title">Your bag is empty</p>
    <p class="pf-cart-drawer__empty-sub">Find a fragrance you love and it will show up here.</p>
    <a href="{{ routes.all_products_collection_url }}" class="pf-drawer-btn pf-drawer-btn--solid">Shop fragrances</a>
    <button type="button" class="pf-drawer-link" data-pf-open-wishlist>View wishlist</button>
  </div>
{% endcapture %}

<cart-drawer-component
  id="cart-drawer"
  class="pf-cart-drawer color-{{ settings.drawer_color_scheme }}"
  {% if section.settings.auto_open %}
    auto-open
  {% endif %}
>
  <button
    class="pf-cart-drawer__trigger visually-hidden"
    on:click="/open"
    aria-haspopup="dialog"
    aria-label="{{ 'accessibility.cart' | t }}"
    type="button"
  >
    {{ cart.items.size }}
  </button>

  <template id="empty-cart-template">
    {{ empty_cart_drawer_content }}
  </template>

  <dialog
    ref="dialog"
    class="pf-cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}"
    aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
    scroll-lock
    cart-summary-sticky="true"
  >
    <span ref="liveRegion" class="visually-hidden" role="status"></span>

    <div class="pf-cart-drawer__inner" data-hydration-key="cart-drawer-inner">
      {% capture cart_items_children %}
        {%- if cart.empty? -%}
          {{ empty_cart_drawer_content }}
        {%- else -%}
          <div class="pf-cart-drawer__header" id="cart-drawer-header">
            <div class="pf-cart-drawer__title-wrap">
              <h2 class="pf-cart-drawer__heading" id="cart-drawer-heading">Shopping Bag</h2>
              <span class="pf-cart-drawer__badge" aria-label="{{ cart.item_count }} items">{{ cart.item_count }}</span>
            </div>
            <div class="pf-cart-drawer__header-actions">
              <button type="button" class="pf-cart-drawer__clear" data-pf-clear-cart>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9.5 7V4.8h5V7"/><path d="M6.5 7l.8 12.2a1 1 0 0 0 1 .9h7.4a1 1 0 0 0 1-.9L17.5 7"/></svg>
                <span>Clear all</span>
              </button>
              <span class="pf-cart-drawer__header-sep" aria-hidden="true"></span>
              {{ pf_close_button }}
            </div>
          </div>

          <div class="pf-cart-drawer__scroll">
            {%- if section.settings.show_delivery or free_ship_cents > 0 -%}
              <div class="pf-cart-drawer__info">
                <span class="pf-cart-drawer__info-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5h11v9.5h-11z"/><path d="M13.5 9.5h4l3 3.2V16h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                </span>
                <div class="pf-cart-drawer__info-text">
                  {%- if section.settings.show_delivery -%}
                    <p class="pf-cart-drawer__info-title">
                      {{ section.settings.delivery_title | default: 'Ships next working day' }}
                      <span aria-hidden="true">·</span>
                      <strong>{{ ship_date }}</strong>
                    </p>
                    {%- if section.settings.delivery_text != blank -%}
                      <p class="pf-cart-drawer__info-sub">{{ section.settings.delivery_text }}</p>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if free_ship_cents > 0 -%}
                    {%- liquid
                      assign ship_progress = cart.total_price | times: 100 | divided_by: free_ship_cents
                      if ship_progress > 100
                        assign ship_progress = 100
                      endif
                      assign ship_remaining = free_ship_cents | minus: cart.total_price
                    -%}
                    <div class="pf-cart-drawer__shipping{% if ship_remaining <= 0 %} is-unlocked{% endif %}">
                      <p class="pf-cart-drawer__shipping-text">
                        {%- if ship_remaining > 0 -%}
                          Add <strong>{% render 'format-price', price: ship_remaining %}</strong> more for free shipping
                        {%- else -%}
                          You've unlocked <strong>free shipping</strong>
                        {%- endif -%}
                      </p>
                      <div class="pf-cart-drawer__shipping-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ ship_progress }}" aria-label="Free shipping progress">
                        <span style="width: {{ ship_progress }}%;"></span>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {% render 'pf-cart-drawer-items' %}

            {%- if section.settings.show_offers -%}
              {%- liquid
                assign offers_shown = 0
                capture offer_cards
                  for offer_prod in offers_source.products limit: 16
                    if offers_shown >= 8
                      break
                    endif
                    assign offer_id_token = offer_prod.id | prepend: ',' | append: ','
                    if cart_product_ids contains offer_id_token or offer_prod.available == false
                      continue
                    endif
                    assign offer_variant = offer_prod.selected_or_first_available_variant
                    assign offers_shown = offers_shown | plus: 1
                    render 'pf-cart-offer-card', product: offer_prod, variant: offer_variant
                  endfor
                endcapture
              -%}
              {%- if offers_shown > 0 -%}
                <div class="pf-cart-drawer__offers" data-pf-offers>
                  <div class="pf-cart-drawer__offers-head">
                    <p class="pf-cart-drawer__offers-title">
                      {{ section.settings.offers_title | default: 'You may also like' }}
                      {%- if section.settings.offers_badge != blank -%}
                        <span class="pf-cart-drawer__offers-badge">{{ section.settings.offers_badge }}</span>
                      {%- endif -%}
                    </p>
                    {%- if offers_shown > 1 -%}
                      <div class="pf-cart-drawer__offers-nav">
                        <button type="button" class="pf-offers-nav-btn" aria-label="Previous" data-pf-offers-scroll="-1">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </button>
                        <button type="button" class="pf-offers-nav-btn" aria-label="Next" data-pf-offers-scroll="1">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="pf-cart-drawer__offers-track" data-pf-offers-track>
                    {{ offer_cards }}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>

          <div class="pf-cart-drawer__footer">
            {%- capture total_price -%}{%- render 'format-price', price: cart.total_price -%}{%- endcapture -%}
            {%- if cart.cart_level_discount_applications.size > 0 or cart_savings > 0 -%}
              <div class="pf-cart-drawer__perks">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <span class="pf-cart-drawer__perk">{{ discount.title | escape }} applied</span>
                {%- endfor -%}
                {%- if cart_savings > 0 -%}
                  <span class="pf-cart-drawer__perk pf-cart-drawer__perk--save">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg>
                    You're saving <strong>{% render 'format-price', price: cart_savings %}</strong> on this order
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <form action="{{ routes.cart_url }}" method="post" class="pf-cart-drawer__checkout-form">
              <button type="submit" name="checkout" class="pf-cart-drawer__checkout">
                <span class="pf-cart-drawer__checkout-lock" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/></svg>
                </span>
                <span class="pf-cart-drawer__checkout-label">Checkout</span>
                <text-component ref="cartTotal" class="pf-cart-drawer__checkout-amount" value="{{ total_price | strip_html | strip }}" data-cart-subtotal>{{ total_price }}</text-component>
                <span class="pf-cart-drawer__checkout-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
                </span>
              </button>
            </form>

            <div class="pf-cart-drawer__trust">
              <p class="pf-cart-drawer__trust-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/></svg>
                100% secure payments
              </p>
              <div class="pf-cart-drawer__payments">
                {% render 'payment-icons' %}
              </div>
            </div>
          </div>
        {%- endif -%}
      {% endcapture %}

      {% render 'cart-items-component', children: cart_items_children, is_drawer: true, section_id: section.id %}
    </div>
  </dialog>
</cart-drawer-component>

<script>
  (function () {
    if (window.__pfCartDrawerInit) return;
    window.__pfCartDrawerInit = true;

    // Re-fetch the cart and broadcast it so the drawer re-renders and the header count stays in sync.
    window.pfRefreshCart = function (source) {
      return fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: { resource: cart, sourceId: source || 'pf-cart', data: { itemCount: cart.item_count, source: source || 'pf-cart' } }
          }));
          return cart;
        });
    };

    // Used by every quick-add modal: refresh the drawer + header count, then slide the drawer open.
    window.pfOpenCart = function (source) {
      return window.pfRefreshCart(source || 'pf-quick-add')
        .then(function (cart) {
          var drawer = document.querySelector('cart-drawer-component');
          if (drawer && typeof drawer.open === 'function') {
            drawer.open();
          } else {
            window.location.href = '/cart';
          }
          return cart;
        })
        .catch(function () { window.location.href = '/cart'; });
    };

    document.addEventListener('click', function (e) {
      var navBtn = e.target.closest('[data-pf-offers-scroll]');
      if (navBtn) {
        var track = navBtn.closest('[data-pf-offers]')?.querySelector('[data-pf-offers-track]');
        if (track) {
          var card = track.querySelector('.pf-offer-card');
          var step = card ? card.getBoundingClientRect().width + 10 : 240;
          track.scrollBy({ left: Number(navBtn.dataset.pfOffersScroll) * step, behavior: 'smooth' });
        }
        return;
      }

      var clearBtn = e.target.closest('[data-pf-clear-cart]');
      if (clearBtn) {
        if (!confirm('Remove all items from your bag?')) return;
        clearBtn.disabled = true;
        fetch('/cart/clear.js', { method: 'POST', headers: { Accept: 'application/json' } })
          .then(function () { return window.pfRefreshCart('pf-cart-clear'); })
          .catch(function (err) { console.error('Clear cart failed', err); })
          .finally(function () { clearBtn.disabled = false; });
        return;
      }

      if (e.target.closest('[data-pf-open-wishlist]')) {
        document.querySelector('cart-drawer-component')?.close?.();
        setTimeout(function () {
          if (window.openWishlistDrawer) window.openWishlistDrawer();
        }, 250);
        return;
      }

      var offerBtn = e.target.closest('[data-pf-offer-variant-id]');
      if (!offerBtn || offerBtn.disabled) return;
      var variantId = offerBtn.getAttribute('data-pf-offer-variant-id');
      if (!variantId) return;

      offerBtn.disabled = true;
      offerBtn.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id: Number(variantId), quantity: 1 })
      })
        .then(function (res) {
          if (!res.ok) throw new Error('add failed');
          return window.pfRefreshCart('pf-cart-offers');
        })
        .catch(function (err) {
          console.error('Add offer failed', err);
          offerBtn.disabled = false;
          offerBtn.classList.remove('is-loading');
        });
    });
  })();
</script>

{%- comment -%} Drawer styles live in assets/cart-drawer.css (cached, loaded without blocking: the drawer is a closed <dialog> until opened) {%- endcomment -%}
{%- if template.name == 'cart' -%}
  {%- comment -%} Cart page: loaded in <head> by layout/theme.liquid (the page reuses these classes) {%- endcomment -%}
{%- else -%}
  <link rel="stylesheet" href="{{ 'cart-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}</noscript>
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_open",
      "label": "Auto open on add to cart",
      "default": true
    },
    {
      "type": "header",
      "content": "Delivery info"
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show delivery estimate card",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_title",
      "label": "Heading",
      "default": "Ships next working day",
      "info": "The next working date (skipping Sunday) is added automatically."
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery times",
      "default": "Delivered across India in 3–7 business days"
    },
    {
      "type": "header",
      "content": "Free shipping bar"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "info": "Order value (in store currency) needed for free shipping. Set to 0 to hide the bar.",
      "default": 0
    },
    {
      "type": "header",
      "content": "Recommended products"
    },
    {
      "type": "checkbox",
      "id": "show_offers",
      "label": "Show recommended products",
      "default": true
    },
    {
      "type": "text",
      "id": "offers_title",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "offers_badge",
      "label": "Badge text",
      "info": "Optional, e.g. \"Up to 30% off\"."
    },
    {
      "type": "collection",
      "id": "offers_collection",
      "label": "Collection",
      "info": "Defaults to all products. Items already in the bag are skipped."
    }
  ],
  "presets": [
    {
      "name": "Cart drawer"
    }
  ]
}
{% endschema %}
