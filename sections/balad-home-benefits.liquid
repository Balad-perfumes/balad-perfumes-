<section
  class="balad-home-benefits{% if section.settings.separate_cards %} balad-home-benefits--cards{% endif %} color-{{ section.settings.color_scheme }}"
  style="--benefits-bg: {{ section.settings.background | default: '#ffffff' }};"
>
  <div class="balad-home-benefits__inner">
    <div class="balad-home-benefits__grid" role="list" aria-label="Service benefits">
      {% for block in section.blocks %}
        <div class="balad-home-benefits__card" role="listitem" {{ block.shopify_attributes }}>
          <span class="balad-home-benefits__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'clock', 'longevity' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 7.5V12l3.2 2.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'quality', 'star' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3.5l2.4 5.2 5.6.7-4.1 3.9 1 5.6-4.9-2.7-4.9 2.7 1-5.6-4.1-3.9 5.6-.7L12 3.5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'mood', 'sparkles' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3c.5 3.5 2.5 5.5 6 6-3.5.5-5.5 2.5-6 6-.5-3.5-2.5-5.5-6-6 3.5-.5 5.5-2.5 6-6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M18.5 14.5c.3 1.8 1.2 2.7 3 3-1.8.3-2.7 1.2-3 3-.3-1.8-1.2-2.7-3-3 1.8-.3 2.7-1.2 3-3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="6" cy="18" r="1" fill="currentColor"/>
                </svg>
              {% when 'gift' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="4" y="11" width="16" height="9" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                  <rect x="3" y="7" width="18" height="4" rx="1" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 7v13" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 7c-1.5-2.5-4-3-5.5-1.5S6 8 8.5 8.5L12 7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 7c1.5-2.5 4-3 5.5-1.5S18 8 15.5 8.5L12 7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'returns' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7.8 7.6c-1.9 0-3.4 1.5-3.4 3.4v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10 6.6 7.4 9.2 10 11.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16.2 16.4c1.9 0 3.4-1.5 3.4-3.4v-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14 17.4 16.6 14.8 14 12.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'shipping' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 8.6h8v7.2H4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M12 10.6H15.5l2.5 3v2h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="8" cy="17" r="1.55" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="17" cy="17" r="1.55" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M17.4 15.4c-1 2.1-2.8 3.4-5.4 3.4-4.1 0-6.9-3.1-6.9-7.1s2.8-7.1 6.9-7.1 6.9 3.1 6.9 7.1c0 .9-.2 1.7-.5 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14.2 15.4c.8 0 1.5-.7 1.5-1.5s-.7-1.5-1.5-1.5c-.5 0-1 .2-1.3.6l-2 2.2c-.3.3-.7.5-1.1.5H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'discount' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M8.5 7.5h7c.8 0 1.5.7 1.5 1.5v7c0 .8-.7 1.5-1.5 1.5h-7C7.7 17.5 7 16.8 7 16V9c0-.8.7-1.5 1.5-1.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M9.4 14.6 14.6 9.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <circle cx="9.8" cy="9.8" r=".8" fill="currentColor"/>
                  <circle cx="14.2" cy="14.2" r=".8" fill="currentColor"/>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 7.5V12l3.2 2.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            {% endcase %}
          </span>

          <div class="balad-home-benefits__content">
            <h3 class="balad-home-benefits__card-title">{{ block.settings.heading }}</h3>
            <p class="balad-home-benefits__card-text">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.notice_text != blank %}
      <div class="balad-home-benefits__notice" role="note" aria-label="{{ section.settings.notice_label | escape }}">
        <span class="balad-home-benefits__notice-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 5v14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M5 12h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M6.5 9.2c2 0 3.8-.9 5.1-2.5-.3 2.1-1.7 3.6-3.7 3.6H6.5V9.2Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M17.5 9.2c-2 0-3.8-.9-5.1-2.5.3 2.1 1.7 3.6 3.7 3.6h1.4V9.2Z" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <p class="balad-home-benefits__notice-text">{{ section.settings.notice_text }}</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .balad-home-benefits {
    --balad-benefits-ink: #111111;
    --balad-benefits-muted: #6b7280;
    --balad-benefits-line: rgb(17 17 17 / 0.08);
    background: var(--benefits-bg, #ffffff) !important;
    color: var(--balad-benefits-ink);
    padding-top: clamp(10px, 1.4vw, 16px);
    padding-bottom: clamp(4px, 0.8vw, 8px);
  }

  .balad-home-benefits__inner {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px 0;
    box-sizing: border-box;
  }

  .balad-home-benefits__header {
    display: none;
  }

  .balad-home-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    border: none;
    border-radius: 0;
    overflow: visible;
    background: transparent;
    box-shadow: none;
  }

  .balad-home-benefits__card {
    display: flex;
    padding: clamp(18px, 2.2vw, 24px);
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 12px;
    text-align: left;
    background: #ffffff;
  }

  .balad-home-benefits__card,
  .balad-home-benefits__card:not(:first-child),
  .balad-home-benefits__card:nth-child(2n),
  .balad-home-benefits__card:nth-child(n + 3) {
    border: 1px solid var(--balad-benefits-line);
    border-radius: 16px;
  }

  .balad-home-benefits__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 5px;
    color: #ffffff;
    background: #111111;
    flex-shrink: 0;
  }

  .balad-home-benefits__icon svg {
    width: 20px;
    height: 20px;
  }

  .balad-home-benefits__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .balad-home-benefits__card-title {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: 14.5px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #111111;
  }

  .balad-home-benefits__card-text {
    margin: 0;
    color: #6b7280;
    font-size: 11.5px;
    line-height: 1.45;
  }

  .balad-home-benefits__notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
    padding: 12px 16px;
    background: #111111;
    color: #ffffff;
    border-radius: 5px;
  }

  .balad-home-benefits__notice-icon {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  .balad-home-benefits__notice-icon svg {
    width: 16px;
    height: 16px;
  }

  .balad-home-benefits__notice-text {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    letter-spacing: 0.01em;
  }

  @media screen and (max-width: 989px) {
    .balad-home-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

    @media screen and (min-width: 750px) and (max-width: 1024px) {
    .balad-home-benefits__inner {
      padding: 0 20px 0;
    }
  }

  @media screen and (max-width: 749px) {
    .balad-home-benefits {
      padding: 0;
    }

    .balad-home-benefits__inner {
      padding: 8px 12px 4px;
      width: 100%;
      box-sizing: border-box;
    }

    .balad-home-benefits__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      padding: 0;
      border: none;
      background: transparent;
      box-shadow: none;
      overflow: visible;
    }

    .balad-home-benefits__card {
      padding: 14px 12px;
      gap: 8px;
      border: 1px solid var(--balad-benefits-line);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: none;
    }

    .balad-home-benefits__card:not(:first-child) {
      border-left: 1px solid var(--balad-benefits-line);
      border-top: 1px solid var(--balad-benefits-line);
    }

    .balad-home-benefits__icon {
      width: 34px;
      height: 34px;
      border-radius: 4px;
    }

    .balad-home-benefits__icon svg {
      width: 16px;
      height: 16px;
    }

    .balad-home-benefits__card-title {
      font-size: 14px;
    }

    .balad-home-benefits__card-text {
      font-size: 12px;
      line-height: 1.35;
    }

    .balad-home-benefits__notice {
      padding: 10px 12px;
    }

    .balad-home-benefits__notice-text {
      font-size: 11.5px;
    }
  }

    .balad-home-benefits__notice {
      display: none;
    }
  }
  /* Separate cards variant */
  .balad-home-benefits--cards .balad-home-benefits__grid {
    gap: 12px;
    border: none;
    background: transparent;
    overflow: visible;
  }

  .balad-home-benefits--cards .balad-home-benefits__card,
  .balad-home-benefits--cards .balad-home-benefits__card:not(:first-child),
  .balad-home-benefits--cards .balad-home-benefits__card:nth-child(2n),
  .balad-home-benefits--cards .balad-home-benefits__card:nth-child(n + 3) {
    border: 1px solid var(--balad-benefits-line);
    border-radius: 16px;
  }

  @media screen and (max-width: 749px) {
    .balad-home-benefits--cards .balad-home-benefits__card,
    .balad-home-benefits--cards .balad-home-benefits__card:not(:first-child) {
      border-radius: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Stag Benefits Grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_cards",
      "label": "Show as separate cards",
      "default": false
    },
    {
      "type": "text",
      "id": "notice_label",
      "label": "Notice label",
      "default": "Bulk order note"
    },
    {
      "type": "textarea",
      "id": "notice_text",
      "label": "Notice text",
      "default": "For Bulk Orders — WhatsApp us at +91 94474 25555 or email hello@baladperfume.com"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "clock",
          "options": [
            { "value": "clock", "label": "Clock / Longevity" },
            { "value": "quality", "label": "Quality / Star" },
            { "value": "mood", "label": "Mood / Sparkles" },
            { "value": "gift", "label": "Gift Box" },
            { "value": "returns", "label": "Returns" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "support", "label": "Support" },
            { "value": "discount", "label": "Discount" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Long-Lasting Fragrance"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Enjoy captivating scents that stay with you throughout the day."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stag Benefits Grid",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "heading": "Long-Lasting Fragrance",
            "text": "Enjoy captivating scents that stay with you throughout the day."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "quality",
            "heading": "Premium Quality",
            "text": "Carefully crafted fragrances made to leave a lasting impression."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "mood",
            "heading": "Scents for Every Mood",
            "text": "Discover distinctive fragrances for every occasion and personality."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "gift",
            "heading": "Elegant Gift Choices",
            "text": "Beautiful fragrances thoughtfully selected for gifting and special moments."
          }
        }
      ]
    }
  ]
}
{% endschema %}
