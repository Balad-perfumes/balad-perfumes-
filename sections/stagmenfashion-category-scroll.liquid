{% liquid
  assign section_id = 'stagmenfashion-catscroll-' | append: section.id

  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif

  assign cat_collections = section.settings.collection_list

  if cat_collections == blank and has_blocks == false
    assign cat_collections = collections
  endif
%}

<section
  class="smf-cat-editorial color-{{ section.settings.color_scheme }}"
  data-catscroll="{{ section.id }}"
  style="
    --cat-bg: {{ section.settings.background | default: '#ffffff' }};
    --cat-text: {{ section.settings.text_color | default: '#111111' }};
    --cat-muted: {{ section.settings.muted_text_color | default: '#6b7280' }};
    --cat-radius: {{ section.settings.card_radius | default: 6 }}px;
  "
>
  <div class="smf-cat-shell">
    
    <!-- ── Header with Controls ── -->
    <div class="smf-cat-head">
      <div class="smf-cat-head__left">
        {% if section.settings.heading != blank %}
          <h2 class="smf-cat-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="smf-cat-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="smf-cat-head__right">
        {% if section.settings.discover_more_label != blank and section.settings.discover_more_link != blank %}
          <a href="{{ section.settings.discover_more_link }}" class="smf-cat-discover-more">
            {{ section.settings.discover_more_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- ── Modern Editorial Scroll Rail ── -->
    <div class="smf-cat-rail-wrap">
      <div class="smf-cat-rail" data-catscroll-rail>
        {% if has_blocks %}
          {% for block in section.blocks %}
            {% liquid
              assign coll = collections[block.settings.collection]

              if coll == blank or coll.title == blank
                if collections.size > 0
                  assign coll_index = forloop.index0
                  assign coll = collections[coll_index]
                endif
              endif

              assign card_title = block.settings.title
              if card_title == blank
                if coll != blank and coll.title != blank
                  assign card_title = coll.title
                else
                  assign card_title = 'Category ' | append: forloop.index
                endif
              endif

              assign card_image = block.settings.image
              if card_image == blank and coll != blank
                assign card_image = coll.image | default: coll.featured_image
                if card_image == blank and coll.products.size > 0
                  assign first_prod = coll.products.first
                  assign card_image = first_prod.featured_image | default: first_prod.images.first
                endif
              endif

              assign card_link = coll.url
              if card_link == blank
                assign card_link = '/collections'
              endif

              assign product_count = 0
              if coll != blank
                assign product_count = coll.all_products_count | default: coll.products_count | default: 0
              endif
            %}

            <a
              href="{{ card_link }}"
              class="smf-cat-card"
              style="scroll-snap-align: start;"
              {{ block.shopify_attributes }}
            >
              <!-- Card Media & Image -->
              <div class="smf-cat-card__media">
                {% if card_image != blank %}
                  {{ card_image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    class: 'smf-cat-card__img',
                    widths: '240,360,480,600',
                    sizes: '(max-width: 749px) 78vw, (max-width: 1024px) 48vw, 33vw',
                    alt: card_title | escape
                  }}
                {% else %}
                  <div class="smf-cat-card__placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                  </div>
                {% endif %}

                <!-- Subtle Bottom Contrast Gradient -->
                <div class="smf-cat-card__overlay" aria-hidden="true"></div>

                <!-- Floating Frosted Glass Pill -->
                <div class="smf-cat-card__glass-pill">
                  <div class="smf-cat-card__glass-content">
                    <h3 class="smf-cat-card__title">{{ card_title }}</h3>
                    {% if section.settings.show_product_count %}
                      <span class="smf-cat-card__count">
                        {% if product_count > 0 %}
                          {{ product_count }} {{ product_count | pluralize: 'Item', 'Items' }}
                        {% else %}
                          Explore
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>
                  <div class="smf-cat-card__glass-action" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" width="12" height="12">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          {% endfor %}
        {% else %}
          {% for coll in cat_collections %}
            {% liquid
              if coll == blank or coll.title == blank
                continue
              endif

              if section.settings.hide_empty_collections and coll.all_products_count == 0
                continue
              endif

              assign card_title = coll.title

              assign card_image = coll.image | default: coll.featured_image
              if card_image == blank and coll.products.size > 0
                assign first_prod = coll.products.first
                assign card_image = first_prod.featured_image | default: first_prod.images.first
              endif

              assign card_link = coll.url
              if card_link == blank
                assign card_link = '/collections'
              endif

              assign product_count = coll.all_products_count | default: coll.products_count | default: 0
            %}

            <a
              href="{{ card_link }}"
              class="smf-cat-card"
              style="scroll-snap-align: start;"
            >
              <!-- Card Media & Image -->
              <div class="smf-cat-card__media">
                {% if card_image != blank %}
                  {{ card_image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    class: 'smf-cat-card__img',
                    widths: '240,360,480,600',
                    sizes: '(max-width: 749px) 78vw, (max-width: 1024px) 48vw, 33vw',
                    alt: card_title | escape
                  }}
                {% else %}
                  <div class="smf-cat-card__placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                  </div>
                {% endif %}

                <!-- Subtle Bottom Contrast Gradient -->
                <div class="smf-cat-card__overlay" aria-hidden="true"></div>

                <!-- Floating Frosted Glass Pill -->
                <div class="smf-cat-card__glass-pill">
                  <div class="smf-cat-card__glass-content">
                    <h3 class="smf-cat-card__title">{{ card_title }}</h3>
                    {% if section.settings.show_product_count %}
                      <span class="smf-cat-card__count">
                        {% if product_count > 0 %}
                          {{ product_count }} {{ product_count | pluralize: 'Item', 'Items' }}
                        {% else %}
                          Explore
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>
                  <div class="smf-cat-card__glass-action" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" width="12" height="12">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>

  </div>
</section>

<style>
  /* ════════════════════════════════════════════════════════════════
     STAGMENFASHION SLEEK GLASSMORPHISM CATEGORY RAIL
     ════════════════════════════════════════════════════════════════ */
  .smf-cat-editorial {
    background: var(--cat-bg, #ffffff);
    color: var(--cat-text, #111111);
    width: 100%;
    padding-top: clamp(14px, 2vw, 24px);
    padding-bottom: clamp(14px, 2vw, 24px);
  }

  .smf-cat-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
    box-sizing: border-box;
  }

  /* ── Header ── */
  .smf-cat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgb(17 17 17 / 0.08);
  }

  .smf-cat-head__left {
    flex: 1;
    min-width: 0;
  }

  .smf-cat-heading {
    margin: 0;
    color: #111111;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 18px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .smf-cat-subheading {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--cat-muted, #6b7280);
    line-height: 1.4;
    font-weight: 400;
  }

  .smf-cat-head__right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .smf-cat-discover-more {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #111111;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.25s ease;
  }

  .smf-cat-discover-more:hover {
    color: var(--color-primary, #111111);
  }

  /* ── Rail Container ── */
  .smf-cat-rail-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .smf-cat-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (2 * 16px)) / 3);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-top: 4px;
    padding-bottom: 8px;
    cursor: grab;
    -webkit-user-select: none;
    user-select: none;
  }

  .smf-cat-rail:active {
    cursor: grabbing;
  }

  .smf-cat-rail::-webkit-scrollbar {
    display: none;
  }

  /* ── Glassmorphism Category Card ── */
  .smf-cat-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    background: transparent;
    border-radius: var(--cat-radius, 6px);
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
    scroll-snap-align: start;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
  }

  .smf-cat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
  }

  /* ── Card Media ── */
  .smf-cat-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f4f4f6;
    border-radius: var(--cat-radius, 6px);
  }

  .smf-cat-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .smf-cat-card:hover .smf-cat-card__img {
    transform: scale(1.08);
  }

  .smf-cat-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f2f2f4 0%, #e5e5e8 100%);
    color: rgba(17, 17, 17, 0.3);
  }

  .smf-cat-card__placeholder svg {
    width: 36px;
    height: 36px;
  }

  .smf-cat-card__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.42) 0%,
      rgba(0, 0, 0, 0.1) 42%,
      transparent 70%
    );
    transition: background 0.3s ease;
  }

  .smf-cat-card:hover .smf-cat-card__overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.52) 0%,
      rgba(0, 0, 0, 0.15) 45%,
      transparent 70%
    );
  }

  /* ── Floating Frosted Glass Pill ── */
  .smf-cat-card__glass-pill {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 11px;
    border-radius: 5px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.22) 100%);
    backdrop-filter: blur(16px) saturate(190%) brightness(106%);
    -webkit-backdrop-filter: blur(16px) saturate(190%) brightness(106%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.14);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    z-index: 2;
  }

  .smf-cat-card:hover .smf-cat-card__glass-pill {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0.35) 100%);
    border-color: rgba(255, 255, 255, 0.75);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  .smf-cat-card__glass-content {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }

  .smf-cat-card__title {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
  }

  .smf-cat-card__count {
    font-size: 10.5px;
    color: #1e293b;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.4);
  }

  .smf-cat-card__glass-action {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    color: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .smf-cat-card:hover .smf-cat-card__glass-action {
    background: var(--color-primary, #111111);
    border-color: var(--color-primary, #111111);
    color: #ffffff;
    box-shadow: 0 4px 14px rgb(var(--color-primary-rgb, 8 0 207) / 0.4);
    transform: translate(2px, -2px);
  }

  /* ═══ Responsive ═══ */
  @media screen and (min-width: 1025px) and (max-width: 1400px) {
    .smf-cat-rail {
      grid-auto-columns: calc((100% - (2 * 12px)) / 3);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .smf-cat-shell {
      padding: 0 20px;
    }

    .smf-cat-rail {
      grid-auto-columns: calc((100% - 10px) / 2);
      gap: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    .smf-cat-editorial {
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .smf-cat-shell {
      padding: 0 12px;
      margin: 0;
    }

    .smf-cat-head {
      margin-bottom: 12px;
      padding-bottom: 10px;
    }

    .smf-cat-heading {
      font-size: 13.5px;
    }

    .smf-cat-subheading {
      font-size: 11.5px;
    }

    .smf-cat-discover-more {
      font-size: 11px;
    }

    .smf-cat-rail {
      grid-auto-columns: calc((100% - 8px) / 1.25);
      gap: 8px;
      padding-bottom: 4px;
    }

    .smf-cat-card__glass-pill {
      bottom: 6px;
      left: 6px;
      right: 6px;
      padding: 5px 8px;
      gap: 5px;
      border-radius: 4px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0.25) 100%);
      backdrop-filter: blur(14px) saturate(180%) brightness(105%);
      -webkit-backdrop-filter: blur(14px) saturate(180%) brightness(105%);
      border: 1px solid rgba(255, 255, 255, 0.45);
    }

    .smf-cat-card__title {
      font-size: 11.5px;
    }

    .smf-cat-card__count {
      font-size: 9.5px;
    }

    .smf-cat-card__glass-action {
      width: 20px;
      height: 20px;
      border-radius: 3px;
    }

    .smf-cat-card__glass-action svg {
      width: 9px;
      height: 9px;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('[data-catscroll="{{ section.id }}"]');
    if (!section) return;

    const rail = section.querySelector('[data-catscroll-rail]');
    if (!rail) return;

    const scrollByCards = (direction) => {
      const card = rail.querySelector('.smf-cat-card');
      if (!card) return;
      const cardWidth = card.offsetWidth;
      const gap = parseInt(getComputedStyle(rail).gap) || 12;
      const amount = (cardWidth + gap) * 2;
      rail.scrollBy({
        left: direction === 'next' ? amount : -amount,
        behavior: 'smooth'
      });
    };

    const prevBtn = section.querySelector('[data-catscroll-prev]');
    const nextBtn = section.querySelector('[data-catscroll-next]');

    if (prevBtn) prevBtn.addEventListener('click', () => scrollByCards('prev'));
    if (nextBtn) nextBtn.addEventListener('click', () => scrollByCards('next'));

    /* Drag-to-scroll on desktop */
    let isDown = false, startX, scrollLeft, moved = false;

    rail.addEventListener('mousedown', (e) => {
      isDown = true;
      moved = false;
      startX = e.pageX - rail.offsetLeft;
      scrollLeft = rail.scrollLeft;
    });

    rail.addEventListener('mouseleave', () => {
      isDown = false;
    });

    rail.addEventListener('mouseup', () => {
      isDown = false;
    });

    rail.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      moved = true;
      const x = e.pageX - rail.offsetLeft;
      const walk = (x - startX) * 1.5;
      rail.scrollLeft = scrollLeft - walk;
    });

    // Prevent accidental link navigation on drag
    rail.querySelectorAll('.smf-cat-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        if (moved) {
          e.preventDefault();
          moved = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Category Scroll",
  "tag": "section",
  "class": "stagmenfashion-catscroll-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse our curated collections"
    },
    {
      "type": "text",
      "id": "discover_more_label",
      "label": "Discover More Label",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "discover_more_link",
      "label": "Discover More Link",
      "default": "/collections"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "info": "Select collections to display. If left empty, all store collections will be shown automatically."
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_empty_collections",
      "label": "Hide empty collections",
      "default": false
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#6b7280"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the collection image. Recommended: 600×800px."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Overrides the collection title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Scroll"
    }
  ]
}
{% endschema %}
