{% liquid
  assign layout_mode = section.settings.layout_mode | default: 'full_bleed'
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
  assign overlay_opacity = section.settings.overlay_opacity | default: 20 | divided_by: 100.0
  assign slide_count = section.blocks.size
  assign desktop_h = section.settings.desktop_height | default: 'fit_screen'
  assign mobile_h = section.settings.mobile_height | default: 'fit_screen'
  assign first_slide = section.blocks.first
  assign show_text = section.settings.show_text
  if show_text == nil
    assign show_text = true
  endif
%}

<section
  class="stagmenfashion-min-hero stagmenfashion-min-hero--{{ layout_mode }} color-{{ section.settings.color_scheme }}{% if section.settings.enable_container %} stagmenfashion-min-hero--contained{% endif %}"
  data-stagmenfashion-min-hero
  data-layout="{{ layout_mode }}"
  data-autoplay="{{ autoplay_ms }}"
  data-slide-count="{{ slide_count }}"
  style="
    --hero-overlay-opacity: {{ overlay_opacity }};
    --hero-overlay-color: {{ section.settings.overlay_color | default: '#000000' }};
    {% if desktop_h == 'fit_screen' or desktop_h == '100vh' %}
      --hero-desktop-height-final: 100vh;
    {% else %}
      --hero-desktop-height-final: {{ desktop_h }};
    {% endif %}
    {% if mobile_h == 'fit_screen' or mobile_h == '100vh' %}
      --hero-mobile-height-final: 100vh;
    {% else %}
      --hero-mobile-height-final: {{ mobile_h }};
    {% endif %}
    --hero-radius: {{ section.settings.corner_radius | default: 0 }}px;
    --hero-padding-bottom: {% if section.settings.padding_bottom != blank %}{{ section.settings.padding_bottom }}px{% else %}0px{% endif %};
    {% if section.settings.custom_bg != blank %}--hero-custom-bg: {{ section.settings.custom_bg }};{% endif %}
    {% if section.settings.custom_text != blank %}--hero-custom-text: {{ section.settings.custom_text }};{% endif %}
  "
>
  <div class="stagmenfashion-min-hero__container">
    <div class="stagmenfashion-min-hero__viewport">
      <div class="stagmenfashion-min-hero__track" data-track>
        {% for block in section.blocks %}
          {% liquid
            assign btn_label = block.settings.button_label | default: 'Shop now'
            assign btn_link = block.settings.button_link | default: routes.all_products_collection_url
            assign has_btn = true

            assign has_product = false
            if block.settings.featured_product != blank
              assign has_product = true
              assign feat_prod = block.settings.featured_product
            endif

            assign has_headings = false
            if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.subheading != blank
              assign has_headings = true
            endif
          %}

          <article
            class="stagmenfashion-min-hero__slide stagmenfashion-min-hero__slide--{{ layout_mode }}{% if forloop.first %} is-active{% endif %}"
            data-slide
            data-index="{{ forloop.index0 }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} ==================== LAYOUT 1: FULL BLEED MINIMAL ==================== {%- endcomment -%}
            {% if layout_mode == 'full_bleed' %}
              <div class="stagmenfashion-min-hero__media-wrapper">
                <div class="stagmenfashion-min-hero__media{% if section.settings.enable_zoom %} stagmenfashion-min-hero__media--zoom{% endif %}">
                  {% if block.settings.image != blank %}
                    {% assign loading_attr = 'lazy' %}
                    {% assign priority_attr = 'auto' %}
                    {% if forloop.first %}
                      {% assign loading_attr = 'eager' %}
                      {% assign priority_attr = 'high' %}
                    {% endif %}
                    {% if block.settings.mobile_image != blank %}
                      <picture class="stagmenfashion-min-hero__picture">
                        <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 375, format: 'webp' }} 375w, {{ block.settings.mobile_image | image_url: width: 550, format: 'webp' }} 550w, {{ block.settings.mobile_image | image_url: width: 750, format: 'webp' }} 750w" sizes="100vw">
                        {{ block.settings.image | image_url: width: 1200, format: 'webp' | image_tag: class: 'stagmenfashion-min-hero__img', widths: '550, 750, 950, 1200', sizes: '100vw', loading: loading_attr, fetchpriority: priority_attr, decoding: 'async', alt: block.settings.heading | default: 'Hero image' }}
                      </picture>
                    {% else %}
                      {{ block.settings.image | image_url: width: 1200, format: 'webp' | image_tag: class: 'stagmenfashion-min-hero__img', widths: '550, 750, 950, 1200', sizes: '100vw', loading: loading_attr, fetchpriority: priority_attr, decoding: 'async', alt: block.settings.heading | default: 'Hero image' }}
                    {% endif %}
                  {% else %}
                    <div class="stagmenfashion-min-hero__placeholder">
                      <span>Select Hero Image</span>
                    </div>
                  {% endif %}
                </div>

                {% if section.settings.enable_overlay %}
                  <div class="stagmenfashion-min-hero__overlay overlay--{{ section.settings.overlay_type | default: 'backdrop_blur' }}{% if section.settings.enable_backdrop_blur %} overlay--has-backdrop{% endif %}"></div>
                {% endif %}
              </div>

              <div class="stagmenfashion-min-hero__content-box pos-{{ block.settings.content_position | default: 'bottom-left' }} align-{{ block.settings.text_alignment | default: 'left' }}">
                <div class="stagmenfashion-min-hero__inner{% if section.settings.enable_content_backdrop %} stagmenfashion-min-hero__inner--backdrop{% endif %}">
                  {% if show_text and has_headings %}
                    {% if block.settings.eyebrow != blank %}
                      <div class="stagmenfashion-min-hero__eyebrow-wrap">
                        <span class="stagmenfashion-min-hero__eyebrow">{{ block.settings.eyebrow | escape }}</span>
                      </div>
                    {% endif %}

                    {% if block.settings.heading != blank %}
                      <h1 class="stagmenfashion-min-hero__heading stagmenfashion-min-hero__heading--{{ section.settings.heading_size | default: 'medium' }}">
                        {{ block.settings.heading | escape }}
                      </h1>
                    {% endif %}

                    {% if block.settings.subheading != blank %}
                      <div class="stagmenfashion-min-hero__subheading">
                        {{ block.settings.subheading }}
                      </div>
                    {% endif %}
                  {% endif %}

                  {% if has_btn %}
                    <div class="stagmenfashion-min-hero__actions">
                      <a href="{{ btn_link }}" class="stagmenfashion-min-btn stagmenfashion-min-btn--{{ block.settings.button_style | default: 'text_underline' }}">
                        <span>{{ btn_label | escape }}</span>
                      </a>
                    </div>
                  {% endif %}
                </div>
              </div>

            {%- comment -%} ==================== LAYOUT 2: EDITORIAL SPLIT ==================== {%- endcomment -%}
            {% elsif layout_mode == 'editorial_split' %}
              <div class="stagmenfashion-min-hero__split-grid">
                <div class="stagmenfashion-min-hero__split-text align-{{ block.settings.text_alignment | default: 'left' }}">
                  <div class="stagmenfashion-min-hero__split-inner">
                    {% if block.settings.eyebrow != blank %}
                      <div class="stagmenfashion-min-hero__eyebrow-wrap">
                        <span class="stagmenfashion-min-hero__eyebrow stagmenfashion-min-hero__eyebrow--dark">{{ block.settings.eyebrow | escape }}</span>
                      </div>
                    {% endif %}

                    {% if block.settings.heading != blank %}
                      <h1 class="stagmenfashion-min-hero__heading stagmenfashion-min-hero__heading--dark stagmenfashion-min-hero__heading--{{ section.settings.heading_size | default: 'medium' }}">
                        {{ block.settings.heading | escape }}
                      </h1>
                    {% endif %}

                    {% if block.settings.subheading != blank %}
                      <div class="stagmenfashion-min-hero__subheading stagmenfashion-min-hero__subheading--dark">
                        {{ block.settings.subheading }}
                      </div>
                    {% endif %}

                    {% if has_btn %}
                      <div class="stagmenfashion-min-hero__actions">
                        <a href="{{ btn_link }}" class="stagmenfashion-min-btn stagmenfashion-min-btn--dark stagmenfashion-min-btn--{{ block.settings.button_style | default: 'text_underline' }}">
                          <span>{{ btn_label | escape }}</span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>

                <div class="stagmenfashion-min-hero__split-media-col">
                  <div class="stagmenfashion-min-hero__split-media-frame">
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'stagmenfashion-min-hero__split-img', widths: '600, 900, 1200, 1600', loading: 'eager', alt: block.settings.heading | default: 'Editorial Image' }}
                    {% else %}
                      <div class="stagmenfashion-min-hero__placeholder"><span>Editorial Image</span></div>
                    {% endif %}
                  </div>
                </div>
              </div>

            {%- comment -%} ==================== LAYOUT 3: FRAMED LOOKBOOK ==================== {%- endcomment -%}
            {% elsif layout_mode == 'framed_lookbook' %}
              <div class="stagmenfashion-min-hero__lookbook-wrap">
                <div class="stagmenfashion-min-hero__lookbook-card">
                  <div class="stagmenfashion-min-hero__lookbook-primary">
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 2200 | image_tag: class: 'stagmenfashion-min-hero__lookbook-img', widths: '700, 1100, 1500, 2200', loading: 'eager', alt: block.settings.heading | default: 'Lookbook Primary' }}
                    {% else %}
                      <div class="stagmenfashion-min-hero__placeholder"><span>Lookbook Main Image</span></div>
                    {% endif %}
                  </div>

                  {% if section.settings.enable_overlay %}
                    <div class="stagmenfashion-min-hero__overlay overlay--{{ section.settings.overlay_type | default: 'backdrop_blur' }}{% if section.settings.enable_backdrop_blur %} overlay--has-backdrop{% endif %}"></div>
                  {% endif %}

                  {% if show_text and has_headings %}
                    <div class="stagmenfashion-min-hero__lookbook-overlay">
                      <div class="stagmenfashion-min-hero__lookbook-meta{% if section.settings.enable_content_backdrop %} stagmenfashion-min-hero__inner--backdrop{% endif %}">
                        {% if block.settings.eyebrow != blank %}
                          <span class="stagmenfashion-min-hero__eyebrow">{{ block.settings.eyebrow }}</span>
                        {% endif %}
                        {% if block.settings.heading != blank %}
                          <h2 class="stagmenfashion-min-hero__heading stagmenfashion-min-hero__heading--{{ section.settings.heading_size | default: 'medium' }}">
                            {{ block.settings.heading }}
                          </h2>
                        {% endif %}
                      </div>

                      {% if has_btn %}
                        <a href="{{ btn_link }}" class="stagmenfashion-min-btn stagmenfashion-min-btn--{{ block.settings.button_style | default: 'text_underline' }}">
                          <span>{{ btn_label }}</span>
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>

            {%- comment -%} ==================== LAYOUT 4: FLOATING BADGE SPOTLIGHT ==================== {%- endcomment -%}
            {% elsif layout_mode == 'floating_badge' %}
              <div class="stagmenfashion-min-hero__media-wrapper">
                <div class="stagmenfashion-min-hero__media{% if section.settings.enable_zoom %} stagmenfashion-min-hero__media--zoom{% endif %}">
                  {% if block.settings.image != blank %}
                    {% if block.settings.mobile_image != blank %}
                      <picture class="stagmenfashion-min-hero__picture">
                        <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 600 }} 600w, {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w">
                        {{ block.settings.image | image_url: width: 3000 | image_tag: class: 'stagmenfashion-min-hero__img', widths: '750, 1100, 1600, 2200, 3000', loading: 'eager', alt: block.settings.heading | default: 'Hero image' }}
                      </picture>
                    {% else %}
                      {{ block.settings.image | image_url: width: 3000 | image_tag: class: 'stagmenfashion-min-hero__img', widths: '750, 1100, 1600, 2200, 3000', loading: 'eager', alt: block.settings.heading | default: 'Hero image' }}
                    {% endif %}
                  {% else %}
                    <div class="stagmenfashion-min-hero__placeholder"><span>Select Spotlight Image</span></div>
                  {% endif %}
                </div>

                {% if section.settings.enable_overlay %}
                  <div class="stagmenfashion-min-hero__overlay overlay--{{ section.settings.overlay_type | default: 'backdrop_blur' }}{% if section.settings.enable_backdrop_blur %} overlay--has-backdrop{% endif %}"></div>
                {% endif %}
              </div>

              <div class="stagmenfashion-min-hero__spotlight-shell">
                <div class="stagmenfashion-min-hero__spotlight-content">
                  {% if show_text and has_headings %}
                    {% if block.settings.eyebrow != blank %}
                      <div class="stagmenfashion-min-hero__eyebrow-wrap">
                        <span class="stagmenfashion-min-hero__eyebrow">{{ block.settings.eyebrow }}</span>
                      </div>
                    {% endif %}
                    {% if block.settings.heading != blank %}
                      <h1 class="stagmenfashion-min-hero__heading stagmenfashion-min-hero__heading--{{ section.settings.heading_size | default: 'medium' }}">
                        {{ block.settings.heading }}
                      </h1>
                    {% endif %}
                    {% if block.settings.subheading != blank %}
                      <div class="stagmenfashion-min-hero__subheading">{{ block.settings.subheading }}</div>
                    {% endif %}
                  {% endif %}
                  {% if has_btn %}
                    <div class="stagmenfashion-min-hero__actions">
                      <a href="{{ btn_link }}" class="stagmenfashion-min-btn stagmenfashion-min-btn--{{ block.settings.button_style | default: 'text_underline' }}">
                        <span>{{ btn_label }}</span>
                      </a>
                    </div>
                  {% endif %}
                </div>

                {% if has_product %}
                  <a href="{{ feat_prod.url }}" class="stagmenfashion-min-hero__product-card" aria-label="View {{ feat_prod.title }}">
                    <div class="stagmenfashion-min-hero__product-thumb">
                      {% if feat_prod.featured_image != blank %}
                        <img src="{{ feat_prod.featured_image | image_url: width: 140 }}" alt="{{ feat_prod.title }}" loading="lazy" width="60" height="72">
                      {% endif %}
                    </div>
                    <div class="stagmenfashion-min-hero__product-info">
                      <span class="stagmenfashion-min-hero__product-tag">Featured</span>
                      <span class="stagmenfashion-min-hero__product-title">{{ feat_prod.title | truncate: 24 }}</span>
                      <span class="stagmenfashion-min-hero__product-price">{{ feat_prod.price | money }}</span>
                    </div>
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {%- comment -%} Ultra-Minimal Hairline Pagination {%- endcomment -%}
      {% if slide_count > 1 %}
        <div class="stagmenfashion-min-hero__controls">
          <div class="stagmenfashion-min-hero__pagination">
            <span class="stagmenfashion-min-hero__counter-current" data-counter-current>01</span>
            <div class="stagmenfashion-min-hero__progress-bar">
              <div class="stagmenfashion-min-hero__progress-fill" data-progress-fill></div>
            </div>
            <span class="stagmenfashion-min-hero__counter-total">0{{ slide_count }}</span>
          </div>

          <div class="stagmenfashion-min-hero__nav-arrows">
            <button class="stagmenfashion-min-hero__nav-btn" type="button" data-action="prev" aria-label="Previous slide">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 13l-5-5 5-5"/></svg>
            </button>
            <button class="stagmenfashion-min-hero__nav-btn" type="button" data-action="next" aria-label="Next slide">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M6 3l5 5-5 5"/></svg>
            </button>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  /* ----------------------------------------------------
     BASE CONTAINER & RESET
  ---------------------------------------------------- */
  .stagmenfashion-min-hero,
  .stagmenfashion-min-hero[class*="color-"] {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #ffffff !important;
    background: #ffffff !important;
    color: var(--hero-custom-text, var(--color-foreground, #111111));
    font-family: inherit;
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-top: 0 !important;
    padding-bottom: var(--hero-padding-bottom, 0px) !important;
    box-sizing: border-box;
    --hero-calc-desktop: 100vh;
    --hero-calc-mobile: 100vh;
  }

  .stagmenfashion-min-hero--contained {
    --hero-container-pad-v: 0px;
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-top: 0 !important;
  }

  .stagmenfashion-min-hero__container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .stagmenfashion-min-hero__viewport {
    position: relative;
    width: 100%;
    height: var(--hero-desktop-height-final, var(--hero-calc-desktop));
    min-height: var(--hero-desktop-height-final, var(--hero-calc-desktop));
    max-height: var(--hero-desktop-height-final, var(--hero-calc-desktop));
    overflow: hidden;
    border-radius: var(--hero-radius, 0px);
    touch-action: pan-y;
  }

  .stagmenfashion-min-hero__track {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 100%;
    transition: transform 0.75s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .stagmenfashion-min-hero__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-height: 100%;
    display: flex;
    overflow: hidden;
  }

  .stagmenfashion-min-hero__full-link {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    cursor: pointer;
  }

  @media (max-width: 989px) {
    .stagmenfashion-min-hero__viewport {
      height: var(--hero-mobile-height-final, var(--hero-calc-mobile));
      min-height: var(--hero-mobile-height-final, var(--hero-calc-mobile));
      max-height: var(--hero-mobile-height-final, var(--hero-calc-mobile));
    }
  }

  /* ----------------------------------------------------
     MEDIA & LIGHTWEIGHT OVERLAYS
  ---------------------------------------------------- */
  .stagmenfashion-min-hero__media-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .stagmenfashion-min-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .stagmenfashion-min-hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .stagmenfashion-min-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .stagmenfashion-min-hero__media--zoom .stagmenfashion-min-hero__img {
    transform: scale(1);
  }

  .stagmenfashion-min-hero__slide.is-active .stagmenfashion-min-hero__media--zoom .stagmenfashion-min-hero__img {
    transform: scale(1.03);
    transition: transform 7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .stagmenfashion-min-hero__placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background: #f4f4f5;
    color: #71717a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Overlay Styles - Clean Black Overlay Without Blur or Distorting Effects */
  .stagmenfashion-min-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    background-color: var(--hero-overlay-color, #000000);
    opacity: var(--hero-overlay-opacity, 0.3);
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .stagmenfashion-min-hero__overlay.overlay--has-backdrop,
  .stagmenfashion-min-hero__overlay.overlay--backdrop_blur,
  .stagmenfashion-min-hero__overlay.overlay--solid,
  .stagmenfashion-min-hero__overlay.overlay--black_light,
  .stagmenfashion-min-hero__overlay.overlay--luxury_scrim {
    background-color: var(--hero-overlay-color, #000000);
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .stagmenfashion-min-hero__overlay.overlay--soft_bottom {
    background: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.35) 45%,
      transparent 100%
    );
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .stagmenfashion-min-hero__overlay.overlay--cinematic_vignette {
    background: radial-gradient(
      circle at center,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.55) 100%
    );
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  /* Frosted Glass Content Backdrop Card */
  .stagmenfashion-min-hero__inner--backdrop {
    background: rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: clamp(20px, 3.2vw, 36px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
  }

  /* ----------------------------------------------------
     MINIMAL AIRY CONTENT LAYOUT
  ---------------------------------------------------- */
  .stagmenfashion-min-hero__content-box {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-group-height, 66px) + clamp(16px, 3vw, 36px)) clamp(24px, 5vw, 64px) clamp(32px, 5vw, 64px);
    box-sizing: border-box;
    pointer-events: none;
  }

  .stagmenfashion-min-hero__content-box.pos-bottom-left { justify-content: flex-end; align-items: flex-start; }
  .stagmenfashion-min-hero__content-box.pos-bottom-center { justify-content: flex-end; align-items: center; }
  .stagmenfashion-min-hero__content-box.pos-center-left { justify-content: center; align-items: flex-start; }
  .stagmenfashion-min-hero__content-box.pos-center { justify-content: center; align-items: center; }
  .stagmenfashion-min-hero__content-box.pos-top-left { justify-content: flex-start; align-items: flex-start; padding-top: clamp(60px, 8vw, 90px); }

  .stagmenfashion-min-hero__inner {
    max-width: 680px;
    width: 100%;
    pointer-events: auto;
  }

  .stagmenfashion-min-hero__content-box.align-left .stagmenfashion-min-hero__inner { text-align: left; }
  .stagmenfashion-min-hero__content-box.align-center .stagmenfashion-min-hero__inner,
  .stagmenfashion-min-hero__content-box.pos-bottom-center .stagmenfashion-min-hero__inner,
  .stagmenfashion-min-hero__content-box.pos-center .stagmenfashion-min-hero__inner {
    text-align: center;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stagmenfashion-min-hero__content-box.align-right .stagmenfashion-min-hero__inner { text-align: right; margin-left: auto; }

  /* Whisper-thin refined typography */
  .stagmenfashion-min-hero__eyebrow-wrap {
    margin-bottom: 12px;
  }

  .stagmenfashion-min-hero__eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  .stagmenfashion-min-hero__eyebrow--dark {
    color: #71717a;
    text-shadow: none;
  }

  .stagmenfashion-min-hero__heading {
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0 0 14px;
    text-wrap: balance;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25);
  }

  .stagmenfashion-min-hero__heading--dark {
    color: var(--hero-custom-text, #111111);
    text-shadow: none;
  }

