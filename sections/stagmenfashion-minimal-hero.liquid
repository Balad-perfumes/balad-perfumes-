{% javascript %}
  (function () {
    const initHero = () => {
      document.querySelectorAll('[data-stagmenfashion-min-hero]').forEach((hero) => {
        if (hero.dataset.initialized === 'true') return;
        hero.dataset.initialized = 'true';

        const track = hero.querySelector('[data-track]');
        const slides = Array.from(hero.querySelectorAll('[data-slide]'));
        const total = slides.length;
        if (total <= 1) return;

        const counterCurrent = hero.querySelector('[data-counter-current]');
        const progressFill = hero.querySelector('[data-progress-fill]');
        const prevBtn = hero.querySelector('[data-action="prev"]');
        const nextBtn = hero.querySelector('[data-action="next"]');
        const autoplayMs = parseInt(hero.dataset.autoplay, 10) || 0;

        let currentIndex = 0;
        let autoplayTimer = null;
        let progressTimer = null;
        let progressStart = 0;

        const updatePagination = (idx) => {
          if (counterCurrent) {
            counterCurrent.textContent = (idx + 1 < 10 ? '0' : '') + (idx + 1);
          }
        };

        const resetProgress = () => {
          if (progressTimer) cancelAnimationFrame(progressTimer);
          if (progressFill) progressFill.style.width = '0%';
        };

        const startProgress = () => {
          if (!autoplayMs || !progressFill) return;
          resetProgress();
          progressStart = performance.now();

          const frame = (now) => {
            const elapsed = now - progressStart;
            const pct = Math.min(100, (elapsed / autoplayMs) * 100);
            progressFill.style.width = pct + '%';
            if (pct < 100) {
              progressTimer = requestAnimationFrame(frame);
            }
          };
          progressTimer = requestAnimationFrame(frame);
        };

        const goToSlide = (newIndex) => {
          currentIndex = (newIndex + total) % total;
          track.style.transform = `translateX(-${currentIndex * 100}%)`;

          slides.forEach((s, idx) => {
            if (idx === currentIndex) {
              s.classList.add('is-active');
              s.setAttribute('aria-hidden', 'false');
            } else {
              s.classList.remove('is-active');
              s.setAttribute('aria-hidden', 'true');
            }
          });

          updatePagination(currentIndex);
          startAutoplay();
        };

        const startAutoplay = () => {
          if (autoplayTimer) clearInterval(autoplayTimer);
          if (autoplayMs > 0) {
            startProgress();
            autoplayTimer = setInterval(() => {
              goToSlide(currentIndex + 1);
            }, autoplayMs);
          }
        };

        const stopAutoplay = () => {
          if (autoplayTimer) clearInterval(autoplayTimer);
          resetProgress();
        };

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            goToSlide(currentIndex - 1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            goToSlide(currentIndex + 1);
          });
        }

        hero.addEventListener('mouseenter', stopAutoplay);
        hero.addEventListener('mouseleave', startAutoplay);

        // Touch swipe support
        let startX = 0;
        let currentX = 0;
        let isTouching = false;

        hero.addEventListener('touchstart', (e) => {
          isTouching = true;
          startX = e.touches[0].clientX;
          currentX = startX;
          stopAutoplay();
        }, { passive: true });

        hero.addEventListener('touchmove', (e) => {
          if (!isTouching) return;
          currentX = e.touches[0].clientX;
        }, { passive: true });

        hero.addEventListener('touchend', () => {
          if (!isTouching) return;
          isTouching = false;
          const diffX = startX - currentX;
          if (diffX > 40) {
            goToSlide(currentIndex + 1);
          } else if (diffX < -40) {
            goToSlide(currentIndex - 1);
          } else {
            startAutoplay();
          }
        });

        // Initialize first state
        updatePagination(0);
        startAutoplay();
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHero);
    } else {
      initHero();
    }

    document.addEventListener('shopify:section:load', initHero);
  })();
