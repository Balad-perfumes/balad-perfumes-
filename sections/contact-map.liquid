<section
  class="pf-contact-map color-{{ section.settings.color_scheme }}"
  style="--map-pt: {{ section.settings.padding_top | default: 20 }}px; --map-pb: {{ section.settings.padding_bottom | default: 28 }}px;"
>
  <div class="pf-contact-shell">
    
    <div class="pf-contact-map__header">
      <div class="pf-contact-map__titles">
        {% if section.settings.eyebrow != blank %}
          <span class="pf-contact-map__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="pf-contact-map__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="pf-contact-map__desc">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    </div>

    {% liquid
      assign has_blocks = false
      if section.blocks.size > 0
        assign has_blocks = true
      endif

      # Location 1 defaults
      assign loc1_name = section.settings.studio_name_1
      if loc1_name == blank
        assign loc1_name = section.settings.studio_name | default: 'Balad Perfumes (Calicut)'
      endif
      assign loc1_addr = section.settings.studio_address_1
      if loc1_addr == blank
        assign loc1_addr = section.settings.studio_address | default: 'Khaleej Residency, near Aster, Near M.I.M.S Hospital, Govindapuram, Kozhikode, Kerala 673016'
      endif
      assign loc1_hours = section.settings.studio_hours_1
      if loc1_hours == blank
        assign loc1_hours = section.settings.studio_hours | default: 'Mon - Sun: 09:30 AM - 08:30 PM'
      endif
      assign loc1_iframe = section.settings.iframe_code_1
      if loc1_iframe == blank
        assign loc1_iframe = section.settings.iframe_code | default: '<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d52643.33908510284!2d75.76950604334138!3d11.280543280302826!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba659c5e8b2bc91%3A0xd4dff452d15a7f2f!2sBALAD%20PERFUMES!5e0!3m2!1sen!2sin!4v1789538424914!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>'
      endif
      assign loc1_url = section.settings.directions_url_1
      if loc1_url == blank
        assign loc1_url = section.settings.directions_url | default: 'https://maps.app.goo.gl/wVwRCDasLU6jKLSQ6'
      endif

      # Location 2 defaults
      assign loc2_name = section.settings.studio_name_2 | default: 'Balad Perfumes (Thekkady)'
      assign loc2_addr = section.settings.studio_address_2 | default: 'BALAD PERFUMES, Kavitha building, JUNCTION thekkadiy, Thekkady, Kumily, Attappallam, Kerala 685509'
      assign loc2_hours = section.settings.studio_hours_2 | default: 'Mon - Sun: 09:30 AM - 08:30 PM'
      assign loc2_iframe = section.settings.iframe_code_2 | default: '<iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d245.86669628135277!2d77.1671735!3d9.6067067!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3b065516fbf48fc5%3A0x38d4930c20c92cc8!2zQkFMQUQgUEVSRlVNRVMgKOC0rOC0suC0puC1jSDgtKrgtYbgtbzgtKvgtY3gtK_gtYLgtILgtLjgtY0p!5e0!3m2!1sen!2sin!4v1789544975056!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin">'
      assign loc2_url = section.settings.directions_url_2 | default: 'https://maps.app.goo.gl/twvc1pxgdXNvDpTx6'
    %}

    {% if has_blocks %}
      <div class="pf-contact-map__grid pf-contact-map__grid--{{ section.blocks.size }}">
        {% for block in section.blocks %}
          <div class="pf-contact-map__card" {{ block.shopify_attributes }}>
            {% if block.settings.iframe_code != blank %}
              <div class="pf-contact-map__iframe-wrap">
                {{ block.settings.iframe_code }}
              </div>
            {% else %}
              <div class="pf-contact-map__fallback">
                <div class="pf-contact-map__fallback-content">
                  <div class="pf-contact-map__pin-icon">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  </div>
                  <h3 class="pf-contact-map__fallback-title">{{ block.settings.studio_name | default: 'Balad Perfumes' }}</h3>
                  <p class="pf-contact-map__fallback-addr">{{ block.settings.studio_address }}</p>
                  {% if block.settings.directions_url != blank %}
                    <a href="{{ block.settings.directions_url }}" target="_blank" rel="noopener noreferrer" class="pf-contact-map__fallback-btn">
                      Get Directions
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            {% if block.settings.show_location_card != false and block.settings.studio_name != blank %}
              <div class="pf-contact-map__floating-card">
                <div class="pf-contact-map__floating-dot"></div>
                <div class="pf-contact-map__floating-info">
                  <div class="pf-contact-map__floating-header">
                    <p class="pf-contact-map__floating-title">{{ block.settings.studio_name }}</p>
                    {% if block.settings.directions_url != blank %}
                      <a href="{{ block.settings.directions_url }}" target="_blank" rel="noopener noreferrer" class="pf-contact-map__floating-link" title="Open in Google Maps">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                      </a>
                    {% endif %}
                  </div>
                  <p class="pf-contact-map__floating-text">{{ block.settings.studio_address }}</p>
                  {% if block.settings.studio_hours != blank %}
                    <p class="pf-contact-map__floating-hours">{{ block.settings.studio_hours }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="pf-contact-map__grid pf-contact-map__grid--2">
        <!-- Location 1 Card -->
        <div class="pf-contact-map__card">
          {% if loc1_iframe != blank %}
            <div class="pf-contact-map__iframe-wrap">
              {{ loc1_iframe }}
            </div>
          {% else %}
            <div class="pf-contact-map__fallback">
              <div class="pf-contact-map__fallback-content">
                <h3 class="pf-contact-map__fallback-title">{{ loc1_name }}</h3>
                <p class="pf-contact-map__fallback-addr">{{ loc1_addr }}</p>
              </div>
            </div>
          {% endif %}

          <div class="pf-contact-map__floating-card">
            <div class="pf-contact-map__floating-dot"></div>
            <div class="pf-contact-map__floating-info">
              <div class="pf-contact-map__floating-header">
                <p class="pf-contact-map__floating-title">{{ loc1_name }}</p>
                {% if loc1_url != blank %}
                  <a href="{{ loc1_url }}" target="_blank" rel="noopener noreferrer" class="pf-contact-map__floating-link" title="Open in Google Maps">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                {% endif %}
              </div>
              <p class="pf-contact-map__floating-text">{{ loc1_addr }}</p>
              {% if loc1_hours != blank %}
                <p class="pf-contact-map__floating-hours">{{ loc1_hours }}</p>
              {% endif %}
            </div>
          </div>
        </div>

        <!-- Location 2 Card -->
        <div class="pf-contact-map__card">
          {% if loc2_iframe != blank %}
            <div class="pf-contact-map__iframe-wrap">
              {{ loc2_iframe }}
            </div>
          {% else %}
            <div class="pf-contact-map__fallback">
              <div class="pf-contact-map__fallback-content">
                <h3 class="pf-contact-map__fallback-title">{{ loc2_name }}</h3>
                <p class="pf-contact-map__fallback-addr">{{ loc2_addr }}</p>
              </div>
            </div>
          {% endif %}

          <div class="pf-contact-map__floating-card">
            <div class="pf-contact-map__floating-dot"></div>
            <div class="pf-contact-map__floating-info">
              <div class="pf-contact-map__floating-header">
                <p class="pf-contact-map__floating-title">{{ loc2_name }}</p>
                {% if loc2_url != blank %}
                  <a href="{{ loc2_url }}" target="_blank" rel="noopener noreferrer" class="pf-contact-map__floating-link" title="Open in Google Maps">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                {% endif %}
              </div>
              <p class="pf-contact-map__floating-text">{{ loc2_addr }}</p>
              {% if loc2_hours != blank %}
                <p class="pf-contact-map__floating-hours">{{ loc2_hours }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .pf-contact-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
    box-sizing: border-box;
  }

  @media (max-width: 749px) {
    .pf-contact-shell {
      padding: 0 10px;
    }
  }

  .pf-contact-map {
    padding-top: var(--map-pt, 40px);
    padding-bottom: var(--map-pb, 60px);
  }

  .pf-contact-map__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .pf-contact-map__titles {
    max-width: 620px;
  }

  .pf-contact-map__eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.6;
    margin-bottom: 8px;
  }

  .pf-contact-map__heading {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading, #111111);
  }

  .pf-contact-map__desc {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.4;
    color: currentColor;
    opacity: 0.75;
  }

  .pf-contact-map__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .pf-contact-map__grid--1 {
    grid-template-columns: 1fr;
  }

  .pf-contact-map__card {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #f4f4f5;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.06);
    min-height: 420px;
  }

  .pf-contact-map__iframe-wrap,
  .pf-contact-map__iframe-wrap iframe {
    width: 100%;
    height: 100%;
    min-height: 420px;
    display: block;
    border: 0;
  }

  .pf-contact-map__fallback {
    min-height: 420px;
    display: grid;
    place-items: center;
    padding: 40px 20px;
    background: radial-gradient(circle at 50% 50%, #fafafa 0%, #f0f0f2 100%);
  }

  .pf-contact-map__fallback-content {
    text-align: center;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pf-contact-map__pin-icon {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: grid;
    place-items: center;
    color: #111111;
    margin-bottom: 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .pf-contact-map__fallback-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 600;
    color: #111111;
  }

  .pf-contact-map__fallback-addr {
    margin: 0 0 20px;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.65);
    line-height: 1.5;
  }

  .pf-contact-map__floating-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    max-width: 340px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    padding: 16px 20px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    display: flex;
    gap: 12px;
    align-items: flex-start;
    z-index: 2;
  }

  .pf-contact-map__floating-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    margin-top: 6px;
    flex: 0 0 auto;
  }

  .pf-contact-map__floating-info {
    flex: 1 1 auto;
    min-width: 0;
  }

  .pf-contact-map__floating-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 2px;
  }

  .pf-contact-map__floating-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #111111;
  }

  .pf-contact-map__floating-link {
    color: #111111;
    opacity: 0.7;
    transition: opacity 0.2s;
    display: inline-flex;
  }

  .pf-contact-map__floating-link:hover {
    opacity: 1;
  }

  .pf-contact-map__floating-text {
    margin: 0 0 4px;
    font-size: 12px;
    color: rgba(0, 0, 0, 0.7);
    line-height: 1.4;
  }

  .pf-contact-map__floating-hours {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.5);
  }

  @media screen and (max-width: 899px) {
    .pf-contact-map__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media screen and (max-width: 640px) {
    .pf-contact-map__card {
      min-height: 340px;
    }

    .pf-contact-map__iframe-wrap,
    .pf-contact-map__iframe-wrap iframe,
    .pf-contact-map__fallback {
      min-height: 340px;
    }

    .pf-contact-map__floating-card {
      position: static;
      margin: 16px;
      max-width: calc(100% - 32px);
    }
  }
</style>

{% schema %}
{
