<section
  class="pf-contact-map color-{{ section.settings.color_scheme }}"
  style="--map-pt: {{ section.settings.padding_top | default: 20 }}px; --map-pb: {{ section.settings.padding_bottom | default: 28 }}px;"
>
  <div class="pf-contact-shell">
    
    <div class="pf-contact-map__header">
      <div class="pf-contact-map__titles">
        {% if section.settings.eyebrow != blank %}
          <span class="pf-contact-map__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="pf-contact-map__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="pf-contact-map__desc">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      {% if section.settings.directions_url != blank %}
        <div class="pf-contact-map__header-action">
          <a href="{{ section.settings.directions_url }}" target="_blank" rel="noopener noreferrer" class="pf-map-directions-btn">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M10 2a6 6 0 0 0-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 0 0-6-6Z"/>
              <circle cx="10" cy="8" r="2"/>
            </svg>
            <span>{{ section.settings.directions_label | default: 'Open in Google Maps' }}</span>
          </a>
        </div>
      {% endif %}
    </div>

    <div class="pf-contact-map__container">
      <div class="pf-contact-map__card">
        {% if section.settings.iframe_code != blank %}
          <div class="pf-contact-map__iframe-wrap">
            {{ section.settings.iframe_code }}
          </div>
        {% else %}
          <div class="pf-contact-map__fallback">
            <div class="pf-contact-map__fallback-content">
              <div class="pf-contact-map__pin-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <h3 class="pf-contact-map__fallback-title">{{ section.settings.studio_name | default: 'Stag Men Fashion Design Studio' }}</h3>
              <p class="pf-contact-map__fallback-addr">{{ section.settings.studio_address | default: 'Kochi, Kerala, India' }}</p>
              {% if section.settings.directions_url != blank %}
                <a href="{{ section.settings.directions_url }}" target="_blank" rel="noopener noreferrer" class="pf-contact-map__fallback-btn">
                  Get Directions
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <!-- Studio Quick Badge Overlay -->
        {% if section.settings.show_location_card and section.settings.studio_name != blank %}
          <div class="pf-contact-map__floating-card">
            <div class="pf-contact-map__floating-dot"></div>
            <div>
              <p class="pf-contact-map__floating-title">{{ section.settings.studio_name }}</p>
              <p class="pf-contact-map__floating-text">{{ section.settings.studio_address }}</p>
              {% if section.settings.studio_hours != blank %}
                <p class="pf-contact-map__floating-hours">{{ section.settings.studio_hours }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<style>
  .pf-contact-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
    box-sizing: border-box;
  }

  @media (max-width: 749px) {
    .pf-contact-shell {
      padding: 0 10px;
    }
  }

  .pf-contact-map {
    padding-top: var(--map-pt, 40px);
    padding-bottom: var(--map-pb, 60px);
  }

  .pf-contact-map__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .pf-contact-map__titles {
    max-width: 620px;
  }

  .pf-contact-map__eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.6;
    margin-bottom: 8px;
  }

  .pf-contact-map__heading {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading, #111111);
  }

  .pf-contact-map__desc {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.4;
    color: currentColor;
    opacity: 0.75;
  }

  .pf-map-directions-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 5px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-foreground-heading, #111111);
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .pf-map-directions-btn:hover {
    border-color: #111111;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .pf-contact-map__card {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #f4f4f5;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.06);
    min-height: 420px;
  }

  .pf-contact-map__iframe-wrap,
  .pf-contact-map__iframe-wrap iframe {
    width: 100%;
    height: 100%;
    min-height: 420px;
    display: block;
    border: 0;
  }

  .pf-contact-map__fallback {
    min-height: 420px;
    display: grid;
    place-items: center;
    padding: 40px 20px;
    background: radial-gradient(circle at 50% 50%, #fafafa 0%, #f0f0f2 100%);
  }

  .pf-contact-map__fallback-content {
    text-align: center;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pf-contact-map__pin-icon {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: grid;
    place-items: center;
    color: #111111;
    margin-bottom: 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .pf-contact-map__fallback-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 600;
    color: #111111;
  }

  .pf-contact-map__fallback-addr {
    margin: 0 0 20px;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.65);
    line-height: 1.5;
  }

  .pf-contact-map__fallback-btn {
    display: inline-flex;
    padding: 10px 22px;
    border-radius: 5px;
    background: #0800CF;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .pf-contact-map__fallback-btn:hover {
    background: #0600a3;
    transform: translateY(-1px);
  }

  .pf-contact-map__floating-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    max-width: 320px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    padding: 16px 20px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    display: flex;
    gap: 12px;
    align-items: flex-start;
    z-index: 2;
  }

  .pf-contact-map__floating-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    margin-top: 6px;
    flex: 0 0 auto;
  }

  .pf-contact-map__floating-title {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 600;
    color: #111111;
  }

  .pf-contact-map__floating-text {
    margin: 0 0 4px;
    font-size: 12px;
    color: rgba(0, 0, 0, 0.7);
    line-height: 1.4;
  }

  .pf-contact-map__floating-hours {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.5);
  }

  @media screen and (max-width: 640px) {
    .pf-contact-map__card {
      min-height: 340px;
    }

    .pf-contact-map__iframe-wrap,
    .pf-contact-map__iframe-wrap iframe,
    .pf-contact-map__fallback {
      min-height: 340px;
    }

    .pf-contact-map__floating-card {
      position: static;
      margin: 16px;
      max-width: calc(100% - 32px);
    }
  }
</style>

{% schema %}
{
  "name": "Contact map",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Flagship Studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit our studio" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Experience our collection in person, feel the heavyweight fabrics, and get styled by our team." },
    { "type": "textarea", "id": "iframe_code", "label": "Google Maps Embed <iframe> Code", "info": "Paste the Google Maps HTML embed code here." },
    { "type": "header", "content": "Studio Card Overlay" },
    { "type": "checkbox", "id": "show_location_card", "label": "Show location summary card", "default": true },
    { "type": "text", "id": "studio_name", "label": "Studio name", "default": "Stag Men Fashion Studio" },
    { "type": "text", "id": "studio_address", "label": "Studio address", "default": "Kochi, Kerala, India" },
    { "type": "text", "id": "studio_hours", "label": "Studio hours", "default": "Mon - Sat: 10:00 AM - 6:30 PM" },
    { "type": "url", "id": "directions_url", "label": "Google Maps directions link" },
    { "type": "text", "id": "directions_label", "label": "Directions link text", "default": "Open in Maps" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 28 }
  ],
  "presets": [{ "name": "Contact map" }]
}
{% endschema %}
