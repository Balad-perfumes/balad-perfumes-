{%- liquid
  assign msg_count = section.blocks.size
-%}

{%- if section.settings.enable and msg_count > 0 -%}
  {%- capture marquee_group -%}
    {%- for rep in (1..3) -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <span class="balad-announce__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="balad-announce__link">{{ block.settings.text }}</a>
            {%- else -%}
              <span class="balad-announce__label">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
          <svg class="balad-announce__sep" viewBox="0 0 24 24" width="10" height="10" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 1.5l2.6 8 8 2.5-8 2.5-2.6 8-2.6-8-8-2.5 8-2.5z"/></svg>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div
    class="balad-announce{% if section.settings.pause_on_hover %} balad-announce--pausable{% endif %}"
    role="region"
    aria-label="Announcement"
    style="
      --announce-text: {{ section.settings.text_color }};
      --announce-bg-start: {{ section.settings.bg_start }};
      --announce-bg-end: {{ section.settings.bg_end }};
      --announce-speed: {{ section.settings.speed }}s;
    "
  >
    <div class="balad-announce__track">
      <div class="balad-announce__group">{{ marquee_group }}</div>
      <div class="balad-announce__group" aria-hidden="true">{{ marquee_group }}</div>
    </div>
  </div>

  <style>
    .balad-announce {
      position: relative;
      z-index: 101;
      width: 100%;
      overflow: hidden;
      background: linear-gradient(90deg, var(--announce-bg-start, #13173a), var(--announce-bg-end, #632266));
      color: var(--announce-text, #ffffff);
    }

    .balad-announce__track {
      display: flex;
      width: max-content;
      animation: balad-announce-scroll var(--announce-speed, 45s) linear infinite;
      will-change: transform;
    }

    .balad-announce--pausable:hover .balad-announce__track {
      animation-play-state: paused;
    }

    .balad-announce__group {
      display: flex;
      flex: none;
      align-items: center;
      min-width: 100vw;
      justify-content: space-around;
    }

    .balad-announce__item {
      display: inline-flex;
      align-items: center;
      padding: 0 22px;
      white-space: nowrap;
      font-size: 12.5px;
      font-weight: 600;
      line-height: 1;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .balad-announce__label,
    .balad-announce__link {
      display: inline-block;
      padding: 11px 0;
      color: inherit;
      text-decoration: none;
    }

    .balad-announce__link:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .balad-announce__sep {
      flex: none;
      opacity: 0.7;
    }

    @keyframes balad-announce-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media screen and (max-width: 749px) {
      .balad-announce__item {
        padding: 0 16px;
        font-size: 11.5px;
        letter-spacing: 0.02em;
      }

      .balad-announce__label,
      .balad-announce__link {
        padding: 9px 0;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (seconds, higher = slower)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause when hovering",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_start",
      "label": "Background gradient start",
      "default": "#13173a"
    },
    {
      "type": "color",
      "id": "bg_end",
      "label": "Background gradient end",
      "default": "#632266"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Shop Your Favourite Fragrances with Free Pan-India Delivery!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
