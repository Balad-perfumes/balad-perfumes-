{% liquid
  assign bg_video = section.settings.video
  assign bg_image = section.settings.image
%}

<section
  class="pf-video-proof color-{{ section.settings.color_scheme }}"
  style="
    --pf-video-proof-card-radius: {{ section.settings.card_radius }}px;
    --pf-video-proof-card-bg: {{ section.settings.card_background }};
    --pf-video-proof-card-border: {{ section.settings.card_border }};
    --pf-video-proof-card-shadow: {{ section.settings.card_shadow }};
  "
>
  <div class="pf-video-proof__stage">
    <div class="pf-video-proof__media" aria-hidden="true">
      {% if bg_video != blank %}
        {{
          bg_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            class: 'pf-video-proof__video'
        }}
      {% elsif bg_image != blank %}
        {{
          bg_image
          | image_url: width: 2400
          | image_tag:
            class: 'pf-video-proof__image',
            widths: '640, 960, 1200, 1600, 2000, 2400',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.heading
        }}
      {% else %}
        <div class="pf-video-proof__placeholder"></div>
      {% endif %}
    </div>

    <div class="pf-video-proof__shade"></div>

    <div class="pf-video-proof__inner">
      <div class="pf-video-proof__card">
        {% for block in section.blocks %}
          <div class="pf-video-proof__row" {{ block.shopify_attributes }}>
            <div class="pf-video-proof__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'idea' %}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 18h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M10 21h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M8.2 14.8c-1.7-1.2-2.7-3-2.7-5 0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5c0 2-1 3.8-2.7 5-.8.6-1.2 1.5-1.2 2.5V18H9.4v-.7c0-1-.4-1.9-1.2-2.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M9.7 8.6c.4-.9 1.1-1.4 2.3-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                {% when 'leaf' %}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M18.6.1c.3.1.6.3.8.4.2.2.3.5.4.8.1.3.1.7.1 1.1 0 1.1-.1 2.6-.4 4.1-.5 2.7-1.3 5.9-2.2 8.8-.5 1.5-1.2 2.7-2 3.5-1.6 1.6-3.9 2.5-6.2 2.5-2.4 0-4.7-.9-6.3-2.5-3.6-3.6-3.5-9.5.1-13.1 1-1 2.5-1.6 4-2.1 1.6-.5 3.4-.9 5.1-1.2 1.7-.3 3.2-.5 4.4-.6.6-.1 1.2-.1 1.8 0Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  </svg>
                {% when 'diamond' %}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 4 9l8 12 8-12-8-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M4 9h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M8.2 9 12 21l3.8-12" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            </div>

            <div class="pf-video-proof__content">
              {% if block.settings.heading != blank %}
                <h3 class="pf-video-proof__title">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="pf-video-proof__text">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          </div>

          {% unless forloop.last %}
            <div class="pf-video-proof__divider" aria-hidden="true"></div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .pf-video-proof {
    background: #ffffff;
    color: var(--color-foreground);
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px clamp(20px, 4vw, 42px) 16px;
  }

  .pf-video-proof__stage {
    position: relative;
    min-height: clamp(680px, 84svh, 1000px);
    overflow: hidden;
    isolation: isolate;
    background: #e8e8e8;
    border-radius: 10px;
  }

  .pf-video-proof__media,
  .pf-video-proof__video,
  .pf-video-proof__image,
  .pf-video-proof__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pf-video-proof__video,
  .pf-video-proof__image {
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .pf-video-proof__placeholder {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.16), rgb(0 0 0 / 0.16)),
      linear-gradient(135deg, #b8b8b8 0%, #e0e0e0 48%, #c8c8c8 100%);
  }

  .pf-video-proof__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(160deg, rgb(0 0 0 / 0.28) 0%, rgb(0 0 0 / 0.08) 40%, transparent 65%),
      linear-gradient(to top, rgb(0 0 0 / 0.4) 0%, transparent 45%);
    z-index: 1;
  }

  .pf-video-proof__inner {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    min-height: inherit;
    padding: clamp(32px, 5vw, 72px) 20px;
  }

  .pf-video-proof__card {
    width: min(100%, 660px);
    padding: clamp(24px, 3.5vw, 36px) clamp(22px, 4vw, 38px);
    border-radius: var(--pf-video-proof-card-radius);
    background: color-mix(in srgb, var(--pf-video-proof-card-bg) 92%, transparent);
    border: 1px solid rgb(255 255 255 / 0.18);
    box-shadow: var(--pf-video-proof-card-shadow), 0 0 0 1px rgb(255 255 255 / 0.06) inset;
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
  }

  .pf-video-proof__row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .pf-video-proof__divider {
    height: 1px;
    margin: 22px 0;
    background: rgb(17 17 17 / 0.07);
  }

  .pf-video-proof__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgb(0 0 0 / 0.08);
    color: #000000;
    flex: 0 0 auto;
  }

  .pf-video-proof__icon svg {
    width: 26px;
    height: 26px;
    display: block;
  }

  .pf-video-proof__content {
    min-width: 0;
    padding-top: 3px;
  }

  .pf-video-proof__title {
    margin: 0;
    color: var(--color-foreground);
    font-size: 17px;
    line-height: 1.08;
    letter-spacing: 0;
    font-weight: 600;
  }

  .pf-video-proof__text {
    margin: 10px 0 0;
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    font-size: 13.5px;
    line-height: 1.65;
    max-width: 42ch;
  }

  @media screen and (max-width: 749px) {
    .pf-video-proof {
      padding: 0;
      margin: 0;
    }

    .pf-video-proof__stage {
      min-height: 460px;
      border-radius: 0;
    }

    .pf-video-proof__inner {
      padding: 44px 14px 44px;
      align-items: end;
    }

    .pf-video-proof__card {
      width: min(100%, 560px);
      padding: 50px;
      border-radius: 10px;
    }

    .pf-video-proof__row {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 14px;
    }

    .pf-video-proof__icon {
      width: 44px;
      height: 44px;
      border-radius: 8px;
    }

    .pf-video-proof__icon svg {
      width: 22px;
      height: 22px;
    }

    .pf-video-proof__divider {
      margin: 18px 0;
    }

    .pf-video-proof__title {
      font-size: 16px;
    }

    .pf-video-proof__text {
      margin-top: 7px;
      max-width: none;
      font-size: 0.88rem;
    }
  }
</style>

{% schema %}
{
  "name": "Video Feature Card",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card radius",
      "default": 22
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#ececec"
    },
    {
      "type": "text",
      "id": "card_shadow",
      "label": "Card shadow",
      "default": "0 22px 60px rgba(0, 0, 0, 0.18)"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "idea",
          "options": [
            { "value": "idea", "label": "Idea" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "diamond", "label": "Diamond" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Thoughtfully Designed"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Created with a focus on function, innovation, and everyday use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Feature Card",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature",
          "settings": {
            "icon": "leaf",
            "heading": "Sustainably Made",
            "text": "Created with care for the environment, reducing carbon impact."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "diamond",
            "heading": "Built to Last",
            "text": "Made with premium, durable materials for long-term use."
          }
        }
      ]
    }
  ]
}
{% endschema %}
