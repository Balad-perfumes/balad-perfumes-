{% liquid
  assign footer_logo = section.settings.logo | default: settings.logo
  assign brand_name = section.settings.brand_name | default: settings.brand_name | default: shop.name
  assign brand_text = section.settings.brand_text | default: "Contemporary streetwear designed for everyday confidence and individuality."
  assign year_now = 'now' | date: '%Y'

  assign menu_1_handle = section.settings.menu_1
  assign menu_1_title = section.settings.menu_title_1 | default: 'Shop'

  assign menu_2_handle = section.settings.menu_2
  assign menu_2_title = section.settings.menu_title_2 | default: 'Info & Legal'

  assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link | default: 'https://instagram.com/'
  assign whatsapp_url = section.settings.whatsapp_url | default: 'https://wa.me/'
  assign tiktok_url = section.settings.tiktok_url | default: settings.social_tiktok_link
  assign facebook_url = section.settings.facebook_url | default: settings.social_facebook_link
  assign youtube_url = section.settings.youtube_url | default: settings.social_youtube_link

  assign contact_email = section.settings.contact_email | default: 'hello@baladperfume.com'
  assign contact_whatsapp_text = section.settings.contact_whatsapp_text | default: '+91 94474 25555'
%}

{%- comment -%}
  Homepage: the footer is ~10 KB gzip of HTML at the very bottom of a long page, so it loads on demand like the
  balad-* homepage sections (snippets/lazy-section.liquid). section.index is blank when Shopify renders the
  section through the Section Rendering API (?section_id=), so that fetch returns the real footer.
  Heights measured from the rendered footer: 931px phones, 890px tablets, 414px desktop.
{%- endcomment -%}
{%- if template.name == 'index' and section.index != blank and request.design_mode == false -%}
  {%- render 'lazy-section', section_id: section.id, kind: 'block', h: 931, ht: 890, hd: 414 -%}
{%- else -%}
<footer class="balad-footer color-{{ section.settings.color_scheme }}" id="balad-site-footer">
  <div class="balad-footer__wrap">
    <div class="balad-footer__grid">
      <!-- Col 1: Brand & Tagline -->
      <div class="balad-footer__brand-col">
        {% if footer_logo != blank %}
          <a href="{{ routes.root_url }}" class="balad-footer__logo-link">
            {{
              footer_logo
              | image_url: width: 260
              | image_tag:
                class: 'balad-footer__logo-img',
                widths: '130, 200, 260',
                loading: 'lazy',
                alt: brand_name
            }}
          </a>
        {% else %}
          <a href="{{ routes.root_url }}" class="balad-footer__brand-name">{{ brand_name }}</a>
        {% endif %}

        <p class="balad-footer__brand-text">{{ brand_text }}</p>

        <div class="balad-footer__contact-links">
          {% if contact_email != blank %}
            <a href="mailto:{{ contact_email }}" class="balad-footer__contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <span>{{ contact_email }}</span>
            </a>
          {% endif %}

          {% if whatsapp_url != blank and contact_whatsapp_text != blank %}
            <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="balad-footer__contact-item">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.48-.28z"/></svg>
              <span>{{ contact_whatsapp_text }}</span>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Col 2: Shop / Navigation Menu -->
      <div class="balad-footer__nav-col balad-footer__nav-col--shop">
        <h3 class="balad-footer__heading">{{ menu_1_title }}</h3>
        <ul class="balad-footer__menu">
          {% if menu_1_handle != blank and linklists[menu_1_handle].links.size > 0 %}
            {% for link in linklists[menu_1_handle].links %}
              <li><a href="{{ link.url }}" class="balad-footer__link">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/collections/all" class="balad-footer__link">New In</a></li>
            <li><a href="/collections" class="balad-footer__link">Oversized Tees</a></li>
            <li><a href="/collections" class="balad-footer__link">Co-ord Sets</a></li>
            <li><a href="/collections" class="balad-footer__link">Streetwear Tops</a></li>
            <li><a href="/collections" class="balad-footer__link">Best Sellers</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Col 3: Boring Stuff / Legal Menu -->
      <div class="balad-footer__nav-col balad-footer__nav-col--legal">
        <h3 class="balad-footer__heading">{{ menu_2_title }}</h3>
        <ul class="balad-footer__menu">
          {% if menu_2_handle != blank and linklists[menu_2_handle].links.size > 0 %}
            {% for link in linklists[menu_2_handle].links %}
              <li><a href="{{ link.url }}" class="balad-footer__link">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            {% if shop.shipping_policy != blank and shop.shipping_policy.url != blank %}
              <li><a href="{{ shop.shipping_policy.url }}" class="balad-footer__link">Shipping Information</a></li>
            {% endif %}
            <li><a href="/policies/refund-policy" class="balad-footer__link">Returns & Exchanges</a></li>
            <li><a href="/policies/privacy-policy" class="balad-footer__link">Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service" class="balad-footer__link">Terms of Service</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Col 4: Connect & Socials -->
      <div class="balad-footer__nav-col balad-footer__nav-col--connect">
        <h3 class="balad-footer__heading">Connect</h3>
        <div class="balad-footer__social-list">
          {% if instagram_url != blank %}
            <a href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" class="balad-footer__social-link" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              <span>Instagram</span>
            </a>
          {% endif %}

          {% if whatsapp_url != blank %}
            <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="balad-footer__social-link" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.48-.28z"/></svg>
              <span>WhatsApp</span>
            </a>
          {% endif %}

          {% if tiktok_url != blank %}
            <a href="{{ tiktok_url }}" target="_blank" rel="noopener noreferrer" class="balad-footer__social-link" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
              <span>TikTok</span>
            </a>
          {% endif %}

          {% if facebook_url != blank %}
            <a href="{{ facebook_url }}" target="_blank" rel="noopener noreferrer" class="balad-footer__social-link" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              <span>Facebook</span>
            </a>
          {% endif %}

          {% if youtube_url != blank %}
            <a href="{{ youtube_url }}" target="_blank" rel="noopener noreferrer" class="balad-footer__social-link" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
              <span>YouTube</span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Clean Bottom Bar -->
    <div class="balad-footer__bottom">
      <p class="balad-footer__copyright">
        &copy; {{ year_now }} {{ brand_name }}. All rights reserved.
      </p>

      {% if section.settings.show_payment_icons %}
        <div class="balad-footer__payments" aria-label="Accepted payment methods">
          {% render 'payment-icons' %}
        </div>
      {% endif %}

      {% if section.settings.show_back_to_top %}
        <button type="button" class="balad-footer__top-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'});" aria-label="Back to top">
          <span>Back to top</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
        </button>
      {% endif %}
    </div>
  </div>
</footer>

<style>
  .balad-footer {
    background: #111111;
    color: #ffffff;
    font-family: var(--font-body--family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .balad-footer__wrap {
    max-width: 1400px;
    margin: 0 auto;
    padding: 56px 28px 28px;
  }

  .balad-footer__grid {
    display: grid;
    grid-template-columns: 2.2fr 1.2fr 1.4fr 1.2fr;
    gap: clamp(32px, 5vw, 64px);
    margin-bottom: 48px;
  }

  /* Brand Column */
  .balad-footer__brand-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .balad-footer__logo-link {
    display: inline-block;
    margin-bottom: 14px;
    text-decoration: none;
  }

  .balad-footer__logo-img {
    display: block;
    max-width: 140px;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .balad-footer__brand-name {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
    text-decoration: none;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .balad-footer__brand-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 20px 0;
    max-width: 340px;
  }

  .balad-footer__contact-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .balad-footer__contact-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .balad-footer__contact-item svg {
    width: 14px;
    height: 14px;
    color: rgba(255, 255, 255, 0.7);
    flex-shrink: 0;
  }

  .balad-footer__contact-item:hover {
    color: #ffffff;
  }

  /* Navigation Columns */
  .balad-footer__nav-col {
    display: flex;
    flex-direction: column;
  }

  .balad-footer__heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.95;
    margin: 0 0 18px 0;
  }

  .balad-footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .balad-footer__link {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 13.5px;
    line-height: 1.4;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .balad-footer__link:hover {
    color: #ffffff;
    opacity: 1;
  }

  /* Social Links */
  .balad-footer__social-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .balad-footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 13.5px;
    transition: color 0.2s ease;
  }

  .balad-footer__social-link svg {
    width: 15px;
    height: 15px;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }

  .balad-footer__social-link:hover {
    color: #ffffff;
  }

  .balad-footer__social-link:hover svg {
    color: #ffffff;
  }

  /* Bottom Bar */
  .balad-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .balad-footer__copyright {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .balad-footer__payments {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .balad-footer__payments .balad-payment-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 19px;
    border-radius: 3px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .balad-footer__payments .balad-payment-badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.4);
  }

  .balad-footer__payments .balad-payment-badge svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .balad-footer__top-btn {
    appearance: none;
    background: transparent;
    border: none;
    padding: 4px 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }

  .balad-footer__top-btn svg {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .balad-footer__top-btn:hover {
    color: #ffffff;
  }

  .balad-footer__top-btn:hover svg {
    transform: translateY(-2px);
  }

  /* Responsive Breakpoints */
  @media screen and (max-width: 989px) {
    .balad-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }

    .balad-footer__brand-col {
      grid-column: 1 / -1;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media screen and (max-width: 749px) {
    .balad-footer__wrap {
      padding: 36px 20px 24px;
    }

    .balad-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
      margin-bottom: 32px;
    }

    .balad-footer__brand-col {
      grid-column: 1 / -1;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .balad-footer__brand-text {
      max-width: 100%;
    }

    .balad-footer__nav-col--connect {
      grid-column: 1 / -1;
    }

    .balad-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .balad-footer__payments {
      width: 100%;
      justify-content: flex-start;
      gap: 4px;
    }

    .balad-footer__payments .balad-payment-badge {
      width: 27px;
      height: 17px;
      border-radius: 2.5px;
    }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand Information"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Balad Perfumes"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand Tagline",
      "default": "Contemporary streetwear designed for everyday confidence and individuality."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "hello@baladperfume.com"
    },
    {
      "type": "text",
      "id": "contact_whatsapp_text",
      "label": "WhatsApp Display Text",
      "default": "+91 94474 25555"
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "text",
      "id": "menu_title_1",
      "label": "Menu 1 Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1 (Link List)"
    },
    {
      "type": "text",
      "id": "menu_title_2",
      "label": "Menu 2 Title",
      "default": "Info & Legal"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2 (Link List)"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Footer Settings"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "Show Back to Top Button",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
