{% schema %}
{
  "name": "Stag Video",
  "tag": "section",
  "class": "stagmenfashion-video-section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop Height",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile Height",
      "min": 150,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Stag Video",
      "category": "Video"
    }
  ]
}
{% endschema %}

<style>
  .stagmenfashion-video-wrapper-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: clamp(20px, 4vw, 42px);
  }
  .stagmenfashion-video-wrapper-{{ section.id }} video,
  .stagmenfashion-video-wrapper-{{ section.id }} iframe {
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
    display: block;
    border-radius: {{ section.settings.corner_radius }}px;
    object-fit: cover;
    background-color: #e5e5e5;
  }
  .stagmenfashion-video-placeholder-{{ section.id }} {
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
    background-color: #dfdfdf;
    border-radius: {{ section.settings.corner_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111;
    font-weight: 500;
    font-size: 16px;
  }
  @media screen and (max-width: 749px) {
    .stagmenfashion-video-wrapper-{{ section.id }} {
      padding-inline: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
    .stagmenfashion-video-wrapper-{{ section.id }} video,
    .stagmenfashion-video-wrapper-{{ section.id }} iframe {
      height: {{ section.settings.mobile_height }}px;
      border-radius: 0;
    }
    .stagmenfashion-video-placeholder-{{ section.id }} {
      height: {{ section.settings.mobile_height }}px;
      border-radius: 0;
    }
  }
</style>

<div class="stagmenfashion-video-wrapper-{{ section.id }}">
  {% if section.settings.video != blank %}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
  {% else %}
    <div class="stagmenfashion-video-placeholder-{{ section.id }}">
      Video
    </div>
  {% endif %}
</div>
