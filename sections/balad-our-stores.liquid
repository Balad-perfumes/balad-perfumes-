<section
  id="our-stores"
  class="smf-our-stores-section color-{{ section.settings.color_scheme }} smf-stores--align-{{ section.settings.header_alignment | default: 'left' }}"
  data-section-id="{{ section.id }}"
  style="--smf-stores-bg: {{ section.settings.background | default: '#ffffff' }}; --smf-stores-pt: {{ section.settings.padding_top | default: 24 }}px; --smf-stores-pb: {{ section.settings.padding_bottom | default: 24 }}px; scroll-margin-top: 100px;"
>
  <div class="smf-stores-shell">

    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="smf-stores-head">
        <div class="smf-stores-heading-wrap">
          {% if section.settings.heading != blank %}
            <h2 class="smf-stores-heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="smf-stores-subheading">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>

        {% if section.settings.discover_more_label != blank %}
          {% assign more_url = section.settings.discover_more_link | default: '/pages/our-stores' %}
          <a href="{{ more_url }}" class="smf-stores-discover-more">
            {{ section.settings.discover_more_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="smf-stores-grid smf-stores-grid--{{ section.blocks.size }}">
        {% for block in section.blocks %}
          {% liquid
            assign dir_url = block.settings.directions_url
            if dir_url == blank and block.settings.address != blank
              assign clean_addr = block.settings.address | strip_newlines | strip
              assign dir_url = 'https://www.google.com/maps/search/?api=1&query=' | append: clean_addr
            endif
          %}
          <div class="smf-store-card" {{ block.shopify_attributes }}>

            <!-- Media Container -->
            <div class="smf-store-card__media-box">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.store_name | escape }}"
                  width="800"
                  height="500"
                  loading="lazy"
                  class="smf-store-card__img"
                >
              {% else %}
                <div class="smf-store-card__placeholder">
                  <svg viewBox="0 0 64 64" fill="none" width="40" height="40" aria-hidden="true">
                    <rect x="10" y="24" width="44" height="30" rx="3" stroke="currentColor" stroke-width="2"/>
                    <path d="M10 28l7-14h30l7 14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <rect x="25" y="38" width="14" height="16" rx="2" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              {% endif %}
              <span class="smf-store-card__badge">Balad Boutique</span>
            </div>

            <!-- Store Details Body -->
            <div class="smf-store-card__body">
              <h3 class="smf-store-card__title">{{ block.settings.store_name | default: 'BALAD PERFUMES' }}</h3>

              {% if block.settings.address != blank %}
                <div class="smf-store-card__address">
                  <span class="smf-store-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg></span>
                  <span class="smf-store-card__label">Address</span><span class="smf-store-card__text">{{ block.settings.address }}</span>
                </div>
              {% endif %}

              {% if block.settings.phone != blank %}
                <div class="smf-store-card__phone">
                  <span class="smf-store-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg></span>
                  <span class="smf-store-card__label">Phone</span><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                </div>
              {% endif %}

              <div class="smf-store-card__actions">
                {% if dir_url != blank %}
                  <a
                    href="{{ dir_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="smf-store-card__btn"
                    aria-label="Get directions to {{ block.settings.store_name | escape }}"
                  >
                    <span class="smf-store-card__btn-label">{{ block.settings.directions_label | default: 'Get Direction' }}</span>
                    <span class="smf-store-card__btn-arrow" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none" width="14" height="14">
                        <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </a>
                {% endif %}
                {% if block.settings.phone != blank %}
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="smf-store-card__call" aria-label="Call {{ block.settings.store_name | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  .smf-our-stores-section {
    background: var(--smf-stores-bg, #ffffff);
    color: #111111;
    width: 100%;
    padding-top: clamp(10px, 1.4vw, 16px);
    padding-bottom: clamp(4px, 0.8vw, 8px);
  }

  .smf-stores-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px;
    box-sizing: border-box;
  }

  .smf-stores-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgb(17 17 17 / 0.1);
  }

  .smf-stores-heading-wrap {
    flex: 1;
    min-width: 0;
  }

  .smf-stores-heading {
    margin: 0;
    color: #111111;
    font-family: var(--font-heading--family, inherit);
    font-size: 18px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .smf-stores-subheading {
    margin: 6px 0 0;
    font-size: 13px;
    color: #6b7280;
    line-height: 1.4;
    font-weight: 400;
  }

  .smf-stores-discover-more {
    color: #111111;
    font-size: 13px;
    font-weight: 600;
    flex-shrink: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .smf-stores-discover-more:hover {
    opacity: 0.7;
  }

  /* ── Store Grid Layout ── */
  .smf-stores-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .smf-stores-shell {
      padding: 0 20px;
    }
  }

  @media (max-width: 749px) {
    .smf-stores-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .smf-stores-shell {
      padding: 0 12px;
    }

    .smf-stores-heading {
      font-size: 15px;
    }

    .smf-stores-subheading {
      font-size: 12px;
    }

    .smf-stores-discover-more {
      font-size: 11px;
    }

    .smf-stores-head {
      margin-bottom: 12px;
      padding-bottom: 10px;
    }
  }

  /* ── Store Card: nested frames, same language as the product cards ── */
  .smf-store-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 6px;
    padding: 6px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 0 0 1px rgb(17 17 17 / 0.07);
    transition: box-shadow 0.3s ease;
  }

  .smf-store-card:hover {
    box-shadow: 0 0 0 1px rgb(17 17 17 / 0.14), 0 18px 40px rgba(0, 0, 0, 0.08);
  }

  .smf-store-card__media-box {
    position: relative;
    min-height: clamp(240px, 19vw, 275px);
    border-radius: 15px;
    background: #ece9e4;
    overflow: hidden;
    isolation: isolate;
  }

  .smf-store-card__media-box::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(to top, rgb(0 0 0 / 0.25), transparent);
    pointer-events: none;
  }

  .smf-store-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .smf-store-card:hover .smf-store-card__img { transform: scale(1.05); }

  .smf-store-card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(17, 17, 17, 0.28);
  }

  .smf-store-card__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 22px;
    padding: 0 9px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #111111;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
  }


  /* details panel */
  .smf-store-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    border-radius: 15px;
    background: #f3f3f2;
    min-width: 0;
  }

  .smf-store-card__title {
    margin: 0 0 2px 2px;
    font-family: var(--font-heading--family, inherit);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #111111;
  }

  .smf-store-card__address,
  .smf-store-card__phone {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    grid-template-areas: 'icon label' 'icon text';
    column-gap: 10px;
    row-gap: 0;
    align-items: center;
    padding: 10px 12px 10px 10px;
    border-radius: 11px;
    background: #ffffff;
  }

  .smf-store-card__icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    background: #111111;
    color: #ffffff;
  }

  .smf-store-card__icon svg { width: 13px; height: 13px; }

  .smf-store-card__label {
    grid-area: label;
    align-self: end;
    color: #9a9a9a;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .smf-store-card__text {
    grid-area: text;
    align-self: start;
    color: #222222;
    font-size: 12px;
    line-height: 1.4;
  }

  .smf-store-card__phone a {
    grid-area: text;
    align-self: start;
    color: #111111;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .smf-store-card__phone a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .smf-store-card__actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
  }

  .smf-store-card__btn {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 42px;
    padding: 0 5px 0 18px;
    background: #111111;
    color: #ffffff;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    box-sizing: border-box;
    transition: background 0.2s ease;
  }

  .smf-store-card__btn:hover { background: #000000; }

  .smf-store-card__btn-arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    transition: transform 0.2s ease;
  }

  .smf-store-card__btn:hover .smf-store-card__btn-arrow { transform: translate(2px, -2px); }

  .smf-store-card__call {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    box-shadow: 0 0 0 1px rgb(17 17 17 / 0.1);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .smf-store-card__call:hover { background: #111111; color: #ffffff; }
  .smf-store-card__call svg { width: 15px; height: 15px; }

  @media (max-width: 1024px) {
    .smf-store-card { grid-template-columns: 1fr; border-radius: 18px; }
    .smf-store-card__media-box { min-height: 0; aspect-ratio: 16 / 9; }
  }

  @media (max-width: 749px) {
    .smf-store-card__title { font-size: 14px; }
    .smf-store-card__body { padding: 12px; }
  }
</style>

{% schema %}
{
  "name": "Our Stores",
  "tag": "section",
  "class": "smf-our-stores-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Stores"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visit our retail locations across India."
    },
    {
      "type": "text",
      "id": "discover_more_label",
      "label": "Discover More Label"
    },
    {
      "type": "url",
      "id": "discover_more_link",
      "label": "Discover More Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Store Image"
        },
        {
          "type": "text",
          "id": "store_name",
          "label": "Store Name / City",
          "default": "Calicut"
        },
        {
          "type": "text",
          "id": "directions_label",
          "label": "Directions link text",
          "default": "Get Direction"
        },
        {
          "type": "url",
          "id": "directions_url",
          "label": "Google Maps link"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Khaleej Residency, near Aster, Kozhikode, Kerala 673016"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number",
          "default": "+91 94474 25555"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Stores",
      "blocks": [
        {
          "type": "store",
          "settings": {
            "store_name": "Calicut",
            "address": "Khaleej Residency, near Aster, Kozhikode, Kerala 673016",
            "phone": "+91 94474 25555",
            "directions_label": "Get Direction"
          }
        },
        {
          "type": "store",
          "settings": {
            "store_name": "Thekkady",
            "address": "BALAD PERFUMES, Kavitha building, Thekkady, Kerala 685509",
            "phone": "+91 94473 76786",
            "directions_label": "Get Direction"
          }
        }
      ]
    }
  ]
}
{% endschema %}
