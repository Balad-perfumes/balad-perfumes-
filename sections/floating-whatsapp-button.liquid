{% liquid
  assign raw_number = section.settings.whatsapp_number | default: '919447425555'
  assign whatsapp_number = raw_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+'
  assign whatsapp_link = section.settings.whatsapp_link
  if whatsapp_link == blank and whatsapp_number != blank
    assign whatsapp_link = 'https://wa.me/' | append: whatsapp_number
  endif
%}

{% if section.settings.enable_button and whatsapp_link != blank %}
  <a
    class="floating-whatsapp-button{% if section.settings.show_label %} floating-whatsapp-button--with-label{% endif %}"
    href="{{ whatsapp_link }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ section.settings.aria_label | escape }}"
    style="
      --floating-whatsapp-bottom: {{ section.settings.bottom_offset | default: 20 }}px;
      --floating-whatsapp-inline: {{ section.settings.side_offset | default: 20 }}px;
    "
  >
    <span class="floating-whatsapp-button__icon" aria-hidden="true">
      {% if section.settings.icon_image != blank %}
        {{
          section.settings.icon_image
          | image_url: width: 160
          | image_tag:
            loading: 'lazy',
            class: 'floating-whatsapp-button__icon-image',
            widths: '40, 60, 80, 120, 160',
            alt: section.settings.aria_label
        }}
      {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" fill-rule="evenodd" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
        </svg>
      {% endif %}
    </span>

    {% if section.settings.show_label %}
      <span class="floating-whatsapp-button__text">
        <span class="floating-whatsapp-button__label">{{ section.settings.label }}</span>
      </span>
    {% endif %}
  </a>
{% endif %}

<style>
  .floating-whatsapp-button {
    position: fixed;
    right: var(--floating-whatsapp-inline, 20px);
    bottom: var(--floating-whatsapp-bottom, 20px);
    z-index: 99990; /* stays below the product sticky card (999998) and drawers */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 52px;
    height: 52px;
    padding: 0;
    border-radius: 50%;
    background-color: #25d366;
    color: #ffffff;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    /* White ring keeps the button clean on top of any content, soft shadow lifts it */
    box-shadow: 0 0 0 3px #ffffff, 0 8px 20px rgba(0, 0, 0, 0.18);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background-color 0.2s ease;
  }

  /* Soft pulse ring so the button is noticed without looking noisy */
  .floating-whatsapp-button::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #25d366;
    opacity: 0;
    pointer-events: none;
    animation: floatingWhatsappPulse 3.2s ease-out infinite;
  }

  .floating-whatsapp-button:hover,
  .floating-whatsapp-button:focus-visible {
    transform: translateY(-2px) scale(1.05);
    background-color: #1fbd5b;
    box-shadow: 0 0 0 3px #ffffff, 0 12px 26px rgba(0, 0, 0, 0.22);
    color: #ffffff;
  }

  .floating-whatsapp-button:active { transform: scale(0.96); }
  .floating-whatsapp-button:focus-visible { outline: 2px solid #151515; outline-offset: 5px; }

  .floating-whatsapp-button__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #ffffff;
  }

  .floating-whatsapp-button__icon svg,
  .floating-whatsapp-button__icon-image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .floating-whatsapp-button__icon-image { object-fit: contain; }

  /* With a text label: becomes a pill instead of a stretched circle */
  .floating-whatsapp-button--with-label {
    width: auto;
    padding: 0 20px 0 14px;
    border-radius: 999px;
  }

  .floating-whatsapp-button__text { display: inline-flex; flex-direction: column; min-width: 0; line-height: 1.1; }

  .floating-whatsapp-button__label {
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    color: #ffffff;
  }

  @keyframes floatingWhatsappPulse {
    0% { transform: scale(1); opacity: 0.5; }
    70%, 100% { transform: scale(1.5); opacity: 0; }
  }

  @media screen and (max-width: 749px) {
    .floating-whatsapp-button {
      right: var(--floating-whatsapp-inline, 16px);
      bottom: var(--floating-whatsapp-bottom, 20px);
      width: 46px;
      height: 46px;
    }

    .floating-whatsapp-button__icon { width: 26px; height: 26px; }

    /* The label is hidden on phones, so go back to a round button */
    .floating-whatsapp-button--with-label { width: 46px; padding: 0; border-radius: 50%; }
    .floating-whatsapp-button__text { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp-button { transition: none; }
    .floating-whatsapp-button::before { animation: none; display: none; }
  }
</style>

{% schema %}
{
  "name": "WhatsApp button",
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "default": "+91 94474 25555"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "WhatsApp link",
      "info": "Optional. Leave blank to build the link from the number."
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": false
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Chat with Balad Perfumes on WhatsApp"
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "label": "Bottom offset",
      "min": 8,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "side_offset",
      "label": "Side offset",
      "min": 8,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "WhatsApp button"
    }
  ]
}
{% endschema %}
