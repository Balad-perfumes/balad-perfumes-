  (() => {
    // -------------------------------------------------------------
    // Header & Drawer Logic
    // -------------------------------------------------------------
    const header = document.querySelector('[data-pf-header]');
    const drawer = document.querySelector('[data-pf-header-drawer]');
    const openButtons = document.querySelectorAll('[data-pf-header-menu]');
    const closeButtons = document.querySelectorAll('[data-pf-header-close]');

    if (drawer && drawer.parentElement !== document.body) {
      document.body.appendChild(drawer);
    }

    const setScrollState = () => {
      if (!header) return;
      const isScrolled = window.scrollY > 10;
      header.dataset.scrolled = isScrolled ? 'true' : 'false';
      header.setAttribute('data-scrolled', isScrolled ? 'true' : 'false');
      const h = header.offsetHeight;
      if (h > 0) {
        document.documentElement.style.setProperty('--header-height', `${h}px`);
        document.documentElement.style.setProperty('--header-height-mobile', `${h}px`);
        document.documentElement.style.setProperty('--header-group-height', `${h}px`);
      }
    };

    const toggleMobileNav = (hide) => {
      const mobileNavs = document.querySelectorAll('[data-stagmenfashion-mobile-nav], .stagmenfashion-mobile-nav, .stagmenfashion-mobile-tabs');
      mobileNavs.forEach((nav) => {
        if (hide) {
          nav.setAttribute('data-hidden', 'true');
          nav.style.setProperty('display', 'none', 'important');
        } else {
          nav.removeAttribute('data-hidden');
          nav.style.removeProperty('display');
        }
      });
    };

    const openDrawer = (e) => {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (!drawer) return;
      drawer.hidden = false;
      drawer.removeAttribute('hidden');
      document.body.classList.add('pf-drawer-open');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      toggleMobileNav(true);
    };

    const closeDrawer = (e) => {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (!drawer) return;
      drawer.hidden = true;
      drawer.setAttribute('hidden', 'true');
      document.body.classList.remove('pf-drawer-open');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      toggleMobileNav(false);
    };

    openButtons.forEach((button) => button.addEventListener('click', openDrawer));
    closeButtons.forEach((button) => button.addEventListener('click', closeDrawer));
    drawer?.addEventListener('click', (event) => {
      if (event.target === drawer) closeDrawer();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && !drawer.hidden) {
        closeDrawer();
      }
    });

    const updateCartCount = (count) => {
      const countNodes = document.querySelectorAll('.pf-header__cart-count');
      countNodes.forEach((countNode) => {
        if (count > 0) {
          countNode.textContent = count;
          countNode.removeAttribute('hidden');
          countNode.removeAttribute('aria-hidden');
        } else {
          countNode.textContent = '0';
          countNode.setAttribute('hidden', 'true');
          countNode.setAttribute('aria-hidden', 'true');
        }
      });
    };

    document.addEventListener('cart:update', (event) => {
      let count = 0;
      if (event.detail?.resource?.items !== undefined) {
        count = event.detail.resource.items.length;
      } else if (event.detail?.resource?.item_count !== undefined) {
        count = event.detail.resource.items ? event.detail.resource.items.length : Number(event.detail.resource.item_count);
      } else {
        const comingFromProductForm = event.detail?.data?.source === 'product-form-component';
        const currentCountNode = document.querySelector('.pf-header__cart-count');
        const currentCount = currentCountNode ? Number(currentCountNode.textContent) : 0;
        count = comingFromProductForm ? currentCount + Number(event.detail?.data?.itemCount ?? 0) : Number(event.detail?.data?.itemCount ?? 0);
      }
      updateCartCount(count);
    });

    setScrollState();
    window.addEventListener('scroll', setScrollState, { passive: true });
    window.addEventListener('resize', setScrollState, { passive: true });

    // -------------------------------------------------------------
    // Clean Structured Story Modal Logic & Instant Preload Fix
    // -------------------------------------------------------------
    const storyModal = document.getElementById('pf-story-modal');
    const openStoryBtns = document.querySelectorAll('[data-open-story-modal]');
    const closeStoryBtns = document.querySelectorAll('[data-story-close]');
    const storyDataScript = document.getElementById('pf-story-data');

    if (storyModal) {
      // Ensure modal is moved to <body> so sticky header & backdrop-filter don't trap or clip it
      if (storyModal.parentElement !== document.body) {
        document.body.appendChild(storyModal);
      }

      let stories = [];
      if (storyDataScript && storyDataScript.textContent.trim()) {
        try {
          const sanitized = storyDataScript.textContent.trim().replace(/,\s*([\]}])/g, '$1');
          stories = JSON.parse(sanitized);
        } catch (e) {
          console.warn('Error parsing story data, using fallback stories', e);
        }
      }

      // Hardened fallback: ensure stories array is never empty so modal ALWAYS opens
      if (!Array.isArray(stories) || stories.length === 0) {
        stories = [
          {
            image: "https://images.unsplash.com/photo-1506630448388-4e683c67ddb0?auto=format&fit=crop&w=1200&q=80",
            tag: "New Arrivals",
            link: "/collections/all",
            btn_text: "Shop Now"
          },
          {
            image: "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=1200&q=80",
            tag: "Winter Drop",
            link: "/collections/all",
            btn_text: "Shop Now"
          },
          {
            image: "https://images.unsplash.com/photo-1576566588028-4147f3842f27?auto=format&fit=crop&w=1200&q=80",
            tag: "Polo Season",
            link: "/collections/all",
            btn_text: "Shop Now"
          }
        ];
      }

      const progressContainer = storyModal.querySelector('[data-story-progress-container]');
      const storyImage = storyModal.querySelector('[data-story-image]');
      const storyLoader = storyModal.querySelector('[data-story-loader]');
      const storyTag = storyModal.querySelector('[data-story-tag]');
      const storyFooterTag = storyModal.querySelector('[data-story-footer-tag]');
      const storyCta = storyModal.querySelector('[data-story-cta]');
      const storyBtnText = storyModal.querySelector('[data-story-btn-text]');
      const prevBtns = storyModal.querySelectorAll('[data-story-prev], [data-story-tap-prev]');
      const nextBtns = storyModal.querySelectorAll('[data-story-next], [data-story-tap-next]');
      const pauseBtn = storyModal.querySelector('[data-story-pause]');
      const pauseIcon = pauseBtn?.querySelector('.pf-story-modal__pause-icon');
      const playIcon = pauseBtn?.querySelector('.pf-story-modal__play-icon');
      const cardElement = storyModal.querySelector('[data-story-card]');

      let currentIndex = 0;
      let isPaused = false;
      let isImageLoading = false;
      let progressInterval = null;
      const DURATION_MS = 5000;
      const TICK_MS = 30;
      let elapsedMs = 0;

      // Image preload cache to ensure instantaneous transitions
      const preloadedImages = new Map();

      const preloadAllImages = () => {
        stories.forEach((item) => {
          if (item && item.image && !preloadedImages.has(item.image)) {
            const img = new Image();
            img.onload = () => {
              preloadedImages.set(item.image, img);
            };
            img.src = item.image;
          }
        });
      };
      // Story images are preloaded when modal is opened to avoid network contention during initial page load

      // Build Progress Segments
      const buildProgressBars = () => {
        if (!progressContainer) return;
        progressContainer.innerHTML = '';
        stories.forEach((_, idx) => {
          const segment = document.createElement('div');
          segment.className = 'pf-story-modal__progress-segment';
          segment.innerHTML = '<div class="pf-story-modal__progress-fill"></div>';
          segment.addEventListener('click', (e) => {
            e.stopPropagation();
            goToStory(idx);
          });
          progressContainer.appendChild(segment);
        });
      };

      const updateProgressBars = () => {
        const fills = progressContainer?.querySelectorAll('.pf-story-modal__progress-fill');
        if (!fills) return;

        fills.forEach((fill, idx) => {
          if (idx < currentIndex) {
            fill.style.width = '100%';
            fill.classList.add('is-finished');
          } else if (idx === currentIndex) {
            const pct = Math.min((elapsedMs / DURATION_MS) * 100, 100);
            fill.style.width = `${pct}%`;
            fill.classList.remove('is-finished');
          } else {
            fill.style.width = '0%';
            fill.classList.remove('is-finished');
          }
        });
      };

      let activeRenderToken = 0;

      const renderStory = (index) => {
        const item = stories[index];
        if (!item) return;

        const currentToken = ++activeRenderToken;

        // Immediately hide current image to prevent showing old/first image while switching
        if (storyImage) {
          storyImage.classList.remove('is-loaded');
        }

        // Update Text & Link content immediately
        if (storyTag) {
          storyTag.textContent = item.tag || 'Featured';
        }
        if (storyFooterTag) {
          storyFooterTag.textContent = item.tag || 'Featured';
        }
        if (storyCta) {
          storyCta.href = item.link || '#';
        }
        if (storyBtnText) {
          storyBtnText.textContent = item.btn_text || 'Shop Now';
        }

        elapsedMs = 0;
        updateProgressBars();

        // Check if image is already cached
        const preloaded = preloadedImages.get(item.image);
        const isAlreadyComplete = preloaded && preloaded.complete && preloaded.naturalWidth > 0;

        if (isAlreadyComplete) {
          if (storyLoader) storyLoader.classList.remove('is-active');
          isImageLoading = false;
          if (storyImage) {
            storyImage.src = item.image;
            storyImage.classList.add('is-loaded');
          }
        } else {
          // Show loader and pause progress while downloading
          if (storyLoader) storyLoader.classList.add('is-active');
          isImageLoading = true;

          const tempImg = new Image();
          tempImg.onload = () => {
            if (currentToken !== activeRenderToken) return;
            preloadedImages.set(item.image, tempImg);
            if (storyLoader) storyLoader.classList.remove('is-active');
            isImageLoading = false;
            if (storyImage) {
              storyImage.src = item.image;
              storyImage.classList.add('is-loaded');
            }
          };
          tempImg.onerror = () => {
            if (currentToken !== activeRenderToken) return;
            if (storyLoader) storyLoader.classList.remove('is-active');
            isImageLoading = false;
            if (storyImage) {
              const fallbackUrl = "https://images.unsplash.com/photo-1506630448388-4e683c67ddb0?auto=format&fit=crop&w=1200&q=80";
              storyImage.src = fallbackUrl;
              storyImage.classList.add('is-loaded');
            }
          };
          tempImg.src = item.image;
        }
      };

      const startTimer = () => {
        clearInterval(progressInterval);
        progressInterval = setInterval(() => {
          if (isPaused || isImageLoading) return;

          elapsedMs += TICK_MS;
          updateProgressBars();

          if (elapsedMs >= DURATION_MS) {
            if (currentIndex < stories.length - 1) {
              currentIndex++;
              renderStory(currentIndex);
            } else {
              closeStory();
            }
          }
        }, TICK_MS);
      };

      const goToStory = (idx) => {
        if (idx < 0) {
          currentIndex = 0;
        } else if (idx >= stories.length) {
          closeStory();
          return;
        } else {
          currentIndex = idx;
        }
        renderStory(currentIndex);
      };

      const openStory = () => {
        if (storyModal.parentElement !== document.body) {
          document.body.appendChild(storyModal);
        }

        storyModal.removeAttribute('hidden');
        storyModal.hidden = false;
        storyModal.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        document.body.classList.add('story-modal-open');

        preloadAllImages();
        buildProgressBars();
        currentIndex = 0;
        isPaused = false;
        renderStory(0);

        requestAnimationFrame(() => {
          storyModal.classList.add('is-active');
        });

        startTimer();
      };

      const closeStory = () => {
        clearInterval(progressInterval);
        storyModal.classList.remove('is-active');
        storyModal.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        document.body.classList.remove('story-modal-open');

        setTimeout(() => {
          storyModal.hidden = true;
          storyModal.setAttribute('hidden', '');
          if (storyImage) storyImage.classList.remove('is-loaded');
        }, 280);
      };

      const togglePause = (forcePause) => {
        if (typeof forcePause === 'boolean') {
          isPaused = forcePause;
        } else {
          isPaused = !isPaused;
        }

        if (pauseIcon && playIcon) {
          if (isPaused) {
            pauseIcon.style.display = 'none';
            playIcon.style.display = 'block';
          } else {
            pauseIcon.style.display = 'block';
            playIcon.style.display = 'none';
          }
        }
      };

      // Press & Hold to Pause Feature (Instagram Style)
      let holdTimer = null;
      let isHolding = false;

      if (cardElement) {
        const handleHoldStart = (e) => {
          if (e.target.closest('[data-story-close], [data-story-pause], [data-story-cta], .pf-story-modal__progress-segment')) {
            return;
          }
          holdTimer = setTimeout(() => {
            isHolding = true;
            togglePause(true);
          }, 180);
        };

        const handleHoldEnd = () => {
          clearTimeout(holdTimer);
          if (isHolding) {
            isHolding = false;
            togglePause(false);
          }
        };

        cardElement.addEventListener('mousedown', handleHoldStart);
        cardElement.addEventListener('mouseup', handleHoldEnd);
        cardElement.addEventListener('mouseleave', handleHoldEnd);
        cardElement.addEventListener('touchstart', handleHoldStart, { passive: true });
        cardElement.addEventListener('touchend', handleHoldEnd, { passive: true });
      }

      openStoryBtns.forEach((btn) => btn.addEventListener('click', openStory));
      closeStoryBtns.forEach((btn) => btn.addEventListener('click', closeStory));

      // Document-level event delegation for opening & closing reliably from anywhere
      document.addEventListener('click', (e) => {
        const openBtn = e.target.closest('[data-open-story-modal]');
        if (openBtn) {
          e.preventDefault();
          e.stopPropagation();
          openStory();
          return;
        }

        const closeBtn = e.target.closest('[data-story-close]');
        if (closeBtn && !storyModal.hidden) {
          e.preventDefault();
          e.stopPropagation();
          closeStory();
          return;
        }
      });

      prevBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          goToStory(currentIndex - 1);
        });
      });

      nextBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          goToStory(currentIndex + 1);
        });
      });

      pauseBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePause();
      });

      // Keyboard support
      window.addEventListener('keydown', (e) => {
        if (storyModal.hidden) return;
        if (e.key === 'Escape') closeStory();
        if (e.key === 'ArrowLeft') goToStory(currentIndex - 1);
        if (e.key === 'ArrowRight') goToStory(currentIndex + 1);
        if (e.key === ' ') {
          e.preventDefault();
          togglePause();
        }
      });
    }
  })();
{% endjavascript %}

