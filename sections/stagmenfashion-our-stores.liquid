<section
  id="our-stores"
  class="smf-our-stores-section color-{{ section.settings.color_scheme }} smf-stores--align-{{ section.settings.header_alignment | default: 'left' }}"
  data-section-id="{{ section.id }}"
  style="--smf-stores-bg: {{ section.settings.background | default: '#ffffff' }}; --smf-stores-pt: {{ section.settings.padding_top | default: 24 }}px; --smf-stores-pb: {{ section.settings.padding_bottom | default: 24 }}px; scroll-margin-top: 100px;"
>
  <div class="smf-stores-shell">

    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="smf-stores-head">
        <div class="smf-stores-heading-wrap">
          {% if section.settings.heading != blank %}
            <h2 class="smf-stores-heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="smf-stores-subheading">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>

        {% if section.settings.discover_more_label != blank %}
          {% assign more_url = section.settings.discover_more_link | default: '/pages/our-stores' %}
          <a href="{{ more_url }}" class="smf-stores-discover-more">
            {{ section.settings.discover_more_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="smf-stores-grid smf-stores-grid--{{ section.blocks.size }}">
        {% for block in section.blocks %}
          {% liquid
            assign dir_url = block.settings.directions_url
            if dir_url == blank and block.settings.address != blank
              assign clean_addr = block.settings.address | strip_newlines | strip
              assign dir_url = 'https://www.google.com/maps/search/?api=1&query=' | append: clean_addr
            endif
          %}
          <div class="smf-store-card" {{ block.shopify_attributes }}>

            <!-- Media Container -->
            <div class="smf-store-card__media-box">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.store_name | escape }}"
                  width="800"
                  height="500"
                  loading="lazy"
                  class="smf-store-card__img"
                >
              {% else %}
                <div class="smf-store-card__placeholder">
                  <svg viewBox="0 0 64 64" fill="none" width="40" height="40" aria-hidden="true">
                    <rect x="10" y="24" width="44" height="30" rx="3" stroke="currentColor" stroke-width="2"/>
                    <path d="M10 28l7-14h30l7 14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <rect x="25" y="38" width="14" height="16" rx="2" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              {% endif %}
              <div class="smf-store-card__badge">BALAD BOUTIQUE</div>
            </div>

            <!-- Store Details Body -->
            <div class="smf-store-card__body">
              <h3 class="smf-store-card__title">{{ block.settings.store_name | default: 'BALAD PERFUMES' }}</h3>

              {% if block.settings.address != blank %}
                <div class="smf-store-card__address">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span>{{ block.settings.address }}</span>
                </div>
              {% endif %}

              {% if block.settings.phone != blank %}
                <div class="smf-store-card__phone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                </div>
              {% endif %}

              {% if dir_url != blank %}
                <a
                  href="{{ dir_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="smf-store-card__btn"
                  aria-label="Get directions to {{ block.settings.store_name | escape }}"
                >
                  <span>{{ block.settings.directions_label | default: 'Get Direction' }}</span>
                  <svg viewBox="0 0 16 16" fill="none" width="14" height="14" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  .smf-our-stores-section {
    background: var(--smf-stores-bg, #ffffff);
    color: #111111;
    width: 100%;
    padding-top: clamp(12px, 1.8vw, 24px);
    padding-bottom: clamp(12px, 1.8vw, 24px);
  }

  .smf-stores-shell {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 36px);
    box-sizing: border-box;
  }

  .smf-stores-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(18px, 2.5vw, 28px);
  }

  .smf-stores-heading-wrap {
    flex: 1;
    min-width: 0;
  }

  .smf-stores-heading {
    margin: 0;
    color: #111111;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .smf-stores-subheading {
    margin: 6px 0 0;
    font-size: 14px;
    color: #666666;
    line-height: 1.4;
    font-weight: 400;
  }

  .smf-stores-discover-more {
    color: #111111;
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .smf-stores-discover-more:hover {
    opacity: 0.7;
  }

  /* ── Store Grid Layout ── */
  .smf-stores-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 749px) {
    .smf-stores-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .smf-stores-shell {
      padding: 0 16px;
    }
  }

  /* ── Luxury Store Card ── */
  .smf-store-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e8e8e8;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .smf-store-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.08);
    border-color: #d0d0d0;
  }

  /* ── Media Box ── */
  .smf-store-card__media-box {
    position: relative;
    width: 100%;
    height: clamp(260px, 24vw, 380px);
    background: #f5f5f5;
    overflow: hidden;
  }

  .smf-store-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .smf-store-card:hover .smf-store-card__img {
    transform: scale(1.05);
  }

  .smf-store-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #f2f2f4;
    color: rgba(17, 17, 17, 0.28);
  }

  .smf-store-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(17, 17, 17, 0.85);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.04em;
  }

  /* ── Card Body Details ── */
  .smf-store-card__body {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
    background: #ffffff;
  }

  .smf-store-card__title {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 17px;
    font-weight: 700;
    color: #111111;
    letter-spacing: -0.01em;
  }

  .smf-store-card__address {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13.5px;
    line-height: 1.5;
    color: #555555;
  }

  .smf-store-card__address svg {
    width: 18px;
    height: 18px;
    color: #111111;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .smf-store-card__phone {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: #111111;
  }

  .smf-store-card__phone svg {
    width: 17px;
    height: 17px;
    color: #111111;
    flex-shrink: 0;
  }

  .smf-store-card__phone a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .smf-store-card__phone a:hover {
    opacity: 0.7;
  }

  .smf-store-card__btn {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 18px;
    background: #111111;
    color: #ffffff;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease;
    box-sizing: border-box;
  }

  .smf-store-card__btn:hover {
    background: #000000;
  }

  .smf-store-card__btn:active {
    transform: scale(0.98);
  }

  .smf-store-card__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .smf-store-card__btn:hover svg {
    transform: translate(2px, -2px);
  }
</style>

{% schema %}
{
  "name": "Our Stores",
  "tag": "section",
  "class": "smf-our-stores-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Stores"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visit our retail locations across India."
    },
    {
      "type": "text",
      "id": "discover_more_label",
      "label": "Discover More Label"
    },
    {
      "type": "url",
      "id": "discover_more_link",
      "label": "Discover More Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Store Image"
        },
        {
          "type": "text",
          "id": "store_name",
          "label": "Store Name / City",
          "default": "Calicut"
        },
        {
          "type": "text",
          "id": "directions_label",
          "label": "Directions link text",
          "default": "Get Direction"
        },
        {
          "type": "url",
          "id": "directions_url",
          "label": "Google Maps link"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Khaleej Residency, near Aster, Kozhikode, Kerala 673016"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number",
          "default": "+91 94474 25555"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Stores",
      "blocks": [
        {
          "type": "store",
          "settings": {
            "store_name": "Calicut",
            "address": "Khaleej Residency, near Aster, Kozhikode, Kerala 673016",
            "phone": "+91 94474 25555",
            "directions_label": "Get Direction"
          }
        },
        {
          "type": "store",
          "settings": {
            "store_name": "Thekkady",
            "address": "BALAD PERFUMES, Kavitha building, Thekkady, Kerala 685509",
            "phone": "+91 94473 76786",
            "directions_label": "Get Direction"
          }
        }
      ]
    }
  ]
}
{% endschema %}
