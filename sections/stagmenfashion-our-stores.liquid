<section
  id="our-stores"
  class="smf-our-stores-section color-{{ section.settings.color_scheme }} smf-stores--align-{{ section.settings.header_alignment | default: 'left' }}"
  data-section-id="{{ section.id }}"
  style="--smf-stores-bg: {{ section.settings.background | default: '#ffffff' }}; --smf-stores-pt: {{ section.settings.padding_top | default: 24 }}px; --smf-stores-pb: {{ section.settings.padding_bottom | default: 24 }}px; scroll-margin-top: 100px;"
>
  <div class="smf-stores-shell">

    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="smf-stores-head">
        <div class="smf-stores-heading-wrap">
          {% if section.settings.heading != blank %}
            <h2 class="smf-stores-heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="smf-stores-subheading">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>

        {% if section.settings.discover_more_label != blank %}
          {% assign more_url = section.settings.discover_more_link | default: '/pages/our-stores' %}
          <a href="{{ more_url }}" class="smf-stores-discover-more">
            {{ section.settings.discover_more_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="smf-stores-grid smf-stores-grid--{{ section.blocks.size }}">
        {% for block in section.blocks %}
          <div class="smf-store-card" {{ block.shopify_attributes }}>

            <!-- Media Container (Single Store Image) -->
            <div class="smf-store-card__media-box">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.store_name | escape }}"
                  width="900"
                  height="600"
                  loading="lazy"
                  class="smf-store-card__img"
                >
              {% else %}
                <div class="smf-store-card__placeholder">
                  <svg viewBox="0 0 64 64" fill="none" width="40" height="40" aria-hidden="true">
                    <rect x="10" y="24" width="44" height="30" rx="3" stroke="currentColor" stroke-width="2"/>
                    <path d="M10 28l7-14h30l7 14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <rect x="25" y="38" width="14" height="16" rx="2" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              {% endif %}
            </div>

            <!-- Store Details Bottom Bar -->
            <div class="smf-store-card__bottom">
              
              <!-- Left Column: Title & Direction Link -->
              <div class="smf-store-card__info-left">
                <h3 class="smf-store-card__name">{{ block.settings.store_name | default: 'Store Location' }}</h3>
                
                {% assign dir_url = block.settings.directions_url %}
                {% if dir_url == blank and block.settings.address != blank %}
                  {% assign clean_addr = block.settings.address | strip_newlines | strip %}
                  {% assign dir_url = 'https://www.google.com/maps/search/?api=1&query=' | append: clean_addr %}
                {% endif %}

                {% if dir_url != blank %}
                  <a
                    href="{{ dir_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="smf-store-card__direction-link"
                    aria-label="Get directions to {{ block.settings.store_name | escape }}"
                  >
                    <span>{{ block.settings.directions_label | default: 'Get Direction' }}</span>
                    <svg viewBox="0 0 16 16" fill="none" width="13" height="13" aria-hidden="true" class="smf-store-card__arrow">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {% else %}
                  <div class="smf-store-card__direction-link">
                    <span>{{ block.settings.directions_label | default: 'Get Direction' }}</span>
                    <svg viewBox="0 0 16 16" fill="none" width="13" height="13" aria-hidden="true" class="smf-store-card__arrow">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <!-- Right Column: Address & Phone -->
              <div class="smf-store-card__info-right">
                {% if block.settings.address != blank %}
                  <p class="smf-store-card__address">{{ block.settings.address }}</p>
                {% endif %}

                {% if block.settings.phone != blank %}
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="smf-store-card__phone">
                    {{ block.settings.phone }}
                  </a>
                {% endif %}
              </div>

            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  .smf-our-stores-section {
    background: var(--smf-stores-bg, #ffffff);
    color: #111111;
    width: 100%;
    padding-top: var(--smf-stores-pt, clamp(14px, 2vw, 22px));
    padding-bottom: var(--smf-stores-pb, clamp(14px, 2vw, 22px));
  }

  .smf-stores-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 36px clamp(10px, 3.5vw, 12px);
    box-sizing: border-box;
  }

  /* ── Header: Default Left-Aligned (Matching Homepage / Trending) ── */
  .smf-stores-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgb(17 17 17 / 0.1);
  }

  .smf-stores-heading-wrap {
    flex: 1;
    min-width: 0;
    text-align: left;
  }

  .smf-stores-heading {
    margin: 0;
    color: #000000;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 18px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
    text-align: left;
  }

  .smf-stores-subheading {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--pf-real-life-muted, #6b7280);
    line-height: 1.4;
    font-weight: 400;
    text-align: left;
  }

  .smf-stores-discover-more {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #111111;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.25s ease;
    flex-shrink: 0;
  }

  .smf-stores-discover-more:hover {
    color: #000000;
    opacity: 0.7;
  }

  /* ── Header: Centered Alignment (For Dedicated Store Page) ── */
  .smf-stores--align-center .smf-stores-head {
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
  }

  .smf-stores--align-center .smf-stores-heading-wrap {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .smf-stores--align-center .smf-stores-heading {
    text-align: center;
  }

  .smf-stores--align-center .smf-stores-subheading {
    margin: 6px auto 0;
    text-align: center;
  }

  .smf-stores--align-center .smf-stores-discover-more {
    margin-top: 10px;
  }

  /* ── Grid ── */
  .smf-stores-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .smf-stores-grid--1 { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
  .smf-stores-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .smf-stores-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .smf-stores-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  /* ── Card Shell with Clean Light Border ── */
  .smf-store-card {
    background: #ffffff;
    border-radius: 5px;
    border: 1px solid rgb(17 17 17 / 0.09);
    box-shadow: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s ease;
  }

  .smf-store-card:hover {
    border-color: rgb(17 17 17 / 0.25);
    box-shadow: none;
    transform: none;
  }

  /* ── Media Box (Single Store Image) ── */
  .smf-store-card__media-box {
    position: relative;
    width: 100%;
    height: 440px;
    background: #eaeaea;
    overflow: hidden;
    border-radius: 4px 4px 0 0;
  }

  .smf-store-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .smf-store-card:hover .smf-store-card__img {
    transform: scale(1.03);
  }

  .smf-store-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #f2f2f4 0%, #e5e5e8 100%);
    color: rgba(17, 17, 17, 0.28);
  }

  /* ── Bottom Details Bar ── */
  .smf-store-card__bottom {
    padding: 16px 16px 18px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 14px;
    background: #ffffff;
    align-items: flex-start;
    flex-grow: 1;
  }

  /* Left Side: Store Name & Get Direction */
  .smf-store-card__info-left {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .smf-store-card__name {
    margin: 0;
    font-family: var(--font-heading--family), sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #111111;
    word-break: break-word;
  }

  .smf-store-card__direction-link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    font-weight: 500;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    line-height: 1.2;
    transition: opacity 0.2s ease;
  }

  .smf-store-card__direction-link:hover {
    opacity: 0.7;
  }

  .smf-store-card__arrow {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    display: inline-block;
  }

  /* Right Side: Address & Phone */
  .smf-store-card__info-right {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .smf-store-card__address {
    margin: 0;
    font-size: 10.5px;
    line-height: 1.45;
    color: rgba(17, 17, 17, 0.75);
    word-break: break-word;
  }

  .smf-store-card__phone {
    font-size: 10.5px;
    font-weight: 600;
    color: rgba(17, 17, 17, 0.75);
    text-decoration: none;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .smf-store-card__phone:hover {
    color: #111111;
  }

  /* ── Responsive Queries (Matching stagmenfashion-trending) ── */
  @media screen and (max-width: 1024px) {
    .smf-stores-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .smf-store-card__media-box {
      height: 380px;
    }
  }

  @media screen and (max-width: 749px) {
    .smf-our-stores-section {
      padding: 0;
    }

    .smf-stores-shell {
      padding: 10px 10px 10px;
    }

    .smf-stores-head {
      margin-bottom: 14px;
      padding-bottom: 12px;
    }

    .smf-stores-heading {
      font-size: 13px;
    }

    .smf-stores-subheading {
      font-size: 12px;
    }

    .smf-stores-discover-more {
      font-size: 10px;
    }

    .smf-stores-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .smf-store-card__media-box {
      height: 340px;
    }

    .smf-store-card__bottom {
      padding: 14px 14px 16px;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .smf-store-card__direction-link {
      font-size: 9.5px;
    }

    .smf-store-card__arrow {
      width: 9.5px;
      height: 9.5px;
    }
  }
</style>

{% schema %}
