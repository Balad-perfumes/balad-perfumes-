{
  "name": "Stag Outfit Combo",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wardrobe combo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your signature outfit combo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Pick your favourite streetwear essentials, co-ords, or oversized tees, review your combo in one smooth panel, and unlock exclusive styling bundle savings for your wardrobe.</p>"
    },
    {
      "type": "range",
      "id": "discount_threshold",
