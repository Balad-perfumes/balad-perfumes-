{% liquid
  assign per_page = section.settings.collections_per_page | default: 36
  assign columns_desktop = section.settings.columns_desktop | default: 6
  assign columns_mobile = section.settings.columns_mobile | default: '2'
  assign card_radius = section.settings.card_radius | default: 5
%}

<div
  class="smf-collections-page color-{{ section.settings.color_scheme }}"
  style="
    --smf-colls-radius: {{ card_radius }}px;
  "
>
  <div class="smf-colls-shell">
    
    <!-- Optional Theme Blocks (if any) -->
    {%- if section.blocks.size > 0 -%}
      <div class="smf-colls-blocks">
        {%- content_for 'blocks' -%}
      </div>
    {%- endif -%}

    <!-- ── Collections Grid ── -->
    {% paginate collections by per_page %}
      <div class="smf-colls-grid smf-colls-grid--d-{{ columns_desktop }} smf-colls-grid--m-{{ columns_mobile }}">
        {% for coll in collections %}
          {% liquid
            if coll == blank or coll.title == blank
              continue
            endif

            if section.settings.hide_empty_collections and coll.all_products_count == 0
              continue
            endif

            assign card_title = coll.title

            assign card_image = coll.image | default: coll.featured_image
            if card_image == blank and coll.products.size > 0
              assign first_prod = coll.products.first
              assign card_image = first_prod.featured_image | default: first_prod.images.first
            endif

            assign card_link = coll.url
            if card_link == blank
              assign card_link = '#'
            endif

            assign product_count = coll.all_products_count | default: coll.products_count | default: 0
          %}

          <a href="{{ card_link }}" class="smf-cat-card">
            <div class="smf-cat-card__media">
              {% if card_image != blank %}
                {{ card_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  class: 'smf-cat-card__img',
                  widths: '240,360,480,600',
                  sizes: '(max-width: 749px) 45vw, (max-width: 1024px) 30vw, 16vw',
                  alt: ''
                }}
              {% else %}
                <div class="smf-cat-card__placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                </div>
              {% endif %}

              {% if section.settings.show_product_count != false %}
                <span class="smf-cat-card__count">
                  {% if product_count > 0 %}{{ product_count }} {{ product_count | pluralize: 'item', 'items' }}{% else %}Explore{% endif %}
                </span>
              {% endif %}
            </div>

            <div class="smf-cat-card__bar">
              <span class="smf-cat-card__title">{{ card_title }}</span>
              <span class="smf-cat-card__go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </span>
            </div>
          </a>
        {% endfor %}
      </div>

      <!-- Pagination (if more than per_page items) -->
      {% if paginate.pages > 1 %}
        <div class="smf-colls-pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="smf-colls-page-btn smf-colls-page-btn--prev" aria-label="Previous page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span>Previous</span>
            </a>
          {% endif %}

          <div class="smf-colls-page-numbers">
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" class="smf-colls-page-num">{{ part.title }}</a>
              {% else %}
                {% if part.title == paginate.current_page %}
                  <span class="smf-colls-page-num is-active">{{ part.title }}</span>
                {% else %}
                  <span class="smf-colls-page-num is-dots">{{ part.title }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="smf-colls-page-btn smf-colls-page-btn--next" aria-label="Next page">
              <span>Next</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

<style>
  /* ════════════════════════════════════════════════════════════════
     BALAD COLLECTION LIST PAGE - MODERN EDITORIAL CARDS
     Matching homepage section padding and layout
     ════════════════════════════════════════════════════════════════ */
  .smf-collections-page {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding-top: 0;
    padding-bottom: clamp(12px, 3.5vw, 16px);
    background: var(--color-background, #ffffff);
    color: var(--color-foreground, #111111);
  }

  .smf-colls-shell {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 10px 36px clamp(10px, 3.5vw, 12px);
    box-sizing: border-box;
  }

  /* ── Grid Layouts ── */
  .smf-colls-grid {
    display: grid;
    gap: 12px;
    width: 100%;
  }

  .smf-colls-grid--d-6 {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .smf-colls-grid--d-5 {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .smf-colls-grid--d-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .smf-colls-grid--d-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .smf-colls-grid--d-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* ── Category card: same frame language as the product card, built around a title bar ── */
  .smf-cat-card {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.07);
    color: #111111;
    text-decoration: none;
    transition: box-shadow 0.25s ease;
  }

  .smf-cat-card:hover {
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.2);
  }

  .smf-cat-card:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 2px;
  }

  .smf-cat-card__media {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 16px;
    background: #ece9e4;
    overflow: hidden;
    isolation: isolate;
  }

  .smf-cat-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .smf-cat-card:hover .smf-cat-card__img {
    transform: scale(1.04);
  }

  .smf-cat-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: rgb(17 17 17 / 0.3);
  }

  .smf-cat-card__placeholder svg {
    width: 36px;
    height: 36px;
  }

  .smf-cat-card__count {
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 11px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #111111;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .smf-cat-card__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 56px;
    padding: 0 8px 0 20px;
    border-radius: 999px;
    background: #f3f3f2;
  }

  .smf-cat-card__title {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(13px, 7.5cqw, 17px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .smf-cat-card__go {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #111111;
    color: #ffffff;
    transition: transform 0.25s ease;
  }

  .smf-cat-card__go svg {
    width: 16px;
    height: 16px;
  }

  .smf-cat-card:hover .smf-cat-card__go {
    transform: translateX(2px);
  }

  @container (max-width: 190px) {
    .smf-cat-card__bar {
      height: 46px;
      padding: 0 6px 0 14px;
    }

    .smf-cat-card__go {
      width: 34px;
      height: 34px;
    }

    .smf-cat-card__go svg {
      width: 14px;
      height: 14px;
    }

    .smf-cat-card__count {
      top: 8px;
      left: 8px;
      height: 24px;
      padding: 0 9px;
      font-size: 10.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .smf-cat-card,
    .smf-cat-card__img,
    .smf-cat-card__go {
      transition: none;
    }
  }

  /* ── Pagination ── */
  .smf-colls-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(17, 17, 17, 0.08);
  }

  .smf-colls-page-numbers {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .smf-colls-page-num,
  .smf-colls-page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    background: #ffffff;
    border: 1px solid rgba(17, 17, 17, 0.12);
    transition: all 0.2s ease;
  }

  .smf-colls-page-num:hover,
  .smf-colls-page-btn:hover {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  .smf-colls-page-num.is-active {
    background: var(--color-primary, #111111);
    color: #ffffff;
    border-color: var(--color-primary, #111111);
  }

  .smf-colls-page-num.is-dots {
    border: none;
    background: transparent;
    cursor: default;
    color: #888888;
  }

  .smf-colls-page-btn {
    gap: 6px;
    padding: 0 14px;
  }

  /* ═══ Responsive ═══ */
  @media screen and (min-width: 1025px) and (max-width: 1400px) {
    .smf-colls-grid--d-6 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .smf-colls-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      gap: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    .smf-collections-page {
      padding-top: 0;
      padding-bottom: 20px;
    }

    .smf-colls-shell {
      padding: 10px 10px 20px;
    }

    .smf-colls-grid {
      gap: 8px;
    }

    .smf-colls-grid--m-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .smf-colls-grid--m-1 {
      grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
    }





  }
</style>

{% schema %}
{
  "name": "Collection list",
  "class": "ui-test-collection-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "Collections per page",
      "min": 12,
      "max": 48,
      "step": 6,
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_empty_collections",
      "label": "Hide empty collections",
      "default": false
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
