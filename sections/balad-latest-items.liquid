    background: #f5f5f5;
    color: #888888;
    border-radius: 16px;
    font-size: 13px;
    font-weight: 600;
  }

  /* ══════════════════════════════════════════════════════════════
     SMOOTH HOVER (product cards)
     ══════════════════════════════════════════════════════════════ */
  .balad-latest .bpc__image {
    transform: scale(1);
    transform-origin: center center;
    transition:
      opacity 0.5s ease,
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) !important;
  }

  .balad-latest .bpc__buy {
    transition: background-color 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) !important;
  }

  .balad-latest .bpc__buy-arrow {
    transition:
      transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
      background-color 0.5s ease,
      color 0.5s ease !important;
  }

  .balad-latest .bpc__wish {
    transition:
      transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
      background-color 0.4s ease,
      color 0.4s ease !important;
  }


  .balad-latest .bpc__media::after {
    transition: opacity 0.6s ease;
  }

  .balad-latest .balad-latest-grid__card:hover .bpc__image.is-active,
  .balad-latest .balad-latest-grid__card:focus-within .bpc__image.is-active {
    transform: scale(1.06) !important;
  }

  /* ── Rows setting: 2 rows (default) ── */
  .balad-latest--rows-2 .balad-latest-grid {
    grid-template-rows: repeat(2, auto);
  }

  @media screen and (min-width: 1025px) {
    .balad-latest--rows-2 .balad-latest-grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-columns: auto;
      overflow: visible;
      cursor: default;
      padding-bottom: 0;
    }

    .balad-latest--rows-2 .balad-latest__nav-arrows {
      display: none;
    }
  }

  /* ── Tablet & mobile: fixed grid, NO horizontal scroll ── */
  @media screen and (max-width: 1024px) {
    .balad-latest--rows-2 .balad-latest-grid {
      grid-auto-flow: row;
      grid-template-rows: none;
      grid-auto-columns: auto;
      overflow: visible;
      overscroll-behavior-x: auto;
      cursor: default;
      touch-action: auto;
      will-change: auto;
      padding-bottom: 0;
    }

    .balad-latest--rows-2 .balad-latest__nav-arrows {
      display: none;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .balad-latest--rows-2 .balad-latest-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .balad-latest--rows-2 .balad-latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>

