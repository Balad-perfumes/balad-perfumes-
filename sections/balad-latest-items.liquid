{{ 'balad-product-card.css' | asset_url | stylesheet_tag }}
{% liquid
  assign coll_handle = section.settings.collection
  if coll_handle != blank
    assign active_collection = collections[coll_handle]
  endif
  if active_collection == blank
    assign active_collection = collections['new-in']
  endif
  if active_collection == blank
    assign active_collection = collections['all']
  endif
  assign sizes_list = ''
%}

<section
  class="balad-latest balad-latest--rows-{{ section.settings.rows | default: 2 }} color-{{ section.settings.color_scheme }}"
  style="--latest-bg: {{ section.settings.background | default: '#ffffff' }};"
>
  <div class="balad-latest__shell">
    <div class="balad-latest__head">
      <div class="balad-latest__heading-wrap">
        {% if section.settings.heading != blank %}
          <h2 class="balad-latest__heading">
            {% assign heading_upper = section.settings.heading | upcase %}
            {% if heading_upper contains 'BESTSELLERS' %}
              Discover <span class="balad-latest__highlight">Our Bestsellers</span>
            {% elsif heading_upper contains 'NEW ARRIVALS' %}
              New <span class="balad-latest__highlight">Arrivals</span>
            {% else %}
              {{ section.settings.heading | downcase }}
            {% endif %}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="balad-latest__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="balad-latest__head-right">
        {% assign discover_url = section.settings.discover_more_link | default: active_collection.url %}
        {% if section.settings.discover_more_label != blank and discover_url != blank %}
          <a href="{{ discover_url }}" class="balad-latest__discover-more">
            {{ section.settings.discover_more_label }}
          </a>
        {% endif %}
        <div class="balad-latest__nav-arrows">
          <button type="button" class="balad-latest__nav-arrow balad-latest__nav-arrow--prev" data-slider-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="balad-latest__nav-arrow balad-latest__nav-arrow--next" data-slider-next aria-label="Next products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="balad-latest-grid" data-slider-track>
      {% for product in active_collection.products limit: 12 %}
        {% liquid
          assign images = product.images
          assign image_count = images.size
          assign first_image = product.featured_image | default: images.first
          assign sizes_list = ''
          for opt in product.options_with_values
            assign opt_name_down = opt.name | downcase
            if opt_name_down contains 'size' or opt.name == 'Size'
              assign sizes_list = opt.values | join: ','
            endif
          endfor
          if sizes_list == ''
            assign sizes_check = '|'
            for v in product.variants
              assign sz = v.option1 | strip
              unless sz == blank or sz == 'Default Title'
                assign check_sz = '|' | append: sz | append: '|'
                unless sizes_check contains check_sz
                  assign sizes_check = sizes_check | append: check_sz
                  if sizes_list != ''
                    assign sizes_list = sizes_list | append: ','
                  endif
                  assign sizes_list = sizes_list | append: sz
                endunless
              endunless
            endfor
          endif

          assign size_array = sizes_list | split: ','

          assign fragrance_descriptor = ''
          assign tags_string = product.tags | join: ' ' | downcase
          if tags_string contains 'woody'
            assign fragrance_descriptor = 'WOODY | ALLDAY | UNISEX'
          elsif tags_string contains 'floral'
            assign fragrance_descriptor = 'FLORAL | ALLDAY | UNISEX'
          elsif tags_string contains 'fresh'
            assign fragrance_descriptor = 'FRESH | ALLDAY | MEN'
          elsif tags_string contains 'oriental'
            assign fragrance_descriptor = 'ORIENTAL | NIGHT | MEN'
          elsif tags_string contains 'fruity'
            assign fragrance_descriptor = 'FRUITY | ALLDAY | UNISEX'
          else
            assign fragrance_descriptor = product.vendor | default: 'EAU DE PARFUM' | upcase
          endif
        %}
        <div class="balad-latest-grid__card" data-product-card>
          {% render 'balad-product-card', product: product, limit: 4, badge_first: forloop.first, show_rating: section.settings.show_rating, show_buy_now: section.settings.show_buy_now %}
        </div>
      {% endfor %}

      {% if active_collection.products.size == 0 %}
        {% for i in (1..6) %}
          <div class="balad-latest-grid__card balad-latest-grid__card--placeholder">
            <div class="balad-latest-grid__media">
              {{ 'product-1' | placeholder_svg_tag: 'balad-latest-grid__placeholder' }}
            </div>
            <div class="balad-latest-grid__info">
              <div class="balad-latest-grid__title-row">
                <h3 class="balad-latest-grid__title">Product {{ i }}</h3>
                <div class="balad-latest-grid__price-wrap">
                  <span class="balad-latest-grid__price">₹0</span>
                </div>
              </div>
              <div class="balad-latest-grid__rating">
                <span class="balad-latest-grid__stars">
                  <span class="balad-latest-grid__star is-dim">★</span>
                  <span class="balad-latest-grid__star is-dim">★</span>
                  <span class="balad-latest-grid__star is-dim">★</span>
                  <span class="balad-latest-grid__star is-dim">★</span>
                  <span class="balad-latest-grid__star is-dim">★</span>
                </span>
                <span class="balad-latest-grid__rating-count">(0)</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <!-- Wishlist Modal -->
  <div class="balad-wishlist-modal" data-wishlist-modal style="display:none;" hidden>
    <div class="balad-wishlist-modal__backdrop" data-wishlist-close></div>
    <div class="balad-wishlist-modal__card">
      <button type="button" class="balad-wishlist-modal__close" data-wishlist-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="balad-wishlist-modal__header">
        <div class="balad-wishlist-modal__product-img" data-wishlist-img></div>
        <div class="balad-wishlist-modal__product-info">
          <h3 class="balad-wishlist-modal__title" data-wishlist-title></h3>
          <div class="balad-wishlist-modal__price-wrap">
            <span class="balad-wishlist-modal__price" data-wishlist-price></span>
            <span class="balad-wishlist-modal__compare-price" data-wishlist-compare-price></span>
          </div>
        </div>
      </div>

      <div class="balad-wishlist-modal__sizes">
        <div class="balad-wishlist-modal__sizes-top">
          <span class="balad-wishlist-modal__label" data-wishlist-size-label>Size</span>
        </div>
        <div class="balad-wishlist-modal__size-grid" data-wishlist-sizes></div>
      </div>

      <button type="button" class="balad-wishlist-modal__add-btn" data-wishlist-add>
        Add To List
      </button>
    </div>
  </div>

  <!-- Quick Add Modal -->
  <div class="balad-qa-modal" data-qa-modal style="display:none;" hidden>
    <div class="balad-qa-modal__backdrop" data-qa-close></div>
    <div class="balad-qa-modal__card">
      <button type="button" class="balad-qa-modal__close" data-qa-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="balad-qa-modal__header">
        <div class="balad-qa-modal__product-img" data-qa-img></div>
        <div class="balad-qa-modal__product-info">
          <h3 class="balad-qa-modal__title" data-qa-title></h3>
          <span class="balad-qa-modal__price" data-qa-price></span>
        </div>
      </div>

      <div class="balad-qa-modal__sizes">
        <div class="balad-qa-modal__sizes-top">
          <span class="balad-qa-modal__label">Size</span>
        </div>
        <div class="balad-qa-modal__size-grid" data-qa-sizes></div>
      </div>

      <div class="balad-qa-modal__actions" data-qa-actions>
        <button type="button" class="balad-qa-modal__btn balad-qa-modal__btn--bag" data-qa-add-bag>Add To Bag</button>
        <button type="button" class="balad-qa-modal__btn balad-qa-modal__btn--buy" data-qa-buy-now>Buy Now</button>
      </div>
      <div class="balad-qa-modal__sold-out" data-qa-sold-out style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        <span>Sold Out</span>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const STORAGE_KEY = 'wishlist';
    let selectedSize = null;
    let currentProductId = '';

    const getWishlist = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch(e) { return []; }
    };

    const saveWishlist = (list) => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch(e) {
        console.warn('Wishlist save failed:', e);
      }
    };

    const updateHeartStates = (scope) => {
      const wishlist = getWishlist();
      scope.querySelectorAll('[data-wishlist-heart]').forEach((btn) => {
        const handle = extractHandle(btn.dataset.productUrl);
        const isInList = wishlist.some((item) => item.handle === handle);
        btn.classList.toggle('is-saved', isInList);
        const svg = btn.querySelector('svg');
        if (svg) {
          svg.setAttribute('fill', isInList ? 'currentColor' : 'none');
        }
      });
    };

    const openModal = (btn) => {
      const modal = document.querySelector('[data-wishlist-modal]');
      if (!modal) return;
      const titleEl = modal.querySelector('[data-wishlist-title]');
      const priceEl = modal.querySelector('[data-wishlist-price]');
      const comparePriceEl = modal.querySelector('[data-wishlist-compare-price]');
      const imgEl = modal.querySelector('[data-wishlist-img]');
      const sizesEl = modal.querySelector('[data-wishlist-sizes]');
      const sizeLabel = modal.querySelector('[data-wishlist-size-label]');
      const addBtn = modal.querySelector('[data-wishlist-add]');

      const title = btn.dataset.productTitle || '';
      const price = btn.dataset.productPrice || '0';
      const comparePrice = btn.dataset.productComparePrice || '';
      const productId = String(btn.dataset.productId || '').trim();
      const productUrl = btn.dataset.productUrl || '#';
      const productImage = btn.dataset.productImage || '';
      const sizesRaw = btn.dataset.productSizes || '';
      const sizes = sizesRaw.split(',').map(s => s.trim()).filter(s => s.length > 0);

      currentProductId = productId;

      if (titleEl) titleEl.textContent = title;
      if (priceEl) priceEl.textContent = 'INR ' + price;

      if (comparePriceEl) {
        if (comparePrice && comparePrice !== price && comparePrice !== '0') {
          comparePriceEl.textContent = 'INR ' + comparePrice;
          comparePriceEl.style.display = 'inline';
        } else {
          comparePriceEl.textContent = '';
          comparePriceEl.style.display = 'none';
        }
      }

      if (imgEl) {
        if (productImage) {
          imgEl.innerHTML = '<img src="' + productImage + '" alt="' + title.replace(/"/g, '&quot;') + '" />';
          imgEl.style.display = 'flex';
        } else {
          imgEl.innerHTML = '';
          imgEl.style.display = 'none';
        }
      }

      selectedSize = null;

      if (sizesEl) {
        if (sizes.length > 0) {
          if (sizeLabel) sizeLabel.textContent = 'Size';
          sizesEl.parentElement.style.display = 'block';
          sizesEl.innerHTML = sizes.map((size, i) => {
            const isSelected = i === 0 ? ' is-selected' : '';
            if (i === 0) selectedSize = size;
            return '<button type="button" class="balad-wishlist-modal__size' + isSelected + '" data-size-btn data-size="' + size + '">' + size + '</button>';
          }).join('');

          sizesEl.querySelectorAll('[data-size-btn]').forEach((sizeBtn) => {
            sizeBtn.addEventListener('click', () => {
              sizesEl.querySelectorAll('[data-size-btn]').forEach(b => b.classList.remove('is-selected'));
              sizeBtn.classList.add('is-selected');
              selectedSize = sizeBtn.dataset.size;
            });
          });
        } else {
          if (sizeLabel) sizeLabel.textContent = 'Default';
          sizesEl.parentElement.style.display = 'block';
          selectedSize = 'Default';
          sizesEl.innerHTML = '<button type="button" class="balad-wishlist-modal__size is-selected" data-size-btn data-size="Default">Default</button>';
        }
      }

      if (addBtn) {
        addBtn.dataset.productId = productId;
        addBtn.dataset.productTitle = title;
        addBtn.dataset.productPrice = price;
        addBtn.dataset.productUrl = productUrl;
        addBtn.dataset.productImage = productImage;
      }

      modal.style.display = 'flex';
      modal.removeAttribute('hidden');
      requestAnimationFrame(() => {
        modal.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      const modal = document.querySelector('[data-wishlist-modal]');
      if (!modal) return;
      modal.classList.remove('is-open');
      setTimeout(() => {
        if (!modal.classList.contains('is-open')) {
          modal.style.display = 'none';
          modal.setAttribute('hidden', '');
        }
      }, 220);
      document.body.style.overflow = '';
    };

    const removeFromWishlist = (handle) => {
      let wishlist = getWishlist();
      wishlist = wishlist.filter((item) => item.handle !== handle);
      saveWishlist(wishlist);
      document.dispatchEvent(new CustomEvent('wishlist:update'));
    };

    const addToWishlist = (handle, id, title, price, image, size) => {
      const wishlist = getWishlist();
      const exists = wishlist.some((item) => item.handle === handle);
      if (!exists) {
        wishlist.push({ handle, id, title, price, image, size: size || '' });
        saveWishlist(wishlist);
        document.dispatchEvent(new CustomEvent('wishlist:update'));
      }
    };

    const extractHandle = (url) => {
      if (!url) return '';
      const parts = url.split('/');
      return parts[parts.length - 1] || parts[parts.length - 2] || '';
    };

    const toggleWishlist = (btn) => {
      const handle = extractHandle(btn.dataset.productUrl);
      const wishlist = getWishlist();
      const isInList = wishlist.some((item) => item.handle === handle);

      if (isInList) {
        removeFromWishlist(handle);
        updateHeartStates(document);
        return;
      }
      openModal(btn);
    };

    const initSection = (scope = document) => {
      scope.querySelectorAll('[data-wishlist-heart]').forEach((btn) => {
        if (btn.dataset.ready === 'true') return;
        btn.dataset.ready = 'true';
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleWishlist(btn);
        });
      });

      // Track Arrow Navigation
      scope.querySelectorAll('[data-slider-track]').forEach((track) => {
        const parentSection = track.closest('.balad-latest');
        if (!parentSection) return;
        const prevBtn = parentSection.querySelector('[data-slider-prev]');
        const nextBtn = parentSection.querySelector('[data-slider-next]');

        if (prevBtn && !prevBtn.dataset.ready) {
          prevBtn.dataset.ready = 'true';
          prevBtn.addEventListener('click', () => {
            const card = track.querySelector('.balad-latest-grid__card');
            const gap = parseInt(getComputedStyle(track).columnGap) || 12;
            const amount = card ? (card.offsetWidth + gap) * 2 : 320;
            track.scrollBy({ left: -amount, behavior: 'smooth' });
          });
        }

        /* Mouse drag-to-scroll with momentum (touch scrolls natively) */
        if (!track.dataset.dragReady) {
          track.dataset.dragReady = 'true';
          let isDown = false, moved = false, startX = 0, startScroll = 0;
          let lastX = 0, lastT = 0, velocity = 0, rafId = 0;

          const stopMomentum = () => { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } };

          const momentum = () => {
            velocity *= 0.95;
            if (Math.abs(velocity) < 0.15) { rafId = 0; return; }
            track.scrollLeft -= velocity;
            rafId = requestAnimationFrame(momentum);
          };

          track.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;
            if (e.target.closest('button')) return;
            stopMomentum();
            isDown = true;
            moved = false;
            startX = lastX = e.clientX;
            lastT = performance.now();
            startScroll = track.scrollLeft;
            velocity = 0;
          });

          window.addEventListener('pointermove', (e) => {
            if (!isDown) return;
            const dx = e.clientX - startX;
            if (!moved && Math.abs(dx) > 5) {
              moved = true;
              track.classList.add('is-dragging');
            }
            if (!moved) return;
            const now = performance.now();
            const dt = Math.max(now - lastT, 1);
            velocity = ((e.clientX - lastX) / dt) * 16;
            lastX = e.clientX;
            lastT = now;
            track.scrollLeft = startScroll - dx;
          });

          const endDrag = () => {
            if (!isDown) return;
            isDown = false;
            if (moved) {
              track.classList.remove('is-dragging');
              rafId = requestAnimationFrame(momentum);
              setTimeout(() => { moved = false; }, 0);
            }
          };
          window.addEventListener('pointerup', endDrag);
          window.addEventListener('pointercancel', endDrag);

          track.addEventListener('wheel', stopMomentum, { passive: true });
          track.addEventListener('click', (e) => {
            if (moved) { e.preventDefault(); e.stopPropagation(); }
          }, true);
          track.addEventListener('dragstart', (e) => e.preventDefault());
        }

        if (nextBtn && !nextBtn.dataset.ready) {
          nextBtn.dataset.ready = 'true';
          nextBtn.addEventListener('click', () => {
            const card = track.querySelector('.balad-latest-grid__card');
            const gap = parseInt(getComputedStyle(track).columnGap) || 12;
            const amount = card ? (card.offsetWidth + gap) * 2 : 320;
            track.scrollBy({ left: amount, behavior: 'smooth' });
          });
        }
      });

      // Card size pills selection
      scope.querySelectorAll('[data-card-size-pills]').forEach((pillsContainer) => {
        const card = pillsContainer.closest('[data-product-card]');
        const qaBtn = card ? card.querySelector('[data-quick-add]') : null;

        pillsContainer.querySelectorAll('.balad-latest-grid__size-pill').forEach((pill) => {
          if (pill.dataset.ready === 'true') return;
          pill.dataset.ready = 'true';
          pill.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            pillsContainer.querySelectorAll('.balad-latest-grid__size-pill').forEach(p => p.classList.remove('is-selected'));
            pill.classList.add('is-selected');
            if (qaBtn) {
              qaBtn.dataset.qaSelectedSize = pill.dataset.sizeValue;
            }
          });
        });
      });

      updateHeartStates(scope);
    };

    const initModal = () => {
      document.querySelectorAll('[data-wishlist-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });

      const addBtn = document.querySelector('[data-wishlist-add]');
      if (addBtn && !addBtn.dataset.ready) {
        addBtn.dataset.ready = 'true';
        addBtn.addEventListener('click', () => {
          const productId = currentProductId;
          const title = addBtn.dataset.productTitle || '';
          const price = addBtn.dataset.productPrice || '0';
          const url = addBtn.dataset.productUrl || '#';
          const image = addBtn.dataset.productImage || '';
          const handle = extractHandle(url);

          if (!handle) return;

          addToWishlist(handle, productId, title, price, image, selectedSize || '');
          closeModal();
          updateHeartStates(document);
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    };

    /* ── Quick Add Modal & Action ───────────────────────────────── */
    let qaSelectedSize = null;
    let qaProductUrl = '';

    const getQAModal = () => document.querySelector('[data-qa-modal]');

    const resolveVariantId = (modal) => {
      const variantsData = modal?.dataset.qaVariants || '';
      const firstVariant = modal?.dataset.qaFirstVariant || '';
      let variantId = '';

      if (variantsData && qaSelectedSize) {
        const pairs = variantsData.split(',').filter(Boolean);
        for (const pair of pairs) {
          const [name, id] = pair.split(':');
          if (name && id && name.trim() === qaSelectedSize.trim()) {
            variantId = id.trim();
            break;
          }
        }
      }

      if (!variantId && firstVariant) {
        variantId = firstVariant;
      }
      return variantId;
    };

    const openQAModal = (btn) => {
      const modal = getQAModal();
      if (!modal) return;

      const titleEl = modal.querySelector('[data-qa-title]');
      const priceEl = modal.querySelector('[data-qa-price]');
      const imgEl = modal.querySelector('[data-qa-img]');
      const sizesEl = modal.querySelector('[data-qa-sizes]');
      const actionsEl = modal.querySelector('[data-qa-actions]');
      const soldOutEl = modal.querySelector('[data-qa-sold-out]');

      const title = btn.dataset.qaTitle || '';
      const price = btn.dataset.qaPrice || '0';
      qaProductUrl = btn.dataset.qaUrl || '';
      const image = btn.dataset.qaImage || '';
      const sizesRaw = btn.dataset.qaSizes || '';
      const firstVariant = btn.dataset.qaFirstVariant || '';
      const variantsData = btn.dataset.qaVariants || '';
      const isAvailable = btn.dataset.qaAvailable === 'true';
      const presetSize = btn.dataset.qaSelectedSize || null;

      modal.dataset.qaFirstVariant = firstVariant;
      modal.dataset.qaVariants = variantsData;

      if (titleEl) titleEl.textContent = title;
      if (priceEl) priceEl.textContent = '₹' + Number(price || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 });

      if (imgEl) {
        if (image) {
          imgEl.innerHTML = '<img src="' + image + '" alt="' + title.replace(/"/g, '&quot;') + '" />';
          imgEl.style.display = 'block';
        } else {
          imgEl.innerHTML = '';
          imgEl.style.display = 'none';
        }
      }

      const sizes = sizesRaw.split(',').map(s => s.trim()).filter(Boolean);
      qaSelectedSize = presetSize || (sizes.length > 0 ? sizes[0] : null);

      if (sizesEl) {
        if (sizes.length > 0) {
          sizesEl.parentElement.style.display = 'block';
          sizesEl.innerHTML = sizes.map((sz) => {
            const isSel = (sz === qaSelectedSize) ? ' is-selected' : '';
            return '<button type="button" class="balad-qa-modal__size' + isSel + '" data-qa-size-btn data-size="' + sz + '">' + sz + '</button>';
          }).join('');

          sizesEl.querySelectorAll('[data-qa-size-btn]').forEach((sb) => {
            sb.addEventListener('click', () => {
              sizesEl.querySelectorAll('[data-qa-size-btn]').forEach(b => b.classList.remove('is-selected'));
              sb.classList.add('is-selected');
              qaSelectedSize = sb.dataset.size;
            });
          });
        } else {
          sizesEl.parentElement.style.display = 'none';
        }
      }

      if (!isAvailable) {
        if (actionsEl) actionsEl.style.display = 'none';
        if (soldOutEl) soldOutEl.style.display = 'flex';
      } else {
        if (actionsEl) actionsEl.style.display = 'grid';
        if (soldOutEl) soldOutEl.style.display = 'none';
      }

      modal.style.display = 'flex';
      modal.removeAttribute('hidden');
      requestAnimationFrame(() => modal.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
    };

    const closeQAModal = () => {
      const modal = getQAModal();
      if (!modal) return;
      modal.classList.remove('is-open');
      setTimeout(() => {
        if (!modal.classList.contains('is-open')) {
          modal.style.display = 'none';
          modal.setAttribute('hidden', '');
        }
      }, 220);
      document.body.style.overflow = '';
    };

    const addToCartAndRedirect = async (variantId, shouldRedirect = false) => {
      if (!variantId) return;

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }] }),
        });

        if (!response.ok) throw new Error('Failed to add item to cart');

        if (shouldRedirect) {
          window.location.href = '/checkout';
          return;
        }

        closeQAModal();

        // Dispatch theme cart updates
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

        const cartDrawer = document.querySelector('cart-drawer') || document.querySelector('#CartDrawer');
        if (cartDrawer && typeof cartDrawer.open === 'function') {
          cartDrawer.open();
        } else {
          window.location.href = '/cart';
        }
      } catch (err) {
        console.error('Add to cart error:', err);
        if (qaProductUrl) window.location.href = qaProductUrl;
      }
    };

    const initQAModal = (scope = document) => {
      scope.querySelectorAll('[data-quick-add]').forEach((btn) => {
        if (btn.dataset.qaReady === 'true') return;
        btn.dataset.qaReady = 'true';
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openQAModal(btn);
        });
      });

      const modal = getQAModal();
      if (modal && !modal.dataset.qaEventsBound) {
        modal.dataset.qaEventsBound = 'true';

        modal.querySelectorAll('[data-qa-close]').forEach((el) => {
          el.addEventListener('click', closeQAModal);
        });

        const bagBtn = modal.querySelector('[data-qa-add-bag]');
        if (bagBtn) {
          bagBtn.addEventListener('click', () => {
            const vId = resolveVariantId(modal);
            addToCartAndRedirect(vId, false);
          });
        }

        const buyBtn = modal.querySelector('[data-qa-buy-now]');
        if (buyBtn) {
          buyBtn.addEventListener('click', () => {
            const vId = resolveVariantId(modal);
            addToCartAndRedirect(vId, true);
          });
        }
      }
    };

    // Carousel init with mobile finger swipe support
    const initCarousels = (scope = document) => {
      scope.querySelectorAll('[data-carousel]').forEach((carousel) => {
        if (carousel.dataset.ready === 'true') return;
        carousel.dataset.ready = 'true';

        const slides = carousel.querySelectorAll('[data-carousel-slide]');
        const dots = carousel.querySelectorAll('[data-carousel-dot]');

        if (slides.length <= 1) return;

        let currentIndex = 0;

        const goTo = (index) => {
          if (index < 0) index = slides.length - 1;
          if (index >= slides.length) index = 0;
          slides[currentIndex].classList.remove('is-active');
          dots[currentIndex]?.classList.remove('is-active');
          currentIndex = index;
          slides[currentIndex].classList.add('is-active');
          dots[currentIndex]?.classList.add('is-active');
        };

        const cardEl = carousel.closest('[data-product-card]') || carousel;
        cardEl.addEventListener('mouseenter', () => {
          if (slides.length > 1) goTo(1);
        });

        cardEl.addEventListener('mouseleave', () => {
          if (slides.length > 1) goTo(0);
        });

        /* Touch swipes now scroll the product row instead of flipping images. */

        dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            goTo(parseInt(dot.dataset.index, 10));
          });
        });
      });
    };

    document.addEventListener('DOMContentLoaded', () => {
      initCarousels();
      initSection();
      initModal();
      initQAModal();
    });
    document.addEventListener('shopify:section:load', (event) => {
      initCarousels(event.target);
      initSection(event.target);
      initQAModal(event.target);
    });
  })();
</script>

