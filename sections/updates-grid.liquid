<link rel="stylesheet" href="{{ 'about.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'updates.css' | asset_url }}">
<script src="{{ 'updates.js' | asset_url }}" defer></script>

{% liquid
  assign current_blog = section.settings.blog

  # If section.settings.blog is a string handle or blog drop
  if current_blog != blank
    if current_blog.articles == blank or current_blog.articles.size == 0
      assign blog_handle = section.settings.blog
      if blogs[blog_handle] != blank and blogs[blog_handle].articles.size > 0
        assign current_blog = blogs[blog_handle]
      endif
    endif
  endif

  # Fallback to global blog if on a blog template
  if current_blog == blank or current_blog.articles.size == 0
    if blog.articles != blank and blog.articles.size > 0
      assign current_blog = blog
    endif
  endif

  # Fallback to standard store blog handles
  if current_blog == blank or current_blog.articles.size == 0
    if blogs['news'].articles.size > 0
      assign current_blog = blogs['news']
    elsif blogs['updates'].articles.size > 0
      assign current_blog = blogs['updates']
    elsif blogs['journal'].articles.size > 0
      assign current_blog = blogs['journal']
    elsif blogs['blog'].articles.size > 0
      assign current_blog = blogs['blog']
    endif
  endif

  # Universal fallback: search all blogs in store
  if current_blog == blank or current_blog.articles.size == 0
    for b in blogs
      if b.articles.size > 0
        assign current_blog = b
        break
      endif
    endfor
  endif

  assign has_articles = false
  if current_blog != blank and current_blog.articles.size > 0
    assign has_articles = true
  endif

  assign desktop_cols = section.settings.columns_desktop | default: 3
  assign aspect_ratio = section.settings.image_aspect_ratio | default: '16-10'
%}

<section
  id="updates-grid-{{ section.id }}"
  class="updates-grid-section"
  style="
    background: transparent;
    padding-top: {{ section.settings.padding_top | default: 32 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  "
>
  <div class="updates-shell">
    {% comment %} Section Header - Styled exactly like About Page Section Headers {% endcomment %}
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="updates-grid__intro {% if section.settings.heading_alignment == 'left' %}updates-grid__intro--left{% else %}updates-grid__intro--center{% endif %}">
        {% if section.settings.eyebrow != blank %}
          <p class="about-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="updates-grid__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="updates-grid__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if has_articles %}
      <div class="updates-grid updates-grid--col-{{ desktop_cols }}">
        {% for article in current_blog.articles limit: section.settings.posts_limit %}
          {% liquid
            assign article_category = article.tags.first
            assign words = article.content | strip_html | split: ' ' | size
            assign read_time = words | divided_by: 180 | at_least: 2
          %}
          <article class="updates-card">
            <a
              href="{{ article.url }}"
              class="updates-card__media-wrap updates-card__media-wrap--{{ aspect_ratio }}"
              aria-label="{{ article.title | escape }}"
            >
              {% if article.image != blank %}
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'updates-card__image',
                    loading: 'lazy',
                    widths: '360, 540, 720, 800',
                    alt: article.title
                }}
              {% else %}
                <div class="updates-card__placeholder" aria-hidden="true">
                  <span>{{ current_blog.title | default: 'Stag Men Fashion' }}</span>
                </div>
              {% endif %}

              {% if section.settings.show_tags and article_category != blank %}
                <span class="updates-card__tag">{{ article_category }}</span>
              {% endif %}
            </a>

            <div class="updates-card__body">
              {% if section.settings.show_date or section.settings.show_read_time %}
                <div class="updates-card__meta">
                  {% if section.settings.show_date %}
                    <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                  {% endif %}

                  {% if section.settings.show_read_time %}
                    <span class="updates-meta-dot" aria-hidden="true"></span>
                    <span>{{ read_time }} min read</span>
                  {% endif %}
                </div>
              {% endif %}

              <a href="{{ article.url }}" class="updates-card__title-link">
                <h2 class="updates-card__title">{{ article.title }}</h2>
              </a>

              {% if section.settings.show_excerpt and article.excerpt_or_content != blank %}
                <p class="updates-card__excerpt">
                  {{ article.excerpt_or_content | strip_html | truncate: 110 }}
                </p>
              {% endif %}

              <div class="updates-card__footer">
                <a href="{{ article.url }}" class="updates-card__link" aria-label="Read full article: {{ article.title | escape }}">
                  <span>Read Article</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      {% comment %} Minimal Clean Empty State (No Background) {% endcomment %}
      <div class="updates-empty">
        <p class="updates-empty__text">No updates available</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .updates-grid__intro {
    max-width: 680px;
    margin: 0 auto clamp(20px, 3.5vw, 36px);
  }
  .updates-grid__intro--center {
    text-align: center;
  }
  .updates-grid__intro--left {
    text-align: left;
    margin-left: 0;
  }

  .updates-grid__heading {
    font-family: var(--font-heading--family), sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading, #111111);
    margin: 0 0 6px;
  }

  .updates-grid__subheading {
    font-size: 13px;
    color: rgba(var(--color-foreground-rgb, 17, 17, 17), 0.65);
    line-height: 1.55;
    margin: 0;
  }

  .updates-card__media-wrap--16-9 {
    aspect-ratio: 16 / 9;
  }
  .updates-card__media-wrap--16-10 {
    aspect-ratio: 16 / 10;
  }
  .updates-card__media-wrap--4-3 {
    aspect-ratio: 4 / 3;
  }
  .updates-card__media-wrap--1-1 {
    aspect-ratio: 1 / 1;
  }

  .updates-card__placeholder {
    width: 100%;
    height: 100%;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7f7f7;
    color: rgba(17, 17, 17, 0.35);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>

{% schema %}
{
  "name": "Updates card grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Updates"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Drops & Journal"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Stories, lookbooks, and behind-the-scenes notes from our Kochi studio.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Blog Selection"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Choose the blog whose articles will be displayed in this grid."
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "posts_limit",
      "label": "Maximum articles to show",
      "min": 3,
      "max": 36,
      "step": 3,
      "default": 12
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "16-10", "label": "16:10 (Default)" },
        { "value": "16-9", "label": "16:9 (Widescreen)" },
        { "value": "4-3", "label": "4:3 (Classic)" },
        { "value": "1-1", "label": "1:1 (Square)" }
      ],
      "default": "16-10"
    },
    {
      "type": "header",
      "content": "Card Details"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show published date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show category tag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show article excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Updates card grid"
    }
  ]
}
{% endschema %}
