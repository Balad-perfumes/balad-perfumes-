<section class="about-craftsmanship color-{{ section.settings.color_scheme }}" {% if section.settings.enable_animations %}data-about-reveal{% endif %}>
  <div class="about-shell">
    <div class="about-craftsmanship__header text-center">
      {% if section.settings.eyebrow != blank %}
        <p class="about-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="about-craftsmanship__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="about-craftsmanship__intro-text rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="about-craftsmanship__zigzag">
      {% for block in section.blocks %}
        <div class="about-craftsmanship__row {% cycle 'odd', 'even' %} about-reveal-item" {{ block.shopify_attributes }} data-about-reveal>
          <div class="about-craftsmanship__media">
            {% if block.settings.image != blank %}
              <div class="about-craftsmanship__image-wrapper">
                {{ block.settings.image 
                  | image_url: width: 1000 
                  | image_tag: 
                    class: 'about-craftsmanship__image', 
                    loading: 'lazy', 
                    alt: block.settings.title 
                }}
              </div>
            {% else %}
              <div class="about-craftsmanship__placeholder-image" aria-hidden="true"></div>
            {% endif %}
          </div>
          
          <div class="about-craftsmanship__text-card">
            <span class="about-craftsmanship__step">0{{ forloop.index }}</span>
            <h3 class="about-craftsmanship__title">{{ block.settings.title | escape }}</h3>
            {% if block.settings.description != blank %}
              <p class="about-craftsmanship__description">{{ block.settings.description | escape }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About craftsmanship",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Crafted with Care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From Sketch to Wardrobe" },
    { "type": "richtext", "id": "text", "label": "Intro text", "default": "<p>Every garment we design is built to hold its structure, feel ultra-soft, and last. Here is how we craft our signature streetwear pieces.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable animations", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Step Image" },
        { "type": "text", "id": "title", "label": "Step Title", "default": "Design & Patterning" },
        { "type": "textarea", "id": "description", "label": "Step Description", "default": "We start with hand sketches and custom pattern drafting, creating relaxed proportions and sharp silhouettes tailored for modern men." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About craftsmanship",
      "blocks": [
        { "type": "step", "settings": { "title": "Design & Patterning", "description": "We begin with sketches and custom pattern drafting, creating relaxed proportions and sharp silhouettes tailored for modern men." } },
        { "type": "step", "settings": { "title": "Fabric Selection", "description": "We source 100% combed organic cottons, heavyweight French terry, and premium colorfast dyes that resist fading." } },
        { "type": "step", "settings": { "title": "Precision Tailoring", "description": "Our master garment artisans cut, stitch, and finish every piece with reinforced seams and obsessive attention to detail." } }
      ]
    }
  ]
}
{% endschema %}
