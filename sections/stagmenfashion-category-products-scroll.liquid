<script>
  (() => {
    const sectionContainer = document.querySelector('[data-catprod-section="{{ section.id }}"]');
    if (!sectionContainer) return;

    const rail = sectionContainer.querySelector('[data-catprod-rail]');

    /* ── Auto-scroll & Drag/Swipe Engine ── */
    let isDown = false;
    let startX = 0;
    let initialScrollLeft = 0;
    let hasDragged = false;
    let isHovered = false;
    let isTouching = false;
    let isUserScrolling = false;
    let userScrollTimeout = null;
    let isAutoScrolling = false;
    let animId = null;
    let isVisible = true;
    const scrollSpeed = 0.65; // Smooth continuous scroll speed

    const step = () => {
      if (isVisible && !isDown && !isHovered && !isTouching && !isUserScrolling && rail) {
        isAutoScrolling = true;
        rail.scrollLeft += scrollSpeed;
        if (rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 1) {
          rail.scrollLeft = 0;
        }
        isAutoScrolling = false;
      }
      animId = requestAnimationFrame(step);
    };

    if (rail) {
      animId = requestAnimationFrame(step);

      const triggerUserPause = (delay = 1800) => {
        isUserScrolling = true;
        if (userScrollTimeout) clearTimeout(userScrollTimeout);
        userScrollTimeout = setTimeout(() => {
          isUserScrolling = false;
        }, delay);
      };

      // Handle user scrolling (e.g. touch momentum, trackpad, mouse wheel)
      rail.addEventListener('scroll', () => {
        if (!isAutoScrolling) {
          triggerUserPause(1800);
        }
      }, { passive: true });

      // Pause when section is outside viewport
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            isVisible = entry.isIntersecting;
          });
        }, { threshold: 0.05 });
        observer.observe(sectionContainer);
      }

      // Hover on desktop
      rail.addEventListener('mouseenter', () => {
        isHovered = true;
      });

      rail.addEventListener('mouseleave', () => {
        isHovered = false;
        if (!isDown && !isTouching) {
          triggerUserPause(800);
        }
      });

      // Mouse drag on desktop
      rail.addEventListener('mousedown', (e) => {
        if (e.target.closest('[data-wishlist-heart], [data-quick-add], button, [data-carousel-dot]')) return;
        isDown = true;
        hasDragged = false;
        startX = e.pageX - rail.offsetLeft;
        initialScrollLeft = rail.scrollLeft;
        rail.classList.add('is-dragging');
        triggerUserPause(2000);
      });

      window.addEventListener('mouseup', () => {
        if (!isDown) return;
        isDown = false;
        if (rail) rail.classList.remove('is-dragging');
        setTimeout(() => {
          hasDragged = false;
        }, 80);
        triggerUserPause(1500);
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDown || !rail) return;
        const x = e.pageX - rail.offsetLeft;
        const walk = (x - startX);
        if (Math.abs(walk) > 4) {
          hasDragged = true;
        }
        rail.scrollLeft = initialScrollLeft - walk;
      });

      // Touch swipe on mobile & touchscreens
      rail.addEventListener('touchstart', (e) => {
        isTouching = true;
        hasDragged = false;
        if (e.touches && e.touches[0]) {
          startX = e.touches[0].pageX;
          initialScrollLeft = rail.scrollLeft;
        }
        triggerUserPause(2000);
      }, { passive: true });

      rail.addEventListener('touchmove', (e) => {
        if (!isTouching) return;
        if (e.touches && e.touches[0]) {
          const x = e.touches[0].pageX;
          if (Math.abs(x - startX) > 6) {
            hasDragged = true;
          }
        }
      }, { passive: true });

      rail.addEventListener('touchend', () => {
        isTouching = false;
        setTimeout(() => {
          hasDragged = false;
        }, 100);
        triggerUserPause(2000);
      }, { passive: true });

      rail.addEventListener('touchcancel', () => {
        isTouching = false;
        setTimeout(() => {
          hasDragged = false;
        }, 100);
        triggerUserPause(2000);
      }, { passive: true });

      // Prevent link clicking if dragging/swiping
      rail.addEventListener('click', (e) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    }

    /* ── Wishlist Logic ── */
    const STORAGE_KEY = 'wishlist';
    let selectedSize = null;
    let currentProductId = '';

    const getWishlist = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch(e) { return []; }
    };

    const saveWishlist = (list) => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch(e) {}
    };

    const extractHandle = (url) => {
      if (!url) return '';
      const parts = url.split('/');
      return parts[parts.length - 1] || parts[parts.length - 2] || '';
    };

    const updateHeartStates = () => {
      const wishlist = getWishlist();
      sectionContainer.querySelectorAll('[data-wishlist-heart]').forEach((btn) => {
        const handle = extractHandle(btn.dataset.productUrl);
        const isInList = wishlist.some((item) => item.handle === handle);
        btn.classList.toggle('is-saved', isInList);
        const svg = btn.querySelector('svg');
        if (svg) {
          if (isInList) {
            svg.setAttribute('fill', 'currentColor');
          } else {
            svg.setAttribute('fill', 'none');
          }
        }
      });
    };

    const openWishlistModal = (btn) => {
      const modal = sectionContainer.querySelector('[data-wishlist-modal]');
      if (!modal) return;
      const titleEl = modal.querySelector('[data-wishlist-title]');
      const priceEl = modal.querySelector('[data-wishlist-price]');
      const comparePriceEl = modal.querySelector('[data-wishlist-compare-price]');
      const imgEl = modal.querySelector('[data-wishlist-img]');
      const sizesEl = modal.querySelector('[data-wishlist-sizes]');
      const sizeLabel = modal.querySelector('[data-wishlist-size-label]');
      const addBtn = modal.querySelector('[data-wishlist-add]');

      const title = btn.dataset.productTitle || '';
      const price = btn.dataset.productPrice || '0';
      const comparePrice = btn.dataset.productComparePrice || '';
      const productId = String(btn.dataset.productId || '').trim();
      const productUrl = btn.dataset.productUrl || '#';
      const productImage = btn.dataset.productImage || '';
      const sizesRaw = btn.dataset.productSizes || '';
      const sizes = sizesRaw.split(',').map(s => s.trim()).filter(s => s.length > 0);

      currentProductId = productId;
      titleEl.textContent = title;
      priceEl.textContent = 'RS. ' + price;

      if (comparePrice && comparePrice !== price && comparePrice !== '0' && comparePrice !== '') {
        comparePriceEl.textContent = 'RS. ' + comparePrice;
        comparePriceEl.style.display = 'inline';
      } else {
        comparePriceEl.textContent = '';
        comparePriceEl.style.display = 'none';
      }

      if (productImage) {
        imgEl.innerHTML = '<img src="' + productImage + '" alt="' + title.replace(/"/g, '&quot;') + '" />';
        imgEl.style.display = 'flex';
      } else {
        imgEl.innerHTML = '';
        imgEl.style.display = 'none';
      }

      selectedSize = null;

      if (sizes.length > 0) {
        sizeLabel.textContent = 'Size';
        sizesEl.parentElement.style.display = 'block';
        sizesEl.innerHTML = sizes.map((size, i) => {
          const isSelected = i === 0 ? ' is-selected' : '';
          if (i === 0) selectedSize = size;
          return '<button type="button" class="stagmenfashion-wishlist-modal__size' + isSelected + '" data-size-btn data-size="' + size + '">' + size + '</button>';
        }).join('');

        sizesEl.querySelectorAll('[data-size-btn]').forEach((sizeBtn) => {
          sizeBtn.addEventListener('click', () => {
            sizesEl.querySelectorAll('[data-size-btn]').forEach(b => b.classList.remove('is-selected'));
            sizeBtn.classList.add('is-selected');
            selectedSize = sizeBtn.dataset.size;
          });
        });
      } else {
        sizeLabel.textContent = 'Default';
        sizesEl.parentElement.style.display = 'block';
        selectedSize = 'Default';
        sizesEl.innerHTML = '<button type="button" class="stagmenfashion-wishlist-modal__size is-selected" data-size-btn data-size="Default">Default</button>';
      }

      addBtn.dataset.productId = productId;
      addBtn.dataset.productTitle = title;
      addBtn.dataset.productPrice = price;
      addBtn.dataset.productUrl = productUrl;
      addBtn.dataset.productImage = productImage;

      modal.style.display = 'flex';
      modal.removeAttribute('hidden');
      requestAnimationFrame(() => {
        modal.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
    };

    const closeWishlistModal = () => {
      const modal = sectionContainer.querySelector('[data-wishlist-modal]');
      if (!modal) return;
      modal.classList.remove('is-open');
      setTimeout(() => {
        if (!modal.classList.contains('is-open')) {
          modal.style.display = 'none';
          modal.setAttribute('hidden', '');
        }
      }, 220);
      document.body.style.overflow = '';
    };

    sectionContainer.querySelectorAll('[data-wishlist-heart]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const handle = extractHandle(btn.dataset.productUrl);
        const wishlist = getWishlist();
        const isInList = wishlist.some((item) => item.handle === handle);
        if (isInList) {
          const updated = wishlist.filter(item => item.handle !== handle);
          saveWishlist(updated);
          document.dispatchEvent(new CustomEvent('wishlist:update'));
          updateHeartStates();
        } else {
          openWishlistModal(btn);
        }
      });
    });

    const addWishBtn = sectionContainer.querySelector('[data-wishlist-add]');
    if (addWishBtn) {
      addWishBtn.addEventListener('click', () => {
        const handle = extractHandle(addWishBtn.dataset.productUrl);
        if (!handle) return;
        const wishlist = getWishlist();
        if (!wishlist.some(item => item.handle === handle)) {
          wishlist.push({
            handle,
            id: currentProductId,
            title: addWishBtn.dataset.productTitle,
            price: addWishBtn.dataset.productPrice,
            image: addWishBtn.dataset.productImage,
            size: selectedSize || ''
          });
          saveWishlist(wishlist);
          document.dispatchEvent(new CustomEvent('wishlist:update'));
        }
        closeWishlistModal();
        updateHeartStates();
      });
    }

    sectionContainer.querySelectorAll('[data-wishlist-close]').forEach(el => el.addEventListener('click', closeWishlistModal));
    document.addEventListener('wishlist:update', updateHeartStates);
    updateHeartStates();

    /* ── Quick Add Modal & Cart ── */
    const qaModal = sectionContainer.querySelector('[data-qa-modal]');
    let qaSelectedSize = null;

    const resolveVariantId = () => {
      if (!qaModal) return '';
      const variantsData = qaModal.dataset.qaVariants || '';
      const firstVariant = qaModal.dataset.qaFirstVariant || '';
      let variantId = '';

      if (variantsData && qaSelectedSize) {
        const pairs = variantsData.split(',').filter(Boolean);
        for (const pair of pairs) {
          const [name, id] = pair.split(':');
          if (name && id && name.trim() === qaSelectedSize.trim()) {
            variantId = id.trim();
            break;
          }
        }
      }
      return variantId || firstVariant;
    };

    const openQAModal = (btn) => {
      if (!qaModal) return;
      const titleEl = qaModal.querySelector('[data-qa-title]');
      const priceEl = qaModal.querySelector('[data-qa-price]');
      const imgEl = qaModal.querySelector('[data-qa-img]');
      const sizesEl = qaModal.querySelector('[data-qa-sizes]');

      const title = btn.dataset.qaTitle || '';
      const price = btn.dataset.qaPrice || '0';
      const image = btn.dataset.qaImage || '';
      const firstVariant = btn.dataset.qaFirstVariant || '';
      const sizesRaw = btn.dataset.qaSizes || '';
      const variantsRaw = btn.dataset.qaVariants || '';
      const productAvailable = btn.dataset.qaAvailable === 'true';
      const variantAvailRaw = btn.dataset.qaVariantAvailability || '';
      const sizes = sizesRaw.split(',').map(s => s.trim()).filter(s => s.length > 0);

      const variantAvailMap = {};
      if (variantAvailRaw) {
        variantAvailRaw.split(',').filter(Boolean).forEach(pair => {
          const [name, avail] = pair.split(':');
          if (name) variantAvailMap[name.trim()] = avail && avail.trim() === 'true';
        });
      }

      qaModal.dataset.qaVariants = variantsRaw;
      qaModal.dataset.qaFirstVariant = firstVariant;
      qaSelectedSize = null;

      titleEl.textContent = title;
      priceEl.textContent = 'RS. ' + price;

      if (image) {
        imgEl.innerHTML = '<img src="' + image + '" alt="' + title.replace(/"/g, '&quot;') + '" />';
        imgEl.style.display = 'flex';
      } else {
        imgEl.innerHTML = '';
        imgEl.style.display = 'none';
      }

      const actionsEl = qaModal.querySelector('[data-qa-actions]');
      const soldOutEl = qaModal.querySelector('[data-qa-sold-out]');

      const setQASoldOut = (isSoldOut) => {
        if (actionsEl) actionsEl.style.display = isSoldOut ? 'none' : 'grid';
        if (soldOutEl) soldOutEl.style.display = isSoldOut ? 'flex' : 'none';
      };

      if (!productAvailable) {
        setQASoldOut(true);
      } else {
        setQASoldOut(false);
      }

      if (sizes.length > 0) {
        let firstAvailIdx = sizes.findIndex(s => variantAvailMap[s] !== false);
        if (firstAvailIdx === -1) firstAvailIdx = 0;

        sizesEl.innerHTML = sizes.map((size, i) => {
          const isSelected = i === firstAvailIdx ? ' is-selected' : '';
          const isUnavailable = variantAvailMap[size] === false ? ' is-unavailable' : '';
          if (i === firstAvailIdx) qaSelectedSize = size;
          return '<button type="button" class="stagmenfashion-qa-modal__size' + isSelected + isUnavailable + '" data-qa-size-btn data-size="' + size + '">' + size + '</button>';
        }).join('');

        sizesEl.querySelectorAll('[data-qa-size-btn]').forEach(sizeBtn => {
          sizeBtn.addEventListener('click', () => {
            sizesEl.querySelectorAll('[data-qa-size-btn]').forEach(b => b.classList.remove('is-selected'));
            sizeBtn.classList.add('is-selected');
            qaSelectedSize = sizeBtn.dataset.size;
            setQASoldOut(variantAvailMap[qaSelectedSize] === false);
          });
        });

        if (productAvailable && variantAvailMap[qaSelectedSize] === false) {
          setQASoldOut(true);
        }
      } else {
        sizesEl.innerHTML = '<button type="button" class="stagmenfashion-qa-modal__size is-selected" data-qa-size-btn data-size="Default">Default</button>';
        qaSelectedSize = 'Default';
      }

      qaModal.style.display = 'flex';
      qaModal.removeAttribute('hidden');
      requestAnimationFrame(() => {
        qaModal.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
    };

    const closeQAModal = () => {
      if (!qaModal) return;
      qaModal.classList.remove('is-open');
      setTimeout(() => {
        if (!qaModal.classList.contains('is-open')) {
          qaModal.style.display = 'none';
          qaModal.setAttribute('hidden', '');
        }
      }, 220);
      document.body.style.overflow = '';
    };

    sectionContainer.querySelectorAll('[data-quick-add]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openQAModal(btn);
      });
    });

    sectionContainer.querySelectorAll('[data-qa-close]').forEach(el => el.addEventListener('click', closeQAModal));

    // Cart Add
    const cartAddUrl = window.Shopify?.routes?.root ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js';
    const addBagBtn = sectionContainer.querySelector('[data-qa-add-bag]');
    if (addBagBtn) {
      addBagBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const variantId = resolveVariantId();
        if (!variantId) return;

        addBagBtn.textContent = 'Adding...';
        addBagBtn.disabled = true;

        fetch(cartAddUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/javascript',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
        })
        .then(res => {
          if (!res.ok) return res.json().then(d => { throw new Error(d.description || 'Failed'); });
          return res.json();
        })
        .then((cart) => {
          addBagBtn.textContent = 'Added!';
          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: { data: cart, resource: cart, metadata: { itemCount: cart.item_count } }
          }));
          setTimeout(() => {
            addBagBtn.textContent = 'Add To Bag';
            addBagBtn.disabled = false;
            closeQAModal();
          }, 1200);
        })
        .catch(err => {
          console.error(err);
          addBagBtn.textContent = 'Add To Bag';
          addBagBtn.disabled = false;
        });
      });
    }

    const buyBtn = sectionContainer.querySelector('[data-qa-buy-now]');
    if (buyBtn) {
      buyBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const variantId = resolveVariantId();
        if (!variantId) return;
        buyBtn.textContent = 'Redirecting...';
        buyBtn.disabled = true;
        const rootUrl = window.Shopify?.routes?.root || '/';
        const cleanRoot = rootUrl.endsWith('/') ? rootUrl : rootUrl + '/';
        window.location.href = `${cleanRoot}cart/${variantId}:1`;
      });
    }

    /* ── Size Guide Modal ── */
    const sgModal = sectionContainer.querySelector('[data-qa-size-guide-modal]');
    const openSizeGuide = () => {
      if (!sgModal) return;
      sgModal.style.display = 'flex';
      sgModal.removeAttribute('hidden');
      requestAnimationFrame(() => sgModal.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
    };

    const closeSizeGuide = () => {
      if (!sgModal) return;
      sgModal.classList.remove('is-open');
      setTimeout(() => {
        if (!sgModal.classList.contains('is-open')) {
          sgModal.style.display = 'none';
          sgModal.setAttribute('hidden', '');
        }
      }, 220);
      if (!qaModal || !qaModal.classList.contains('is-open')) {
        document.body.style.overflow = '';
      }
    };

    sectionContainer.querySelectorAll('[data-qa-size-guide], [data-wishlist-size-guide]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openSizeGuide();
      });
    });

    sectionContainer.querySelectorAll('[data-qa-size-guide-close]').forEach(btn => {
      btn.addEventListener('click', closeSizeGuide);
    });

    sectionContainer.querySelectorAll('.stagmenfashion-unit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const unit = btn.dataset.unit;
        sectionContainer.querySelectorAll('.stagmenfashion-unit-btn').forEach(b => b.classList.toggle('is-active', b === btn));
        const table = sectionContainer.querySelector('[data-qa-size-table]');
        if (table) {
          table.dataset.activeUnit = unit;
          table.querySelectorAll('td[data-val-cm]').forEach(cell => {
            cell.textContent = unit === 'in' ? cell.dataset.valIn : cell.dataset.valCm;
          });
        }
      });
    });

    /* ── Card Image Carousel / Slide Hover ── */
    sectionContainer.querySelectorAll('[data-carousel]').forEach((carousel) => {
      const slides = carousel.querySelectorAll('[data-carousel-slide]');
      const dots = carousel.querySelectorAll('[data-carousel-dot]');
      if (slides.length <= 1) return;

      let currentIndex = 0;
      const goTo = (index) => {
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        slides[currentIndex].classList.remove('is-active');
        dots[currentIndex]?.classList.remove('is-active');
        currentIndex = index;
        slides[currentIndex].classList.add('is-active');
        dots[currentIndex]?.classList.add('is-active');
      };

      const cardEl = carousel.closest('[data-product-card]') || carousel;
      cardEl.addEventListener('mouseenter', () => {
        if (slides.length > 1) goTo(1);
      });
      cardEl.addEventListener('mouseleave', () => {
        if (slides.length > 1) goTo(0);
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          goTo(parseInt(dot.dataset.index, 10));
        });
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (sgModal && sgModal.classList.contains('is-open')) {
          closeSizeGuide();
        } else if (qaModal && qaModal.classList.contains('is-open')) {
          closeQAModal();
        } else {
          closeWishlistModal();
        }
      }
    });

  })();
</script>

