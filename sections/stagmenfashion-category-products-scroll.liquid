{% liquid
  assign coll_handle = section.settings.collection
  if coll_handle != blank
    assign active_collection = collections[coll_handle]
  endif
  if active_collection == blank or active_collection.products.size == 0
    assign active_collection = collections['all']
  endif
  if active_collection == blank or active_collection.products.size == 0
    assign active_collection = collections['new-in']
  endif
  if active_collection == blank or active_collection.products.size == 0
    assign active_collection = collections['co-ords']
  endif

  assign limit_count = section.settings.products_to_show | default: 12
  assign sorted_products = active_collection.products
  assign discover_url = section.settings.discover_more_link | default: active_collection.url
%}

<section
  class="stagmenfashion-catprod color-{{ section.settings.color_scheme }}"
  data-catprod-section="{{ section.id }}"
  style="
    --catprod-section-bg: {{ section.settings.section_background | default: 'transparent' }};
    --catprod-bg: {{ section.settings.background | default: '#f0f1f4' }};
    --catprod-radius: {{ section.settings.shell_radius | default: 12 }}px;
  "
>
  <div class="stagmenfashion-catprod__shell">
    
    <!-- ── Header ── -->
    <div class="stagmenfashion-catprod__head">
      <div class="stagmenfashion-catprod__heading-wrap">
        {% if section.settings.heading != blank %}
          <h2 class="stagmenfashion-catprod__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="stagmenfashion-catprod__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="stagmenfashion-catprod__head-right">
        {% if section.settings.discover_more_label != blank and discover_url != blank %}
          <a
            href="{{ discover_url }}"
            class="stagmenfashion-catprod__discover-more"
          >
            {{ section.settings.discover_more_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- ── Horizontally Scrolling Products Rail ── -->
    <div class="stagmenfashion-catprod__rail-wrap">
      <div class="stagmenfashion-catprod__rail" data-catprod-rail>
        {% if sorted_products.size > 0 %}
          {% for product in sorted_products limit: limit_count %}
            {% liquid
              assign images = product.images
              assign image_count = images.size
              assign first_image = product.featured_image | default: images.first
              assign sizes_list = ''
              for opt in product.options_with_values
                assign opt_name_down = opt.name | downcase
                if opt_name_down contains 'size' or opt.name == 'Size'
                  assign sizes_list = opt.values | join: ','
                endif
              endfor
              if sizes_list == ''
                assign sizes_check = '|'
                for v in product.variants
                  assign sz = v.option1 | strip
                  unless sz == blank or sz == 'Default Title'
                    assign check_sz = '|' | append: sz | append: '|'
                    unless sizes_check contains check_sz
                      assign sizes_check = sizes_check | append: check_sz
                      if sizes_list != ''
                        assign sizes_list = sizes_list | append: ','
                      endif
                      assign sizes_list = sizes_list | append: sz
                    endunless
                  endunless
                endfor
              endif

              assign card_has_sale = false
              assign card_discount_pct = 0
              if product.compare_at_price > product.price
                assign card_has_sale = true
                assign card_discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
              endif
            %}

            <div class="stagmenfashion-catprod__card" data-product-card>
              <!-- Media Box -->
              <div class="stagmenfashion-catprod__media-wrap">
                <a href="{{ product.url }}" class="stagmenfashion-catprod__media" data-carousel>
                  {% if image_count > 0 %}
                    {% for image in images limit: 6 %}
                      <img
                        class="stagmenfashion-catprod__image{% if forloop.first %} is-active{% endif %}"
                        src="{{ image | image_url: width: 500 }}"
                        srcset="{{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 500 }} 500w"
                        sizes="(max-width: 749px) 45vw, (max-width: 1024px) 25vw, 16vw"
                        alt="{{ image.alt | default: product.title | escape }}"
                        width="500"
                        height="750"
                        loading="lazy"
                        decoding="async"
                        data-carousel-slide
                      >
                    {% endfor %}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'stagmenfashion-catprod__placeholder' }}
                  {% endif %}

                  <!-- Badges -->
                  {% if card_has_sale and card_discount_pct > 0 %}
                    <div class="stagmenfashion-catprod__badges">
                      <span class="stagmenfashion-catprod__badge stagmenfashion-catprod__badge--sale">-{{ card_discount_pct }}%</span>
                    </div>
                  {% endif %}

                  {% if image_count > 1 %}
                    <div class="stagmenfashion-catprod__dots" data-carousel-dots>
                      {% for image in images limit: 6 %}
                        <span class="stagmenfashion-catprod__dot{% if forloop.first %} is-active{% endif %}" data-carousel-dot data-index="{{ forloop.index0 }}"></span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </a>

                <!-- Wishlist / Heart button -->
                <button
                  type="button"
                  class="stagmenfashion-catprod__heart"
                  data-wishlist-heart
                  data-product-id="{{ product.id }}"
                  data-product-title="{{ product.title | escape }}"
                  data-product-price="{{ product.price | money_without_currency | remove: ',' }}"
                  data-product-compare-price="{{ product.compare_at_price | money_without_currency | remove: ',' }}"
                  data-product-url="{{ product.url }}"
                  data-product-image="{{ first_image | image_url: width: 400 }}"
                  data-product-sizes="{{ sizes_list | split: ',' | join: ',' }}"
                  data-product-available="{{ product.available }}"
                  aria-label="Add {{ product.title }} to wishlist"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
              </div>

              <!-- Product Details -->
              <div class="stagmenfashion-catprod__body">
                <div class="stagmenfashion-catprod__meta">
                  <a href="{{ product.url }}" class="stagmenfashion-catprod__title-link">
                    <h3 class="stagmenfashion-catprod__title">{{ product.title }}</h3>
                  </a>
                  <div class="stagmenfashion-catprod__price-row">
                    <span class="stagmenfashion-catprod__price">RS. {{ product.price | money_without_currency | remove: ',' }}</span>
                    {% if card_has_sale %}
                      <span class="stagmenfashion-catprod__compare-price">RS. {{ product.compare_at_price | money_without_currency | remove: ',' }}</span>
                      <span class="stagmenfashion-catprod__discount-tag">{{ card_discount_pct }}% OFF</span>
                    {% endif %}
                  </div>
                </div>

                <!-- Full-Width Bottom Action Bar Button -->
                <button
                  type="button"
                  class="stagmenfashion-catprod__action-btn"
                  data-quick-add
                  data-qa-title="{{ product.title | escape }}"
                  data-qa-price="{{ product.price | money_without_currency | remove: ',' }}"
                  data-qa-url="{{ product.url }}"
                  data-qa-id="{{ product.id }}"
                  data-qa-image="{{ first_image | image_url: width: 400 }}"
                  data-qa-sizes="{{ sizes_list | split: ',' | join: ',' }}"
                  data-qa-first-variant="{{ product.selected_or_first_available_variant.id }}"
                  data-qa-variants="{% for v in product.variants %}{% unless v.option1 == 'Default Title' %}{{ v.option1 }}:{{ v.id }},{% endunless %}{% endfor %}"
                  data-qa-available="{{ product.available }}"
                  data-qa-variant-availability="{% for v in product.variants %}{% unless v.option1 == 'Default Title' %}{{ v.option1 }}:{{ v.available }},{% endunless %}{% endfor %}"
                  aria-label="Quick add {{ product.title }}"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>Quick Add</span>
                </button>
              </div>
            </div>
          {% endfor %}

        {% else %}
          {% for i in (1..6) %}
            <div class="stagmenfashion-catprod__card stagmenfashion-catprod__card--placeholder">
              <div class="stagmenfashion-catprod__media-wrap">
                <div class="stagmenfashion-catprod__media">
                  {{ 'product-1' | placeholder_svg_tag: 'stagmenfashion-catprod__placeholder' }}
                  <div class="stagmenfashion-catprod__badges">
                    <span class="stagmenfashion-catprod__badge stagmenfashion-catprod__badge--sale">-20%</span>
                  </div>
                </div>
              </div>
              <div class="stagmenfashion-catprod__body">
                <div class="stagmenfashion-catprod__meta">
                  <h3 class="stagmenfashion-catprod__title">Stag Essential {{ i }}</h3>
                  <div class="stagmenfashion-catprod__price-row">
                    <span class="stagmenfashion-catprod__price">RS. 1,499</span>
                    <span class="stagmenfashion-catprod__compare-price">RS. 1,899</span>
                    <span class="stagmenfashion-catprod__discount-tag">20% OFF</span>
                  </div>
                </div>
                <span class="stagmenfashion-catprod__action-btn">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <span>Quick Add</span>
                </span>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

  </div>

  <!-- ── Wishlist Modal ── -->
  <div class="stagmenfashion-wishlist-modal" data-wishlist-modal style="display:none;" hidden>
    <div class="stagmenfashion-wishlist-modal__backdrop" data-wishlist-close></div>
    <div class="stagmenfashion-wishlist-modal__card">
      <button type="button" class="stagmenfashion-wishlist-modal__close" data-wishlist-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="stagmenfashion-wishlist-modal__header">
        <div class="stagmenfashion-wishlist-modal__product-img" data-wishlist-img></div>
        <div class="stagmenfashion-wishlist-modal__product-info">
          <h3 class="stagmenfashion-wishlist-modal__title" data-wishlist-title></h3>
          <div class="stagmenfashion-wishlist-modal__price-wrap">
            <span class="stagmenfashion-wishlist-modal__price" data-wishlist-price></span>
            <span class="stagmenfashion-wishlist-modal__compare-price" data-wishlist-compare-price></span>
          </div>
        </div>
      </div>

      <div class="stagmenfashion-wishlist-modal__sizes">
        <div class="stagmenfashion-wishlist-modal__sizes-top">
          <span class="stagmenfashion-wishlist-modal__label" data-wishlist-size-label>Size</span>
          <button type="button" class="stagmenfashion-wishlist-modal__size-guide" data-wishlist-size-guide>Size Guide</button>
        </div>
        <div class="stagmenfashion-wishlist-modal__size-grid" data-wishlist-sizes></div>
      </div>

      <button type="button" class="stagmenfashion-wishlist-modal__add-btn" data-wishlist-add>
        Add To List
      </button>
    </div>
  </div>

  <!-- ── Quick Add Modal ── -->
  <div class="stagmenfashion-qa-modal" data-qa-modal style="display:none;" hidden>
    <div class="stagmenfashion-qa-modal__backdrop" data-qa-close></div>
    <div class="stagmenfashion-qa-modal__card">
      <button type="button" class="stagmenfashion-qa-modal__close" data-qa-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="stagmenfashion-qa-modal__header">
        <div class="stagmenfashion-qa-modal__product-img" data-qa-img></div>
        <div class="stagmenfashion-qa-modal__product-info">
          <h3 class="stagmenfashion-qa-modal__title" data-qa-title></h3>
          <span class="stagmenfashion-qa-modal__price" data-qa-price></span>
        </div>
      </div>

      <div class="stagmenfashion-qa-modal__sizes">
        <div class="stagmenfashion-qa-modal__sizes-top">
          <span class="stagmenfashion-qa-modal__label">Size</span>
          <button type="button" class="stagmenfashion-qa-modal__size-guide" data-qa-size-guide>Size Guide</button>
        </div>
        <div class="stagmenfashion-qa-modal__size-grid" data-qa-sizes></div>
      </div>

      <div class="stagmenfashion-qa-modal__actions" data-qa-actions>
        <button type="button" class="stagmenfashion-qa-modal__btn stagmenfashion-qa-modal__btn--bag" data-qa-add-bag>Add To Bag</button>
        <button type="button" class="stagmenfashion-qa-modal__btn stagmenfashion-qa-modal__btn--buy" data-qa-buy-now>Buy Now</button>
      </div>
      <div class="stagmenfashion-qa-modal__sold-out" data-qa-sold-out style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        <span>Sold Out</span>
      </div>
    </div>
  </div>

  <!-- ── Size Guide Modal ── -->
  <div class="stagmenfashion-size-guide-modal" data-qa-size-guide-modal aria-hidden="true" style="display:none;" hidden>
    <div class="stagmenfashion-size-guide-modal__backdrop" data-qa-size-guide-close></div>
    <div class="stagmenfashion-size-guide-modal__card" role="dialog" aria-labelledby="{{ section.id }}-sg-title">
      <div class="stagmenfashion-size-guide-modal__header">
        <h3 id="{{ section.id }}-sg-title" class="stagmenfashion-size-guide-modal__title">Size guide</h3>
        <div class="stagmenfashion-size-guide__unit-toggle" data-qa-unit-toggle role="radiogroup" aria-label="Unit of measurement">
          <button type="button" class="stagmenfashion-unit-btn" data-unit="in" aria-label="Show measurements in Inches" role="radio" aria-checked="false">
            IN
          </button>
          <button type="button" class="stagmenfashion-unit-btn is-active" data-unit="cm" aria-label="Show measurements in Centimeters" role="radio" aria-checked="true">
            CM
          </button>
        </div>
        <button type="button" class="stagmenfashion-size-guide-modal__close" data-qa-size-guide-close aria-label="Close size guide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="stagmenfashion-size-guide-modal__body">
        <div class="stagmenfashion-size-table-wrapper">
          <table class="stagmenfashion-size-table" data-qa-size-table data-active-unit="cm">
            <thead>
              <tr>
                <th>Size</th>
                <th>Chest</th>
                <th>Shoulder</th>
                <th>Length</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>XXXS</td>
                <td data-val-cm="88.90" data-val-in="35.00">88.90</td>
                <td data-val-cm="41.91" data-val-in="16.50">41.91</td>
                <td data-val-cm="63.50" data-val-in="25.00">63.50</td>
              </tr>
              <tr>
                <td>XXS</td>
                <td data-val-cm="93.98" data-val-in="37.00">93.98</td>
                <td data-val-cm="43.18" data-val-in="17.00">43.18</td>
                <td data-val-cm="66.04" data-val-in="26.00">66.04</td>
              </tr>
              <tr>
                <td>XS</td>
                <td data-val-cm="99.06" data-val-in="39.00">99.06</td>
                <td data-val-cm="44.45" data-val-in="17.50">44.45</td>
                <td data-val-cm="69.85" data-val-in="27.50">69.85</td>
              </tr>
              <tr>
                <td>S</td>
                <td data-val-cm="106.68" data-val-in="42.00">106.68</td>
                <td data-val-cm="46.99" data-val-in="18.50">46.99</td>
                <td data-val-cm="71.12" data-val-in="28.00">71.12</td>
              </tr>
              <tr>
                <td>M</td>
                <td data-val-cm="111.76" data-val-in="44.00">111.76</td>
                <td data-val-cm="48.26" data-val-in="19.00">48.26</td>
                <td data-val-cm="73.66" data-val-in="29.00">73.66</td>
              </tr>
              <tr>
                <td>L</td>
                <td data-val-cm="116.84" data-val-in="46.00">116.84</td>
                <td data-val-cm="48.26" data-val-in="19.00">48.26</td>
                <td data-val-cm="74.93" data-val-in="29.50">74.93</td>
              </tr>
              <tr>
                <td>XL</td>
                <td data-val-cm="119.38" data-val-in="47.00">119.38</td>
                <td data-val-cm="49.53" data-val-in="19.50">49.53</td>
                <td data-val-cm="78.74" data-val-in="31.00">78.74</td>
              </tr>
              <tr>
                <td>XXL</td>
                <td data-val-cm="129.54" data-val-in="51.00">129.54</td>
                <td data-val-cm="53.34" data-val-in="21.00">53.34</td>
                <td data-val-cm="78.74" data-val-in="31.00">78.74</td>
              </tr>
              <tr>
                <td>XXXL</td>
                <td data-val-cm="134.62" data-val-in="53.00">134.62</td>
                <td data-val-cm="57.15" data-val-in="22.50">57.15</td>
                <td data-val-cm="82.55" data-val-in="32.50">82.55</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section & Styled Shell with Background, Margin & Border Radius ── */
  .stagmenfashion-catprod {
    background: var(--catprod-section-bg, transparent);
    padding-top: clamp(14px, 2vw, 22px);
    padding-bottom: clamp(14px, 2vw, 22px);
    --catprod-heading-size: 18px;
    --catprod-discover-more-size: 13px;
    --catprod-card-title-size: 13px;
    --catprod-card-price-size: 11px;
    width: 100%;
    box-sizing: border-box;
  }

  .stagmenfashion-catprod__shell {
    width: auto;
    max-width: 100%;
    margin: 0 36px;
    background: var(--catprod-bg, #ffffff);
    border-radius: var(--catprod-radius, 12px);
    padding: clamp(18px, 2.5vw, 26px) clamp(16px, 2.5vw, 24px) clamp(16px, 2.5vw, 24px);
    box-sizing: border-box;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
  }

  /* ── Header ── */
  .stagmenfashion-catprod__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgb(17 17 17 / 0.1);
  }

  .stagmenfashion-catprod__heading-wrap {
    flex: 1;
    min-width: 0;
  }

  .stagmenfashion-catprod__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--catprod-heading-size);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-foreground-heading, #111111);
  }

  .stagmenfashion-catprod__subheading {
    margin: 6px 0 0;
    font-size: 13px;
    color: #6b7280;
    line-height: 1.4;
    font-weight: 400;
  }

  .stagmenfashion-catprod__head-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .stagmenfashion-catprod__discover-more {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #111111;
    font-size: var(--catprod-discover-more-size);
    font-weight: 600;
    padding: 0;
    border: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.25s ease;
    flex-shrink: 0;
  }

  .stagmenfashion-catprod__discover-more:hover {
    color: var(--color-primary, #000000);
  }

  /* ── Rail Container matching Category Scroll ── */
  .stagmenfashion-catprod__rail-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .stagmenfashion-catprod__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (5 * 8px)) / 6);
    gap: 8px;
    width: 100%;
    overflow-x: auto;
    scroll-behavior: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    cursor: grab;
    padding-bottom: 4px;
    box-sizing: border-box;
  }

  .stagmenfashion-catprod__rail.is-dragging {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
  }

  .stagmenfashion-catprod__rail::-webkit-scrollbar {
    display: none;
  }

  /* ── Product Card (Modern Shop Card with Bottom Action Bar) ── */
  .stagmenfashion-catprod__card {
    width: 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: transparent;
    border-radius: 0;
    border: none;
    box-shadow: none;
    position: relative;
  }

  .stagmenfashion-catprod__media-wrap {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: #f5f5f7;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  /* Responsive column sizing */
  @media screen and (min-width: 1025px) and (max-width: 1400px) {
    .stagmenfashion-catprod__rail {
      grid-auto-columns: calc((100% - (4 * 8px)) / 5);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .stagmenfashion-catprod__rail {
      grid-auto-columns: calc((100% - (2 * 8px)) / 3.2);
    }
  }

  @media screen and (max-width: 749px) {
    .stagmenfashion-catprod {
      --catprod-heading-size: 15px;
      --catprod-card-title-size: 11.5px;
      --catprod-card-price-size: 11px;
      --catprod-discover-more-size: 11px;
    }

    .stagmenfashion-catprod__shell {
      margin: 0 10px;
