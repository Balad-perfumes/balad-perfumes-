<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}

    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}
    {%- render 'shoppable-video-enhancer' -%}

    {% comment %} Smooth Scroll & Viewport Overflow Protection {% endcomment %}
    <style>
      html {
        scroll-behavior: smooth;
        overflow-x: clip;
      }
      body {
        overflow-x: clip;
      }
      #instareel-block-AQU54REdJdUNCbFdOS__instareel_ig_reels_instagram_reels_feed_mAaTPW,
      [id*="instareel-block"] {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }
    </style>

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
  </head>

  <body
    class="
      page-width-{{ settings.page_width }}
      card-hover-effect-{{ settings.card_hover_effect }}
      {% if request.page_type == 'collection' or request.page_type == 'search' %}hide-mobile-tabs{% endif %}
      template-{{ template.name | default: 'index' }}
    "
  >
    {% if settings.loader_enable %}
      {% render 'logo-loader' %}
    {% endif %}
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      (function() {
        const deferFn = window.requestIdleCallback || ((cb) => setTimeout(cb, 100));
        deferFn(() => {
          const header = document.querySelector('header-component, [data-pf-header]');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section, [data-pf-header]');

          if (header && headerGroup) {
            // Batch all DOM reads first to avoid forced reflow
            const headerTopRow = header.querySelector('.header__row--top');
            const headerHeight = header.offsetHeight;
            const headerTopRowHeight = headerTopRow ? headerTopRow.offsetHeight : 0;

            let headerGroupHeight = 0;
            const children = headerGroup.children;
            for (let i = 0; i < children.length; i++) {
              const element = children[i];
              if (element === header || !(element instanceof HTMLElement)) continue;
              headerGroupHeight += element.offsetHeight;
            }

            const isTransparent = header.hasAttribute('transparent');
            if (isTransparent && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            const hasImmediateSection = hasHeaderSection?.nextElementSibling?.classList.contains('shopify-section');
            const shouldApplyOffset = (!hasHeaderSection || !isTransparent) ? '0' : (!hasImmediateSection ? '1' : '0');

            // Batch all DOM writes in a single animation frame
            requestAnimationFrame(() => {
              document.body.style.setProperty('--header-height', `${headerHeight}px`);
              document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
              if (headerTopRowHeight > 0) {
                document.body.style.setProperty('--top-row-height', `${headerTopRowHeight}px`);
              }
              document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
            });
          }

          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        });
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {% if request.path == '/policies/refund-policy' %}
        <article class="shopify-policy__container rte">
          <h1>Refund and Return Policy</h1>
          <p>Contact us within 7 calendar days of delivery to request a return or report a problem. Include your order number. For a damaged bottle or incorrect item, include clear photos of the product and its packaging. Email <a href="mailto:hello@baladperfume.com">hello@baladperfume.com</a> or call <a href="tel:+919447425555">+91 94474 25555</a>.</p>

          <h2>Sealed perfumes</h2>
          <p>An unused perfume is eligible for a return for a refund if its original factory seal is intact and it is returned in its original packaging. Request the return within 7 calendar days of delivery and wait for our instructions before sending it back. We issue the refund to the original payment method after the return arrives and we confirm the seal and packaging are intact.</p>

          <h2>Opened perfumes</h2>
          <p>Opened, unsealed, or used perfumes are not eligible for a change-of-mind return or a refund for scent preference. This does not affect a claim that an item arrived damaged, defective, or incorrect. Contact us within 7 calendar days so we can review it.</p>

          <h2>Damaged deliveries or incorrect items</h2>
          <p>If a bottle arrives broken, leaking, defective, or different from what you ordered, contact us within 7 calendar days of delivery with photos of the bottle and packaging. Keep the item and packaging while we review your claim. If we verify the issue, you can choose a replacement or refund; the perfume does not need to be unopened to report damage or an incorrect item. Verified refunds go to the original payment method after review.</p>

          <h2>Return shipping and refunds</h2>
          <p>Perfumes may be treated as flammable goods by carriers. Do not mail a perfume back until our team provides safe return or collection instructions. Refund timing after approval depends on your payment provider. This policy does not limit any rights you may have under applicable consumer law.</p>
        </article>
      {% elsif request.path == '/policies/terms-of-service' %}
        {{ content_for_layout | replace: '[LINK]', '<a href="/policies/privacy-policy">Privacy Policy</a>' }}
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% section 'cart-drawer' %}
    {% section 'wishlist-drawer' %}
    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add or request.page_type == 'collection' or request.page_type == 'search' %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% comment %} Native smooth scroll active {% endcomment %}
  </body>
</html>
