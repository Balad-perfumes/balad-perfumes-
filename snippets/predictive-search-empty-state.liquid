{% doc %}
  Renders the predictive search empty state with popular products grid.

  @param {number} shadow_opacity - shadow opacity for the empty state container shadow
  @param {string} products_test_id - a playwright test id, used to differentiate empty state from 'real' search results
  @param {boolean} [load_empty_state] - Render the real products. When false, renders skeleton cards
  (search-modal.liquid does this so every page doesn't carry 10 product cards in its HTML; assets/predictive-search.js
  swaps in the real ones from the predictive-search-empty section the first time search opens).
{% enddoc %}

<div
  id="predictive-search-results"
  class="predictive-search-dropdown"
  role="listbox"
  aria-expanded="true"
  style="--color-shadow: rgb(var(--color-foreground-rgb) / {{ shadow_opacity | default: 0.1 }});"
>
  {%- comment -%}
    #predictive-search-products: assets/predictive-search.js puts "Recently viewed" in here, above Popular Products.
  {%- endcomment -%}
  <div
    id="predictive-search-products"
    class="predictive-search-results__inner search-modal__layout"
    {% if products_test_id %}
      data-testid="{{ products_test_id }}"
    {% endif %}
  >
    <div class="search-modal__products-section">
      <h4 class="search-modal__section-heading">Popular Products</h4>
      <ul class="search-modal__products-grid list-unstyled">
        {%- if load_empty_state -%}
          {%- assign popular_collection = settings.empty_state_collection | default: collections.all -%}
          {%- for product in popular_collection.products limit: 8 -%}
            <li class="predictive-search-results__card predictive-search-results__card--product">
              {% render 'balad-product-card', product: product, limit: 4, show_buy_now: false, show_rating: false %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li class="predictive-search-results__card--skeleton" aria-hidden="true">
              {% render 'balad-product-card', skeleton: true, show_buy_now: false %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>
