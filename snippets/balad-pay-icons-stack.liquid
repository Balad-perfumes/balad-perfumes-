{% stylesheet %}
  .balad-pay-stack {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    line-height: 0;
    vertical-align: middle;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0;
  }

  .balad-pay-stack__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--balad-pay-size, 16px);
    height: var(--balad-pay-size, 16px);
    padding: 1.5px;
    margin: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px currentColor, 0 1px 2px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
    overflow: hidden;
    flex-shrink: 0;
  }

  .balad-pay-stack__icon + .balad-pay-stack__icon {
    margin-left: calc(var(--balad-pay-size, 16px) * -0.22);
  }

  .balad-pay-stack__icon--flush { padding: 0; }
  .balad-pay-stack__icon--gpay { padding: 0.5px; }

  .balad-pay-stack .balad-pay-stack__icon svg {
    display: block;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
  }
{% endstylesheet %}
