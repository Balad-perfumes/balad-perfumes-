{%- comment -%}
  Small overlapping round payment icons (GPay, PhonePe, UPI) shown inside
  checkout / buy-now buttons. Artwork is cropped from snippets/payment-icons.liquid.

  Usage: {% render 'balad-pay-icons-stack' %}
  Optional: size (px, default 16)
{%- endcomment -%}
{%- assign pay_size = size | default: 16 -%}
<span class="balad-pay-stack" style="--balad-pay-size: {{ pay_size }}px;" aria-hidden="true">
