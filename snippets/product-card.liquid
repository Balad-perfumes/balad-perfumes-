{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif

  assign card_section_id = block.id
  assign card_form_id = 'ProductCardForm-' | append: card_section_id | append: '-' | append: product.id
  assign card_variant = product.selected_or_first_available_variant
  assign card_rating = product.metafields.reviews.rating.value.rating
  if card_rating == blank
    assign card_rating = 4.9
  endif
  assign card_rating_round = card_rating | round
  assign card_rating_count = product.metafields.reviews.rating_count
  if card_rating_count == blank
    assign card_rating_count = 128
  endif

  assign card_has_price = false
  if children contains 'product-price' or children contains 'compare-at-price' or children contains 'price__regular'
    assign card_has_price = true
  endif

  assign is_collection_page = false
  if request.page_type == 'collection' or request.page_type == 'search'
    assign is_collection_page = true
  endif

  assign card_selected_variant = product.selected_or_first_available_variant
  assign card_price = card_selected_variant.price
  assign card_compare_at_price = card_selected_variant.compare_at_price
  assign card_has_sale = false
  if card_compare_at_price > card_price
    assign card_has_sale = true
  endif

  assign card_discount_percentage = 0
  if card_has_sale
    assign card_discount_percentage = card_compare_at_price
    assign card_discount_percentage = card_discount_percentage | minus: card_price
    assign card_discount_percentage = card_discount_percentage | times: 100.0
    assign card_discount_percentage = card_discount_percentage | divided_by: card_compare_at_price
    assign card_discount_percentage = card_discount_percentage | round
  endif

  assign delivery_start = 'now' | date: '%s' | plus: 259200 | date: '%-d %b'
  assign delivery_end = 'now' | date: '%s' | plus: 604800 | date: '%-d %b'
%}

<product-card
  class="product-card size-style{% if is_collection_page %} product-card--collection-shop{% endif %}"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product.title }}
    </span>
  </a>
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >

    {% unless onboarding %}
      {% if is_collection_page %}
        {{ children }}
        <div class="product-card__collection-meta">
          <a href="{{ variant_to_link.url }}" class="product-card__collection-title" aria-label="{{ product.title | escape }}">
            {{ product.title }}
          </a>

          <div class="product-card__collection-price-row">
            {% if card_has_sale %}
              <span class="product-card__collection-discount">-{{ card_discount_percentage }}%</span>
              <span class="product-card__collection-compare-at">{{ card_compare_at_price | money }}</span>
            {% endif %}
            <span class="product-card__collection-price">{{ card_price | money }}</span>
          </div>

          <div class="product-card__collection-delivery">
            Delivery by {{ delivery_start }} - {{ delivery_end }}
          </div>
        </div>
      {% else %}
        {{ children }}
        <div class="product-card__footer">
          <div class="product-card__review" aria-label="Rated {{ card_rating }} out of 5">
            <span class="product-card__review-stars" aria-hidden="true">
              {% for star in (1..5) %}
                <span class="{% if star > card_rating_round %}is-dim{% endif %}">★</span>
              {% endfor %}
            </span>
            <span class="product-card__review-score">({{ card_rating | round: 1 }})</span>
          </div>

          <div
            class="
              product-card__purchase-row
              {% unless card_has_price %}product-card__purchase-row--button-only{% endunless %}
            "
          >
            {% unless card_has_price %}
              <product-price
                class="product-card__price"
                data-block-id="{{ block.id }}"
                data-product-id="{{ product.id }}"
              >
                {% render 'price',
                  show_unit_price: false,
                  product_resource: product,
                  show_sale_price_first: true
                %}
              </product-price>
            {% endunless %}

            <product-form-component
              class="product-card__quick-form"
              data-section-id="{{ card_section_id }}"
              data-product-id="{{ product.id }}"
              on:submit="/handleSubmit"
            >
              <div
                class="visually-hidden"
                aria-live="assertive"
                role="status"
                aria-atomic="true"
                ref="liveRegion"
              ></div>

              {%- form 'product', product, id: card_form_id, class: 'shopify-product-form', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  ref="variantId"
                  value="{{ card_variant.id }}"
                >
                <input type="hidden" name="quantity" value="1">

                {% render 'add-to-cart-button',
                  add_to_cart_text: 'Add to bag',
                  class: 'product-card__quick-add add-to-cart-button',
                  can_add_to_cart: card_variant.available,
                  icon_only_on_mobile: false,
                  product: product,
                  data_testid: 'product-card-quick-add'
                %}
              {%- endform -%}
            </product-form-component>
          </div>
        </div>
      {% endif %}
    {% endunless %}
  </div>
  {% unless onboarding %}
    {% liquid
      assign card_sizes = ''
      for opt in product.options_with_values
        assign opt_name_down = opt.name | downcase
        if opt_name_down contains 'size' or opt.name == 'Size'
          assign card_sizes = opt.values | join: ','
        endif
      endfor
      if card_sizes == ''
        assign sizes_check = '|'
        for v in product.variants
          assign sz = v.option1 | strip
          unless sz == blank or sz == 'Default Title'
            assign check_sz = '|' | append: sz | append: '|'
            unless sizes_check contains check_sz
              assign sizes_check = sizes_check | append: check_sz
              if card_sizes != ''
                assign card_sizes = card_sizes | append: ','
              endif
              assign card_sizes = card_sizes | append: sz
            endunless
          endunless
        endfor
      endif
    %}
    <button
      type="button"
      class="product-card__wishlist"
      aria-label="Add to wishlist"
      title="Add to wishlist"
      data-wishlist-button
      data-product-handle="{{ product.handle }}"
      data-product-id="{{ product.id }}"
      data-product-variant-id="{{ card_variant.id | default: product.first_available_variant.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-image="{{ product.featured_media.preview_image | image_url: width: 360 }}"
      data-product-price="{{ product.price | money | strip_html | escape }}"
      data-product-sizes="{{ card_sizes }}"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
    </button>
  {% endunless %}
</product-card>

<style>
  .product-card {
    display: block;
    position: relative;
    transition: transform 0.22s ease, filter 0.22s ease;
  }

  .product-card:hover {
    transform: translateY(-2px);
  }

  .product-card__content {
    position: relative;
    border-radius: 6px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.98), rgb(var(--color-primary-rgb) / 0.02));
    box-shadow: 0 14px 34px rgb(var(--color-primary-rgb) / 0.08);
    transition: box-shadow 0.22s ease, border-color 0.22s ease, background-color 0.22s ease;
  }

  .product-card:hover .product-card__content {
    box-shadow: 0 20px 42px rgb(var(--color-primary-rgb) / 0.12);
  }

  .product-card__wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.96);
    color: var(--color-primary);
    box-shadow: 0 10px 22px rgb(var(--color-primary-rgb) / 0.14);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .product-card__wishlist svg {
    width: 18px;
    height: 18px;
  }

  .product-card__wishlist[aria-pressed="true"],
  .product-card__wishlist.is-active {
    color: #000000;
  }

  .product-card__wishlist[aria-pressed="true"] svg path,
  .product-card__wishlist.is-active svg path {
    fill: #000000 !important;
    stroke: #000000 !important;
  }

  .product-card__wishlist:hover {
    transform: translateY(-1px);
    background: rgb(255 255 255 / 1);
    box-shadow: 0 14px 26px rgb(var(--color-primary-rgb) / 0.18);
  }

  .product-card__wishlist:focus-visible {
    outline: 2px solid rgb(var(--color-primary-rgb) / 0.22);
    outline-offset: 2px;
  }

  .product-card__footer {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 7px;
    margin-top: auto;
    padding: 10px 12px 12px;
  }

  .product-card .text-block p[role='heading'] {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-overflow: ellipsis;
    margin-block: 0;
  }

  .product-card .text-block p[role='heading'] {
    font-size: 0.86rem;
    line-height: 1.22;
    font-weight: 600;
  }

  .product-card .text-block p:not([role='heading']) {
    font-size: 0.76rem;
    line-height: 1.25;
  }

  .product-card .text-block p[role='heading'],
  .product-card .text-block p:not([role='heading']) {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    word-break: break-word;
  }

  .product-card .text-block {
    width: 100%;
    min-width: 0;
  }

  .product-card product-price {
    width: 100%;
    min-width: 0;
  }

  .product-card__purchase-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px;
  }

  .product-card__purchase-row--button-only {
    grid-template-columns: 1fr;
    justify-items: end;
  }

  .product-card product-price div[ref='priceContainer'] {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-card product-price .price-item__group {
    display: block;
  }

  .product-card product-price .price__sale {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
  }

  .product-card product-price .price__hidden {
    display: none !important;
  }

  .product-card product-price .price,
  .product-card product-price .compare-at-price {
    white-space: nowrap;
  }

  .product-card product-price .price-item__group {
    display: block;
  }

  .product-card product-price .price {
    font-size: 0.98rem;
    line-height: 1.1;
  }

  .product-card product-price .compare-at-price {
    font-size: 0.74rem;
    opacity: 0.78;
  }

  .product-card__review {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    padding: 3px 7px;
    border-radius: 999px;
    background: rgb(var(--color-primary-rgb) / 0.08);
    color: var(--color-primary);
    box-shadow: inset 0 0 0 1px rgb(var(--color-primary-rgb) / 0.08);
    white-space: nowrap;
    align-self: flex-start;
  }

  .product-card__review--overlay {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 3;
    padding: 5px 8px;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-primary);
    box-shadow: 0 10px 22px rgb(0 0 0 / 0.08);
    backdrop-filter: blur(10px);
  }

  .product-card__review--overlay .product-card__review-score {
    display: inline;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .product-card--collection-shop .product-card__footer {
    display: none;
  }

  .product-card--collection-shop .group-block-content {
    display: none;
  }

  .product-card--collection-shop .product-grid-view-zoom-out--details {
    display: none !important;
  }

  .product-card--collection-shop .product-badges {
    top: 10px;
    right: auto;
    bottom: auto;
    left: 10px;
  }

  .product-card--collection-shop .text-block p:not([role='heading']) {
    display: -webkit-box;
  }

  .product-card--collection-shop .product-card__collection-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px 12px;
  }

  .product-card--collection-shop .product-card__collection-title {
    color: var(--color-primary);
    font-size: 0.98rem;
    line-height: 1.14;
    font-weight: 800;
    letter-spacing: -0.015em;
    text-wrap: balance;
    text-decoration: none;
    cursor: pointer;
    display: inline-block;
    position: relative;
    width: fit-content;
  }

  .product-card--collection-shop .product-card__collection-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1.5px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left bottom;
    transition: transform 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .product-card--collection-shop .product-card__collection-title:hover::after {
    transform: scaleX(1);
  }

  .product-card--collection-shop .product-card__collection-description {
    color: rgb(var(--color-primary-rgb) / 0.62);
    font-size: 0.76rem;
    line-height: 1.3;
    min-height: 1.3em;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    text-overflow: ellipsis;
  }

  .product-card--collection-shop .product-card__collection-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
    line-height: 1;
  }

  .product-card--collection-shop .product-card__collection-discount {
    color: #2da45c;
    font-size: 0.98rem;
    font-weight: 800;
  }

  .product-card--collection-shop .product-card__collection-compare-at {
    color: rgb(var(--color-primary-rgb) / 0.38);
    font-size: 0.82rem;
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .product-card--collection-shop .product-card__collection-price {
    color: var(--color-primary);
    font-size: 0.98rem;
    font-weight: 800;
  }

  .product-card--collection-shop .product-card__collection-delivery {
    color: var(--color-primary);
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .product-card__review-stars {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    line-height: 1;
    color: #f0ab25;
    font-size: 0.82rem;
  }

  .product-card__review-stars .is-dim {
    opacity: 0.3;
  }

  .product-card__review-score {
    display: inline;
    font-size: 0.72rem;
    line-height: 1;
    color: rgb(var(--color-primary-rgb) / 0.82);
  }

  .product-card__quick-form {
    display: flex;
    justify-content: flex-end;
    min-width: 0;
  }

  .product-card__quick-form .shopify-product-form {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .product-card__quick-add {
    min-height: 34px;
    padding-inline: 12px;
    border-radius: 999px;
    font-size: 0.74rem;
    box-shadow: 0 12px 24px rgb(var(--color-primary-rgb) / 0.14);
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card__wishlist {
      top: 8px;
      right: 8px;
      width: 30px;
      height: 30px;
    }

    .product-card__wishlist svg {
      width: 16px;
      height: 16px;
    }

    .product-card__content {
      border-radius: 4px;
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
      box-shadow: 0 10px 24px rgb(0 0 0 / 0.05);
      background: rgb(255 255 255 / 0.98);
    }

    .product-card__footer {
      padding: 8px 8px 10px;
      gap: 5px;
    }

    .product-card .text-block p[role='heading'] {
      font-size: 0.88rem;
      line-height: 1.18;
    }

    .product-card .text-block p:not([role='heading']) {
      display: none;
    }

    .product-card--collection-shop .text-block p:not([role='heading']) {
      display: -webkit-box;
      font-size: 0.73rem;
      line-height: 1.2;
      color: rgb(var(--color-primary-rgb) / 0.62);
    }

    .product-card--collection-shop .text-block p[role='heading'] {
      font-size: 0.95rem;
      line-height: 1.14;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .product-card--collection-shop .product-badges {
      top: 8px;
      left: 8px;
    }

    .product-card--collection-shop .product-card__collection-meta {
      padding: 8px 10px 10px;
      gap: 3px;
    }

    .product-card--collection-shop .product-card__collection-title {
      font-size: 0.94rem;
      line-height: 1.12;
    }

    .product-card--collection-shop .product-card__collection-description {
      font-size: 0.72rem;
      line-height: 1.2;
    }

    .product-card--collection-shop .product-card__collection-price-row {
      gap: 6px;
    }

    .product-card--collection-shop .product-card__collection-discount,
    .product-card--collection-shop .product-card__collection-price {
      font-size: 0.92rem;
    }

    .product-card--collection-shop .product-card__collection-compare-at {
      font-size: 0.76rem;
    }

    .product-card--collection-shop .product-card__collection-delivery {
      font-size: 0.68rem;
    }

    .product-card__quick-form {
      width: 100%;
      justify-content: flex-end;
    }

    .product-card__purchase-row {
      grid-template-columns: 1fr;
      justify-items: stretch;
      gap: 7px;
      align-items: stretch;
    }

    .product-card product-price {
      flex: 1 1 auto;
      min-width: 0;
    }

    .product-card product-price div[ref='priceContainer'] {
      gap: 1px;
    }

    .product-card product-price .compare-at-price {
      display: none;
    }

    .product-card product-price .price-item__group {
      display: inline;
    }

    .product-card product-price .price {
      font-size: 0.94rem;
      line-height: 1.1;
    }

    .product-card__quick-add {
      width: 100%;
      min-width: 0;
      min-height: 44px;
      padding-inline: 12px;
      font-size: 0.78rem;
      flex-shrink: 0;
      border-radius: 12px;
      background: rgb(255 255 255 / 0.98);
      border: 1.25px solid rgb(var(--color-primary-rgb) / 0.34);
      color: #000;
      box-shadow: 0 10px 20px rgb(var(--color-primary-rgb) / 0.1);
    }

    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
</style>
