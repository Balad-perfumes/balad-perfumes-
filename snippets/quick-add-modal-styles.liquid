{%- doc -%}
  Quick-add modal styles consolidated into a single snippet.

  @example
  {% render 'quick-add-modal-styles' %}
{%- enddoc -%}

{%- comment -%}
  The modal is a closed <dialog> until someone taps quick add, so its ~26 KB of CSS doesn't need to block the
  first paint. It used to be inlined in every page, and once per product card that renders this snippet.
  The CSS is in assets/quick-add-modal.css; the browser fetches it once, however many times this is rendered.
{%- endcomment -%}
<style>
  #quick-add-dialog {
    display: contents;
  }
</style>
<link rel="stylesheet" href="{{ 'quick-add-modal.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'quick-add-modal.css' | asset_url | stylesheet_tag }}</noscript>
