{% doc %}
  Renders the clean minimal full-width search dropdown modal.

  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [class] - Additional CSS classes to apply to the predictive search component.
{% enddoc %}

{%- if template.name == 'index' -%}
  {%- comment -%} Homepage: loaded after page load or on first tap (deferred-modules in layout/theme.liquid) {%- endcomment -%}
  <script type="module-deferred" data-src="{{ 'dialog.js' | asset_url }}"></script>
{%- else -%}
<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>
{%- endif -%}

{%- if template.name == 'index' -%}
  {%- comment -%} Homepage: loaded after page load or on first tap (deferred-modules in layout/theme.liquid) {%- endcomment -%}
  <script type="module-deferred" data-src="{{ 'predictive-search.js' | asset_url }}"></script>
{%- else -%}
<script
  src="{{ 'predictive-search.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{%- endif -%}

<dialog-component
  id="search-modal"
  class="search-modal"
  {{ block.shopify_attributes }}
>
  <dialog
    ref="dialog"
    class="search-modal__content dialog-modal"
    scroll-lock
    aria-labelledby="search-modal-heading"
    data-lenis-prevent
  >
    <h2
      id="search-modal-heading"
      class="visually-hidden"
    >
      {{ 'content.search' | t }}
    </h2>
    <predictive-search-component
      class="predictive-search color-{{ settings.popover_color_scheme }}{% if class != blank %} {{ class | strip }}{% endif %}"
      style="--product-corner-radius: {{ settings.product_corner_radius | default: 8 | append: 'px' }}; --card-corner-radius: {{ settings.card_corner_radius | default: 8 | append: 'px' }};{% if settings.card_title_case == 'uppercase' %} --title-case: uppercase;{% endif %}"
      data-section-id="predictive-search"
      data-testid="{{ 'search-component--modal' }}"
      role="search"
      aria-label="{{ 'content.search_input_label' | t }}"
      data-lenis-prevent
    >
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="predictive-search-form"
        ref="form"
        on:keydown="/onSearchKeyDown"
        data-lenis-prevent
      >
        <!-- Sticky Top Search Bar Row -->
        <div class="predictive-search-form__header">
          <div class="predictive-search-form__header-inner">
            <label
              for="{{ 'cmdk-input' | default: 'Search' }}"
              class="visually-hidden"
            >
              {{- 'content.search_input_label' | t -}}
            </label>
            <input
              class="search-input"
              id="{{ 'cmdk-input' | default: 'Search' }}"
              type="search"
              name="q"
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocomplete="off"
              placeholder="Search here....."
              ref="searchInput"
              on:input="/search"
            >
            <input
              name="options[prefix]"
              type="hidden"
              value="last"
            >
            <button
              type="button"
              class="predictive-search__reset-button"
              ref="resetButton"
              hidden
              on:click="/resetSearch"
              aria-label="{{ 'actions.clear' | t }}"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
            <span class="predictive-search__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
              </svg>
            </span>
          </div>

          <!-- Close Button -->
          <button
            type="button"
            class="predictive-search__close-modal-button"
            aria-label="{{ 'accessibility.close_dialog' | t }}"
            on:click="dialog-component/closeDialog"
            ref="closeModalButton"
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <!-- Scrollable Search Results Container -->
        <div class="predictive-search-form__content-wrapper" data-lenis-prevent>
          <div
            class="predictive-search-form__content"
            ref="predictiveSearchResults"
            on:click="/handleModalClick"
            data-lenis-prevent
          >
            {% render 'predictive-search-empty-state',
              load_empty_state: false,
              shadow_opacity: 0.1,
              products_test_id: 'products-list-default--modal'
            %}
          </div>
        </div>

        <!-- Fixed Bottom Footer CTA Button -->
        <div class="predictive-search-form__footer">
          <button
            type="submit"
            class="button predictive-search__search-button"
            ref="viewAllButton"
          >
            {{ 'content.search_results_view_all' | t }}
          </button>
        </div>
      </form>
    </predictive-search-component>
  </dialog>
</dialog-component>

{%- comment -%}
  The search sheet is a closed <dialog> until someone opens it, so its ~16 KB of CSS loads without blocking the
  first paint (assets/search-modal.css). Only the rules that keep it hidden while closed stay inline.
{%- endcomment -%}
<style>
  .search-modal {
    display: contents;
  }

  dialog.search-modal__content:not([open]),
  .search-modal__content:not([open]),
  dialog-component#search-modal dialog:not([open]) {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
    opacity: 0 !important;
  }
</style>
<link rel="stylesheet" href="{{ 'search-modal.css' | asset_url }}" media="print" onload="this.media='all'">
{%- comment -%} Search results use the site's product card (snippets/balad-product-card.liquid) {%- endcomment -%}
<link rel="stylesheet" href="{{ 'balad-product-card.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  {{ 'search-modal.css' | asset_url | stylesheet_tag }}
  {{ 'balad-product-card.css' | asset_url | stylesheet_tag }}
</noscript>

{%- comment -%}
  Opening and closing belong to <dialog-component> (assets/dialog.js): the header buttons call
  #search-modal/showDialog, and ✕, the backdrop and Escape call closeDialog. This script only adds what the
  component doesn't do. (It used to also open/close the dialog itself, which ran every open/close twice and
  force-closed the sheet mid-animation, so the "closed" event that clears old results never fired.)
{%- endcomment -%}
<script>
  (function () {
    var modal = document.getElementById('search-modal');
    if (!modal) return;
    var dialog = modal.querySelector('dialog');

    function searchInput() {
      return modal.querySelector('input.search-input');
    }

    // Put the cursor in the box as soon as the sheet opens
    modal.addEventListener('dialog:open', function () {
      setTimeout(function () {
        var input = searchInput();
        if (input && dialog.open) input.focus({ preventScroll: true });
      }, 60);
    });

    // Triggers without their own on:click (e.g. links added in the theme editor): wait for the component if needed
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-open-search-modal]:not([on\\:click])');
      if (!trigger) return;
      e.preventDefault();
      customElements.whenDefined('dialog-component').then(function () {
        modal.showDialog();
      });
    });

    // Quick view (+) and wishlist on a result card open their own modal. The search sheet sits in the browser's
    // top layer, so that modal would open underneath it: close the sheet first.
    dialog.addEventListener(
      'click',
      function (e) {
        if (!e.target.closest('[data-quick-add], [data-wishlist-heart]')) return;
        if (typeof modal.closeDialog === 'function') modal.closeDialog();
      },
      true
    );

    // "View all" with an empty box: show every product instead of an empty search page
    dialog.addEventListener('submit', function (e) {
      var input = searchInput();
      if (input && !input.value.trim()) {
        e.preventDefault();
        window.location.href = '{{ routes.all_products_collection_url }}';
      }
    });

    // Let the wheel scroll the results list (the page's smooth-scroll library would otherwise take it)
    document.addEventListener(
      'wheel',
      function (e) {
        if (e.target.closest && e.target.closest('.predictive-search-form__content-wrapper')) e.stopPropagation();
      },
      { passive: true }
    );
  })();
</script>
