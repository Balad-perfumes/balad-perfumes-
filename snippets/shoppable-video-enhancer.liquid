<style>
  /* Shoppable Video & App Section Alignment, Spacing & Gap Overrides */
  [id*="1790060856d032d058"],
  .shopify-section[id*="1790060856"],
  [class*="shoppable-video"] {
    width: 100% !important;
    max-width: 100% !important;
    padding-left: clamp(20px, 4vw, 56px) !important;
    padding-right: clamp(20px, 4vw, 56px) !important;
    box-sizing: border-box !important;
    margin-top: 12px !important;
    margin-bottom: 16px !important;
    padding-top: 0 !important;
  }

  /* Reset inner app container top margins/padding that cause blank vertical gap */
  [id*="1790060856d032d058"] > div,
  [id*="1790060856d032d058"] [class*="wrapper"],
  [id*="1790060856d032d058"] [class*="container"],
  [id*="1790060856d032d058"] [class*="feed"],
  [id*="1790060856d032d058"] [class*="grid"],
  [id*="1790060856d032d058"] [class*="slider"],
  [class*="shoppable-video"] > div,
  [class*="shoppable-video"] [class*="container"] {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  /* Custom Left-Aligned Header with tight 6px gap to video cards */
  .pf-app-ig-header {
    text-align: left !important;
    margin-top: 0 !important;
    margin-bottom: 6px !important;
    padding: 0 !important;
  }

  .pf-app-ig-title {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem) !important;
    font-weight: 700 !important;
    letter-spacing: -0.02em !important;
    color: #111111 !important;
    margin: 0 0 2px 0 !important;
    line-height: 1.2 !important;
    text-align: left !important;
  }

  .pf-app-ig-sub {
    font-size: clamp(0.85rem, 1.2vw, 0.95rem) !important;
    color: #777777 !important;
    font-weight: 400 !important;
    margin: 0 !important;
    line-height: 1.35 !important;
    text-align: left !important;
  }

  /* Hide default small centered headers produced by third-party app block */
  [id*="1790060856d032d058"] [class*="title"]:not(.pf-app-ig-title),
  [id*="1790060856d032d058"] [class*="heading"],
  [id*="1790060856d032d058"] h1,
  [id*="1790060856d032d058"] h2,
  [id*="1790060856d032d058"] h3,
  [id*="1790060856d032d058"] h4 {
    text-align: left !important;
  }

  /* Mobile Responsive Optimizations for App Section */
  @media screen and (max-width: 749px) {
    [id*="1790060856d032d058"],
    .shopify-section[id*="1790060856"],
    [class*="shoppable-video"] {
      padding-left: 12px !important;
      padding-right: 12px !important;
      margin-top: 4px !important;
      margin-bottom: 12px !important;
      padding-top: 0 !important;
    }

    .pf-app-ig-header {
      margin-bottom: 6px !important;
    }

    /* Optimized 2-column mobile card size (172px x 306px) */
    [id*="1790060856d032d058"] [class*="card"],
    [id*="1790060856d032d058"] [class*="item"],
    [id*="1790060856d032d058"] video,
    [class*="shoppable-video"] [class*="card"],
    [class*="shoppable-video"] video {
      flex: 0 0 172px !important;
      width: 172px !important;
      height: 306px !important;
      aspect-ratio: 9 / 16 !important;
      border-radius: 10px !important;
    }
  }
</style>

<script>
  (() => {
    const enhanceShoppableVideoAppSection = () => {
      const section = document.querySelector('[id*="1790060856d032d058"]') || document.querySelector('.shopify-section[id*="1790060856"]') || document.querySelector('[class*="shoppable-video"]');
      if (!section) return;

      if (!section.querySelector('.pf-app-ig-header')) {
        const headerDiv = document.createElement('div');
        headerDiv.className = 'pf-app-ig-header';
        headerDiv.innerHTML = `
          <h2 class="pf-app-ig-title">Shop our Instagram</h2>
          <p class="pf-app-ig-sub">Follow us on Instagram for exciting content</p>
        `;

        const firstChild = section.firstElementChild;
        if (firstChild) {
          section.insertBefore(headerDiv, firstChild);
        } else {
          section.appendChild(headerDiv);
        }
      }
    };

    document.addEventListener('DOMContentLoaded', enhanceShoppableVideoAppSection);
    window.addEventListener('load', enhanceShoppableVideoAppSection);
    setTimeout(enhanceShoppableVideoAppSection, 400);
    setTimeout(enhanceShoppableVideoAppSection, 1200);
  })();
</script>
