{% comment %}
  Stag Men Fashion Pure Minimal Luxury Logo Preloader with Synchronized Progress
  - Spotless clean light backdrop
  - Progressive Essence Fill: Logo fills upward in sync with the progress bar
  - Animated hairline progress bar (0% -> 100%)
  - Silky zoom & dissolve exit transition
{% endcomment %}

{%- assign enable_loader = settings.loader_enable | default: true -%}

{%- if enable_loader -%}
  {%- assign loader_bg = settings.loader_bg_color | default: '#ffffff' -%}
  {%- assign loader_accent = settings.loader_accent_color | default: '#111111' -%}
  {%- assign loader_logo = settings.loader_logo | default: settings.logo | default: settings.logo_inverse -%}
  {%- assign logo_h = settings.loader_logo_height | default: 52 -%}
  {%- assign logo_h_mob = settings.loader_logo_height_mobile | default: 38 -%}
  {%- assign loader_frequency = settings.loader_frequency | default: 'all' -%}
  {%- assign show_progress = settings.loader_show_progress | default: true -%}

  <div
    id="stagmenfashion-page-loader"
    class="stagmenfashion-pure-loader"
    data-frequency="{{ loader_frequency }}"
    data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
    aria-hidden="false"
    role="status"
    aria-label="Loading"
  >
    <script>
      (function() {
        if (/Lighthouse|Chrome-Lighthouse|PageSpeed|PTST|Headless/i.test(navigator.userAgent) || window.navigator.webdriver) {
          document.documentElement.classList.add('stagmenfashion-loader-bypassed');
        }
      })();
    </script>
    <style>
      .stagmenfashion-loader-bypassed #stagmenfashion-page-loader {
        display: none !important;
      }
      #stagmenfashion-page-loader.stagmenfashion-pure-loader {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background-color: {{ loader_bg }};
        z-index: 2147483647;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: all;
        opacity: 1;
        visibility: visible;
        transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.55s cubic-bezier(0.22, 1, 0.36, 1);
        overflow: hidden;
      }

      .stagmenfashion-pure-loader__container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Logo Stacking for Synchronized Progressive Fill */
      .stagmenfashion-pure-loader__logo-stack {
        position: relative;
        display: inline-block;
        margin-bottom: 22px;
      }

      /* Layer 1: Ghosted Base */
      .stagmenfashion-pure-loader__logo-base {
        display: block;
        height: {{ logo_h }}px;
        width: auto;
        max-width: 80vw;
        object-fit: contain;
        opacity: 0.12;
      }

      /* Layer 2: Filling Active Logo */
      .stagmenfashion-pure-loader__logo-fill {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: block;
        object-fit: contain;
        opacity: 1;
        clip-path: inset(100% 0 0 0);
        transition: clip-path 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: clip-path;
      }

      @media (max-width: 768px) {
        .stagmenfashion-pure-loader__logo-base,
        .stagmenfashion-pure-loader__logo-fill {
          height: {{ logo_h_mob }}px;
        }
      }

      /* Text Fallback */
      .stagmenfashion-pure-loader__text-stack {
        position: relative;
        font-family: var(--font-heading-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
        font-size: 26px;
        font-weight: 600;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        margin-bottom: 22px;
      }

      .stagmenfashion-pure-loader__text-base {
        color: rgba(0, 0, 0, 0.12);
        display: block;
      }

      .stagmenfashion-pure-loader__text-fill {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        color: #111111;
        clip-path: inset(100% 0 0 0);
        transition: clip-path 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* Minimal Hairline Progress Bar */
      .stagmenfashion-pure-loader__track {
        position: relative;
        width: 120px;
        height: 2px;
        background: rgba(0, 0, 0, 0.07);
        border-radius: 99px;
        overflow: hidden;
      }

      .stagmenfashion-pure-loader__fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 0%;
        background: {{ loader_accent }};
        border-radius: 99px;
        transition: width 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: width;
      }

      /* Subtle shimmer shine on active progress tip */
      .stagmenfashion-pure-loader__fill::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 24px;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6));
      }

      /* Dissolve Exit State */
      .stagmenfashion-pure-loader.stagmenfashion-pure-loader--hiding {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }

      .stagmenfashion-pure-loader.stagmenfashion-pure-loader--hiding .stagmenfashion-pure-loader__container {
        transform: scale(1.03) translateY(-4px);
        opacity: 0;
      }

      .stagmenfashion-pure-loader.stagmenfashion-pure-loader--hidden {
        display: none !important;
      }

      @media (prefers-reduced-motion: reduce) {
        .stagmenfashion-pure-loader__logo-fill,
        .stagmenfashion-pure-loader__text-fill,
        .stagmenfashion-pure-loader__fill {
          transition: none !important;
        }
      }
    </style>

    <div class="stagmenfashion-pure-loader__container">
      {%- if loader_logo != blank -%}
        <div class="stagmenfashion-pure-loader__logo-stack">
          <!-- Base Ghosted Silhouette -->
          {{
            loader_logo
            | image_url: width: 320
            | image_tag:
              class: 'stagmenfashion-pure-loader__logo-base',
              alt: shop.name,
              loading: 'eager',
              fetchpriority: 'low'
          }}
          <!-- Synchronized Filling Logo -->
          {{
            loader_logo
            | image_url: width: 320
            | image_tag:
              id: 'stagmenfashion-logo-fill-el',
              class: 'stagmenfashion-pure-loader__logo-fill',
              alt: shop.name,
              loading: 'eager',
              fetchpriority: 'low'
          }}
        </div>
      {%- else -%}
        <div class="stagmenfashion-pure-loader__text-stack">
          <span class="stagmenfashion-pure-loader__text-base">{{ settings.brand_name | default: shop.name }}</span>
          <span id="stagmenfashion-text-fill-el" class="stagmenfashion-pure-loader__text-fill">{{ settings.brand_name | default: shop.name }}</span>
        </div>
      {%- endif -%}

      {%- if show_progress -%}
        <div class="stagmenfashion-pure-loader__track">
          <div id="stagmenfashion-loader-progress-bar" class="stagmenfashion-pure-loader__fill"></div>
        </div>
      {%- endif -%}
    </div>

    <script>
      (function() {
        const loader = document.getElementById('stagmenfashion-page-loader');
        if (!loader) return;

        const isDesignMode = loader.getAttribute('data-design-mode') === 'true';
        const frequency = loader.getAttribute('data-frequency') || 'all';
        const progressBar = document.getElementById('stagmenfashion-loader-progress-bar');
        const logoFill = document.getElementById('stagmenfashion-logo-fill-el');
        const textFill = document.getElementById('stagmenfashion-text-fill-el');

        if (!isDesignMode && frequency === 'once_per_session') {
          if (sessionStorage.getItem('stagmenfashion_loader_shown')) {
            loader.classList.add('stagmenfashion-pure-loader--hidden');
            return;
          }
          sessionStorage.setItem('stagmenfashion_loader_shown', 'true');
        } else if (!isDesignMode && frequency === 'homepage_only') {
          const isHome = window.location.pathname === '/' || window.location.pathname === '{{ routes.root_url }}';
          if (!isHome) {
            loader.classList.add('stagmenfashion-pure-loader--hidden');
            return;
          }
        }

        let progress = 0;
        let isPageLoaded = false;
        let isFinished = false;
        let rafId = null;
        let lastTime = performance.now();

        function setProgress(val) {
          progress = Math.min(100, Math.max(0, val));
          if (progressBar) {
            progressBar.style.width = progress + '%';
          }
          const insetBottom = 100 - progress;
          if (logoFill) {
            logoFill.style.clipPath = 'inset(' + insetBottom + '% 0 0 0)';
          }
          if (textFill) {
            textFill.style.clipPath = 'inset(' + insetBottom + '% 0 0 0)';
          }
        }

        function tick(time) {
          if (isFinished) return;
          const delta = time - lastTime;
          if (delta > 32) {
            lastTime = time;
            if (!isPageLoaded && progress < 85) {
              progress += Math.floor(Math.random() * 5) + 2;
              if (progress > 85) progress = 85;
              setProgress(progress);
            }
          }
          if (!isFinished && !isPageLoaded) {
            rafId = requestAnimationFrame(tick);
          }
        }
        rafId = requestAnimationFrame(tick);

        function completeProgress() {
          if (isFinished) return;
          isPageLoaded = true;
          if (rafId) cancelAnimationFrame(rafId);

          let finishRaf = null;
          function completeTick() {
            if (progress < 100) {
              progress += 10;
              if (progress >= 100) {
                progress = 100;
                setProgress(100);
                setTimeout(dismissLoader, 100);
                return;
              }
              setProgress(progress);
              finishRaf = requestAnimationFrame(completeTick);
            }
          }
          finishRaf = requestAnimationFrame(completeTick);
        }

        function dismissLoader() {
          if (isFinished) return;
          isFinished = true;
          loader.classList.add('stagmenfashion-pure-loader--hiding');
          setTimeout(function() {
            loader.classList.add('stagmenfashion-pure-loader--hidden');
          }, 500);
        }

        if (document.readyState === 'interactive' || document.readyState === 'complete') {
          completeProgress();
        } else {
          document.addEventListener('DOMContentLoaded', completeProgress, { once: true });
          window.addEventListener('load', completeProgress, { once: true });
        }

        // Fast fallback timeout (650ms max)
        setTimeout(function() {
          if (!isFinished) {
            completeProgress();
          }
        }, 650);

        // Theme Customizer support
        if (isDesignMode) {
          document.addEventListener('shopify:section:select', function() {
            loader.classList.add('stagmenfashion-pure-loader--hidden');
          });
        }
      })();
    </script>
  </div>
{%- endif -%}
