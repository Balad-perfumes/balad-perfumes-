{%- doc -%}
  Product card: white frame, rounded image panel with wishlist, "Buy now" + price dock, and a grey info panel.
  Styles live in assets/balad-product-card.css (load it once per section).
  Keeps the existing JS hooks: data-carousel, data-carousel-slide,
  data-wishlist-heart and data-quick-add (+ data-qa-* / data-product-*).

  @param {object} product - The product
  @param {number} [limit] - Max images in the hover/swipe carousel (default 6)
  @param {boolean} [eager] - Load the first image eagerly
  @param {boolean} [badge_first] - Show the "Selling fast" badge on this card
  @param {boolean} [show_rating] - Show the rating next to the subtitle (default true)
  @param {boolean} [show_buy_now] - Show the "Buy now" button on the image (default true). Pass false to hide it
  @param {boolean} [direct_add] - "Buy now" adds the first variant straight to the cart (data-similar-add) instead of opening quick-add
  @param {boolean} [skeleton] - Render a placeholder skeleton loading card
{%- enddoc -%}

{%- if product == blank or skeleton == true -%}
  {% render 'balad-product-card-skeleton', show_buy_now: show_buy_now %}
{%- else -%}

{%- liquid
  assign images = product.images
  assign image_count = images.size
  assign first_image = product.featured_image | default: images.first
  assign img_limit = limit | default: 6
  assign variant = product.selected_or_first_available_variant

  assign sizes_list = ''
  assign size_idx = 0
  assign has_size_option = false
  for opt in product.options_with_values
    assign opt_name_down = opt.name | downcase
    if opt_name_down contains 'size'
      assign has_size_option = true
      assign sizes_list = opt.values | join: ','
      assign size_idx = forloop.index0
    endif
  endfor
  if has_size_option == false
    assign sizes_check = '|'
    for v in product.variants
      assign sz = v.option1 | strip
      unless sz == blank or sz == 'Default Title'
        assign check_sz = '|' | append: sz | append: '|'
        unless sizes_check contains check_sz
          assign sizes_check = sizes_check | append: check_sz
          if sizes_list != ''
            assign sizes_list = sizes_list | append: ','
          endif
          assign sizes_list = sizes_list | append: sz
        endunless
      endunless
    endfor
  endif

  assign size_label = variant.options[size_idx] | strip
  if size_label == 'Default Title'
    assign size_label = ''
  endif

  assign card_price = variant.price
  assign card_compare = variant.compare_at_price
  assign off_pct = 0
  if card_compare > card_price
    assign off_pct = card_compare | minus: card_price | times: 100.0 | divided_by: card_compare | round
  endif

  assign subtitle = product.type | default: product.vendor

  assign rating = 0
  assign rating_count = 0
  if product.metafields.reviews.rating.value != blank
    assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | plus: 0
  endif
  if product.metafields.reviews.rating_count != blank
    assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
  endif
  assign jm_badge = product.metafields.judgeme.badge | default: ''
  if jm_badge != blank
    assign jm_badge_q = jm_badge | replace: '"', "'"
    if jm_badge_q contains "data-average-rating='"
      assign jm_r = jm_badge_q | split: "data-average-rating='" | last | split: "'" | first | plus: 0
      if jm_r > 0
        assign rating = jm_r
      endif
    endif
    if jm_badge_q contains "data-number-of-reviews='"
      assign jm_c = jm_badge_q | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
      if jm_c > 0
        assign rating_count = jm_c
      endif
    endif
  endif
  if rating == 0 and product.metafields.judgeme.rating != blank
    assign rating = product.metafields.judgeme.rating | plus: 0
  endif
  if rating_count == 0 and product.metafields.judgeme.review_count != blank
    assign rating_count = product.metafields.judgeme.review_count | plus: 0
  endif
  assign has_reviews = false
  if rating > 0 and show_rating != false
    assign has_reviews = true
  endif

  assign qa_variants = ''
  assign qa_availability = ''
  for v in product.variants
    unless v.option1 == 'Default Title'
      assign qa_variants = qa_variants | append: v.option1 | append: ':' | append: v.id | append: ','
      assign qa_availability = qa_availability | append: v.option1 | append: ':' | append: v.available | append: ','
    endunless
  endfor
-%}

<article class="bpc">
  <a href="{{ product.url }}" class="bpc__media" data-carousel>
    <div class="bpc__skeleton" aria-hidden="true"></div>
    {%- if image_count > 0 -%}
      {%- for image in images limit: img_limit -%}
        <img
          class="bpc__image{% if forloop.first %} is-active{% endif %}"
          src="{{ image | image_url: width: 600 }}"
          srcset="{{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 600 }} 600w"
          sizes="(max-width: 749px) 50vw, (max-width: 1200px) 33vw, 25vw"
          alt="{{ image.alt | default: product.title | escape }}"
          width="600"
          height="750"
          loading="{% if eager and forloop.first %}eager{% else %}lazy{% endif %}"
          decoding="async"
          onload="this.classList.add('is-loaded'); this.closest('.bpc__media')?.classList.add('is-loaded');"
          data-carousel-slide
        >
      {%- endfor -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'bpc__placeholder' }}
    {%- endif -%}

    {%- liquid
      assign dot_count = image_count
      if dot_count > img_limit
        assign dot_count = img_limit
      endif
    -%}
    {%- if dot_count > 1 -%}
      <div class="bpc__dots{% unless show_buy_now == false %} bpc__dots--lifted{% endunless %}" aria-hidden="true">
        {%- for i in (1..dot_count) -%}
          <span class="bpc__dot{% if forloop.first %} is-active{% endif %}" data-carousel-dot data-index="{{ forloop.index0 }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="bpc__badges">
      {%- if product.available == false -%}
        <span class="bpc__badge bpc__badge--sold">Sold out</span>
      {%- elsif badge_first or product.tags contains 'selling-fast' or product.tags contains 'bestseller' -%}
        <span class="bpc__badge">Selling fast</span>
      {%- endif -%}
      {%- if off_pct > 0 -%}
        <span class="bpc__badge">-{{ off_pct }}%</span>
      {%- endif -%}
    </div>

    <button
      type="button"
      class="bpc__wish"
      data-wishlist-heart
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-price="{{ product.price | money_without_currency | remove: ',' }}"
      data-product-compare-price="{{ product.compare_at_price | money_without_currency | remove: ',' }}"
      data-product-url="{{ product.url }}"
      data-product-image="{{ first_image | image_url: width: 400 }}"
      data-product-sizes="{{ sizes_list }}"
      data-product-available="{{ product.available }}"
      aria-label="Add {{ product.title | escape }} to wishlist"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
    </button>


    {%- unless show_buy_now == false -%}
    <div class="bpc__dock">
      <button
        type="button"
        class="bpc__buy"
        {%- if direct_add %}
        data-similar-add
        data-variant-id="{{ variant.id }}"
        aria-label="Add {{ product.title | escape }} to cart"
        {%- unless product.available %} disabled{% endunless %}
        {%- else %}
        data-quick-add
        data-qa-title="{{ product.title | escape }}"
        data-qa-price="{{ product.price | money_without_currency | remove: ',' }}"
        data-qa-compare-price="{{ card_compare | money_without_currency | remove: ',' }}"
        data-qa-url="{{ product.url }}"
        data-qa-id="{{ product.id }}"
        data-qa-image="{{ first_image | image_url: width: 400 }}"
        data-qa-sizes="{{ sizes_list }}"
        data-qa-first-variant="{{ variant.id }}"
        data-qa-variants="{{ qa_variants }}"
        data-qa-available="{{ product.available }}"
        data-qa-variant-availability="{{ qa_availability }}"
        aria-label="{% if product.available %}Buy{% else %}View{% endif %} {{ product.title | escape }}"
        {%- endif %}
      >
        <span class="bpc__buy-label">{% if product.available %}Buy now{% else %}Sold out{% endif %}</span>
        <span class="bpc__buy-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </span>
      </button>
    </div>
    {%- endunless -%}
  </a>

  <div class="bpc__info">
    {%- if subtitle != blank or size_label != blank -%}
      <span class="bpc__meta">
        {%- if subtitle != blank -%}<span class="bpc__meta-type">{{ subtitle | escape }}</span>{%- endif -%}
        {%- if subtitle != blank and size_label != blank -%}<span class="bpc__meta-dot" aria-hidden="true"></span>{%- endif -%}
        {%- if size_label != blank -%}<span class="bpc__meta-size">{{ size_label | escape }}</span>{%- endif -%}
      </span>
    {%- endif -%}
    <a href="{{ product.url }}" class="bpc__title" title="{{ product.title | escape }}">
      {{ product.title | escape }}
    </a>
    <span class="bpc__divider" aria-hidden="true"></span>
    <button
      type="button"
      class="bpc__plus bpc__quick-view"
      data-quick-add
      data-qa-title="{{ product.title | escape }}"
      data-qa-price="{{ product.price | money_without_currency | remove: ',' }}"
      data-qa-compare-price="{{ card_compare | money_without_currency | remove: ',' }}"
      data-qa-url="{{ product.url }}"
      data-qa-id="{{ product.id }}"
      data-qa-image="{{ first_image | image_url: width: 400 }}"
      data-qa-sizes="{{ sizes_list }}"
      data-qa-first-variant="{{ variant.id }}"
      data-qa-variants="{{ qa_variants }}"
      data-qa-available="{{ product.available }}"
      data-qa-variant-availability="{{ qa_availability }}"
      aria-label="Quick view {{ product.title | escape }}"
      title="Quick view"
    >
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
    <a href="{{ product.url }}" class="bpc__price-alt">
      <span class="bpc__price-now">{% render 'format-price', price: card_price %}</span>
      {%- if off_pct > 0 -%}
        <span class="bpc__price-was">
          <s>{% render 'format-price', price: card_compare %}</s>
          <span class="bpc__price-off">{{ off_pct }}% off</span>
        </span>
      {%- endif -%}
    </a>
  </div>
</article>
{%- endif -%}

<script>
  if (!window.__bpcInit) {
    window.__bpcInit = true;
    (function () {
      function markBpcLoaded(scope) {
        (scope || document).querySelectorAll('.bpc__image').forEach(function (img) {
          if (img.complete && img.naturalWidth > 0) {
            img.classList.add('is-loaded');
            var m = img.closest('.bpc__media');
            if (m) m.classList.add('is-loaded');
          }
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { markBpcLoaded(); });
      } else {
        markBpcLoaded();
      }
      document.addEventListener('shopify:section:load', function (e) { markBpcLoaded(e.target); });

      var qaSelectedSize = null;
      var qaProductUrl = '';

      function getOrCreateQAModal() {
        var modal = document.querySelector('[data-qa-modal]');
        if (!modal) {
          modal = document.createElement('div');
          modal.className = 'balad-qa-modal';
          modal.setAttribute('data-qa-modal', '');
          modal.style.display = 'none';
          modal.setAttribute('hidden', '');
          modal.innerHTML = ''
            + '<div class="balad-qa-modal__backdrop" data-qa-close></div>'
            + '<div class="balad-qa-modal__card">'
            + '  <button type="button" class="balad-qa-modal__close" data-qa-close aria-label="Close">'
            + '    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
            + '      <line x1="18" y1="6" x2="6" y2="18"></line>'
            + '      <line x1="6" y1="6" x2="18" y2="18"></line>'
            + '    </svg>'
            + '  </button>'
            + '  <div class="balad-qa-modal__header">'
            + '    <div class="balad-qa-modal__product-img" data-qa-img></div>'
            + '    <div class="balad-qa-modal__product-info">'
            + '      <span class="balad-qa-modal__eyebrow">Quick View</span>'
            + '      <h3 class="balad-qa-modal__title" data-qa-title></h3>'
            + '      <div class="balad-qa-modal__price-wrap">'
            + '        <span class="balad-qa-modal__price" data-qa-price></span>'
            + '        <span class="balad-qa-modal__compare-price" data-qa-compare-price></span>'
            + '      </div>'
            + '    </div>'
            + '  </div>'
            + '  <div class="balad-qa-modal__sizes">'
            + '    <div class="balad-qa-modal__sizes-top">'
            + '      <span class="balad-qa-modal__label">Size</span>'
            + '    </div>'
            + '    <div class="balad-qa-modal__size-grid" data-qa-sizes></div>'
            + '  </div>'
            + '  <div class="balad-qa-modal__actions" data-qa-actions>'
            + '    <button type="button" class="balad-qa-modal__btn balad-qa-modal__btn--bag" data-qa-add-bag>Add To Bag</button>'
            + '    <button type="button" class="balad-qa-modal__btn balad-qa-modal__btn--buy" data-qa-buy-now>Buy Now</button>'
            + '  </div>'
            + '  <div class="balad-qa-modal__sold-out" data-qa-sold-out style="display:none;">'
            + '    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">'
            + '      <circle cx="12" cy="12" r="10"></circle>'
            + '      <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>'
            + '    </svg>'
            + '    <span>Sold Out</span>'
            + '  </div>'
            + '</div>';
          document.body.appendChild(modal);
        }
        bindModalEvents(modal);
        return modal;
      }

      function closeQAModal() {
        var modal = document.querySelector('[data-qa-modal]');
        if (!modal) return;
        modal.classList.remove('is-open');
        setTimeout(function () {
          if (!modal.classList.contains('is-open')) {
            modal.style.display = 'none';
            modal.setAttribute('hidden', '');
          }
        }, 220);
        document.body.style.overflow = '';
      }

      function resolveVariantId(modal) {
        var variantsData = modal && modal.dataset ? modal.dataset.qaVariants : '';
        var firstVariant = modal && modal.dataset ? modal.dataset.qaFirstVariant : '';
        var variantId = '';
        if (variantsData && qaSelectedSize) {
          var pairs = variantsData.split(',');
          for (var i = 0; i < pairs.length; i++) {
            if (!pairs[i]) continue;
            var parts = pairs[i].split(':');
            var name = parts[0];
            var id = parts[1];
            if (name && id && name.trim() === qaSelectedSize.trim()) {
              variantId = id.trim();
              break;
            }
          }
        }
        if (!variantId && firstVariant) variantId = firstVariant;
        return variantId;
      }

      async function addToCartAndRedirect(variantId, shouldRedirect) {
        if (!variantId) return;
        try {
          var cartAddUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root)
            ? window.Shopify.routes.root + 'cart/add.js'
            : '/cart/add.js';
          var res = await fetch(cartAddUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }] })
          });
          if (!res.ok) throw new Error('Add to cart failed');
          if (shouldRedirect) {
            window.location.href = '/checkout';
            return;
          }
          closeQAModal();
          if (window.pfOpenCart) { window.pfOpenCart('quick-add'); } else { window.location.href = '/cart'; }
        } catch (err) {
          console.error('Add to cart error:', err);
          if (qaProductUrl) window.location.href = qaProductUrl;
        }
      }

      function bindModalEvents(modal) {
        if (!modal || modal.dataset.qaEventsBound === 'true') return;
        modal.dataset.qaEventsBound = 'true';

        modal.querySelectorAll('[data-qa-close]').forEach(function (el) {
          el.addEventListener('click', closeQAModal);
        });

        var bagBtn = modal.querySelector('[data-qa-add-bag]');
        if (bagBtn) {
          bagBtn.addEventListener('click', function () {
            var vId = resolveVariantId(modal);
            addToCartAndRedirect(vId, false);
          });
        }

        var buyBtn = modal.querySelector('[data-qa-buy-now]');
        if (buyBtn) {
          buyBtn.addEventListener('click', function () {
            var vId = resolveVariantId(modal);
            addToCartAndRedirect(vId, true);
          });
        }
      }

      function openQAModal(btn) {
        var modal = getOrCreateQAModal();
        if (!modal) return;

        var titleEl = modal.querySelector('[data-qa-title]');
        var priceEl = modal.querySelector('[data-qa-price]');
        var compareEl = modal.querySelector('[data-qa-compare-price]');
        var imgEl = modal.querySelector('[data-qa-img]');
        var sizesEl = modal.querySelector('[data-qa-sizes]');
        var actionsEl = modal.querySelector('[data-qa-actions]');
        var soldOutEl = modal.querySelector('[data-qa-sold-out]');

        var title = btn.dataset.qaTitle || '';
        var price = btn.dataset.qaPrice || '0';
        var comparePrice = btn.dataset.qaComparePrice || '';
        qaProductUrl = btn.dataset.qaUrl || '';
        var image = btn.dataset.qaImage || '';
        var sizesRaw = btn.dataset.qaSizes || '';
        var firstVariant = btn.dataset.qaFirstVariant || '';
        var variantsData = btn.dataset.qaVariants || '';
        var isAvailable = btn.dataset.qaAvailable === 'true';
        var presetSize = btn.dataset.qaSelectedSize || null;

        modal.dataset.qaFirstVariant = firstVariant;
        modal.dataset.qaVariants = variantsData;

        if (titleEl) {
          if (qaProductUrl) {
            titleEl.innerHTML = '<a href="' + qaProductUrl + '" style="color:inherit;text-decoration:none;">' + title.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</a>';
          } else {
            titleEl.textContent = title;
          }
        }
        if (priceEl) priceEl.textContent = '₹' + Number(price || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 });
        if (compareEl) {
          if (comparePrice && Number(comparePrice) > Number(price)) {
            compareEl.textContent = '₹' + Number(comparePrice).toLocaleString('en-IN', { maximumFractionDigits: 0 });
            compareEl.style.display = 'inline';
          } else {
            compareEl.textContent = '';
            compareEl.style.display = 'none';
          }
        }

        if (imgEl) {
          if (image) {
            imgEl.innerHTML = '<img src="' + image + '" alt="' + title.replace(/"/g, '&quot;') + '" />';
            imgEl.style.display = 'block';
          } else {
            imgEl.innerHTML = '';
            imgEl.style.display = 'none';
          }
        }

        var sizes = sizesRaw.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        qaSelectedSize = presetSize || (sizes.length > 0 ? sizes[0] : null);

        if (sizesEl) {
          if (sizes.length > 0) {
            if (sizesEl.parentElement) sizesEl.parentElement.style.display = 'block';
            sizesEl.innerHTML = sizes.map(function (sz) {
              var isSel = (sz === qaSelectedSize) ? ' is-selected' : '';
              return '<button type="button" class="balad-qa-modal__size' + isSel + '" data-qa-size-btn data-size="' + sz + '">' + sz + '</button>';
            }).join('');

            sizesEl.querySelectorAll('[data-qa-size-btn]').forEach(function (sb) {
              sb.addEventListener('click', function () {
                sizesEl.querySelectorAll('[data-qa-size-btn]').forEach(function (b) { b.classList.remove('is-selected'); });
                sb.classList.add('is-selected');
                qaSelectedSize = sb.dataset.size;
              });
            });
          } else {
            if (sizesEl.parentElement) sizesEl.parentElement.style.display = 'none';
          }
        }

        if (!isAvailable) {
          if (actionsEl) actionsEl.style.display = 'none';
          if (soldOutEl) soldOutEl.style.display = 'flex';
        } else {
          if (actionsEl) actionsEl.style.display = 'grid';
          if (soldOutEl) soldOutEl.style.display = 'none';
        }

        modal.style.display = 'flex';
        modal.removeAttribute('hidden');
        requestAnimationFrame(function () { modal.classList.add('is-open'); });
        document.body.style.overflow = 'hidden';
      }

      window.__openBaladQAModal = openQAModal;

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-quick-add]');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        openQAModal(btn);
      });
    })();
  }
</script>
