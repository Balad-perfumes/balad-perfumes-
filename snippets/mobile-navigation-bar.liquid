{% liquid
  assign enable_mobile_nav = true
  if section.settings.enable_mobile_nav == false
    assign enable_mobile_nav = false
  endif

  assign nav_style = section.settings.mobile_nav_style | default: 'modern_glass'

  assign show_home = true
  if section.settings.mobile_nav_show_home == false
    assign show_home = false
  endif

  assign show_shop_all = true
  if section.settings.mobile_nav_show_shop_all == false
    assign show_shop_all = false
  endif

  assign show_collections = true
  if section.settings.mobile_nav_show_collections == false
    assign show_collections = false
  endif

  assign show_about = true
  if section.settings.mobile_nav_show_about == false
    assign show_about = false
  endif

  assign show_contact = true
  if section.settings.mobile_nav_show_contact == false
    assign show_contact = false
  endif

  assign show_account = false
  if section.settings.mobile_nav_show_account == true
    assign show_account = true
  endif

  assign home_url = routes.root_url

  assign shop_all_url = section.settings.mobile_nav_shop_all_url
  if shop_all_url == blank
    assign shop_all_url = routes.all_products_collection_url
  endif
  if shop_all_url == blank
    assign shop_all_url = '/collections/all'
  endif

  assign collections_url = section.settings.mobile_nav_collections_url
  if collections_url == blank
    assign collections_url = routes.collections_url
  endif
  if collections_url == blank
    assign collections_url = '/collections'
  endif

  assign about_url = section.settings.mobile_nav_about_url
  if about_url == blank and section.settings.menu != blank
    for navigation_link in section.settings.menu.links
      assign navigation_title = navigation_link.title | downcase
      assign navigation_url = navigation_link.url | downcase
      if navigation_title contains 'about' or navigation_url contains '/pages/about'
        assign about_url = navigation_link.url
        break
      endif
    endfor
  endif
  assign about_url = about_url | default: '/pages/about'

  assign contact_url = section.settings.mobile_nav_contact_url
  if contact_url == blank and section.settings.menu != blank
    for navigation_link in section.settings.menu.links
      assign navigation_title = navigation_link.title | downcase
      assign navigation_url = navigation_link.url | downcase
      if navigation_title contains 'contact' or navigation_url contains '/pages/contact'
        assign contact_url = navigation_link.url
        break
      endif
    endfor
  endif
  assign contact_url = contact_url | default: '/pages/contact'

  if customer
    assign account_url = routes.account_url
  else
    assign account_url = routes.account_login_url
  endif

  assign current_path = request.path | downcase
  assign shop_all_path = shop_all_url | split: '?' | first | downcase
  assign collections_path = collections_url | split: '?' | first | downcase
  assign about_path = about_url | split: '?' | first | downcase
  assign contact_path = contact_url | split: '?' | first | downcase

  assign is_home_active = false
  assign is_shop_all_active = false
  assign is_col_active = false
  assign is_about_active = false
  assign is_contact_active = false
  assign is_account_active = false

  if template.name == 'index'
    assign is_home_active = true
  elsif current_path == shop_all_path or template.name == 'collection' and collection.handle == 'all'
    assign is_shop_all_active = true
  elsif template.name == 'collection' or template.name == 'list-collections' or current_path contains '/collections'
    assign is_col_active = true
  elsif current_path contains about_path or template.suffix == 'about'
    assign is_about_active = true
  elsif current_path contains contact_path or template.suffix == 'contact'
    assign is_contact_active = true
  elsif template.name contains 'account' or template.name contains 'order' or template.name contains 'login' or template.name contains 'register' or current_path contains '/account'
    assign is_account_active = true
  endif
%}

{% if enable_mobile_nav and template.name != 'product' %}
  <nav
    class="balad-mobile-nav balad-mobile-nav--{{ nav_style }}"
    id="balad-mobile-nav"
    aria-label="Mobile Navigation"
    data-balad-mobile-nav
  >
    <div class="balad-mobile-nav__bar">
      <!-- 1. Home -->
      {% if show_home %}
        <a
          href="{{ home_url }}"
          class="balad-mobile-nav__tab{% if is_home_active %} is-active{% endif %}"
          aria-label="{{ section.settings.mobile_nav_home_label | default: 'Home' }}"
          {% if is_home_active %}aria-current="page"{% endif %}
        >
          <span class="balad-mobile-nav__icon-wrap">
            <svg class="balad-mobile-nav__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9.5L12 3l9 6.5V20a1.5 1.5 0 0 1-1.5 1.5h-4.5v-6a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v6H4.5A1.5 1.5 0 0 1 3 20V9.5z"/>
            </svg>
          </span>
          <span class="balad-mobile-nav__title">{{ section.settings.mobile_nav_home_label | default: 'Home' }}</span>
        </a>
      {% endif %}

      <!-- 2. Shop All -->
      {% if show_shop_all %}
        <a
          href="{{ shop_all_url }}"
          class="balad-mobile-nav__tab{% if is_shop_all_active %} is-active{% endif %}"
          aria-label="{{ section.settings.mobile_nav_shop_all_label | default: 'Shop All' }}"
          {% if is_shop_all_active %}aria-current="page"{% endif %}
        >
          <span class="balad-mobile-nav__icon-wrap">
            <svg class="balad-mobile-nav__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 11V7a4 4 0 0 0-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </span>
          <span class="balad-mobile-nav__title">{{ section.settings.mobile_nav_shop_all_label | default: 'Shop All' }}</span>
        </a>
      {% endif %}

      <!-- 3. Collection -->
      {% if show_collections %}
        <a
          href="{{ collections_url }}"
          class="balad-mobile-nav__tab{% if is_col_active %} is-active{% endif %}"
          aria-label="{{ section.settings.mobile_nav_collections_label | default: 'Collection' }}"
          {% if is_col_active %}aria-current="page"{% endif %}
        >
          <span class="balad-mobile-nav__icon-wrap">
            <svg class="balad-mobile-nav__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3.5" y="3.5" width="7" height="7" rx="1.8"/>
              <rect x="13.5" y="3.5" width="7" height="7" rx="1.8"/>
              <rect x="13.5" y="13.5" width="7" height="7" rx="1.8"/>
              <rect x="3.5" y="13.5" width="7" height="7" rx="1.8"/>
            </svg>
          </span>
          <span class="balad-mobile-nav__title">{{ section.settings.mobile_nav_collections_label | default: 'Collection' }}</span>
        </a>
      {% endif %}

      <!-- 4. About -->
      {% if show_about %}
        <a
          href="{{ about_url }}"
          class="balad-mobile-nav__tab{% if is_about_active %} is-active{% endif %}"
          aria-label="{{ section.settings.mobile_nav_about_label | default: 'About' }}"
          {% if is_about_active %}aria-current="page"{% endif %}
        >
          <span class="balad-mobile-nav__icon-wrap">
            <svg class="balad-mobile-nav__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2.5l2.2 6.3 6.3 2.2-6.3 2.2L12 19.5l-2.2-6.3L3.5 11l6.3-2.2L12 2.5z"/>
            </svg>
          </span>
          <span class="balad-mobile-nav__title">{{ section.settings.mobile_nav_about_label | default: 'About' }}</span>
        </a>
      {% endif %}

      <!-- 5. Contact -->
      {% if show_contact %}
        <a
          href="{{ contact_url }}"
          class="balad-mobile-nav__tab{% if is_contact_active %} is-active{% endif %}"
          aria-label="{{ section.settings.mobile_nav_contact_label | default: 'Contact' }}"
          {% if is_contact_active %}aria-current="page"{% endif %}
        >
          <span class="balad-mobile-nav__icon-wrap">
            <svg class="balad-mobile-nav__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </span>
          <span class="balad-mobile-nav__title">{{ section.settings.mobile_nav_contact_label | default: 'Contact' }}</span>
        </a>
      {% endif %}

      <!-- 6. Account (Optional) -->
      {% if show_account %}
        <a
          href="{{ account_url }}"
          class="balad-mobile-nav__tab{% if is_account_active %} is-active{% endif %}"
          aria-label="{{ section.settings.mobile_nav_account_label | default: 'Account' }}"
          {% if is_account_active %}aria-current="page"{% endif %}
        >
          <span class="balad-mobile-nav__icon-wrap">
            <svg class="balad-mobile-nav__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="7.5" r="4"/>
              <path d="M4.5 20c0-4 3.5-6.5 7.5-6.5s7.5 2.5 7.5 6.5"/>
            </svg>
          </span>
          <span class="balad-mobile-nav__title">{{ section.settings.mobile_nav_account_label | default: 'Account' }}</span>
        </a>
      {% endif %}
    </div>
  </nav>

  <style>
    /* ==========================================================================
       BALAD LUXURY NAVIGATION BAR (MOBILE & TABLET)
       Full width, attached to the bottom edge, rounded on the top corners only.
       ========================================================================== */
    .balad-mobile-nav {
      display: none;
      position: fixed !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      top: auto !important;
      transform: translateY(0);
      width: 100%;
      z-index: 999999 !important;
      user-select: none;
      -webkit-user-select: none;
      pointer-events: none;
      opacity: 1;
      /* Only animate transform here: opacity below 1 or will-change: opacity on this
         wrapper stops the bar's backdrop-filter from blurring the page behind it. */
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    /* Scroll Hide State - Smoothly Slides Down into Screen Edge */
    .balad-mobile-nav[data-hidden="true"] {
      transform: translateY(calc(100% + 16px)) !important;
      pointer-events: none !important;
    }

    /* Hide when a drawer or modal is open. Every modal/drawer locks page scroll with
       body/html style="overflow: hidden", so match that instead of html:has(...):
       :has() on <html> makes the browser restyle the whole page whenever any
       is-open / is-active / hidden changes anywhere (carousels do that constantly). */
    body.pf-drawer-open .balad-mobile-nav,
    body.story-modal-open .balad-mobile-nav,
    body[style*="overflow: hidden"] .balad-mobile-nav,
    html[style*="overflow: hidden"] .balad-mobile-nav {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }

    /* Base Bar Layout (Dynamic Column Distribution) */
    .balad-mobile-nav__bar {
      pointer-events: auto;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      align-items: center;
      justify-items: stretch;
      width: 100%;
      min-height: 56px;
      padding: 5px 6px calc(5px + env(safe-area-inset-bottom, 0px));
      box-sizing: border-box;
      position: relative;
    }

    /* Common Tab Structure */
    .balad-mobile-nav__tab {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      padding: 6px 2px 5px;
      border-radius: 9999px;
      text-decoration: none;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      min-width: 0;
      width: 100%;
      text-align: center;
      transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, transform 0.15s ease;
    }

    .balad-mobile-nav__icon-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      margin: 0 auto;
      position: relative;
    }

    .balad-mobile-nav__svg {
      width: 20px;
      height: 20px;
      stroke-width: 1.8;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), stroke-width 0.2s ease;
    }

    .balad-mobile-nav__title {
      font-size: 9.5px;
      font-weight: 500;
      letter-spacing: 0.01em;
      line-height: 1.1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
      text-align: center;
      transition: color 0.2s ease, font-weight 0.2s ease;
    }

    /* -------------------------------------------------------------
       1. Style: modern_glass (Signature Luxury Frosted Bar)
       ------------------------------------------------------------- */
    .balad-mobile-nav--modern_glass .balad-mobile-nav__bar {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.55);
      border-bottom: 0;
      border-radius: 20px 20px 0 0;
      box-shadow:
        0 -8px 24px -6px rgba(0, 0, 0, 0.1),
        0 -2px 8px rgba(0, 0, 0, 0.04),
        inset 0 1px 1.5px rgba(255, 255, 255, 0.95);
    }

    .balad-mobile-nav--modern_glass .balad-mobile-nav__tab {
      color: #3f3f46;
    }

    .balad-mobile-nav--modern_glass .balad-mobile-nav__tab:active {
      transform: scale(0.92);
      background-color: rgba(17, 17, 17, 0.05);
    }

    .balad-mobile-nav--modern_glass .balad-mobile-nav__tab.is-active {
      color: #111111;
    }

    .balad-mobile-nav--modern_glass .balad-mobile-nav__tab.is-active .balad-mobile-nav__svg {
      stroke: #111111;
      stroke-width: 2.2;
      transform: translateY(-1px);
    }

    .balad-mobile-nav--modern_glass .balad-mobile-nav__tab.is-active .balad-mobile-nav__title {
      color: #111111;
      font-weight: 650;
    }

    /* -------------------------------------------------------------
       2. Style: dark_luxury (Dark Obsidian Bar)
       ------------------------------------------------------------- */
    .balad-mobile-nav--dark_luxury .balad-mobile-nav__bar {
      background: rgba(18, 18, 18, 0.62);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-bottom: 0;
      border-radius: 20px 20px 0 0;
      box-shadow:
        0 -10px 28px -8px rgba(0, 0, 0, 0.45),
        0 -3px 10px rgba(0, 0, 0, 0.25),
        inset 0 1px 1px rgba(255, 255, 255, 0.22);
    }

    .balad-mobile-nav--dark_luxury .balad-mobile-nav__tab {
      color: rgba(255, 255, 255, 0.65);
    }

    .balad-mobile-nav--dark_luxury .balad-mobile-nav__tab:active {
      transform: scale(0.92);
      background-color: rgba(255, 255, 255, 0.08);
    }

    .balad-mobile-nav--dark_luxury .balad-mobile-nav__tab.is-active {
      color: #ffffff;
    }

    .balad-mobile-nav--dark_luxury .balad-mobile-nav__tab.is-active .balad-mobile-nav__svg {
      stroke: #ffffff;
      stroke-width: 2.2;
      transform: translateY(-1px);
    }

    .balad-mobile-nav--dark_luxury .balad-mobile-nav__tab.is-active .balad-mobile-nav__title {
      color: #ffffff;
      font-weight: 650;
    }

    /* -------------------------------------------------------------
       3. Style: floating_light (Clean Frosted Crisp Bar)
       ------------------------------------------------------------- */
    .balad-mobile-nav--floating_light .balad-mobile-nav__bar {
      background: rgba(255, 255, 255, 0.68);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-bottom: 0;
      border-radius: 20px 20px 0 0;
      box-shadow:
        0 -8px 24px -6px rgba(0, 0, 0, 0.12),
        0 -2px 8px rgba(0, 0, 0, 0.04),
        inset 0 1px 2px rgba(255, 255, 255, 1);
    }

    .balad-mobile-nav--floating_light .balad-mobile-nav__tab {
      color: rgba(17, 17, 17, 0.78);
    }

    .balad-mobile-nav--floating_light .balad-mobile-nav__tab:active {
      transform: scale(0.92);
      background-color: rgba(17, 17, 17, 0.05);
    }

    .balad-mobile-nav--floating_light .balad-mobile-nav__tab.is-active {
      color: #111111;
    }

    .balad-mobile-nav--floating_light .balad-mobile-nav__tab.is-active .balad-mobile-nav__svg {
      stroke: #111111;
      stroke-width: 2.2;
      transform: translateY(-1px);
    }

    .balad-mobile-nav--floating_light .balad-mobile-nav__tab.is-active .balad-mobile-nav__title {
      color: #111111;
      font-weight: 650;
    }

    /* -------------------------------------------------------------
       RESPONSIVE RULES (Mobile & Tablet: screens <= 1024px)
       ------------------------------------------------------------- */
    @media screen and (max-width: 1024px) {
      .balad-mobile-nav {
        display: block;
      }

      .balad-footer {
        padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px)) !important;
      }
    }

    /* Floating WhatsApp Button Clearance */
    @media screen and (max-width: 1024px) {
      .floating-whatsapp-button {
        bottom: calc(var(--floating-whatsapp-bottom, 16px) + 74px + env(safe-area-inset-bottom, 0px)) !important;
      }
    }
  </style>

  <script>
    (() => {
      const nav = document.getElementById('balad-mobile-nav');
      if (!nav) return;

      // Teleport nav directly to document.body so that header/parent backdrop-filter or transform cannot trap it
      if (nav.parentElement !== document.body) {
        document.body.appendChild(nav);
      }

      // Read lazily on the first scroll: reading scrollY right after the appendChild above forced a layout during load
      let lastScrollY = null;
      let ticking = false;
      const scrollThreshold = 14;

      const setNavHidden = (hidden) => {
        if (hidden) {
          nav.setAttribute('data-hidden', 'true');
          document.body.setAttribute('data-mobile-nav-hidden', 'true');
          window.dispatchEvent(new CustomEvent('mobilenav:toggle', { detail: { hidden: true } }));
        } else {
          nav.removeAttribute('data-hidden');
          document.body.removeAttribute('data-mobile-nav-hidden');
          window.dispatchEvent(new CustomEvent('mobilenav:toggle', { detail: { hidden: false } }));
        }
      };

      const onScroll = () => {
        const currentScrollY = window.scrollY;
        if (lastScrollY === null) lastScrollY = currentScrollY;
        const delta = currentScrollY - lastScrollY;
        const isNearBottom = (window.innerHeight + currentScrollY) >= (document.documentElement.scrollHeight - 60);

        if (isNearBottom || currentScrollY <= 60 || delta < -8) {
          setNavHidden(false);
        } else if (delta > scrollThreshold && currentScrollY > 120) {
          setNavHidden(true);
        }

        lastScrollY = currentScrollY;
        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      }, { passive: true });
    })();
  </script>
{% endif %}
