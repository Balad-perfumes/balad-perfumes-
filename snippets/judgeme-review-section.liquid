{% liquid
  assign reviews_heading = reviews_heading | default: 'Customer Reviews'
  assign reviews_note = reviews_note | default: blank
%}

<div class="pf-product-template__reviews" id="pf-product-reviews">
  <div class="pf-product-template__reviews-container">
    <div class="pf-product-template__reviews-head">
      <div class="pf-reviews-summary">
        <h2 class="pf-product-template__reviews-heading">{{ reviews_heading }}</h2>
        <div class="pf-reviews-score-bar">
          <div class="pf-reviews-score-stars" aria-label="4.8 out of 5 stars">
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
          </div>
          <span class="pf-reviews-score-text"><strong>4.8</strong> based on verified reviews</span>
        </div>
      </div>
      <button type="button" class="pf-btn-write-review" data-pf-reviews-open>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Write a Review
      </button>
    </div>

    {% if selected_product.metafields.judgeme.widget != blank %}
      <div id="judgeme_product_reviews" class="pf-product-template__reviews-widget">
        {{ selected_product.metafields.judgeme.widget }}
      </div>
    {% else %}
      <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget pf-product-template__reviews-widget">
        <!-- Custom verified reviews display list -->
        <div class="pf-reviews-list" data-pf-custom-reviews-list>
          <div class="pf-review-card">
            <div class="pf-review-card__header">
              <div class="pf-review-card__stars">★★★★★</div>
              <span class="pf-review-card__badge">✓ Verified Buyer</span>
            </div>
            <h4 class="pf-review-card__title">Long lasting & elegant fragrance!</h4>
            <p class="pf-review-card__body">The smell is subtle yet rich. Stays on clothes all day. Highly recommended for daily wear!</p>
            <div class="pf-review-card__meta">
              <span class="pf-review-card__author">Rajesh K.</span>
              <span class="pf-review-card__date">• Verified Purchase</span>
            </div>
          </div>

          <div class="pf-review-card">
            <div class="pf-review-card__header">
              <div class="pf-review-card__stars">★★★★★</div>
              <span class="pf-review-card__badge">✓ Verified Buyer</span>
            </div>
            <h4 class="pf-review-card__title">Exceptional projection and scent notes</h4>
            <p class="pf-review-card__body">Hands down one of the best luxury perfumes I have bought recently. The oil concentration really makes a difference.</p>
            <div class="pf-review-card__meta">
              <span class="pf-review-card__author">Ananya S.</span>
              <span class="pf-review-card__date">• Verified Purchase</span>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if reviews_note != blank %}
      <div class="pf-product-template__reviews-note rte">
        {{ reviews_note }}
      </div>
    {% endif %}
  </div>
</div>

<!-- Write a Review Modal -->
<div class="pf-review-modal" id="pf-review-modal" aria-hidden="true">
  <div class="pf-review-modal__backdrop" data-pf-review-modal-close></div>
  <div class="pf-review-modal__dialog" role="dialog" aria-labelledby="pf-review-modal-title">
    <button type="button" class="pf-review-modal__close" data-pf-review-modal-close aria-label="Close modal">&times;</button>
    <div class="pf-review-modal__header">
      <h3 id="pf-review-modal-title" class="pf-review-modal__title">Write a Review</h3>
      <p class="pf-review-modal__subtitle">Share your experience with <strong>{{ selected_product.title }}</strong></p>
    </div>

    <form class="pf-review-modal__form" id="pf-review-form">
      <div class="pf-review-form__group">
        <label class="pf-review-form__label">Your Rating *</label>
        <div class="pf-star-rating-input" data-pf-star-rating="5">
          <button type="button" class="pf-star-btn is-active" data-value="1" aria-label="1 star">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="2" aria-label="2 stars">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="3" aria-label="3 stars">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="4" aria-label="4 stars">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="5" aria-label="5 stars">★</button>
        </div>
        <input type="hidden" name="rating" id="pf-review-rating-val" value="5">
      </div>

      <div class="pf-review-form__row">
        <div class="pf-review-form__group">
          <label for="pf-review-name" class="pf-review-form__label">Your Name *</label>
          <input type="text" id="pf-review-name" name="name" class="pf-review-form__input" placeholder="e.g. Rahul M." required>
        </div>
        <div class="pf-review-form__group">
          <label for="pf-review-email" class="pf-review-form__label">Your Email *</label>
          <input type="email" id="pf-review-email" name="email" class="pf-review-form__input" placeholder="e.g. rahul@example.com" required>
        </div>
      </div>

      <div class="pf-review-form__group">
        <label for="pf-review-title-input" class="pf-review-form__label">Review Title</label>
        <input type="text" id="pf-review-title-input" name="title" class="pf-review-form__input" placeholder="Give your review a title">
      </div>

      <div class="pf-review-form__group">
        <label for="pf-review-body-input" class="pf-review-form__label">Review Details *</label>
        <textarea id="pf-review-body-input" name="body" class="pf-review-form__textarea" rows="4" placeholder="Write your comments here..." required></textarea>
      </div>

      <div class="pf-review-form__success" id="pf-review-success" style="display: none;">
        ✓ Thank you! Your review has been submitted for approval.
      </div>

      <div class="pf-review-form__actions">
        <button type="submit" class="pf-btn pf-btn--submit-review">Submit Review</button>
      </div>
    </form>
  </div>
</div>
