<style>
  .pf-product-template__reviews {
    box-sizing: border-box;
    padding: 32px clamp(16px, 2.1vw, 40px) 24px;
    margin-top: 24px;
    border-top: 1px solid rgba(17, 17, 17, 0.12);
    width: 100%;
    clear: both;
  }
  .pf-product-template__reviews-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }
  .pf-product-template__reviews-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }
  .pf-product-template__reviews-heading {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 6px 0;
    color: #111111;
  }
  .pf-reviews-score-bar {
    display: none;
    align-items: center;
    gap: 10px;
  }
  .pf-reviews-score-stars {
    color: #ffb400;
    font-size: 16px;
    letter-spacing: 2px;
  }
  .pf-reviews-score-text {
    font-size: 14px;
    color: #555555;
  }
  .pf-btn-write-review {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: #111111 !important;
    color: #ffffff !important;
    border: 1px solid #111111 !important;
    border-radius: 9999px !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    flex: 0 0 auto;
  }
  .pf-btn-write-review:hover {
    background: #333333 !important;
    border-color: #333333 !important;
    transform: translateY(-1px);
  }
  .pf-reviews-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  @media screen and (max-width: 749px) {
    .pf-product-template__reviews {
      padding: 24px 16px 20px;
      margin-top: 20px;
    }

    .pf-product-template__reviews-head {
      align-items: flex-start;
      gap: 14px;
    }

    .pf-btn-write-review {
      padding: 9px 14px;
      font-size: 13px !important;
    }
  }
  .pf-review-card {
    background: #fafafa;
    border: 1px solid #ebebeb;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pf-review-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pf-review-card__stars {
    color: #ffb400;
    font-size: 14px;
    letter-spacing: 2px;
  }
  .pf-review-card__badge {
    font-size: 12px;
    font-weight: 600;
    color: #2e7d32;
    background: #e8f5e9;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .pf-review-card__title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    color: #111;
  }
  .pf-review-card__body {
    font-size: 14px;
    line-height: 1.5;
    color: #444;
    margin: 0;
  }
  .pf-review-card__meta {
    font-size: 12px;
    color: #777;
    margin-top: auto;
    display: flex;
    gap: 6px;
  }
  .pf-review-card__author {
    font-weight: 600;
    color: #222;
  }

  /* ---- Write a Review Overlay Modal ---- */
  .pf-review-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.25s ease;
  }
  .pf-review-modal.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .pf-review-modal__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }
  .pf-review-modal__dialog {
    position: relative;
    background: #ffffff;
    width: 90%;
    max-width: 520px;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    transform: translateY(20px);
    transition: transform 0.25s ease;
    max-height: 90vh;
    overflow-y: auto;
    z-index: 2;
  }
  .pf-review-modal.is-active .pf-review-modal__dialog {
    transform: translateY(0);
  }
  .pf-review-modal__close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: transparent;
    border: none;
    font-size: 28px;
    color: #666;
    cursor: pointer;
    line-height: 1;
  }
  .pf-review-modal__close:hover {
    color: #111;
  }
  .pf-review-modal__header {
    margin-bottom: 20px;
  }
  .pf-review-modal__title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 6px 0;
    color: #111;
  }
  .pf-review-modal__subtitle {
    font-size: 13px;
    color: #666;
    margin: 0;
  }
  .pf-review-form__group {
    margin-bottom: 16px;
  }
  .pf-review-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 500px) {
    .pf-review-form__row {
      grid-template-columns: 1fr;
    }
  }
  .pf-review-form__label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
  }
  .pf-star-rating-input {
    display: flex;
    gap: 4px;
  }
  .pf-star-btn {
    background: none !important;
    border: none !important;
    font-size: 24px !important;
    color: #ffb400 !important;
    cursor: pointer !important;
    padding: 0 4px !important;
    box-shadow: none !important;
    transition: color 0.15s ease;
  }
  .pf-review-form__input,
  .pf-review-form__textarea {
    width: 100% !important;
    padding: 10px 14px !important;
    border: 1px solid #ccc !important;
    border-radius: 8px !important;
    font-size: 14px !important;
    font-family: inherit !important;
    box-sizing: border-box !important;
    outline: none !important;
    background: #ffffff !important;
    color: #111111 !important;
    transition: border-color 0.2s ease;
  }
  .pf-review-form__input:focus,
  .pf-review-form__textarea:focus {
    border-color: #111 !important;
  }
  .pf-btn--submit-review {
    width: 100% !important;
    padding: 12px !important;
    background: #111111 !important;
    color: #ffffff !important;
    border: none !important;
    border-radius: 999px !important;
    font-weight: 700 !important;
    font-size: 14px !important;
    cursor: pointer !important;
    transition: background 0.2s ease;
  }
  .pf-btn--submit-review:hover {
    background: #333333 !important;
  }
  .pf-review-form__success {
    background: #e8f5e9;
    color: #2e7d32;
    padding: 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 12px;
  }
</style>

{% liquid
  assign product = selected_product | default: product
  assign reviews_heading = reviews_heading | default: 'Customer Reviews'
  assign reviews_note = reviews_note | default: blank
%}

<div class="pf-product-template__reviews" id="pf-product-reviews">
  <div class="pf-product-template__reviews-container">
    <div class="pf-product-template__reviews-head">
      <div class="pf-reviews-summary">
        <h2 class="pf-product-template__reviews-heading">{{ reviews_heading }}</h2>
        <div class="pf-reviews-score-bar">
          <div class="pf-reviews-score-stars" aria-label="4.8 out of 5 stars">
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
            <span class="pf-star-icon">★</span>
          </div>
          <span class="pf-reviews-score-text"><strong>4.8</strong> based on verified reviews</span>
        </div>
      </div>
      <button type="button" class="pf-btn-write-review" data-pf-reviews-open>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Write a Review
      </button>
    </div>

    <!-- Official Judge.me Widget Code Integration -->
    {% assign has_legacy = false %}
    {% if product.metafields.judgeme.widget.size > 20 %}
      {% assign has_legacy = true %}
    {% endif %}
    <div style='clear:both'></div>
    <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget pf-product-template__reviews-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>
      {% if has_legacy %}
        <div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>
      {% elsif false %}
        <!-- Custom verified fallback reviews display list -->
        <div class="pf-reviews-list" data-pf-custom-reviews-list>
          <div class="pf-review-card">
            <div class="pf-review-card__header">
              <div class="pf-review-card__stars">★★★★★</div>
              <span class="pf-review-card__badge">✓ Verified Buyer</span>
            </div>
            <h4 class="pf-review-card__title">Long lasting & elegant fragrance!</h4>
            <p class="pf-review-card__body">The smell is subtle yet rich. Stays on clothes all day. Highly recommended for daily wear!</p>
            <div class="pf-review-card__meta">
              <span class="pf-review-card__author">Rajesh K.</span>
              <span class="pf-review-card__date">• Verified Purchase</span>
            </div>
          </div>

          <div class="pf-review-card">
            <div class="pf-review-card__header">
              <div class="pf-review-card__stars">★★★★★</div>
              <span class="pf-review-card__badge">✓ Verified Buyer</span>
            </div>
            <h4 class="pf-review-card__title">Exceptional projection and scent notes</h4>
            <p class="pf-review-card__body">Hands down one of the best luxury perfumes I have bought recently. The oil concentration really makes a difference.</p>
            <div class="pf-review-card__meta">
              <span class="pf-review-card__author">Ananya S.</span>
              <span class="pf-review-card__date">• Verified Purchase</span>
            </div>
          </div>
        </div>
      {% endif %}
    </div>

    {% if product.metafields.judgeme.review_widget_data %}
      <script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>
    {% endif %}

    {% if reviews_note != blank %}
      <div class="pf-product-template__reviews-note rte">
        {{ reviews_note }}
      </div>
    {% endif %}
  </div>
</div>

{% comment %}
<!-- Write a Review Modal -->
<div class="pf-review-modal" id="pf-review-modal" aria-hidden="true">
  <div class="pf-review-modal__backdrop" data-pf-review-modal-close></div>
  <div class="pf-review-modal__dialog" role="dialog" aria-labelledby="pf-review-modal-title">
    <button type="button" class="pf-review-modal__close" data-pf-review-modal-close aria-label="Close modal">&times;</button>
    <div class="pf-review-modal__header">
      <h3 id="pf-review-modal-title" class="pf-review-modal__title">Write a Review</h3>
      <p class="pf-review-modal__subtitle">Share your experience with <strong>{{ product.title }}</strong></p>
    </div>

    <form class="pf-review-modal__form" id="pf-review-form">
      <div class="pf-review-form__group">
        <label class="pf-review-form__label">Your Rating *</label>
        <div class="pf-star-rating-input" data-pf-star-rating="5">
          <button type="button" class="pf-star-btn is-active" data-value="1" aria-label="1 star">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="2" aria-label="2 stars">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="3" aria-label="3 stars">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="4" aria-label="4 stars">★</button>
          <button type="button" class="pf-star-btn is-active" data-value="5" aria-label="5 stars">★</button>
        </div>
        <input type="hidden" name="rating" id="pf-review-rating-val" value="5">
      </div>

      <div class="pf-review-form__row">
        <div class="pf-review-form__group">
          <label for="pf-review-name" class="pf-review-form__label">Your Name *</label>
          <input type="text" id="pf-review-name" name="name" class="pf-review-form__input" placeholder="e.g. Rahul M." required>
        </div>
        <div class="pf-review-form__group">
          <label for="pf-review-email" class="pf-review-form__label">Your Email *</label>
          <input type="email" id="pf-review-email" name="email" class="pf-review-form__input" placeholder="e.g. rahul@example.com" required>
        </div>
      </div>

      <div class="pf-review-form__group">
        <label for="pf-review-title-input" class="pf-review-form__label">Review Title</label>
        <input type="text" id="pf-review-title-input" name="title" class="pf-review-form__input" placeholder="Give your review a title">
      </div>

      <div class="pf-review-form__group">
        <label for="pf-review-body-input" class="pf-review-form__label">Review Details *</label>
        <textarea id="pf-review-body-input" name="body" class="pf-review-form__textarea" rows="4" placeholder="Write your comments here..." required></textarea>
      </div>

      <div class="pf-review-form__success" id="pf-review-success" style="display: none;">
        ✓ Thank you! Your review has been submitted for approval.
      </div>

      <div class="pf-review-form__actions">
        <button type="submit" class="pf-btn pf-btn--submit-review">Submit Review</button>
      </div>
    </form>
  </div>
</div>
{% endcomment %}
