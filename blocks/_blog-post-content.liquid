

<div class="blog-post-content rte">
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

<style>
  .blog-post-content {
    max-width: 100%;
    width: 100%;
    margin: 0;
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 14px;
    line-height: 1.75;
    color: rgb(17 17 17 / 0.85);
  }

  .blog-post-content p {
    font-size: 14px;
    line-height: 1.75;
    color: rgb(17 17 17 / 0.8);
    margin-bottom: 18px;
  }

  .blog-post-content h2,
  .blog-post-content h3,
  .blog-post-content h4 {
    font-family: var(--font-heading-family, var(--font-heading--family, 'Manrope', sans-serif));
    color: #111111;
    font-weight: 700;
    line-height: 1.35;
  }

  .blog-post-content h2 {
    font-size: 18px;
    margin-top: 32px;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .blog-post-content h3 {
    font-size: 15.5px;
    font-weight: 600;
    margin-top: 24px;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .blog-post-content h4 {
    font-size: 14px;
    font-weight: 600;
    margin-top: 20px;
    margin-bottom: 8px;
    line-height: 1.45;
  }

  .blog-post-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 24px 0;
    border: 1px solid rgba(17, 17, 17, 0.06);
    display: block;
  }

  .blog-post-content blockquote {
    border-left: 3px solid #111111;
    padding: 12px 18px;
    margin: 24px 0;
    font-size: 14px;
    line-height: 1.7;
    font-style: italic;
    background: rgba(0, 0, 0, 0.02);
    border-radius: 0 6px 6px 0;
    color: rgba(17, 17, 17, 0.85);
  }

  .blog-post-content ul,
  .blog-post-content ol {
    margin-bottom: 20px;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.75;
    color: rgb(17 17 17 / 0.8);
  }

  .blog-post-content li {
    margin-bottom: 6px;
  }

  .blog-post-content a {
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .blog-post-content a:hover {
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "t:names.content",
  "settings": [],
  "presets": [
    {
      "name": "t:names.content"
    }
  ]
}
{% endschema %}
